# Copy to `.env` and fill in. `.env` is gitignored.
#
# Sentry API token. Create at:
#   https://sentry.io/settings/account/api/auth-tokens/
# Required scope: `event:read`. `org:read` and `project:read` also fine but not required for issue listing.
SENTRY_AUTH_TOKEN=

# Sentry org and project slugs (defaults match the tooll.sentry.io project).
SENTRY_ORG=tooll
SENTRY_PROJECT=tooll3
