# Copy to `.env` and fill in. `.env` is gitignored.
#
# Sentry API token. Create at:
#   https://sentry.io/settings/account/api/auth-tokens/
# Required scopes:
#   event:read  — list issues, fetch event details (always needed)
#   event:write — mark issues resolved (needed by Scripts/sentry-issues.ps1 -Resolve)
# Sentry does not let you edit scopes after a token is created — generate a new
# token if your existing one lacks event:write.
SENTRY_AUTH_TOKEN=

# Sentry org and project slugs (defaults match the tooll.sentry.io project).
SENTRY_ORG=tooll
SENTRY_PROJECT=tooll3
