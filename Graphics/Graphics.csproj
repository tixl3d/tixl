<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(SolutionDir)/Tixl.props" />
    <PropertyGroup>
        <TargetFramework>$(TixlNetCoreFrameworkVersion)</TargetFramework>
        <RootNamespace>T3.Graphics</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Graphics.D3D11" />
        <InternalsVisibleTo Include="Graphics.Vulkan" />
        <InternalsVisibleTo Include="Core.Tests" />
    </ItemGroup>
</Project>
