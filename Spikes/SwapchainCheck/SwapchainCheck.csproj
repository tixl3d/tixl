<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(SolutionDir)/Tixl.props" />
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(TixlNetCoreFrameworkVersion)</TargetFramework>
        <RootNamespace>T3.Spikes.SwapchainCheck</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Graphics\Graphics.csproj" />
        <ProjectReference Include="..\..\Graphics.Compat\Graphics.Compat.csproj" />
        <ProjectReference Include="..\..\Graphics.Vulkan\Graphics.Vulkan.csproj" />
    </ItemGroup>
</Project>
