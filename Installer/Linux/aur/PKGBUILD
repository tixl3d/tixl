# Reference PKGBUILD for an AUR `tixl-git` package. The published copy lives in the AUR's own git repo;
# keep this one in sync when the build or the staged layout changes.

pkgname=tixl-git
pkgver=r0
pkgrel=1
pkgdesc="Real-time motion graphics and VJ tool"
arch=('x86_64')
url="https://tixl.app"
license=('MIT')
# shader-slang from extra provides slangc; TiXL is tested with its 2026.18 line.
depends=('dotnet-sdk>=10' 'vulkan-icd-loader' 'shader-slang' 'gcc-libs' 'glibc')
makedepends=('git' 'file')
optdepends=('vulkan-validation-layers: diagnostics for the Vulkan backend'
            'libpulse: audio through PipeWire or PulseAudio'
            'alsa-lib: audio through ALSA')
provides=('tixl')
conflicts=('tixl')
options=('!strip' '!debug')
source=("tixl::git+https://github.com/tixl3d/tixl.git#branch=feat/linux-port")
sha256sums=('SKIP')

pkgver() {
    cd tixl
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd tixl
    export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 NUGET_PACKAGES="$srcdir/nuget"
    # dotnet-sdk is a dependency anyway, so the editor uses the system runtime.
    Installer/Linux/build-tarball.sh --stage-only --system-dotnet
}

package() {
    local stage
    stage="$(find "$srcdir/tixl/Installer/Linux/Output" -mindepth 1 -maxdepth 1 -type d -name 'tixl-*' | head -1)"

    install -d "$pkgdir/usr/lib/tixl" "$pkgdir/usr/share" "$pkgdir/usr/bin"
    cp -a "$stage/." "$pkgdir/usr/lib/tixl/"
    cp -a "$stage/share/." "$pkgdir/usr/share/"
    rm -rf "$pkgdir/usr/lib/tixl/share"
    ln -s /usr/lib/tixl/TiXL "$pkgdir/usr/bin/tixl"

    install -Dm644 "$srcdir/tixl/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    cp -a "$srcdir/tixl/Dependencies/licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
}
