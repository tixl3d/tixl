<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(SolutionDir)/Tixl.props" />
    <PropertyGroup>
        <TargetFramework>$(TixlNetFrameworkVersion)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <Content Include="../Dependencies/linux-x64/libtixlaudio.so" Visible="false" Link="libtixlaudio.so" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <Content Include="../Dependencies/tixlaudio.dll" Visible="false" Link="tixlaudio.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The layout rewriter has no ImGui dependency, so it is tested as linked source instead of referencing the Editor. -->
    <ItemGroup>
        <Compile Include="../Editor/Gui/Windows/Layouts/ImGuiLayoutScaling.cs" Link="Layouts/ImGuiLayoutScaling.cs" />
        <None Include="../.Defaults/Layouts/layout0.json" Link="Layouts/layout0.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../.Defaults/Layouts/layout12.json" Link="Layouts/layout12.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Core.csproj" />
        <ProjectReference Include="..\Graphics\Graphics.csproj" />
        <ProjectReference Include="..\Graphics.Compat\Graphics.Compat.csproj" />
        <ProjectReference Include="..\Graphics.D3D11\Graphics.D3D11.csproj" />
        <ProjectReference Include="..\Graphics.Vulkan\Graphics.Vulkan.csproj" />
    </ItemGroup>
</Project>
