    "dance-phase/bar-phase.meta.json": { "usedBy": "Core (beat phase tracking)", "licence": "MIT" },
    "libusb-1.0.dll": { "usedBy": "Lib [SwiftCamDevice], Windows", "licence": "LGPL-2.1-or-later", "note": "dynamically loaded" },
    "tixlaudio.dll": { "usedBy": "Core audio engine, Windows", "licence": "MIT AND MIT-0", "note": "TiXL code plus miniaudio" },
    "linux-x64/libtixlaudio.so": { "usedBy": "Core audio engine, Linux", "licence": "MIT AND MIT-0", "note": "TiXL code plus miniaudio" },
    "osx/libtixlaudio.dylib": { "usedBy": "Core audio engine, macOS", "licence": "MIT AND MIT-0", "note": "TiXL code plus miniaudio", "builtInCi": true }
