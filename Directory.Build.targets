<!-- SolutionRoot\Directory.Build.targets -->
<Project>
  <!-- Packages like Microsoft.ML.OnnxRuntime ship Android/iOS native blobs (~110 MB) under runtimes/.
       TiXL never runs there, but the SDK copies them into every output folder that references the package. -->
  <Target Name="ExcludeMobileNativeRuntimes" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'android' Or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'ios'" />
    </ItemGroup>
  </Target>

  <!-- An operator package lists in TixlCopyLocalPackages the NuGet packages whose runtime assemblies it must carry
       next to its own assembly. Unlike CopyLocalLockFileAssemblies this copies only those packages, not everything
       that arrives transitively through Core (OnnxRuntime, SharpDX, ...), which the editor already provides. -->
  <Target Name="CopySelectedPackageAssemblies" AfterTargets="ResolvePackageAssets" Condition="'$(TixlCopyLocalPackages)' != ''">
    <ItemGroup>
      <RuntimeCopyLocalItems>
        <TixlSelected>$([System.String]::Copy(';$(TixlCopyLocalPackages);').ToLowerInvariant().Contains($([System.String]::Copy(';%(NuGetPackageId);').ToLowerInvariant())))</TixlSelected>
      </RuntimeCopyLocalItems>
      <RuntimeTargetsCopyLocalItems>
        <TixlSelected>$([System.String]::Copy(';$(TixlCopyLocalPackages);').ToLowerInvariant().Contains($([System.String]::Copy(';%(NuGetPackageId);').ToLowerInvariant())))</TixlSelected>
      </RuntimeTargetsCopyLocalItems>
      <NativeCopyLocalItems>
        <TixlSelected>$([System.String]::Copy(';$(TixlCopyLocalPackages);').ToLowerInvariant().Contains($([System.String]::Copy(';%(NuGetPackageId);').ToLowerInvariant())))</TixlSelected>
      </NativeCopyLocalItems>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.TixlSelected)' == 'True'" />
      <!-- Native libraries keep their runtimes/<rid>/native/ folder, where .NET looks for them -->
      <ReferenceCopyLocalPaths Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.TixlSelected)' == 'True'" />
      <ReferenceCopyLocalPaths Include="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.TixlSelected)' == 'True'" />
    </ItemGroup>
  </Target>
</Project>
