    {
      "Id": "913515fc-da9b-44b9-93bb-a98d07634a9f"/*CustomDrawMesh*/,
      "SymbolId": "c78d114e-b404-491f-93a8-024a382586bd",
      "InputValues": [
        {
          "Id": "05feb9d0-3bfc-4c96-b79e-b884132813e9"/*B*/,
          "Type": "System.Single",
          "Value": 0.5
        },
        {
          "Id": "7a6ca5a8-17a6-4a8b-9610-ed4c9e292cfe"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "\nfloat3 vn=mul(ComputeNormal(pin, pin.tbnToWorld).xyz,transpose((float3x3)CameraToWorld));\npin.texCoord.xy=vn.xy*B*float2(1,-1)+.5;\nSetupFrag(pin);\n//frag.Metalness += Points[pin.pointIndex].FX1;\nfloat3 nf=-normalize(cross(ddx(pin.worldPosition.xyz),ddy(pin.worldPosition.xyz)));\nfrag.N=normalize(lerp(nf,frag.N,A));\nc=frag.albedo;\n//c = ComputePbr();\n\n"
        },
        {
          "Id": "e7dc01ac-cb1d-409a-b8f3-ad22b1255771"/*A*/,
          "Type": "System.Single",
          "Value": 1.0
        }
