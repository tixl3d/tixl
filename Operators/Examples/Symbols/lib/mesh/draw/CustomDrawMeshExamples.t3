    {
      "Id": "60763813-851d-44d2-a431-f27f1612fc64"/*CustomSDF*/,
      "SymbolId": "637d00e4-ab63-4fe3-8e63-1e206c728841",
      "InputValues": [
        {
          "Id": "3c366d34-c398-410e-972b-d8cc2baffddb"/*A*/,
          "Type": "System.Single",
          "Value": 3.0
        },
        {
          "Id": "56e5d5ec-ec59-4ea0-85c1-1eca3dcb5790"/*C*/,
          "Type": "System.Single",
          "Value": 0.8
        },
        {
          "Id": "874ae9c8-5835-4d0c-9bef-253ac75d19b2"/*B*/,
          "Type": "System.Single",
          "Value": 1.206
        },
        {
          "Id": "bde89b93-224c-4a3f-85ab-d85b0401c02a"/*DistanceFunction*/,
          "Type": "System.String",
          "Value": "// by gaziya5 aka gaz on https://jbaker.graphics/writings/DEC.html\nfloat s=A;  // A: 3\nfor(int i = 0; i < 4; i++) {\n  p=mod(p-1, 2)-1;   \n  float r=B / dot(p,p); // B: 1.2\n  p*=r; s*=r;\n}\np = abs(p)-C; // C: 0.8\nif (p.x < p.z) p.xz = p.zx;\nif (p.y < p.z) p.yz = p.zy;\nif (p.x < p.y) p.xy = p.yx;\nreturn length(cross(p,normalize(float3(0,1,1))))/s-.001;"
        }
      ],
      "Outputs": []
    },
