    {
      "Id": "a32822c9-0037-41bd-911c-1b149a0f637b"/*Blob*/,
      "SymbolId": "27b0e1af-cb2e-4603-83f9-5c9b042d87e6",
      "InputValues": [
        {
          "Id": "0c49c872-852a-4f15-8cde-f3cda743c28e"/*FeatherBias*/,
          "Type": "System.Single",
