  "TourPoints": [
    {
      "Id": "6e193163-87ac-5b38-8797-4f482cab42e0",
      "ChildId": "7aa0337e-24eb-5329-9823-0315fdcbe64f",
      "Description": "Hills from spheres, smoothly blended into a floor plane: the terrain is only a formula."
    },
    {
      "Id": "1464de51-1e3c-5511-b0eb-e762b53dd3d9",
      "ChildId": "5ee2ac76-cb78-5d4c-a5f9-b58d472a1697",
      "InputId": "0700d5cb-6a1e-43ad-b7fb-b9b7b1415584",
      "Description": "[RaymarchField] draws the field and writes depth, so meshes drawn afterwards sit inside the scene correctly.",
      "Style": "InfoFor"
    },
    {
      "Id": "2d3b011b-4bff-5b22-91e1-4502e3e8096e",
      "ChildId": "5bfbeceb-14ca-57b8-92e1-a5bbba056c61",
      "Description": "To collide with the field, physics samples it on a grid of points.",
      "Style": "InfoFor"
    },
    {
      "Id": "364a29cf-dedc-5d57-92c1-bfd048517019",
      "ChildId": "5ae37742-4906-5e34-9255-f39df13b63a0",
      "Description": "[SampleFieldPoints] writes the field distance into every point.",
      "Style": "InfoFor"
    },
    {
      "Id": "71735257-183a-5e3e-93e9-2419a3a7781d",
      "ChildId": "9c5c45df-937e-5889-8a6c-83dc7c5c0075",
      "InputId": "77ee7ca9-a2db-4de9-bb9c-21ec4f1bbeaf",
      "Description": "The terrain never changes, so its samples are read back once.",
      "Style": "InfoFor"
    },
    {
      "Id": "146025e0-8b11-5c8c-a756-23602c00bdd5",
      "ChildId": "86af157d-8307-530c-b072-11e958f4c2ad",
      "Description": "[SdfPointsToGeometry] extracts the surface: the collider geometry.",
      "Style": "InfoFor"
    },
    {
      "Id": "1a9ed8f8-d813-5b7b-adf1-480bfb80b489",
      "ChildId": "ed6ed762-bfb4-5748-9dff-b079d72a7f9a",
      "Description": "The blob wanders around with [AnimVec3].",
      "Style": "InfoFor"
    },
    {
      "Id": "7c792b4f-5e86-52b1-b31c-bc353093d8c0",
      "ChildId": "13b1a25f-49a3-5c9a-8305-1973d20ca384",
      "InputId": "70f094d8-c499-40bf-ab28-0081297a5985",
      "Description": "The blob collides as a Kinematic sphere at the same position: no sampling or mesh rebuild on any frame.",
      "Style": "InfoFor"
    },
    {
      "Id": "751b46fd-5159-53c9-a820-d697b1d7281e",
      "ChildId": "6b5a139e-4209-51a4-8c4c-ff641acefa69",
      "Description": "Tori from a GPU mesh through [MeshToGeometry]; Auto splits them into hulls.",
      "Style": "InfoFor"
    }
  ]
}