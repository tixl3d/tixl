  "TourPoints": [
    {
      "Id": "87b44861-1f10-5e2d-8267-413d1c8caa48",
      "ChildId": "154bc513-4ef4-5d84-b5ea-6b6be1d602f4",
      "Description": "Twenty-four links from a line of points. CollisionGroup 1 lets neighbouring links overlap without pushing each other away."
    },
    {
      "Id": "d84db3ac-8c5d-520c-a5b4-5013a5ff7bc5",
      "ChildId": "7a744780-7a27-5b0d-98d8-835531405bce",
      "InputId": "2148cccb-f1d5-41a3-99e1-057d79d29622",
      "Description": "Mode Chain joins point 0 to 1, 1 to 2 and so on: one operator for the whole rope.",
      "Style": "InfoFor"
    },
    {
      "Id": "4425ccc1-c951-513e-9a7c-dc018688761e",
      "ChildId": "cd9e270e-d229-5b12-b01c-6dd27f847456",
      "InputId": "e262b93c-a458-48df-a256-9e508f71b7b9",
      "Description": "Mode World holds a body where it starts; InstanceIndex 0 pins only the first link.",
      "Style": "InfoFor"
    },
    {
      "Id": "e77636a5-914c-5825-a69d-d97b47d69f86",
      "ChildId": "9103c3f7-606b-574f-a7e7-ca9de71f50eb",
      "InputId": "70f094d8-c499-40bf-ab28-0081297a5985",
      "Description": "The pivot is Kinematic: it has infinite mass and never moves unless its Position changes.",
      "Style": "InfoFor"
    },
    {
      "Id": "cdce3e92-1eb1-5643-b53a-2537747bf407",
      "ChildId": "bad2347a-d6bb-5652-a643-717fb28a7ca4",
      "InputId": "da042534-228c-44e5-8f92-37626fb97964",
      "Description": "A Hinge lets the plank turn around the Z axis only.",
      "Style": "InfoFor"
    },
    {
      "Id": "dda5ae91-1e75-5d5f-bef5-1f78c2758e6d",
      "ChildId": "5e3c16a9-76ad-5bf2-b344-95ab7adc4ae5",
      "InputId": "974ca0a2-5f02-4ccd-817b-5114070b243e",
      "Description": "A heavy crate drops on the right end and catapults the light one on the left.",
      "Style": "InfoFor"
    },
    {
      "Id": "2773536e-9d37-506f-9303-e21f8057fb46",
      "ChildId": "83039f37-7fa6-5b6d-8df5-f51f3e6f8c03",
      "InputId": "943e0e36-52d5-4721-aea1-c66e221d71ed",
      "Description": "Mode Nearby links every two knots closer than LinkDistance: a net, or cloth.",
      "Style": "InfoFor"
    },
    {
      "Id": "939a5aee-5df3-5336-9e38-d00e237e533f",
      "ChildId": "5ae59abb-cd58-5836-b76c-4752bc5551c9",
      "InputId": "54247fde-224c-4764-97e1-01d1e725acdc",
      "Description": "Joints like more Substeps and SolverIterations than loose bodies.",
      "Style": "Tip"
    }
  ]
}