    {
      "Id": "069894cd-7db0-5b2a-aca7-c6764b52489a",
      "ChildId": "7986aae1-4385-58bb-93a3-3983b6a96462",
      "Description": "Four wheels from a 2 x 2 grid. The grid turns every point 90 degrees, so the cylinder axis lies sideways.",
      "Style": "InfoFor"
    },
    {
      "Id": "1e9dbfdd-bb87-5216-b63c-3780228c0c67",
      "ChildId": "ffa1e88f-1f62-5e16-b40b-e8c9fe4f7d14",
      "InputId": "15ea23f0-7b4b-43a5-a245-98cac83fa0b6",
      "Description": "AutoAnchor puts the hinge at each wheel, so one joint fits all four. MotorSpeed drives them.",
      "Style": "InfoFor"
    },
    {
      "Id": "d9a9b7e7-9ea0-5532-9985-a912dfb86538",
      "ChildId": "dbb22090-e4ec-50ae-9227-dafa64555468",
      "InputId": "10919c3d-5979-4499-a958-c347008f7c12",
      "Description": "MassMode FromDensity weighs the crates by their volume.",
      "Style": "InfoFor"
    },
    {
      "Id": "a2e50eae-56c3-5709-8779-de88d7c578b3",
      "ChildId": "c7447a1b-9d32-5953-8b47-687954571412",
      "Description": "[RigidBodyPoints] outputs just the crates' poses, with each body's size as the point scale.",
      "Style": "InfoFor"
    },
    {
      "Id": "03199ef7-90a1-5200-abaf-4498b1063948",
      "ChildId": "1e0c475b-0e36-5fbf-ab96-643d877358aa",
      "Description": "One cube mesh repeated at every pose: cheap even for thousands of bodies.",
      "Style": "InfoFor"
    }
