    {
      "Id": "9e0ead12-c2bc-5860-a5df-d518f92a7776",
      "ChildId": "29762861-a50f-50d6-9b73-dd930fedc9c7",
      "InputId": "e13e2b87-7a04-4197-82a8-a11fab87d1f9",
      "Description": "Geometry with several parts: every part becomes its own body, placed where it sits in the cube.",
      "Style": "InfoFor"
    },
    {
      "Id": "587d01fd-abd3-5c9f-a98e-7240b22a2dcc",
      "ChildId": "f517fd1e-4d68-505f-9c62-4a09168c2401",
      "Description": "Each part comes back moved by its body. Any geometry operator can follow, for example [BevelGeometry].",
