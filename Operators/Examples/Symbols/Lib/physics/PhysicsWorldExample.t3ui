  "TourPoints": [
    {
      "Id": "861d7645-1ccb-5f4c-9eae-48950fbbe0ac",
      "ChildId": "05c94afa-2352-56c8-9bb5-6fdd52dbc432",
      "Description": "Every body is a [RigidBody] description. This one is Static: it never moves, but everything collides with it."
    },
    {
      "Id": "fcaed4b6-e387-55c0-9fd7-ede550cfc6ee",
      "ChildId": "fb12e5a6-2a75-585a-bb6c-39fce9759570",
      "InputId": "847babc8-53b1-457d-ab45-f85b8eff80c9",
      "Description": "Five balls differ only in Bounciness, from 0 to 1. Watch how high each one comes back.",
      "Style": "InfoFor"
    },
    {
      "Id": "812a6e16-9133-5a39-8bd5-75533968d89d",
      "ChildId": "c55b7d52-1270-593a-864f-405793ae0ed5",
      "InputId": "c37e0055-1f11-4b35-8d1f-0a3eb0c64a57",
      "Description": "Connecting Points makes one body per point: fifteen dominoes from one operator.",
      "Style": "InfoFor"
    },
    {
      "Id": "46287df1-5a46-5996-8e12-49c2ce578057",
      "ChildId": "e3f83822-6040-5d26-af06-8a99d084fce1",
      "InputId": "e965e0ce-38ce-46da-a7ac-e730d7876d29",
      "Description": "A starting LinearVelocity sends this ball into the first domino.",
      "Style": "InfoFor"
    },
    {
      "Id": "a6ed9bda-7c48-5a55-b4dc-3324d0323efb",
      "ChildId": "e9321e96-9735-573b-8238-866af1749779",
      "Description": "The [PhysicsWorld] collects all bodies and steps the simulation with the playback time.",
      "Style": "InfoFor"
    },
    {
      "Id": "98b4da13-84c0-596a-952e-ed101472e807",
      "ChildId": "e9321e96-9735-573b-8238-866af1749779",
      "InputId": "47787d21-9ddc-45ab-97f6-a573a717675c",
      "Description": "Its Contacts output lists every impact of the frame as points.",
      "Style": "InfoFor"
    },
    {
      "Id": "60140419-2a60-5eea-9ea7-46956cf111d9",
      "ChildId": "b15c4a13-d195-50e9-91f1-3eeed4111e8f",
      "Description": "Drawing a small mesh at the contact points gives a spark wherever something hits.",
      "Style": "InfoFor"
    },
    {
      "Id": "61277e2f-c923-5bb0-ab89-a4bbc7dacec9",
      "ChildId": "2df9e65a-65ac-5187-aa2f-724bfca740c8",
      "Description": "[RigidBodyGeometry] returns bodies at their simulated poses as geometry, so no separate mesh has to match the collider.",
      "Style": "InfoFor"
    },
    {
      "Id": "3c19e716-5a0e-5255-ba52-80f0dacc103e",
      "ChildId": "e9321e96-9735-573b-8238-866af1749779",
      "InputId": "8279a472-cae2-4427-8de7-2fe51bde82b4",
      "Description": "Press Reset on the World and play again.",
      "Style": "CallToAction"
    }
  ]
}