    {
      "Id": "4dd77551-ac2c-59fb-b3fe-ca865ea47ef7",
      "ChildId": "30a1fbe4-f79f-579d-991b-ea047a6c6937",
      "InputId": "a53afcdd-64d2-474b-8a3d-e437f9681de4",
      "Description": "[LoadVdb] reads the file on a background thread and places it: Scale and Translation bring it to scene size.",
      "Style": "InfoFor"
    },
    {
      "Id": "2ac4af07-54d6-5335-b606-5ad3b290e722",
      "ChildId": "ccfe9111-02e5-5e34-8273-da619684e097",
      "InputId": "d21b910d-a7d9-507f-b7f6-4053dbdee86a",
      "Description": "The file has 22 million voxels; resampling to coarser voxels keeps the mesh light.",
      "Style": "InfoFor"
    },
    {
      "Id": "c070e77b-0b66-54af-94f8-449633a60418",
      "ChildId": "de979743-11cf-59a6-955d-438a55a8655c",
      "Description": "The armadillo mesh is a static collider; its collision tree is built in the background too.",
      "Style": "InfoFor"
    },
    {
      "Id": "64b4c726-6a8b-590f-a013-78a836644ec6",
      "ChildId": "6d2ef3f1-bd79-589a-9ce4-d4501957256b",
      "InputId": "f32c0f35-8925-491c-ad36-757c30c37142",
      "Description": "A sequence: %d in Path is replaced by Frame. ZUp stands the EmberGen cache upright.",
      "Style": "InfoFor"
    },
    {
      "Id": "25667142-7844-5712-864b-d53f6428fbba",
      "ChildId": "c4c6ccf9-39cc-5a28-a612-b109fc59ba67",
      "InputId": "ccdea113-c046-4ec2-b1fb-30d6e15db7ce",
      "Description": "Playback time at 24 frames per second, looped over the 100 frames of the cache.",
      "Style": "InfoFor"
    },
    {
      "Id": "db352886-699f-5f16-8585-f97d5aa987d5",
      "ChildId": "5d43bd63-de91-5157-9ce3-b8238dba413a",
      "InputId": "d7a5ce51-3e0f-57b5-81b6-3599334f0d4d",
      "Description": "[NanoVdbRender] reads density from the depth below zero, so the positive temperature is negated.",
      "Style": "InfoFor"
    },
    {
      "Id": "f68fe5f7-17fb-5a6b-a6b1-8ff492dc150e",
      "ChildId": "6c64b23b-0a84-5ec3-88e6-ec1029423876",
      "InputId": "c1140119-00fa-56d4-8f71-6bb4a79366a8",
      "Description": "Temperature is drawn as hot smoke, flames as fire. Tune SmokeDensity and FireIntensity to taste.",
      "Style": "CallToAction"
    }
  ]
}