  "TourPoints": [
    {
      "Id": "b9d757dd-f194-599b-8c88-5aa677c0fce0",
      "ChildId": "dba3a7ba-37d9-501e-8c1d-518c1492d3ef",
      "InputId": "3d95a0ca-fd17-53e5-817f-fdfe293f3b6e",
      "Description": "Mode Displace pushes the surface along the noise. Amplitude is in voxels and cannot reach beyond the BandWidth of the input.",
      "Style": "InfoFor"
    },
    {
      "Id": "b7c4f27b-ad6b-5809-bb13-fe1c42c0be02",
      "ChildId": "51cd85de-6a81-5675-a7b8-98289a9f6d0e",
      "InputId": "2ad87fa8-ac60-5972-a42e-38a4a224c4f1",
      "Description": "Dilate grows the surface outwards by Radius: the bumps swell and the dents between them close up. Erode, Open and Close are the other operations.",
      "Style": "InfoFor"
    },
    {
      "Id": "c839df12-dbb3-5ce2-82fd-92af0a6c4da2",
      "ChildId": "866a2814-643a-53e0-b2ee-4d63dcc16c4c",
      "InputId": "f4356aa3-0941-5c80-bc46-4670bb4edf85",
      "Description": "A Gaussian [VolumeFilter] blurs the voxel values, which softens what is left.",
      "Style": "InfoFor"
    },
    {
      "Id": "836aa992-fdf2-5f71-9074-0b08370c0096",
      "ChildId": "dba3a7ba-37d9-501e-8c1d-518c1492d3ef",
      "InputId": "a8c2bbd9-1601-59c4-bbdb-db3189a7bdf7",
      "Description": "Connect an [AnimVec3] to Offset to make the shape flow. Every change rebuilds the chain on the CPU, so keep VoxelSize coarse while animating.",
      "Style": "Tip"
    },
    {
      "Id": "87d68c95-ef8f-5bb9-bbe3-cf94e51f2ae5",
      "ChildId": "dba3a7ba-37d9-501e-8c1d-518c1492d3ef",
      "InputId": "1ee7f2e0-d46f-5bd6-909e-1cd0cb15d0d0",
      "Description": "Try Fractal Ridged for sharp crests, or NoiseType Worley for cells.",
      "Style": "CallToAction"
    }
  ]
}