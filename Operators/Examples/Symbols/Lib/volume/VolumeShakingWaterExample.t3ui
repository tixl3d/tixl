    },
    {
      "Id": "734c1f18-2b8e-5d4b-9ce1-f7f1cfb06bec",
      "ChildId": "de102d78-f5e3-5394-96e1-49c4126d347d",
      "InputId": "fa3b21cd-383f-5f82-9b5a-57c316cdef7d",
      "Description": "Displacing the water slab with noise gives it waves.",
      "Style": "InfoFor"
    },
    {
      "Id": "06ca6692-b140-5832-862a-43674abaf1b4",
      "ChildId": "11da8e15-3354-50e1-ac37-2980ee022a5c",
      "InputId": "e0616bd7-2a4a-5953-95a5-a11929871bd9",
      "Description": "Intersection keeps only the water inside the box, so no wave pokes through a wall.",
      "Style": "InfoFor"
    },
    {
      "Id": "9ba42933-2e37-5415-8ee7-9b65b82ec210",
