  "TourPoints": [
    {
      "Id": "8ac6ac83-0fcf-5495-911c-dad66e750b6a",
      "ChildId": "fb507bd7-eb91-5aa8-b660-0bc2c79eefed",
      "Description": "A [VolumePrimitive] is a shape made of voxels: signed distances to its surface, stored only near it."
    },
    {
      "Id": "3ff70926-c37b-5f06-988c-310e410cf771",
      "ChildId": "2c79b3db-f907-50f6-8e45-2483f61b8741",
      "InputId": "d2cf0b36-bd51-5f39-9ae4-ea24893f1222",
      "Description": "Shape picks the primitive; Size is its full extent and Center places it.",
      "Style": "InfoFor"
    },
    {
      "Id": "50b12e9d-09d9-5ccf-9801-1a8ecacdb637",
      "ChildId": "2c79b3db-f907-50f6-8e45-2483f61b8741",
      "InputId": "89ac8fe1-dfda-5b97-8d05-1c5378f896b4",
      "Description": "VoxelSize is the grid resolution. Halve it and the surface gets sharper, at four times the memory.",
      "Style": "InfoFor"
    },
    {
      "Id": "360a0178-bdc1-516d-aafc-69a93f09b39f",
      "ChildId": "0b8dd9c1-c3fd-585c-bfde-de11fcaa0823",
      "InputId": "345f946b-8c36-5548-a569-4123e0544b8f",
      "Description": "[VolumeToMesh] extracts the surface where the distance is Isovalue, 0 for a level set.",
      "Style": "InfoFor"
    },
    {
      "Id": "a161a0ab-bcc9-5b08-acf7-838889aa9461",
      "ChildId": "71dc032e-08a1-50cd-944f-0989f2c3e9d9",
      "InputId": "89ac8fe1-dfda-5b97-8d05-1c5378f896b4",
      "Description": "Try changing a VoxelSize to 0.1 to see how coarse voxels round everything off.",
      "Style": "CallToAction"
    }
  ]
