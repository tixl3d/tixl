  "TourPoints": [
    {
      "Id": "1f4d3f00-b9df-5efd-a17e-88c6aad49139",
      "ChildId": "2686bcd8-e2e7-5dc1-b724-eb56c0de7475",
      "InputId": "bd7e2b17-0c96-52d3-a674-68d58855057a",
      "Description": "[VolumeToPoints] gives one point per active voxel, as a CPU list and as a GPU buffer.",
      "Style": "InfoFor"
    },
    {
      "Id": "63518ef8-832f-5d9e-a565-bf8c042ab18f",
      "ChildId": "2338ef35-ba46-5da3-96a1-2b516d6a3f6c",
      "InputId": "1d104dc8-1b12-469f-a2b3-d9093d2634f0",
      "Description": "The orange boxes are the nodes of the sparse tree: a VDB stores data only where the surface is.",
      "Style": "InfoFor"
    },
    {
      "Id": "43533316-a391-5497-b1b6-e510bc41614d",
      "ChildId": "27b8ad19-ef08-5e87-9df8-1b9f3d513949",
      "InputId": "b88c73a2-e66c-530e-9e72-a52bf2c27e13",
      "Description": "[VolumeToTexture3D] bakes a dense texture; MaxResolution caps its size along the longest axis.",
      "Style": "InfoFor"
    },
    {
      "Id": "212a2baf-522f-5245-a905-2c93686ce6e0",
      "ChildId": "850d2d0f-5543-578f-a764-3a6bc73f011c",
      "Description": "[VolumeField] turns the texture into a field, so it combines with every SDF operator.",
      "Style": "InfoFor"
    },
    {
      "Id": "a3deefd6-0b42-5fd9-abb7-0fff5bb6dae7",
      "ChildId": "d8e88c96-334f-56a1-94b1-5c1fa8fd2583",
      "InputId": "0700d5cb-6a1e-43ad-b7fb-b9b7b1415584",
      "Description": "The raymarch is drawn first and writes depth, so the meshes and points sit correctly around it.",
      "Style": "InfoFor"
    }
  ]
