{
  "FormatVersion": 3,
  "Id": "9a7b3c8d-4e2f-5a6b-7c8d-9e0f1a2b3c4d"/*StreamDiffusion*/,
  "Description": "Realtime video-to-video diffusion with the StreamDiffusion V2 causal Wan2.1 model on ONNX Runtime. Every frame of the connected video or camera input is restyled with the prompt; the output size comes from the export.\n\nProduce the ONNX export once with the scripts in Operators/StreamDiffusion/tools/streamdiffusionv2; the checkpoint download in the model browser (Settings > AI Models) provides model.pt, the T5 text encoder and the tokenizer.\n\nTips:\n- Connect a video or camera to `InputImage` - the model is video-only and cannot generate from text alone.\n- `Model` picks the export from the model store (Auto = first valid); models are installed in Settings > AI Models.\n- `Steps` is the KV-cache batch size (1-4); every extra step doubles the cache.\n- `Strength` is how strongly each frame is re-noised: lower keeps more of the previous frame.\n- `FastDecode` decodes one latent instead of a three-latent window: faster, less temporal smoothing.\n- `Feedback` blends the previous output frame to smooth flicker.\n- Use a CUDA or TensorRT GPU; DirectML and CPU work but are far slower.\n\nAKA: ai, generation, diffusion, onnx, streamdiffusion, streamdiffusion v2, video diffusion, wan, video to video, restyle",
  "InputUis": [
    {
      "InputId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"/*Model*/,
      "Position": {
        "X": -250.0,
        "Y": -350.0
      },
      "Description": "Which export in the model store to run. Auto picks the first valid one; the dropdown lists everything Settings > AI Models has installed. Models are managed in the AI settings, never as paths here.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "a3b4c5d6-e7f8-9012-6789-123456789012"/*CudaDevice*/,
      "Position": {
        "X": -250.0,
        "Y": -200.0
      },
      "Description": "DirectML device index for multi-GPU systems. Shows available adapters in dropdown."
    },
    {
      "InputId": "b4c5d6e7-c8d9-4e0f-a1b2-3c4d5e6f7a8b"/*MatchInputAspect*/,
      "Position": {
        "X": 150.0,
        "Y": 350.0
      },
      "Description": "Stretches the model output (e.g. 256x256) back over the input image dimensions, so the output matches the source aspect ratio and pixel size for compositing."
    },
    {
      "InputId": "b4c5d6e7-f8a9-0123-7890-234567890123"/*TriggerGenerate*/,
      "Position": {
        "X": -250.0,
        "Y": 450.0
      },
      "Description": "Momentarily true to trigger a single generation when AutoGenerate is off."
    },
    {
      "InputId": "b7c8d9e0-f1a2-3456-7890-123456789012"/*FastDecode*/,
      "Position": {
        "X": -250.0,
        "Y": 525.0
      },
      "Description": "V2 only: decode one latent instead of a three-latent window. Saves about 20 ms per frame on TensorRT with slightly less temporal smoothing."
    },
    {
      "InputId": "c1d2e3f4-a5b6-4c7d-8e9f-0a1b2c3d4e5f"/*TargetFps*/,
      "Position": {
        "X": 150.0,
        "Y": 300.0
      },
      "Description": "Pace the stream at this many frames per second (default 16, matching capture and downstream). 0 runs as fast as the GPU allows; identical input frames cost nothing at any rate."
    },
    {
      "InputId": "c3d4e5f6-a7b8-9012-cdef-123456789012"/*Prompt*/,
      "Position": {
        "X": -250.0,
        "Y": -150.0
      },
      "Description": "Text prompt describing the desired image. Be descriptive for better results.",
      "Usage": "Default"
    },
    {
      "InputId": "c5d6e7f8-a9b0-1234-8901-345678901234"/*AutoGenerate*/,
      "Position": {
        "X": -250.0,
        "Y": 500.0
      },
      "Description": "Continuously regenerate when inputs change. Disable for manual trigger mode."
    },
    {
      "InputId": "c7d8e9f0-a1b2-3456-7890-1234567890ab"/*ExecutionProvider*/,
      "Position": {
        "X": -250.0,
        "Y": 550.0
      },
      "Description": "Hardware used for inference. The dropdown lists only the accelerations that can actually run this model on this operating system: Windows and Linux offer CUDA and TensorRT, macOS offers CoreML. DirectML cannot run the V2 model (its DiT/VAE 5D reshapes fail on the DML provider), and a saved DirectML choice snaps to CUDA. A provider that cannot initialize falls back to the next one, ending at CPU."
    },
    {
      "InputId": "c9d0e1f2-a3b4-5678-2345-789012345678"/*Strength*/,
      "Position": {
        "X": -250.0,
        "Y": 100.0
      },
      "Description": "In img2img mode, how much to transform the input (0.0 = no change, 1.0 = completely new).",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "c9d0e1f2-a3b4-5678-9abc-def012345678"/*Feedback*/,
      "Position": {
        "X": -250.0,
        "Y": 425.0
      }
    },
    {
      "InputId": "d0e1f2a3-b4c5-6789-3456-890123456789"/*Steps*/,
      "Position": {
        "X": -250.0,
        "Y": 200.0
      },
      "Description": "The V2 step count is the KV-cache batch size: 1 is realtime, 2-4 add temporal context at twice the cache per step. Changing it restarts the stream.",
      "Min": 1,
      "Max": 50,
      "ClampMin": true
    },
    {
      "InputId": "d2e3f4a5-b6c7-8901-2345-678901234567"/*Debug*/,
      "Position": {
        "X": -250.0,
        "Y": 650.0
      },
      "Description": "Logs detailed timing and state information."
    },
    {
      "InputId": "e1f2a3b4-c5d6-7890-4567-901234567890"/*InputImage*/,
      "Position": {
        "X": -250.0,
        "Y": 250.0
      },
      "Description": "Source image for img2img and Stream mode. Ignored in txt2img mode. Accepts RGBA images and float render targets; linear float values are encoded to sRGB before generation."
    },
    {
      "InputId": "e2f3a4b5-c6d7-8901-2345-678901234567"/*ResizeMode*/,
      "Position": {
        "X": -250.0,
        "Y": 350.0
      },
      "Description": "How the input image fits the output: Stretch = fill, CenterCrop = crop then fill, Pad = fit with borders."
    },
    {
      "InputId": "e5a6d7c8-9f0b-4a1c-8b2d-3c4e5f6a7b8d"/*ResetStream*/,
      "Position": {
        "X": 150.0,
        "Y": 250.0
      },
      "Description": "Momentarily true to drop the rolling KV cache and re-prime the stream from the next input frame - useful on scene cuts or when the style drifts over a long take."
    },
    {
      "InputId": "e5f6a7b8-c9d0-1234-ef01-345678901234"/*Seed*/,
      "Position": {
        "X": -250.0,
        "Y": -50.0
      },
      "Description": "A changed seed re-primes the stream with fresh noise. -1 keeps the current seed."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "d8e2f9a1-7b3c-4d5e-8f9a-1b2c3d4e5f6a"/*Output*/,
      "Position": {
        "X": 200.0,
        "Y": -350.0
      }
    },
    {
      "OutputId": "e9f3a2b1-8c4d-5e6f-9a1b-2c3d4e5f6a7b"/*OutputSize*/,
      "Position": {
        "X": 200.0,
        "Y": -300.0
      }
    },
    {
      "OutputId": "f1a4b3c2-9d5e-6f7a-0b2c-3d4e5f6a7b8c"/*GenerationTime*/,
      "Position": {
        "X": 200.0,
        "Y": -250.0
      }
    },
    {
      "OutputId": "f6b7e8c9-a01b-4b2d-9c3e-4d5f6a7b8c9e"/*NoiseScale*/,
      "Position": {
        "X": 200.0,
        "Y": -150.0
      }
    },
    {
      "OutputId": "07c8f9da-b12c-4c3e-8d4f-5e6a7b8c9d0f"/*EncodeMs*/,
      "Position": {
        "X": 200.0,
        "Y": -50.0
      }
    },
    {
      "OutputId": "18d9a0eb-c23d-4d4f-9e5a-6f7b8c9d0e10"/*DenoiseMs*/,
      "Position": {
        "X": 200.0,
        "Y": 50.0
      }
    },
    {
      "OutputId": "29eab1fc-d34e-4e5a-8f6b-7a8c9d0e1f21"/*DecodeMs*/,
      "Position": {
        "X": 200.0,
        "Y": 150.0
      }
    }
  ]
}