    {
      "Id": "edfdf23d-f77a-4220-b460-873e6b6c1dfe"/*CustomSDF*/,
      "SymbolId": "637d00e4-ab63-4fe3-8e63-1e206c728841",
      "InputValues": [
        {
          "Id": "3c366d34-c398-410e-972b-d8cc2baffddb"/*A*/,
          "Type": "System.Single",
          "Value": 2.18
        },
        {
          "Id": "56e5d5ec-ec59-4ea0-85c1-1eca3dcb5790"/*C*/,
          "Type": "System.Single",
          "Value": 0.145
        },
        {
          "Id": "874ae9c8-5835-4d0c-9bef-253ac75d19b2"/*B*/,
          "Type": "System.Single",
          "Value": 1.391
        },
        {
          "Id": "bde89b93-224c-4a3f-85ab-d85b0401c02a"/*DistanceFunction*/,
          "Type": "System.String",
          "Value": "// box fold gaziya5 aka gaz on https://jbaker.graphics/writings/DEC.html\np=abs(p)-A * 10; // A: 15\nif(p.x < p.z)p.xz=p.zx;\nif(p.y < p.z)p.yz=p.zy;\nif(p.x < p.y)p.xy=p.yx;\nfloat s=2.;\nfor (int i=0; i<8; i++){\n  p=-sign(p)*(abs(abs(abs(p)-2.)-1.)-1.);\n  float r=-B/max(.41,dot(p,p)); // B: 1.55\n  s*=r; p*=r; p-=.5;\n}\ns=abs(s);\nreturn dot(p,normalize(float3(1,2,3)))/s;"
        }
      ],
      "Outputs": []
    }
