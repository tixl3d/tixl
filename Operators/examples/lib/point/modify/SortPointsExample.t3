    },
    {
      "Id": "4904f0ba-00b2-446d-a8fb-e59e18765d07"/*fake shadow coloring*/,
      "SymbolId": "3d958f08-9c0f-45eb-a252-de880b5834f3",
      "Name": "fake shadow coloring",
      "InputValues": [
        {
          "Id": "01898885-4140-4435-bb44-a7a6f6f32657"/*Offset*/,
          "Type": "System.Numerics.Vector3",
          "Value": {
            "X": -0.26,
            "Y": -1.31,
            "Z": -0.75
          }
        },
        {
          "Id": "e9712b03-e7aa-4fe5-b5cf-f2c5d0c0b0df"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "int4 c=int4(i.xxx+3,14);int r=(int(0x3504f333*c.x*c.x+c.y)*int(0xf1bbcdcb*c.y*c.y+c.x)*int(0xbf5c3da7*c.z*c.z+c.y)*int(0x2eb164b3*c.w*c.w+c.z));\nint4 r4=int4(0xbf5c3da7,0xa4f8e125,0x9284afeb,0xe4f5ae21)*r;\nfloat4 rnd1=(float4(r4)*(2.0/8589934592.0)+0.5)*0.99999;\n\n\nfloat3 pos=p.Position.xyz;\npos=normalize(pos);\nfloat shd=saturate(.5+.5*dot(pos,Center));\nshd=lerp(saturate(.5+.5*dot(pos,normalize(Center))),saturate(2*dot(pos,normalize(Center))),.25);\np.Color.rgb=lerp((float3(1,2,3)*.4+1)/7,1,shd);\np.Color.w=1;\n\n\n//p.Position += Center;\n//p.Position.y += sin(6*f * A+B);\np.Rotation.w=rnd1.w*48;"
        }
      ],
      "Outputs": []
    },
