    {
      "Id": "1dd80ebf-7a67-4b08-b664-8635b71daf02"/*CustomDrawMesh*/,
      "SymbolId": "c78d114e-b404-491f-93a8-024a382586bd",
      "InputValues": [
        {
          "Id": "7a6ca5a8-17a6-4a8b-9610-ed4c9e292cfe"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "SetupFrag(pin);\n\nPoint p = Points[pin.pointIndex];\n\nfrag.Metalness = saturate(frag.Metalness+ p.FX1);\nfloat3 nf=-normalize(cross(ddx(pin.worldPosition.xyz),ddy(pin.worldPosition.xyz)));\nfrag.N=normalize(lerp(nf,frag.N,A));\n\nc = ComputePbr();\n\n\n"
        },
        {
          "Id": "e7dc01ac-cb1d-409a-b8f3-ad22b1255771"/*A*/,
          "Type": "System.Single",
          "Value": -4.5
        }
      ],
      "Outputs": []
    },
