    {
      "Id": "38c50d88-5876-4f73-a20d-a565e243cac9"/*CustomSDF*/,
      "SymbolId": "637d00e4-ab63-4fe3-8e63-1e206c728841",
      "InputValues": [
        {
          "Id": "3c366d34-c398-410e-972b-d8cc2baffddb"/*A*/,
          "Type": "System.Single",
          "Value": 3.0
        },
        {
          "Id": "56e5d5ec-ec59-4ea0-85c1-1eca3dcb5790"/*C*/,
          "Type": "System.Single",
          "Value": 0.8
        },
        {
          "Id": "874ae9c8-5835-4d0c-9bef-253ac75d19b2"/*B*/,
          "Type": "System.Single",
          "Value": 1.206
        },
        {
          "Id": "bde89b93-224c-4a3f-85ab-d85b0401c02a"/*DistanceFunction*/,
          "Type": "System.String",
          "Value": "// by gaziya5 aka gaz on https://jbaker.graphics/writings/DEC.html\nfloat s=A;  // A: 3\nfor(int i = 0; i < 4; i++) {\n  p=mod(p-1, 2)-1;   \n  float r=B / dot(p,p); // B: 1.2\n  p*=r; s*=r;\n}\np = abs(p)-C; // C: 0.8\nif (p.x < p.z) p.xz = p.zx;\nif (p.y < p.z) p.yz = p.zy;\nif (p.x < p.y) p.xy = p.yx;\nreturn length(cross(p,normalize(float3(0,1,1))))/s-.001;"
        }
      ],
      "Outputs": []
    },
    {
      "Id": "38c70f3d-f985-4087-a256-38d3213fa634"/*ReuseCamera*/,
      "SymbolId": "484bec1b-e441-440a-85b4-b3865c57b4ed",
      "InputValues": [],
      "Outputs": []
    },
    {
      "Id": "38f97e3b-5736-492f-9d22-da4eda09cc33"/*CustomDrawMesh*/,
      "SymbolId": "c78d114e-b404-491f-93a8-024a382586bd",
      "InputValues": [
        {
          "Id": "05feb9d0-3bfc-4c96-b79e-b884132813e9"/*B*/,
          "Type": "System.Single",
          "Value": 0.86
        },
        {
          "Id": "3e7b6c69-f4d1-4f96-a693-a2162fe29a77"/*ShaderDefines*/,
          "Type": "System.String",
          "Value": ""
        },
        {
          "Id": "7a6ca5a8-17a6-4a8b-9610-ed4c9e292cfe"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "SetupFrag(pin);\n//frag.Metalness = Points[pin.pointIndex].FX1;\n//frag.Roughness = Points[pin.pointIndex].FX2;\n\nfloat3 p=mul(pin.worldPosition,WorldToObject).xyz;\nfloat2 e=float2(.0006,0);\nfloat3 nf=float3(GetDistance(p+e.xyy),GetDistance(p+e.yxy),GetDistance(p+e.yyx))-GetDistance(p);\nnf=(float3(FM(GetDistance(p+e.xyy)),FM(GetDistance(p+e.yxy)),FM(GetDistance(p+e.yyx)))-FM(GetDistance(p)))*.1/e.x;\nfrag.N=normalize(frag.N+mul(nf,transpose((float3x3)WorldToObject))*D);\nfrag.Metalness=FM(GetDistance(p));\nfloat mask=smoothstep(0.9,.99,FM(GetDistance(p)));\nfrag.albedo*=SampleGradient(mask);\nc = ComputePbr();\n\n"
        },
        {
          "Id": "ada34207-e581-4f35-9ef5-8f6122e0bde5"/*D*/,
          "Type": "System.Single",
          "Value": 0.09
        },
        {
          "Id": "dc032839-eca3-48d0-be68-99b06da28167"/*C*/,
          "Type": "System.Single",
          "Value": -0.16
        },
        {
          "Id": "e7dc01ac-cb1d-409a-b8f3-ad22b1255771"/*A*/,
          "Type": "System.Single",
          "Value": 213.7
        },
        {
          "Id": "eff4073a-619b-4b4c-8612-758c54dc12bf"/*Gradient*/,
          "Type": "T3.Core.DataTypes.Gradient",
          "Value": {
            "Gradient": {
              "Interpolation": "Linear",
              "Steps": [
                {
                  "Id": "f061e91e-a2fb-4ad5-ba4e-3945c06454b9",
                  "NormalizedPosition": 0.0,
                  "Color": {
                    "R": 1.0,
                    "G": 0.4929639,
                    "B": 0.0,
                    "A": 1.0
                  }
                },
                {
                  "Id": "4f9ce3aa-9b44-465c-ab53-86f47cf797c6",
                  "NormalizedPosition": 1.0,
                  "Color": {
                    "R": 0.5215311,
                    "G": 0.52152604,
                    "B": 0.5215311,
                    "A": 1.0
                  }
                }
              ]
            }
          }
        },
        {
          "Id": "f5754aaf-f276-474f-b36f-4b608bdbfe88"/*AdditionalDefines*/,
          "Type": "System.String",
          "Value": "float FM(float d){\nfloat f=smoothstep(.3,.7,abs(-1+2*frac((d+B)*A)));\nreturn f;\n}"
        }
      ],
      "Outputs": []
    },
    {
