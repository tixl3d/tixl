    {
      "Id": "576dbfe8-bf6f-41b0-991c-082a19705a9b"/*CustomDrawMesh*/,
      "SymbolId": "c78d114e-b404-491f-93a8-024a382586bd",
      "InputValues": [
        {
          "Id": "05feb9d0-3bfc-4c96-b79e-b884132813e9"/*B*/,
          "Type": "System.Single",
          "Value": -0.037
        },
        {
          "Id": "7a6ca5a8-17a6-4a8b-9610-ed4c9e292cfe"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "float3 p=mul(pin.worldPosition,WorldToObject).xyz;\nfloat d=GetDistance(p)+B;\n\nc.a=exp2(-abs(d)*A);\nc.rgb=SampleGradient(exp(d*C)/(1+exp(d*C)));"
        },
        {
