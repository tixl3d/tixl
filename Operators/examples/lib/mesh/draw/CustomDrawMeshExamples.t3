    {
      "Id": "a8d1918b-e213-4c08-9099-dae628e1aa87"/*CustomDrawMesh*/,
      "SymbolId": "c78d114e-b404-491f-93a8-024a382586bd",
      "InputValues": [
        {
          "Id": "05feb9d0-3bfc-4c96-b79e-b884132813e9"/*B*/,
          "Type": "System.Single",
          "Value": 1.09
        },
        {
          "Id": "7a6ca5a8-17a6-4a8b-9610-ed4c9e292cfe"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "float4 pv=mul(float4(pin.worldPosition.xyz,1),WorldToCamera);\nfloat3 nw=ComputeNormal(pin, pin.tbnToWorld).xyz;\nfloat3 vn=mul(nw,transpose((float3x3)CameraToWorld));\n//pv.xy+=vn.xy*A;\nfloat3 rd=pv.xyz;\n\nrd=normalize(mul(rd,transpose((float3x3)WorldToCamera)));\nrd=refract(rd,nw,B);\n\npv.xyz=normalize(mul(rd,transpose((float3x3)CameraToWorld)));\n\nfloat4 pp=mul(pv,CameraToClipSpace);\n//pp=mul(float4(pin.worldPosition.xyz,1),WorldToClipSpace);\nfloat2 uv=(pp.xy/pp.w)*.5*float2(1,-1)+.5;\n\nc.rg=uv;\nc=BaseColorMap.Sample(WrappedSampler, uv);\nfloat g=mul(nw.xyz,transpose((float3x3)CameraToWorld)).z;\nSetupFrag(pin);\nc.rgb*=(length(rd)>0)*SampleGradient(pow(g,1));\n\n\nfrag.Metalness=1;\nfrag.Roughness=.04;\nfrag.albedo=1;\n\nc=lerp(c,ComputePbr(),pow(1-g,1));\nc.a=1;"
        },
        {
          "Id": "e7dc01ac-cb1d-409a-b8f3-ad22b1255771"/*A*/,
          "Type": "System.Single",
          "Value": 1.0
        },
        {
          "Id": "eff4073a-619b-4b4c-8612-758c54dc12bf"/*Gradient*/,
          "Type": "T3.Core.DataTypes.Gradient",
          "Value": {
            "Gradient": {
              "Interpolation": "Linear",
              "Steps": [
                {
                  "Id": "bdb5170b-58cd-4d3d-aaa5-27cb9defe637",
                  "NormalizedPosition": 0.0,
                  "Color": {
                    "R": 0.5677949,
                    "G": 0.794734,
                    "B": 1.0,
                    "A": 1.0
                  }
                },
                {
                  "Id": "ade299a6-ffb0-471c-b905-262d1a83f406",
                  "NormalizedPosition": 0.9880858,
                  "Color": {
                    "R": 0.36257026,
                    "G": 0.4699229,
                    "B": 0.69377995,
                    "A": 1.0
                  }
                }
              ]
            }
          }
        }
      ],
      "Outputs": []
    },
    {
      "Id": "ae95f54b-e8b0-4ea1-a206-ff0551be5de5"/*CustomDrawMesh*/,
      "SymbolId": "c78d114e-b404-491f-93a8-024a382586bd",
      "InputValues": [
        {
          "Id": "05feb9d0-3bfc-4c96-b79e-b884132813e9"/*B*/,
          "Type": "System.Single",
          "Value": 0.86
        },
        {
          "Id": "7a6ca5a8-17a6-4a8b-9610-ed4c9e292cfe"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "SetupFrag(pin);\n//frag.Metalness = Points[pin.pointIndex].FX1;\n//frag.Roughness = Points[pin.pointIndex].FX2;\n\nfloat3 p=mul(pin.worldPosition,WorldToObject).xyz;\nfloat2 e=float2(.0006,0);\nfloat3 nf=float3(GetDistance(p+e.xyy),GetDistance(p+e.yxy),GetDistance(p+e.yyx))-GetDistance(p);\nnf=(float3(FM(GetDistance(p+e.xyy)),FM(GetDistance(p+e.yxy)),FM(GetDistance(p+e.yyx)))-FM(GetDistance(p)))*.1/e.x;\nfrag.N=normalize(frag.N+mul(nf,transpose((float3x3)WorldToObject))*D);\nfrag.Metalness=FM(GetDistance(p));\nfloat mask=smoothstep(0.9,.99,FM(GetDistance(p)));\nfrag.albedo*=SampleGradient(mask);\nc = ComputePbr();\n\n"
        },
        {
          "Id": "ada34207-e581-4f35-9ef5-8f6122e0bde5"/*D*/,
          "Type": "System.Single",
          "Value": 0.09
        },
        {
          "Id": "dc032839-eca3-48d0-be68-99b06da28167"/*C*/,
          "Type": "System.Single",
          "Value": -0.16
        },
        {
          "Id": "e7dc01ac-cb1d-409a-b8f3-ad22b1255771"/*A*/,
