{
  "FormatVersion": 3,
  "Id": "20390db1-e88a-4adb-8ef0-e0a7de2e0012"/*ClxMixer*/,
  "Description": "Mixer state from a CLX sender: channel faders, crossfader, the active deck and the sender's app state.\n\nListens for CLX on the given UDP port (3650 by default) and on the multicast group 239.0.0.1. All CLX operators on the same port share one connection. Senders stream to one unicast address and, if enabled, to multicast: when a Clockworks Viewer runs on the same machine, use multicast.\n\nSee also: [ClxDeck]",
  "InputUis": [
    {
      "InputId": "021044b0-6fcf-4364-8726-5fa478cfa316"/*Deck*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Deck whose fader the Upfader output shows."
    },
    {
      "InputId": "a9cd3e51-4085-4b29-8525-d9e82b7942a4"/*Port*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "GroupTitle": "Connection",
      "Description": "UDP port CLX senders stream to. 3650 unless the sender was changed."
    },
    {
      "InputId": "d535762c-c8ae-4fef-9005-a57838ff624f"/*Listen*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Turn off to close the connection when no other CLX operator uses this port."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "b5ae63e9-d5a9-4ea5-ba9b-8de18b19a691"/*Upfader*/,
      "Position": {
        "X": 133.0,
        "Y": 38.0
      },
      "Description": "Channel fader of the selected deck."
    },
    {
      "OutputId": "cc397653-7bf6-48f5-ae6c-b609c4825bf7"/*Upfaders*/,
      "Position": {
        "X": 133.0,
        "Y": 138.0
      },
      "Description": "Channel faders of decks 1 to 6. Four-channel mixers send 0 for decks 5 and 6."
    },
    {
      "OutputId": "4ab3d60d-5f65-4eca-86ef-3d5ff55d9aac"/*Crossfader*/,
      "Position": {
        "X": 133.0,
        "Y": 238.0
      },
      "Description": "Crossfader position, typically 0 to 1."
    },
    {
      "OutputId": "dd92ff27-9cac-469d-a1a2-e8d1545c2df5"/*ActiveDeck*/,
      "Position": {
        "X": 133.0,
        "Y": 338.0
      },
      "Description": "Deck the sender reports as active or in focus."
    },
    {
      "OutputId": "0a9963b7-9818-444c-b939-283b97dd3044"/*AppState*/,
      "Position": {
        "X": 133.0,
        "Y": 438.0
      },
      "Description": "The sender's connection or session state."
    },
    {
      "OutputId": "3c68544a-0007-4e4d-9ff8-056ca5169636"/*HasData*/,
      "Position": {
        "X": 133.0,
        "Y": 538.0
      },
      "Description": "True once a Control packet has arrived."
    }
  ],
  "Links": [
    {
      "Id": "34cfced6-8b5b-5685-8a6b-ee1ad3f904cc",
      "Title": "CLX protocol",
      "Description": "The CLX specification: packets, fields and network behaviour.",
