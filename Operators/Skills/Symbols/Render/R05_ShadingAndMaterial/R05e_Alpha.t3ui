  "TourPoints": [
    {
      "Id": "608c6682-15ac-4961-8fb1-fd4e6bf59ffb",
      "Description": "The base color of a material is called the albedo.\nThe term comes from Latin and refers to lightness, similar to diffuse color.\nIt represents the material color without shading or shadows."
    },
    {
      "Id": "ba142f5c-491d-4e5f-9aca-15d0112c874a",
      "Description": "The alpha channel of the albedo defines material opacity.\nIn this example, an alpha gradient is animated across the surface."
    },
    {
      "Id": "226bc1d4-a8cb-45dd-b9ce-c73ca1c82323",
      "Description": "Reproduce the animation.",
      "Style": "CallToAction"
    }
  ]
}