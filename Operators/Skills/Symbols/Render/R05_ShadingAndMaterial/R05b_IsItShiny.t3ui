  "TourPoints": [
    {
      "Id": "4520b68a-92c5-4937-8d4c-af59181d7ff1",
      "Description": "The Metallic parameter defines whether a surface behaves like a metal or a non-metal.\nNon-metallic materials such as plastic or stone show their color through diffuse lighting.\nLight enters the surface and exits tinted by the material color."
    },
    {
      "Id": "dbeef8e2-6018-4a04-a953-9268d5a57d69",
      "Description": "Metallic materials show their color primarily through reflections.\nThey do not use diffuse lighting in the same way."
    },
    {
      "Id": "251ac7bd-3378-4ded-8001-d958d609d792",
      "Description": "In theory, the Metallic parameter should be either 0 or 1.\nTiXL does not enforce this rule, allowing intermediate values."
    },
    {
      "Id": "634144b4-931b-4a2f-a06e-f8664319df13",
      "Description": "Study the reference example and observe the difference.\nRecreate it.",
      "Style": "CallToAction"
    }
  ]
}