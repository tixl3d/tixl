  "TourPoints": [
    {
      "Id": "659617c9-009e-49ed-82bc-b26e083d8e9e",
      "Description": "TiXL uses physically based rendering (PBR) for lighting and materials.\nThis model defines material properties such as roughness and metallic, and combines direct lighting with image-based lighting (IBL).\nThis chapter introduces the essential concepts needed to work with materials."
    },
    {
      "Id": "8c59f9ad-f2ba-45d3-ac60-dff6d184ae6a",
      "Description": "By default, TiXL uses a predefined studio lighting setup.\nThe default material is too rough to clearly show reflections, so a new [Material] operator is added to adjust this."
    },
    {
      "Id": "42def860-9278-4772-bdce-e82e703d9165",
      "Description": "Add a [Material] operator and adjust its roughness to match the reference.",
      "Style": "CallToAction"
    }
  ]
}