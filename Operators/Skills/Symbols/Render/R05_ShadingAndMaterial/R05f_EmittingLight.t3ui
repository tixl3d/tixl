  "TourPoints": [
    {
      "Id": "706f1fbb-46d7-4e4e-b85d-58ab699533dc",
      "Description": "Materials can emit light using the emission color and emission texture parameters.\nThe texture and color values are multiplied.\nThe default emission color is black, so emission textures remain invisible until the color brightness is increased."
    },
    {
      "Id": "5f8601ab-d4a2-46fc-8523-0fa82cff9ec8",
      "Description": "HDR emission values greater than 1 work particularly well when combined with a [Bloom] post-processing effect."
    },
    {
      "Id": "4d002807-9e37-46f7-a8b6-cfce16e25459",
      "Description": "In this example, the highlight color of [RyojiPattern] is brightened to create a glow effect."
    },
    {
      "Id": "78209e2a-0930-4bc2-b54d-634d447b7455",
      "Description": "Recreate the example.",
      "Style": "CallToAction"
    }
  ]
}