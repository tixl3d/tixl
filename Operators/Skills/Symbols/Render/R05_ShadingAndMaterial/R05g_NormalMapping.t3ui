  "TourPoints": [
    {
      "Id": "c2f2ef5e-2e9d-4cf3-9247-7b384e9001d0",
      "Description": "Raymarched SDFs will be covered in detail later.\nSince they use the same material and lighting system, they can be used here to demonstrate normal mapping."
    },
    {
      "Id": "d9e34f7c-ce78-4d1c-937e-822c6a40b130",
      "Description": "Normal maps store surface curvature information in their color channels.\nThey are commonly used to add fine surface detail without increasing geometry complexity."
    },
    {
      "Id": "6b3bf149-2288-4837-b61c-8fb147462b59",
      "Description": "Normal map formats vary.\nThe [NormalMap] operator converts a grayscale height map into a normal map."
    },
    {
      "Id": "d5146857-296e-4f05-91b2-7c541d71c9ee",
      "Description": "In this example, a [FractalNoise] operator is animated to drive the normal map.\nThe noise must be seamless to avoid visible artifacts where the pattern wraps."
    },
    {
      "Id": "b73f9804-0a7c-4354-a2cc-132460d8a188",
      "Description": "Recreate the example.",
      "Style": "CallToAction"
    }
  ]
}