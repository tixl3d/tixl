    {
      "Id": "ed8aee91-534b-4803-a958-223c4829449f",
      "Description": "The roughnessMetallicOcclusion texture parameter is special.\nIt expects a channel-packed texture where each property is stored in a different color channel."
    },
    {
      "Id": "2c70371c-3086-4c51-b55d-71617b40735a",
      "Description": "The [Combine3Channels] operator can be used to construct such textures."
    },
