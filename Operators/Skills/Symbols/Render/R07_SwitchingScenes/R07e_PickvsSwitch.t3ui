  "TourPoints": [
    {
      "Id": "2aa47106-7fbe-460d-9ff9-ed5bc300b22e",
      "Description": "There are other operators that switch between values such as images, numbers, or meshes.\nThese operators are called [Pick...] instead of [Switch]."
    },
    {
      "Id": "67a12bba-0c63-4b44-b114-576e5c16abd4",
      "Description": "This distinction is intentional.\nCommand operators are the only operator type in TiXL that can become undefined or inactive.\nMost other operators keep their last valid value.\nFor example, a [LinearGradient] remains a valid texture in memory even if it is no longer updated or used."
    },
    {
      "Id": "042b4705-9fcc-4f03-8e2f-c9a4b5f791e1",
      "Description": "Enough theory.\nPick some images and reproduce the example.",
      "Style": "CallToAction"
    }
  ]
}