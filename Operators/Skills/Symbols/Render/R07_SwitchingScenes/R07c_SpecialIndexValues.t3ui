    {
      "Id": "01cd22ab-9b58-41e8-a2d8-94b9285c9f7b",
      "Description": "The [Switch] operator supports two special index values.\nIf the index is set to -1, none of the connected branches are active.\nThis effectively disables all connected scenes and can be useful to temporarily turn parts of a project off."
    },
    {
      "Id": "da572827-1dc8-4382-aadb-1c7313b2c568",
      "Description": "If the index is set to -2, all connected branches are active at the same time."
    },
    {
      "Id": "f99459c0-b734-49af-b198-703177f231e7",
      "Description": "Recreate the example.",
      "Style": "CallToAction"
    }
  ]
