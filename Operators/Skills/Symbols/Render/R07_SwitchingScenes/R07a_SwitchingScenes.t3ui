  "TourPoints": [
    {
      "Id": "ec40ae26-c980-424a-8340-7ac438d88db2",
      "Description": "For complex projects or setups, it can be necessary to switch between different materials, objects, cameras, or entire scenes.\nAll of these are command operators and share the same connection type.\nThis allows a single operator to switch between them."
    },
    {
      "Id": "6bc61753-e47c-423d-8c6f-ee11fbcdc251",
      "Description": "You can think of this operator like a fork in a track.\nYou can choose either the left or the right path.\nThe [Switch] operator works the same way, but because it supports multiple inputs, it can switch between many branches."
    },
    {
      "Id": "59ea8fcc-6062-41ad-99e4-3e9c42191a0d",
      "Description": "The active branch is controlled by the Index parameter.\nLike all index parameters in TiXL, it starts counting at 0 and wraps around if the value exceeds the number of connected inputs."
    },
    {
      "Id": "fc857955-feeb-440d-963d-e43675b7cd32",
      "Description": "This is a simple example.\nReconnect the operators to match the reference.",
      "Style": "CallToAction"
    }
  ]
}