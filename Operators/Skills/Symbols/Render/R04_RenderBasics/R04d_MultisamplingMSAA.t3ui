  "TourPoints": [
    {
      "Id": "051fe0b1-26a6-42e8-85d5-746005682a9d",
      "Description": "RenderTarget uses multisample anti-aliasing (MSAA) to smooth jagged edges.\nThis instructs the graphics hardware to render edges at a higher effective resolution.\nMSAA is enabled by default."
    },
    {
      "Id": "10222e59-48dc-4868-a802-f7bb9fc89b40",
      "Description": "Higher quality comes at a performance cost.\nIn most projects this is not an issue, but scenes with dozens or hundreds of RenderTargets can be affected.\nIn some cases, a sharper look may even be preferred."
    },
    {
      "Id": "9c9a6a6d-add9-4812-a9c6-cfcd2f81b878",
      "Description": "This challenge compares different MSAA modes.\nNotice that MSAA affects mesh edges, but not images or raymarched geometry."
    },
    {
      "Id": "ec6a604e-d6ff-4f59-9b0a-c070995c1ba2",
      "Description": "Find the correct settings to replicate the example.",
      "Style": "CallToAction"
    }
  ]
}