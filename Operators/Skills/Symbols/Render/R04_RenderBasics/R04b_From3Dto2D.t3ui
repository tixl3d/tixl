  "TourPoints": [
    {
      "Id": "571552b7-6ba1-4836-a64f-cb5f46644387",
      "Description": "The final output of most things you build in TiXL are images.\nThese are sometimes called textures or image buffers.\nYou can explore the SkillQuest topics on working with images to learn about other ways to generate and use them."
    },
    {
      "Id": "8180ac1d-c4a0-4dc4-8c9b-f7c343d42b0b",
      "Description": "The [RenderTarget] operator is used to render 3D geometry into an image.\nIt is one of the most important operators in TiXL and is used in many projects.\nIt can be helpful to understand how the RenderTarget works internally."
    },
    {
      "Id": "f4502c64-c647-45c5-9aac-8e9c67c29b99",
      "Description": "You can think of the RenderTarget as a blank canvas.\nAll geometry connected to it (from the left or above) is prepared to be drawn onto this canvas."
    },
    {
      "Id": "246bcc6b-e2e2-468a-a7db-04c651bf6c74",
      "Description": "At the beginning of each frame, the RenderTarget is cleared with a solid color.\nAfter that, any draw operator (the teal command operators) can render onto it."
    },
    {
      "Id": "a1e4679c-aab8-4fb2-9e6d-3a031371e67b",
      "Description": "In this example, clearing is disabled."
    },
    {
      "Id": "1181a314-c295-4d06-8349-50e4aff15488",
      "Description": "Reproduce the challenge.",
      "Style": "CallToAction"
    }
  ]
}