  "TourPoints": [
    {
      "Id": "8f8f8bf6-42d2-495f-8adc-030abff879aa",
      "Description": "In computer graphics, an algorithm called the Z-buffer is used to ensure that distant objects are not drawn in front of objects that are closer to the camera.\nThe [RenderTarget] operator automatically provides a depth buffer for this purpose.\nEach draw operator has parameters that control how it interacts with depth."
    },
    {
      "Id": "829fdcc3-df02-45da-8c48-b850d88b5a41",
      "Description": "Operators are still drawn in the order they are connected.\nDepth testing determines whether a fragment is visible."
    },
    {
      "Id": "943acfd2-3117-4ad8-b87e-bdf4a80f8231",
      "Description": "In this playful example, the orange torus should appear in front."
    },
    {
      "Id": "a3f481b6-cb6e-4eb7-8712-1bf06be32e91",
      "Description": "Solve the challenge.",
      "Style": "CallToAction"
    }
  ]
}