  "TourPoints": [
    {
      "Id": "9bae1af3-be97-4a3e-8065-b684eced358f",
      "Description": "Sometimes it is clearer to use separate operators for rotation, scaling, or offset.\nThe connection order is still important.\nRotating first and then moving produces a different result than moving first and then rotating."
    },
    {
      "Id": "29a5befa-9bb6-4822-af41-b8c42b9fa664",
      "Description": "Combine the operators in the correct order without changing any parameters.\nTip: you can drag a horizontal slice of an operator stack to reorder it.",
      "Style": "CallToAction"
    }
  ]
}