  "TourPoints": [
    {
      "Id": "72286f44-8dec-4b70-b3a3-c927f3e93753",
      "Description": "Sometimes it is useful to know the final world-space position after a sequence of transformations.\nThe [Locator] operator is connected like a drawable object.\nInstead of rendering geometry, it stores the current position."
    },
    {
      "Id": "19ec9865-545f-472e-a123-1eb2895c785c",
      "Description": "The second output provides this position.\nTo access it, open the additional output indicated by the small triangle in the bottom-right corner and drag out the position output."
    },
    {
      "Id": "0a8c28d3-d0a5-4481-b6fe-1ff86a7eec09",
      "Description": "The [Text] operator only supports x and y positioning.\nA separate [Transform] operator is therefore required."
    },
    {
      "Id": "e0dd9684-0101-4c75-81bc-f548dae74dde",
      "Description": "Recreate the challenge using the given operators.",
      "Style": "CallToAction"
    }
  ]
}