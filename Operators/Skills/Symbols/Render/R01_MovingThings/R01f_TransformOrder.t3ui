  "TourPoints": [
    {
      "Id": "ab4ef431-56ac-45f7-850f-ac40100d8592",
      "ChildId": "2a64dd57-f0fc-44a0-a9a4-8ac9923a95f6",
      "Description": "When drawing multiple instances using [Transform] operators, each branch can be thought of as a sequence of events.\nExamples include “move right,” “rotate,” “scale,” and finally “draw.”\nEach operator is applied in the current local coordinate system."
    },
    {
      "Id": "724afa2c-1dab-4c47-9d26-5859426f779e",
      "Description": "The order matters.\nIf the world is mirrored first, a rotation to the left may appear as a rotation to the right.\nAlways follow the chain step by step."
    },
    {
      "Id": "143e27cb-c117-42d7-ba4e-6ea7b059cf17",
      "Description": "There are many operators related to movement, depending on what is being moved, such as images, particles, or geometry.\nThe teal command-style [Transform] operators are special because they are combined into a single instruction and are effectively free.\nOther movement operators are covered in their respective chapters."
    },
    {
      "Id": "7f46b770-3d8c-4bec-bdbb-ddeb896cb0a9",
      "ChildId": "0e32297c-fafa-44aa-8ae4-7b499534f240",
      "Description": "The [Group] operator also provides built-in transform parameters.\nThis is useful for moving or rotating multiple objects together."
    },
    {
      "Id": "72a37b10-0a86-44f7-995d-dbdcc839876b",
      "Description": "Recreate the challenge using the given operators.",
      "Style": "CallToAction"
    }
  ]
}