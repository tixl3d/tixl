  "TourPoints": [
    {
      "Id": "abac2e93-b58b-4647-a4cf-9e9bbcbeddc3",
      "Description": "Like [Transform], a camera only affects its input.\nThis means it applies only to operators connected on its left side."
    },
    {
      "Id": "12d47d7e-b31e-4fc8-b2e2-9463553d6445",
      "Description": "Unlike [Transform], cameras cannot be combined.\nThe last camera in the chain (furthest to the left) overrides all previous cameras."
    },
    {
      "Id": "9e338934-1a76-440a-80b3-9b4bb4ff5fd2",
      "Description": "Replicate the example by arranging the camera operators correctly.",
      "Style": "CallToAction"
    }
  ]
}