  "TourPoints": [
    {
      "Id": "73911dbb-d74f-4975-a522-e8d55175ee95",
      "Description": "So far, the [Transform] operator has been used to move objects.\nAlternatively, the camera itself can be moved to view the scene from different positions and directions."
    },
    {
      "Id": "e0d58f9f-afeb-44ca-9552-98c9b859719a",
      "Description": "Within SkillQuest, interactive camera controls are disabled to keep things focused.\nCamera movement is therefore controlled entirely through operators."
    },
    {
      "Id": "ae20016f-1963-456d-a386-23f2d461caf1",
      "Description": "A simple but effective operator for this is [OrbitCamera].\nIt rotates the camera around a center point and provides parameters to control distance and orientation."
    }
  ]
}