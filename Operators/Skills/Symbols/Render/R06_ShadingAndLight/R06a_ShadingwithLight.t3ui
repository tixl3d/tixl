  "TourPoints": [
    {
      "Id": "382a5603-f1bc-46ed-8245-1725293b9b46",
      "Description": "So far, the default studio lighting has been used in all examples.\nThis setup consists of a 360-degree HDRI texture used for image-based lighting."
    },
    {
      "Id": "97083cf3-7a96-4b2f-b342-53613fd5a6f6",
      "Description": "To better understand how lighting affects shading, the light will first be turned off."
    },
    {
      "Id": "cea938a6-373f-4795-8902-30a3f8efc9b5",
      "Description": "The [SetEnvironment] operator provides multiple presets.\nUse the \"black\" preset to disable image-based lighting.",
      "Style": "CallToAction"
    },
    {
      "Id": "65ddedd8-f14c-4046-a81c-50cf753c03dc",
      "Description": "Add a [PointLight] and move it through the scene using 3D Perlin noise.\nUse the same position to draw a [Sphere] as a visual indicator for the light position.",
      "Style": "CallToAction"
    },
    {
      "Id": "231867b0-ed9f-4bf9-8708-2df0b9e631bb",
      "Description": "Recreate the example.",
      "Style": "CallToAction"
    }
  ]
}