  "TourPoints": [
    {
      "Id": "1428277b-4866-479c-91cc-b2cde955d441",
      "Description": "One important warning about floating-point values:\nThey are not infinitely precise.\nInternally, most floating-point numbers are stored using 32 bits. This is a compromise that allows a wide range of values, but not equal precision everywhere.\nSmall values (close to zero) have higher precision.   As values grow larger, the resolution becomes coarser and the steps between representable numbers increase."
    },
    {
      "Id": "a5fb16a8-f2c2-456b-b136-2f45a6ed9c53",
      "Description": "As an example of how visible this can become, look at the following setup.\nFigure out how many zeros need to be added to the factors to reproduce the example.",
      "Style": "CallToAction"
    }
  ]
}