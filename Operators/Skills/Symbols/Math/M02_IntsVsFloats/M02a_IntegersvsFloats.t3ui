  "TourPoints": [
    {
      "Id": "e10fc4fe-c421-4798-979c-05ad7f5b4f72",
      "Description": "For computers, values are not all the same. They come in different formats.\nIn TiXL, three numeric types are commonly used.\nFloating-point values are used for most parameters: time, radius, strength, positions, and animation inputs.   While their precision or range may differ depending on the parameter, internally they all behave the same.\nInteger values are different. They can only change in steps of one.   They are used for counts, indices, and many mode or selection parameters."
    },
    {
      "Id": "88f41e89-2d30-4428-b64a-1605e6362af7",
      "Description": "To convert between these types, use the [FloatToInt] and [IntToFloat] operators.\nAutomatic conversion might be convenient, and may exist in the future, but for now these operators make the conversion explicit."
    },
    {
      "Id": "6589a380-d47d-4a30-97d0-d6715bb83479",
      "Description": "The [FloatToInt] operator does **not** round.\nEverything after the decimal point is removed. Period.",
      "Style": "InfoFor"
    },
    {
      "Id": "b3afb16a-46fe-4c8d-a865-ea044440a582",
      "Description": "Let’s start with a small example.\nUse time (a floating-point value) to control which text is shown.\nComplete the example.",
      "Style": "CallToAction"
    }
  ]
}