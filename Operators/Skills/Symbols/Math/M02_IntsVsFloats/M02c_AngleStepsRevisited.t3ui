    {
      "Id": "5384a1fc-dbcc-4db1-9dc1-9b9d8eb2d548",
      "Description": "The previous example was a bit artificial.\nRounding floating-point values is common enough that TiXL provides dedicated operators for it."
    },
    {
      "Id": "c837f435-b733-4e1c-99c3-f6c2ea7aefe7",
      "Description": "The [Floor] operator converts a float to an integer and back.\nIt keeps the whole-number part and removes everything after the decimal point."
    },
    {
      "Id": "54897807-d6b2-4075-b6f3-c1b148da2e33",
      "Description": "Solve the previous example again, this time using [Floor].",
      "Style": "CallToAction"
    }
  ]
