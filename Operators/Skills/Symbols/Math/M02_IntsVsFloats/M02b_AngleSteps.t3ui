  "TourPoints": [
    {
      "Id": "ab7cfe9c-d45e-49b3-8f75-aacbcabac76f",
      "Description": "In this example, we want to rotate the cube in 1 degree increments to exactly 45 degrees.\n\nThis sounds like a good case for [IntToFloat]."
    },
    {
      "Id": "728999be-075b-45d3-8e3f-4529fc1388f0",
      "Description": "We have an [IntValue] node that gives us whole numbers. But the vertical rotation only accepts a float. Use [IntToFloat] to use the integer value for the rotation.",
      "Style": "InfoFor"
    },
    {
      "Id": "fb7af4c5-fa49-4d9d-afaf-6a99b562dbf7",
      "Description": "Adjust the [IntValue] node so that the cube is rotated exactly 45 degrees like in the example.",
      "Style": "CallToAction"
    },
    {
      "Id": "2c463622-2364-4826-958f-875171945035",
      "Description": "You may be wondering whether you could not start out with [Value] instead of [IntValue].\n\nYou can in this example. But sometimes a value comes from a calculation that required float, so you don't always have that choice.",
      "Style": "Conclusion"
    }
  ]
}