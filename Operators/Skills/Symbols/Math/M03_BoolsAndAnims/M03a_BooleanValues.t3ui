  "TourPoints": [
    {
      "Id": "39e2bae8-4653-429e-9684-96f6e814ef23",
      "Description": "Booleans, or “bools”, are numbers with only two possible values.\nThey can be zero (false) or one (true). A boolean represents a single bit."
    },
    {
      "Id": "58398d03-7394-4b81-a64e-9ddde6f03d6a",
      "Description": "In TiXL, booleans are important because they are used by parameters that enable or disable things, such as checkboxes.\nThey are also used to drive trigger-like behavior. Triggers are covered in the next topic."
    },
    {
      "Id": "c285ac7d-e167-4dc2-bc9d-c2f7f2ba2db7",
      "Description": "Define a boolean value using the [Bool] operator.\nYou can toggle it directly in the graph. To move the operator without toggling it, use the drag handle on the left edge.",
      "Style": "CallToAction"
    }
  ]
}