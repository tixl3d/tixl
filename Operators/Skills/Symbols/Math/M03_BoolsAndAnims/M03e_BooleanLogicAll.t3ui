  "TourPoints": [
    {
      "Id": "87d640c0-51e0-4af2-83f2-a6132cb1f770",
      "Description": "As projects grow, chaining many [And] operators can become cumbersome."
    },
    {
      "Id": "21f10ea6-c726-4881-a3e3-3b9796f2dfa9",
      "Description": "Unless you need to animate individual inputs, you can use the [All] operator instead.\nIt accepts multiple inputs and returns true only if all connected inputs are true."
    },
    {
      "Id": "5b7834cc-74ce-49ea-a3f9-7e19f2e224b2",
      "Description": "Replace the chain of [And] operators with [All] and recreate the example.",
      "Style": "CallToAction"
    }
  ]
}