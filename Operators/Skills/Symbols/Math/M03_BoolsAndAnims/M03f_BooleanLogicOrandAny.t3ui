  "TourPoints": [
    {
      "Id": "4269b940-7be2-43a7-ac6a-b09827b1e987",
      "Description": "The more relaxed siblings of [And] and [All] are [Or] and [Any].\nThey return true if at least one input is true."
    },
    {
      "Id": "da8c22f1-987e-4aea-b246-528bc4a53a68",
      "Description": "In this example, several sequence animation operators are combined to simulate a rhythm pattern."
    },
    {
      "Id": "f9fee790-9615-4737-b35f-803fd0325238",
      "Description": "Extend the logic so it works for all parts of the rhythm.",
      "Style": "CallToAction"
    }
  ]
