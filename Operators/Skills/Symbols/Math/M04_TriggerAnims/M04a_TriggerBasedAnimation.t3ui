  "TourPoints": [
    {
      "Id": "4f1e04db-765d-4718-a2e3-e258b3ff9aeb",
      "Description": "One powerful use of triggers is the [TriggerAnim] operator.\nIt is similar to [AnimValue], but it does not follow time directly. Instead, it reacts to events."
    },
    {
      "Id": "55b55020-d54a-47ca-be1d-f21e4a6a5771",
      "Description": "In this example, [HasValueChanged] sends a trigger whenever a noisy value increases.\nThis trigger starts an animation, which is then used to sample a color from a gradient."
    },
    {
      "Id": "af29ed66-6c01-4122-b003-84d17216baf3",
      "Description": "In real projects, trigger signals can come from many sources.\nThey might be audio levels, MIDI input, OSC messages, sensors, or other external events."
    },
    {
      "Id": "5f7229e3-c2d6-41ad-9b80-663c686e41e8",
      "Description": "Solve the puzzle.",
      "Style": "CallToAction"
    }
  ]
}