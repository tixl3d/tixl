  "TourPoints": [
    {
      "Id": "d29866d7-11b5-430d-8708-07138f7f9c96",
      "Description": "Sooner or later, the term “quaternion” comes up when talking about rotations.\nUnderstanding the math is not required to use them in TiXL."
    },
    {
      "Id": "2b7a6fc7-269a-4c9d-a2b7-56d97f08d3b3",
      "Description": "A quaternion is a four-component rotation representation: x, y, z, and w.\nIt is useful for defining and blending rotations."
    },
    {
      "Id": "c3dd6d8c-ac5a-42b7-a2db-d82a6bac6a2f",
      "Description": "TiXL uses quaternions internally in many places.\nMost parameters use simpler representations, such as Euler angles or axis–angle rotations."
    },
    {
      "Id": "5a759ff7-8134-4af1-9050-77b5d9b2afc9",
      "Description": "One confusing detail is that Vector4 values are often interpreted as colors."
    },
    {
      "Id": "530ce761-9bbf-43cf-a614-f0bffd01c622",
      "Description": "This example shows a rare case where quaternions are used directly: blending between two rotations."
    },
    {
      "Id": "7f8c195a-83cd-49d9-b695-82fcbe360edd",
      "Description": "Solve the puzzle.",
      "Style": "CallToAction"
    }
  ]
}