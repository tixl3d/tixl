  "TourPoints": [
    {
      "Id": "ed92e9f6-e408-4baf-8f06-e88b6a3c854c",
      "Description": "Earlier, trigger events were mentioned.\nInternally, trigger parameters are just boolean values: true or false."
    },
    {
      "Id": "15165cf5-b7a9-411a-a618-7c61c49ad925",
      "Description": "What makes them special is how they are used.\nIn TiXL, triggers usually describe booleans that are true for a single frame, or parameters that only react when the value changes from false to true."
    },
    {
      "Id": "f80274a4-5529-468e-96df-618ceedeef45",
      "Description": "Many animation operators provide a [WasHit] output.\nIt becomes true whenever a new cycle starts and is a common trigger source."
    },
    {
      "Id": "00582c72-3489-4ad4-b0e8-1fe8604daa9e",
      "Description": "In this example, a value is constantly incremented, counting frames.\nReset the counter at the beginning of each bar.",
      "Style": "CallToAction"
    }
  ]
}