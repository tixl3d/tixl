  "TourPoints": [
    {
      "Id": "890c660f-1361-4ecf-8d48-d45acaa3a531",
      "Description": "Transparency makes rendering more complex.\nOnce transparency is involved, the depth buffer can no longer reliably sort geometry.\nAs a result, distant surfaces may appear in front of closer ones."
    },
    {
      "Id": "55db6cc4-ce58-4f41-bbbd-68801e7a1fb7",
      "Description": "In this challenge, a transparent Ryoji pattern is applied to a cube.\nThe goal is to see both the outside and the inside faces."
    },
    {
      "Id": "d973a5fd-c7fb-425f-8331-82ba768d38f6",
      "Description": "To achieve this, two things are required.\nFirst, back-face culling must be disabled so faces pointing away from the camera are still rendered."
    },
    {
      "Id": "d0568d30-89fa-49f4-a97d-bd99c9e33030",
      "Description": "Second, the alpha cut-off parameter may need adjustment.\nIt defines a threshold at which transparent pixels are treated as holes and discarded."
    },
    {
      "Id": "50f40d36-b414-4785-a6e6-b723c02f6c25",
      "Description": "Adjust the draw settings and complete the example.",
      "Style": "CallToAction"
    }
  ]
}