  "TourPoints": [
    {
      "Id": "63603c49-132d-43a3-a1f9-0eb1d8ebfe98",
      "Description": "In TiXL, geometry made from polygons is called a mesh.\nInternally, a mesh is a collection of triangles. Each triangle is defined by three corners, called vertices."
    },
    {
      "Id": "65018e68-aae7-4378-b07d-b38fed7a618c",
      "Description": "There are many operators to create and modify meshes.\nIn this topic, the focus is on different ways to draw meshes."
    },
    {
      "Id": "7c5177eb-4c67-4a45-afa1-b780352db8ce",
      "Description": "Most operators that draw meshes start with the word “Draw”.\nThey use the teal command color, which indicates that they render geometry."
    },
    {
      "Id": "e7b98a48-d708-4f2d-a4c8-02c9c50a0fc4",
      "Description": "Start simple.\nDraw a [Cube] and a [Torus] mesh.",
      "Style": "CallToAction"
    }
  ]
}