  "TourPoints": [
    {
      "Id": "7454d165-3412-43d8-8f47-fd5b0eb31392",
      "Description": "[DrawMesh] applies default material and lighting automatically.\nHow to change materials and lighting is covered in later topics."
    },
    {
      "Id": "8bbcd296-e353-47e5-adaa-c3ad708d2728",
      "Description": "Sometimes you do not want any shading at all.\nFor example, when drawing an image directly onto a surface, shading can be distracting.\nIn earlier topics, [Layer2D] was used for this purpose.\nAn even simpler option for meshes is [DrawMeshUnlit]."
    },
    {
      "Id": "c73d8edc-408b-454f-85bf-95a87173b563",
      "Description": "Like all draw operators, it includes a Color parameter that is multiplied with the result."
    },
    {
      "Id": "cec3d797-1ac6-4eb0-a895-5056571ae7b5",
      "Description": "You do not need to adjust any parameters for this example.",
      "Style": "Tip"
    },
    {
      "Id": "d3db9572-0bd1-49f6-8a5e-5479deaa4b14",
      "Description": "Connect the operators and recreate the challenge.",
      "Style": "CallToAction"
    }
  ]
}