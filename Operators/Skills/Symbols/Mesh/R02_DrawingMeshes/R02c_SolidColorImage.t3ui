  "TourPoints": [
    {
      "Id": "f463fe9c-7cf7-4b09-9ed3-74084131d2b1",
      "Description": "Earlier, [RenderTarget] was introduced as a canvas that is cleared before drawing."
    },
    {
      "Id": "77788c5f-0b68-4363-8c27-715426ae4f41",
      "Description": "Sometimes a project needs a simple image that contains only a single color."
    },
    {
      "Id": "cb2a8d04-aed6-4e0a-8c2e-4c6bb07c3d80",
      "Description": "In this example, the [RenderTarget] is set to a size of one pixel.\nMSAA and the depth buffer are disabled to reduce overhead.\nThis setup is intentionally minimal and optimized."
    },
    {
      "Id": "ce78f816-55ad-445e-802d-00b749b929ea",
      "Description": "Recreate the example.",
      "Style": "CallToAction"
    }
