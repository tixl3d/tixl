  "TourPoints": [
    {
      "Id": "d0699b90-4b94-44d6-a5c0-2cdc0cb0867b",
      "Description": "Starting from small building blocks, very complex geometry can be created by repeating and combining them step by step."
    },
    {
      "Id": "846e3bd7-4b4e-40d5-8694-96431bca6f7c",
      "Description": "Meshes are not just instructions but buffers that store computed results.\nTiXL only recreates and updates these buffers when one of their parameters changes."
    },
    {
      "Id": "fd751d06-5ad0-47e0-a48b-8127ef515022",
      "Description": "This behavior is called caching.\nWhen operators in the graph fade slightly, they are cached.\nThe more of your graph is cached, the faster TiXL can render the scene."
    },
    {
      "Id": "e3bb6826-df2d-4af5-b751-2eb367673d9a",
      "Description": "In this example, [RadialRepeatMesh] and [GridRepeatMesh] are used to construct a small building."
    },
    {
      "Id": "f53011fc-9342-4a7b-9646-0a41bb416393",
      "Description": "Figure out how to repeat the beveled cubes to form columns and walls.",
      "Style": "CallToAction"
    }
  ]
}