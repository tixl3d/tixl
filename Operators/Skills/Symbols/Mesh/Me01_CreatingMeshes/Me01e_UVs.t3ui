  "TourPoints": [
    {
      "Id": "16a5440d-e8bf-4df1-80e1-9e0c9bb0bf3a",
      "Description": "Applying an image to a mesh is called texturing.\nTo define how the image maps onto the mesh, each vertex stores image coordinates in its U and V attributes."
    },
    {
      "Id": "9199529c-b3ac-4f44-9335-58564047ca93",
      "Description": "Most generated or imported meshes already contain a UV set, even if it is not actively used.\nIn some cases, it is useful to modify these coordinates."
    },
    {
      "Id": "1fc5222c-e5ef-4af7-b312-37fcb8a9151b",
      "Description": "In this example, a new UV coordinate system is projected onto a [Torus] mesh."
    },
    {
      "Id": "4927c158-2d8e-48a4-be2d-7ea2fd9d14bd",
      "Description": "Reproduce the example.",
      "Style": "CallToAction"
    }
  ]
}