  "TourPoints": [
    {
      "Id": "474bdb6e-7ec4-408b-97f7-bfcc6ffcee27",
      "Description": "For best performance, TiXL reuses vertices whenever possible.\nVertices that occupy the same position are shared between faces."
    },
    {
      "Id": "ba8ad31b-d76c-46ca-be47-2e5544f05c3f",
      "Description": "In this plane, a [Scatter] effect is applied.\nIt does not behave as expected because vertices between adjacent faces are shared.\nSince the vertices are the same, gaps cannot form between faces."
    },
    {
      "Id": "ca3f9e3b-f21e-4cc7-bf58-32ca9a8c5e6e",
      "Description": "To fix this, the [SplitVertices] operator can be used."
    },
    {
      "Id": "9526e2b1-4219-4342-a8ae-9ec02a08a6d8",
      "Description": "Recreate the example.",
      "Style": "CallToAction"
    }
  ]
}