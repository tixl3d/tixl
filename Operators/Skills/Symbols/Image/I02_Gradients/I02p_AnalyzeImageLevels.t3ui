  "TourPoints": [
    {
      "Id": "93623ec2-7680-4e16-8e94-4495cc4f27c3",
      "Description": "Sometimes it is hard to see the actual numeric values behind an image."
    },
    {
      "Id": "d38b11e1-885a-4286-b598-bbdc0b99dcec",
      "Description": "To help with this, TiXL offers operators for analyzing images.\nIn this example, [ImageLevels] slices an image and visualizes the color values along an intersection line."
    },
    {
      "Id": "d3c9388a-50a8-4a91-b815-9ccb05db7a48",
      "Description": "Connect [LinearGradient] to [ImageLevels].",
      "Style": "CallToAction"
    },
    {
      "Id": "9ee67562-6793-4357-85c0-87ec5fa1b23b",
      "Description": "Now a few things become clear:\n- The gradient is linear, with sharp ends. - It does not cover the full width of the image. - It starts at pure black and ends at pure white."
    }
  ]
}