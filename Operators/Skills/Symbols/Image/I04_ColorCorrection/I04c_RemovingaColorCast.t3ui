    {
      "Id": "5b7efef1-c0d2-4481-9d48-e6447a2b124f",
      "Description": "In this level, the image has a visible blue color cast.\nIn the waveform, the blue curve sits higher than the red and green curves."
    },
    {
      "Id": "91a3cf85-5ba2-466a-a319-98b4f988d9b4",
      "Description": "[ColorGrade] is the appropriate tool for this task.\nIt is already present in the graph. Select it."
    },
    {
      "Id": "96e629d5-8399-4f6f-86cd-0fa6f465e0e4",
      "Description": "Open the color picker for the Gain parameter.\nPure gray has no effect.\nMoving away from gray introduces a color shift.\nTo counter a blue cast, move slightly toward the complementary color: yellow."
    },
    {
      "Id": "bc4e67e3-46a7-4487-b335-96a67c751cc2",
      "Description": "Hold the Shift key for finer control.",
      "Style": "Tip"
    },
    {
      "Id": "4d14e08d-8794-436e-ab9b-b22151b89484",
      "Description": "TiXL’s color picker is tuned for grading work.\nIt emphasizes usable, desaturated colors and keeps highly saturated colors near the edges."
    },
    {
      "Id": "46d56a84-d22c-4ba7-81e0-3cfa6db363a7",
      "Description": "Balance the waveform curves to remove the color cast.",
      "Style": "CallToAction"
    }
  ]
