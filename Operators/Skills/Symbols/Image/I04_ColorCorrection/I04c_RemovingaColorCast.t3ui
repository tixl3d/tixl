    },
    {
      "Id": "96e629d5-8399-4f6f-86cd-0fa6f465e0e4",
      "ChildId": "4f68f62c-efb0-454e-898c-76451b6f26e3",
      "InputId": "be4dc864-a5f9-4356-91f9-58de8056a3a8",
      "Description": "Open the color picker for the Gamma parameter.\nPure gray has no effect.\nMoving away from gray introduces a color shift.\nTo counter a blue cast, move slightly toward the complementary color: yellow.",
      "Style": "CallToAction"
    },
    {
      "Id": "bc4e67e3-46a7-4487-b335-96a67c751cc2",
