  "TourPoints": [
    {
      "Id": "6dc5c7eb-c146-48c7-ae90-4665e09538a5",
      "Description": "[ColorGrade] is a powerful operator for adjusting colors.\nIts parameters are closely related to tools used in professional color grading software."
    },
    {
      "Id": "1097e447-0fd7-42d3-8127-f56e4d94047f",
      "Description": "The core parameters are Gain, Gamma, and Lift.\nThe reference gradient goes from pure black to pure white."
    },
    {
      "Id": "0155668b-b742-4da5-ba61-fbe0032592bc",
      "Description": "If Gain, Gamma, and Lift are pure gray, they are neutral and have no effect.\nYou can click parameter names to reset them to their defaults."
    },
    {
      "Id": "6d5d1ffe-39ea-472b-b799-41552d451397",
      "Description": "Adjust Gain by dragging its color thumbnail with the right mouse button.\nIt primarily affects the brightest parts of the image.",
      "Style": "InfoFor"
    },
    {
      "Id": "1937a11f-da60-4429-9c9f-3ba57e9eb7b1",
      "Description": "Adjust Lift in the same way.\nIt primarily affects the darkest parts of the image.",
      "Style": "InfoFor"
    },
    {
      "Id": "eec3e374-0c67-4b5a-96a1-0359a772d33e",
      "Description": "Adjust Gamma to change overall brightness without pushing only highlights or shadows.",
      "Style": "InfoFor"
    },
    {
      "Id": "c7a2a8bc-29a4-4ced-aa14-3cbaa2d29b68",
      "Description": "Dragging the color thumbnail with the left mouse button adjusts the alpha channel.\nThis scales the strength of the effect.",
      "Style": "Tip"
    },
    {
      "Id": "932062d4-9ce0-4a2e-a72e-b91475cd1249",
      "Description": "Recreate the challenge at the bottom.",
      "Style": "CallToAction"
    }
  ]
}