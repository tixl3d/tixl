  "TourPoints": [
    {
      "Id": "c5345035-6381-49ac-ad8a-40d7bbc561ee",
      "Description": "If you think the [WaveForm] view takes some getting used to you're not alone."
    },
    {
      "Id": "a1422689-69b4-4107-93b4-5503abdb8309",
      "Description": "Its Vectorscope might look even more confusing. That's why it's disabled by default. But it can be very powerful to analyze color disctributions."
    },
    {
      "Id": "c2d24386-9b0b-4c65-b67c-e30ed946b6a2",
      "Description": "First let's enable the Vector Scoop.",
      "Style": "CallToAction"
    },
    {
      "Id": "4b9eff95-664c-4c1d-8eef-7d04b6b61f33",
      "Description": "Notice the color circle on the edge: Reds on top, blue on the bottom right, etc.\nThe white dots show the color distribution. Gray colors are in the center. Satatured colors are closer to the edge.",
      "Style": "InfoFor"
    },
    {
      "Id": "d9b379b9-24cf-498f-a374-25f3e1f6e0e0",
      "Description": "The thin white line between Yellow (YL) and Red is the natural skin tone line.",
      "Style": "InfoFor"
    },
    {
      "Id": "d7fceaa9-8d28-43b5-ba93-6275b2981a4c",
      "ChildId": "3ec279c8-7d5d-45c1-90ea-30e6e99db320",
      "InputId": "be4dc864-a5f9-4356-91f9-58de8056a3a8",
      "Description": "The thick lump near the **Red** line is the background.\nLet's adjust the [ColorGrade]'s Gamma parameter to change the background to a natural gray.",
      "Style": "InfoFor"
    },
    {
      "Id": "4656fcf5-9319-477e-aa7e-39a4089e3804",
      "ChildId": "3ec279c8-7d5d-45c1-90ea-30e6e99db320",
      "InputId": "be4dc864-a5f9-4356-91f9-58de8056a3a8",
      "Description": "Click on the Gamma color thumb to open the color picker.  Hold Shift for finer control.",
      "Style": "CallToAction"
    }
  ]
}