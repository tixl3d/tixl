  "TourPoints": [
    {
      "Id": "47b1785a-add0-4a99-9445-933342f18d33",
      "Description": "In professional design, adjusting and refining colors is called “grading”.\nIt often involves shaping the overall look, but also removing unwanted color tints or visual artifacts.\nPrecise work requires precise measurement."
    },
    {
      "Id": "79a5fdc2-4c86-42e0-bc64-fd2050eb5590",
      "Description": "The tool for this is called [WaveForm].\nThe name can be misleading at first, but it is widely used in professional software.\nIt works similarly to [ImageLevels], but instead of showing a single slice, it overlays slices from the entire image.\nThis allows you to read brightness and color distribution across all columns at once.",
      "Style": "InfoFor"
    },
    {
      "Id": "1904fd5f-a12d-43f5-a768-e2e9674682bf",
      "Description": "In this example, the curves on the left side merge into a single gray line.\nThis shows that parts of the image have reduced saturation, because all color channels share the same value."
    },
    {
      "Id": "973abf3b-8b55-4164-a4d5-d006bd342de0",
      "Description": "Try to reproduce the image.",
      "Style": "CallToAction"
    }
  ]
}