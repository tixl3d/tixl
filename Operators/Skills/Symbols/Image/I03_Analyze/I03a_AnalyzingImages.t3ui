  "TourPoints": [
    {
      "Id": "94c56f2b-58e3-499e-a9ef-dac7a605293f",
      "Description": "As projects grow, trial and error is often no longer enough.\nSometimes an image looks wrong. Sometimes an effect behaves in an unexpected way.\nIn these cases you need information. Understanding that information is the key to fixing the problem."
    },
    {
      "Id": "0d395c52-76f4-4be7-834f-25cc37db8b8f",
      "Description": "One of the most useful tools for this is [ImageLevels].\nIt samples a line through the image and maps the brightness of all color channels onto a graph."
    },
    {
      "Id": "5b3079fb-9af1-44ca-a11c-5a36c15aad21",
      "Description": "In this example, the curves sometimes merge into a single line.\nThis happens where the image becomes grayscale, because all color channels have the same value."
    },
    {
      "Id": "ced50e20-8f51-4b8e-b6ef-e8f2a42e474c",
      "Description": "Adjust the gradient settings to reproduce the example.",
      "Style": "CallToAction"
    }
  ]
}