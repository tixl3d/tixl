  "TourPoints": [
    {
      "Id": "f0dd028b-6aae-46e4-8957-252560a0d01e",
      "Description": "Most displays use 8-bit color.\nThat means 256 steps per channel, which is sometimes not enough for smooth gradients."
    },
    {
      "Id": "f8ae908c-c6ae-4d67-8c6f-916f05530737",
      "Description": "In this example, you can see visible banding.\nThe image itself is smooth. TiXL uses 16-bit color here, so the data has much higher precision than the display.\nThe artifacts come from the display, not from the image."
    },
    {
      "Id": "199c3f2c-0b4e-44cc-ad70-2381b7929fb8",
      "Description": "Use [ImageLevels] to narrow the curve range and confirm that the image data is smooth.",
      "Style": "CallToAction"
    },
    {
      "Id": "395ed094-2c9d-440b-8dbc-dec3367a0b9d",
      "Description": "Reduce visible banding by inserting a [Grain] operator.",
      "Style": "CallToAction"
    }
  ]
}