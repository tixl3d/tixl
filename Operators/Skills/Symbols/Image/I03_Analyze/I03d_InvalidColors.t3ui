  "TourPoints": [
    {
      "Id": "739272d0-35ee-491b-a61f-037e3fc532c2",
      "Description": "These colors are outside the valid range.\nNegative color values can cause unpredictable results when blending or rendering an image."
    },
    {
      "Id": "b25af50b-f775-4c74-8de5-20691c45e624",
      "Description": "The alpha channel should always stay between 0 and 1.\nMost image operators clamp alpha automatically, but relying on that can hide problems."
    },
    {
      "Id": "58b8764b-4413-4471-9b00-74b75dacf7e8",
      "Description": "A simple fix is to add [RemapColors].\nIt samples colors from a gradient in the valid 0–1 range and clamps values outside that range."
    },
    {
      "Id": "d219e752-8964-4b69-ae00-dbddf1f31cd9",
      "Description": "Fix the example.",
      "Style": "CallToAction"
    }
  ]
}