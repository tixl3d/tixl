    {
      "Id": "ef7b2821-c35a-4415-886e-c4cfa7ab1eca",
      "Description": "Something is wrong with this image.\nBright values are clipped, creating a visible edge where colors reach pure white.\nThis may not be obvious at first glance, but with [ImageLevels] the edge becomes clear immediately."
    },
    {
      "Id": "40310c3c-3bf5-49b2-a5e2-58e30b340700",
      "Description": "Use [ToneMap] to reduce the maximum brightness.",
