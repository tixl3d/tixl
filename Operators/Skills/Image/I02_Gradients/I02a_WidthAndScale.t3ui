  "TourPoints": [
    {
      "Id": "62da30af-e883-4c17-8d4c-0bca3b2cdc46",
      "Description": "Gradients are a core building block in TiXL. They are used in many operators and effects.\nThis is the [LinearGradient]. It draws a gradient along a line."
    },
    {
      "Id": "54a0a877-ccc7-4df0-a8a0-7904df248d1f",
      "ChildId": "2385e6e5-8fd9-4edc-b4c9-29af4ffcd4e8",
      "Description": "Notice that the gradient does not cover the full width of the image.\nThis is because the default scale mode is AlignToHeight. When the output aspect ratio changes, TiXL adjusts the left and right edges.\nAligning to the height helps avoid unexpected layout changes and keeps the result consistent across aspect ratios.",
      "Style": "InfoFor"
    },
    {
      "Id": "1df787ed-09fe-4c59-b63d-79be5ad5d4ae",
      "ChildId": "2385e6e5-8fd9-4edc-b4c9-29af4ffcd4e8",
      "Description": "Adjust the parameters so the gradient covers the full width.",
      "Style": "CallToAction"
    }
  ],
