  "TourPoints": [
    {
      "Id": "72af5cc7-7b0b-4eca-a045-9b91b37c3f28",
      "Description": "In this step, a transform is not only used to define where something is drawn.\nThe same object is drawn multiple times at different positions."
    },
    {
      "Id": "d2e06216-d1aa-4303-bb61-188b107d9ac3",
      "Description": "This is called instancing.\nIt allows all copies to be defined and adjusted together."
    },
    {
      "Id": "61fed925-973d-4582-95f0-32c86fb62fa7",
      "Description": "Instancing is a powerful concept, and TiXL provides multiple ways to work with it."
    },
    {
      "Id": "91ac350d-fefd-4272-88b7-6e0def2717c4",
      "ChildId": "9141acd6-a837-4d3a-9072-373373f8f42f",
      "Description": "Replicate the example.",
      "Style": "CallToAction"
    }
  ]
