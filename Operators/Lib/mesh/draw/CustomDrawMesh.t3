    {
      "Id": "8d330fcc-201d-4223-8c6e-f79611c48671"/*ShaderCode*/,
      "SymbolId": "5880cbc3-a541-4484-a06a-0e6f77cdbe8e",
      "Name": "ShaderCode",
      "InputValues": [
        {
          "Id": "ceeae47b-d792-471d-a825-49e22749b7b9"/*InputString*/,
          "Type": "System.String",
          "Value": "c=float4(pin.texCoord.xy,0,1);\nc.b=any(frac(pin.texCoord.xy*100)<.02);"
        }
      ],
      "Outputs": []
    },
    {
      "Id": "9c65da2e-902e-4bd4-bb0c-6acbf7986b31"/*ShaderCode*/,
      "SymbolId": "5880cbc3-a541-4484-a06a-0e6f77cdbe8e",
      "Name": "ShaderCode",
      "InputValues": [
        {
          "Id": "ceeae47b-d792-471d-a825-49e22749b7b9"/*InputString*/,
          "Type": "System.String",
          "Value": "frag.N = ComputeNormal(pin, pin.tbnToWorld);\nfloat g=mul(frag.N.xyz,transpose((float3x3)CameraToWorld)).z;\nfloat3 nf=-normalize(cross(ddx(pin.worldPosition.xyz),ddy(pin.worldPosition.xyz)));\nfloat3 nw=normalize(lerp(nf,frag.N,-1.5));\n//c.rgb=mul(frag.N.xyz,transpose((float3x3)CameraToWorld)).xyz;\nc.rgb=nw;\n\n\n\n\n"
        }
      ],
      "Outputs": []
    },
