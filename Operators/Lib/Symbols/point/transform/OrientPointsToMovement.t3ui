{
  "FormatVersion": 3,
  "Id": "d48b02de-8967-4a03-9f7f-843e443470dd"/*OrientPointsToMovement*/,
  "Description": "Rotates points so that their z-axis points in the direction they moved since the last frame.\n\nUseful for instancing meshes like fish, birds or arrows on animated points. Unlike a fixed up vector, the up axis of the previous frame is carried over, so points can move in any direction without flipping around. AlignToUpVector slowly pulls them back upright.\n\nThe rotations are kept between frames, so points must not change their order. Points that don't move keep their last rotation.\n\nAKA: velocity, direction, heading, align, look along, motion\n\nSee also: [OrientPoints], [ReorientLinePoints], [DrawMovingPoints]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "00731dd7-5956-4f9b-bdc5-52b708699843"/*Reset*/,
      "Position": {
        "X": -30.0,
        "Y": 975.0
      },
      "Description": "Resets the rotations to those of the input points."
    },
    {
      "InputId": "15631d43-e3b6-4203-a0ec-c76be4f35a39"/*MinMovement*/,
      "Position": {
        "X": -30.0,
        "Y": 800.0
      },
      "GroupTitle": "Movement",
      "Description": "Points that move less than this distance per frame keep their rotation.",
      "Min": 0.0,
      "Max": 0.01,
      "ClampMin": true
    },
    {
      "InputId": "3dd8ec3d-3e94-4d1c-a36d-d328050dfa05"/*Points*/,
      "Relevancy": "Required",
      "Position": {
        "X": -450.0,
        "Y": 565.0
      }
    },
    {
      "InputId": "5fc4a0d0-5bd4-4b85-b263-8eddd5e50ef1"/*UpVector*/,
      "Position": {
        "X": -30.0,
        "Y": 700.0
      },
      "GroupTitle": "Up Vector",
      "Description": "The direction the up axis (y) of the points is pulled toward."
    },
    {
      "InputId": "61aa155b-a917-4ce2-ae9d-4941ecf78f32"/*AlignToUpVector*/,
      "Position": {
        "X": -30.0,
        "Y": 735.0
      },
      "Description": "0 keeps the previous up axis to avoid sudden flips, but lets the roll drift. 1 always uses UpVector, which flips when moving along it.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "656aea6e-7757-4be2-85ff-f714c9366612"/*Flip*/,
      "Position": {
        "X": -30.0,
        "Y": 940.0
      },
      "Description": "Aligns the negative z-axis with the movement instead."
    },
    {
      "InputId": "cad872c2-a0d9-4cbe-9fb5-662c0ecbc42c"/*Smoothing*/,
      "Position": {
        "X": -30.0,
        "Y": 600.0
      },
      "Description": "Blends from the previous rotation toward the movement direction each frame. 0 follows the movement immediately.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "fdeb9f33-f942-45d1-bd94-7a7a64a54d96"/*JumpThreshold*/,
      "Position": {
        "X": -30.0,
        "Y": 835.0
      },
      "Description": "Points that move further than this per frame are treated as teleported and keep their rotation. 0 disables the check.",
      "Min": 0.0,
      "Max": 5.0,
      "ClampMin": true
    }
  ],
