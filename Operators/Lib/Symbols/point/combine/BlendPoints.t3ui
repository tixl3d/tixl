{
  "FormatVersion": 3,
  "Id": "2dc5c9d1-ea93-4597-a4d9-7b610aad603a"/*BlendPoints*/,
  "Description": "Blends between two point buffers with different transition modes.\n\nSee also: [BlendMeshToPoints], [SnapToPoints]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "91b903a2-5127-431b-ab66-d5a38ce1693c"/*PointsB_*/,
      "Relevancy": "Required",
      "Position": {
        "X": 148.47668,
        "Y": 1052.1796
      }
    },
    {
      "InputId": "97904d2e-ae67-4ab4-9201-7902a85d12f3"/*PointsA_*/,
      "Relevancy": "Required",
      "Position": {
        "X": -539.26337,
        "Y": 958.8297
      }
    },
    {
      "InputId": "acef877d-214d-4ca0-ac11-95fa59d1f6fc"/*Pairing*/,
      "Position": {
        "X": -415.56927,
        "Y": 1432.6199
      },
      "AddPadding": "True"
    },
    {
      "InputId": "ba7ffda2-f9f6-440d-a174-7339844835fa"/*BlendFactor*/,
      "Position": {
        "X": -275.56927,
        "Y": 1362.6199
      },
      "Description": "0 shows PointsA, 1 shows PointsB.\n\nWith BlendMode Mix, values outside 0...1 overshoot. With MixWithSlidingRangeSmooth, the transition loops.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "bdb712a8-3dbc-458a-887a-5add51813196"/*RangeWidth*/,
      "Position": {
        "X": -275.56927,
        "Y": 1467.6199
      },
      "Description": "Width of the transition range for the MixWithSlidingRange modes."
    },
    {
      "InputId": "c5480ce5-a8ba-4a26-8cee-c28e442020b7"/*BlendMode*/,
      "Position": {
        "X": -415.56927,
        "Y": 1397.6199
      },
      "GroupTitle": "Options",
      "Description": "Mix: uses BlendFactor.\nUseA_F1: uses the F1 attribute of PointsA as blend factor.\nUseB_F1: uses 1 - F1 of PointsB.\nMixWithSlidingRange(Smooth): sweeps the transition along the point index."
    },
    {
      "InputId": "ee8e9e15-ce18-4034-abc6-dd56108c8a02"/*Scatter*/,
      "Position": {
        "X": -275.56927,
        "Y": 1502.6199
      },
      "Description": "Adds random offsets to the positions during the transition."
    }
  ],
