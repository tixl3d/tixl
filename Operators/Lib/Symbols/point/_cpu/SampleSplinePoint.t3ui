{
  "FormatVersion": 3,
  "Id": "688230de-a3fc-4740-a12d-9e2f98cad60a"/*SampleSplinePoint*/,
  "Description": "Linearly interpolates a position and orientation along a CPU point list and draws SubTree there.\n\nThe SubTree is drawn with a transform built from the sampled position and orientation; it replaces the incoming object transform. The Position output returns the sampled position. Note that U = 1 reaches the second-to-last point of the list.\n\nSee also: [SampleCPoints]",
  "InputUis": [
    {
      "InputId": "73c4a495-d846-4762-9efd-fc47364920c1"/*U*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Normalized position along the list, clamped to 0..1."
    },
    {
      "InputId": "7c787d9d-38a4-4b09-9ec7-2a24123f9e03"/*Points*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "d3aca17d-cb4a-4f7b-acdf-eaeb25016bc6"/*SubTree*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Commands drawn at the sampled position and orientation."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "c1fcc3a4-bb4c-4ee5-925f-1cc498f352da"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    },
    {
      "OutputId": "e978692f-fe00-4d59-81b9-c71f78c19151"/*Position*/,
      "Position": {
        "X": 0.0,
        "Y": 200.0
      }
    }
  ]
}