{
  "FormatVersion": 3,
  "Id": "10507c42-1240-47cc-9569-5e3f1c733e99"/*PointSimulation*/,
  "Description": "Creates a simulation buffer for applying simulation-like force fields, curl noise, or flocking simulations.\n\nIt initially creates a copy of the connected source point buffer. Operators in lib.point.sim then modify this copy on every frame. The simulation can be reset to the initial state or constantly blended towards it with MixOriginal, which helps to keep a simulation under control.\n\nThe [ParticleSystem] provides a more convenient setup for most particle effects.\n\nSee also: [SimulateBoidsExample]\nAlso check out the [HowToUsePoints] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0954b214-dd1f-40fd-bebe-29f74a8f5585"/*Reset*/,
      "Position": {
        "X": -290.23273,
        "Y": 547.2019
      },
      "Description": "Restores the simulation buffer from the input buffer. Equivalent to setting MixOriginal to 1."
    },
    {
      "InputId": "2f883ce2-421a-45f5-8de2-9e05d984b551"/*MinCapacity*/,
      "Position": {
        "X": -150.23268,
        "Y": 287.87088
      },
      "Description": "If the size of the input buffer changes, the simulation will start from scratch.\nSetting this optional initial size will only reset the simulation if the new input buffer exceeds the reserved size."
    },
    {
      "InputId": "5b9dcd2e-36b6-46f3-bded-0cba148cf628"/*Update*/,
      "Position": {
        "X": -290.2326,
        "Y": 652.2019
      },
      "Description": "Enables the per-frame update of the simulation buffer. When disabled, the buffer is frozen until Reset is used."
    },
    {
      "InputId": "76263857-27ea-40f5-856f-983c6ddcbfe8"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": -546.2322,
        "Y": 80.360535
      }
    },
    {
      "InputId": "79080698-1097-4178-b7da-7d10fd86be28"/*MixOriginal*/,
      "Position": {
        "X": -10.232681,
        "Y": 512.2019
      },
      "Description": "Controls how much of the original state is being restored:\n\n- 0: The simulation runs completely free.\n- 0.03: A small percentage is constantly mixed into the simulation, thus avoiding too extreme deviations.\n- 1: Equivalent to resetting to the source.\n\nFor experimental effects, you can use mix values exceeding the range between 0 and 1.",
      "Scale": 0.001
    }
  ],
