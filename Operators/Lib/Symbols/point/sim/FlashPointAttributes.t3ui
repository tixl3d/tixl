      },
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "8e5269e6-0a01-49e0-983e-1ae100418f93"/*PositionMode*/,
      "Position": {
        "X": -300.0,
        "Y": 495.0
      },
      "Description": "Offset moves points by Position, Replace moves them to Position."
    },
    {
