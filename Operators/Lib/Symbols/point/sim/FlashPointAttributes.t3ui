{
  "FormatVersion": 3,
  "Id": "ca0e9c98-5830-4942-82b4-aaf36b8076fd"/*FlashPointAttributes*/,
  "Description": "Flashes attributes onto a selection of points on a trigger and lets them recover to the incoming points over time.\n\nEach rising edge of TriggerFlash blends the enabled attributes (position, rotation, scale, F1, F2, color) into the points selected by Index, Count, Step and Scatter. The op keeps its own copy of the flashed values and a per-point age, so flashed points fade back to the live input while the input keeps animating. Flashing a point that is still recovering continues from its current state.\n\nThe op is stateful: it only advances while time runs and does not follow timeline scrubbing.\n\nCombines ideas of [PointSimulation], [SetPointAttributes] and [FilterPoints].\n\nAKA: pulse, highlight, hit, accent\n\nTips:\n- Flash one point per bar: connect an [AnimInt] to Index and an [AnimBoolean] to TriggerFlash.\n- Set Scatter to 1 to flash random points; the selection changes on each trigger.\n- Use a small GainAndBias bias for a fast fade-out with a long tail.",
  "InputUis": [
    {
      "InputId": "14e19d37-c921-4a0d-9254-cda8870764c0"/*Points*/,
      "Relevancy": "Required",
      "Position": {
        "X": -300.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "2d013020-13c9-412b-890b-6360ee3261b6"/*TriggerFlash*/,
      "Position": {
        "X": -300.0,
        "Y": 45.0
      },
      "Description": "Flashes the selected points on each rising edge."
    },
    {
      "InputId": "864ef3df-4a5c-43cc-a4c6-420825b8852e"/*Index*/,
      "Position": {
        "X": -300.0,
        "Y": 90.0
      },
      "GroupTitle": "Selection",
      "Description": "Index of the first flashed point. Wraps around the point count, so an animated counter can step through the points.",
      "Min": 0,
      "Max": 100
    },
    {
      "InputId": "5e7537fc-bbfb-416c-9f39-8d45d6e3c82e"/*Count*/,
      "Position": {
        "X": -300.0,
        "Y": 135.0
      },
      "Description": "Number of points flashed per trigger.",
      "Min": 0,
      "Max": 100,
      "ClampMin": true
    },
    {
      "InputId": "21d2b49f-4a2c-431d-b6f8-1dbc49d5811c"/*Step*/,
      "Position": {
        "X": -300.0,
        "Y": 180.0
      },
      "Description": "Index distance between flashed points.",
      "Min": 0.0,
      "Max": 10.0
    },
    {
      "InputId": "ac4a5f51-6080-4c15-8c9b-e5d2bbe3e47e"/*Scatter*/,
      "Position": {
        "X": -300.0,
        "Y": 225.0
      },
      "Description": "Randomly offsets the selected indices. 1 picks from all points. The random pattern changes with each flash.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "229a9f10-ca06-4581-9bd8-a6ef3b881120"/*Seed*/,
      "Position": {
        "X": -300.0,
        "Y": 270.0
      },
      "Min": 0,
      "Max": 100
    },
    {
      "InputId": "ca15d267-1340-47d3-b49c-d99c070ad0e8"/*Strength*/,
      "Position": {
        "X": -300.0,
        "Y": 315.0
      },
      "GroupTitle": "Flash",
      "Description": "How far the flashed attributes are blended from the current state toward the set values.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "d161f5ff-3c38-474d-8468-1dedc42d9cf8"/*StrengthFactor*/,
      "Position": {
        "X": -300.0,
        "Y": 360.0
      },
      "Description": "Multiplies Strength with the F1 or F2 attribute of the source points."
    },
    {
      "InputId": "d84b9184-335f-4672-9d00-9f6eb946d13b"/*SetPosition*/,
      "Position": {
        "X": -300.0,
        "Y": 405.0
      }
    },
    {
      "InputId": "00ab4d10-a25a-4645-b549-4798221da7d5"/*Position*/,
      "Position": {
        "X": -300.0,
