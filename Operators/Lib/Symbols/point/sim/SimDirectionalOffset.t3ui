{
  "FormatVersion": 3,
  "Id": "7a08d73e-1aea-479f-8d36-ecb119d75c3a"/*SimDirectionalOffset*/,
  "Description": "Offsets the points of a simulation buffer along a direction on every frame.\n\nAs the buffer is modified in place, the offset accumulates over time; use it with [PointSimulation]. A draw operator like [DrawPoints], [DrawLines] or [DrawMeshAtPoints] is needed to make the points visible.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "1840e5b8-2aee-44d0-b826-d34395325506"/*Direction*/,
      "Position": {
        "X": -417.82614,
        "Y": 574.45514
      },
      "GroupTitle": "Settings",
      "Description": "Offset per frame.",
      "Scale": 0.001
    },
    {
      "InputId": "1f561bbd-a272-4c06-bd56-a580a2022bc6"/*Mode*/,
      "Position": {
        "X": -417.82614,
        "Y": 754.45526
      },
      "GroupTitle": "Advanced",
      "Description": "Legacy: Offsets the positions directly.\nEncodeInRotation: Adds the offset to a velocity encoded in the length of the rotation quaternion, as used by legacy simulations."
    },
    {
      "InputId": "2fe652d7-92c7-4cd0-8190-78905be178f1"/*RandomAmount*/,
      "Position": {
        "X": -417.82614,
        "Y": 664.45526
      },
      "Description": "Randomly increases the offset per point by up to this factor."
    },
    {
      "InputId": "4f9ab443-3885-4a57-9116-6be5824bd95b"/*Amount*/,
      "Position": {
        "X": -417.82614,
        "Y": 619.45514
      },
      "Description": "Multiplier for Direction.",
      "AddPadding": "True",
      "Scale": 0.001
    },
    {
      "InputId": "82746dde-ab65-4c49-a22f-cf9a50f4a3e9"/*GPoints*/,
      "Position": {
        "X": -112.90869,
        "Y": 209.04144
      }
    },
    {
      "InputId": "a6b0a4da-2f6f-4941-b097-ed5e3dd6af0b"/*ShowGizmo*/,
      "Position": {
        "X": -417.82614,
        "Y": 799.45526
      },
      "Description": "Defines if and how the gizmo is shown in the Output View"
    }
  ],
