{
  "FormatVersion": 3,
  "Id": "90a5794c-4cec-41e1-bd79-403b40e5666f"/*DrawLinesShaded*/,
  "Description": "Draws lines from a point buffer as PBR-shaded tubes using the material defined by [SetMaterial].\n\nEach segment is a camera-facing quad that ray-traces a round-capped tube, so tubes stay perfectly round at any distance and joints stay round at any bend angle, for two triangles per segment. Separators (NaN points) split the buffer into separate lines.\n\nBetween points the tube runs straight. Smoothing averages each point with its neighbours to remove jaggy corners; line ends stay in place.\n\nAKA: tubes, shaded lines, pipes\n\nTips\n- For textures around the tube, few-sided or elliptic profiles, flat ends, mitered corners or faceted shading, use [DrawTubes]. It builds real geometry, so it costs more per segment.\n\nSee also: [DrawLines], [DrawRibbons], [DrawTubes], [DrawPointsShaded]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0295f9fc-3cef-4e93-a3a5-844c7f1d06e9"/*EnableZTest*/,
      "Position": {
        "X": 2630.4138,
        "Y": 4424.199
      },
      "Description": "Hides lines behind other geometry."
    },
    {
      "InputId": "0b1996a0-2255-4289-a07d-7a423fafc191"/*FadeNearest*/,
      "Position": {
        "X": 1619.0709,
        "Y": 3754.4053
      },
      "Description": "Lines closer to the camera than this distance fade out; they are fully visible at twice the distance. 0 disables the fade."
    },
    {
      "InputId": "3082feed-8084-4248-862f-f92c75323583"/*WidthFactor*/,
      "Position": {
        "X": 2345.8533,
        "Y": 3733.3735
      },
      "Description": "Point attribute that multiplies the width: None, F1 or F2."
    },
    {
      "InputId": "51a25054-678d-47f1-9de6-f7180515c178"/*ColorField*/,
      "Position": {
        "X": 2205.8533,
        "Y": 3590.6753
      },
      "Description": "Optional field that multiplies the color depending on the world position of the tube surface."
    },
    {
      "InputId": "5a4e9d51-27c0-4c85-8cd9-37d7dbc27ce3"/*EnableZWrite*/,
      "Position": {
        "X": 2630.4138,
        "Y": 4459.199
      },
      "GroupTitle": "Draw Options",
      "Description": "Writes the tubes to the depth buffer so they can hide geometry drawn later."
    },
    {
      "InputId": "66c56537-7036-48a5-866b-3d21dc756c0e"/*Color*/,
      "Position": {
        "X": 1339.0709,
        "Y": 3544.4053
      },
      "AddPadding": "True"
    },
    {
      "InputId": "76790f65-315a-42ee-b509-d01475a79f49"/*UsePointScale*/,
      "Position": {
        "X": 2205.8533,
        "Y": 3768.3735
      },
      "Description": "Multiplies the width with the point's Scale.x.",
      "AddPadding": "True"
    },
    {
      "InputId": "c000197c-192e-4073-a5aa-f2570933c4c8"/*Smoothing*/,
      "Position": {
        "X": 1619.0709,
        "Y": 3789.4053
      },
      "Description": "How many neighbours on each side are averaged into each point. Removes jaggy corners; 0 draws the points as they are.",
      "Min": 0.0,
      "Max": 16.0,
      "Scale": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "e4ae8056-00bb-4220-80fc-69457debb26c"/*Width*/,
      "Position": {
        "X": 1619.0709,
        "Y": 3684.4053
      },
      "AddPadding": "True",
      "Description": "Diameter of the tubes in world units.",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.0001,
      "ClampMin": true
    },
    {
      "InputId": "f219a75c-a4ab-4e09-a5cb-ab7448101317"/*BlendMode*/,
      "Position": {
        "X": 2630.4138,
        "Y": 4389.199
      }
    },
    {
      "InputId": "fe1ca570-d864-4a18-a500-d7b2311a9c78"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 2339.4011,
        "Y": 4189.2515
      }
    }
  ],
