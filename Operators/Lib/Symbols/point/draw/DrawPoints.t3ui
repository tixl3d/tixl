{
  "FormatVersion": 3,
  "Id": "ffd94e5a-bc98-4e70-84d8-cce831e6925f"/*DrawPoints*/,
  "Description": "Draws a point buffer as camera-facing sprites.\n\nThe orientation of the points is ignored. The size is PointSize multiplied by the point's Scale (see UsePointsScale) and optionally its F1 or F2 attribute (see ScaleFactor). A PointSize of 1 results in a diameter of 0.2 world units. Point colors are multiplied with Color and the optional texture, which replaces the default round shape.\n\nPoints are drawn in buffer order and not sorted by distance to the camera, which can cause artifacts with transparent blending. Try other blend modes or disable depth writing for additive effects. Very large points cause high fill rates and can drastically impact performance.\n\nSee also: [DrawBillboards], [DrawPointsShaded], [DrawLines], [DrawRibbons]\nAlso check out the [HowToDrawThings] and [HowToUsePoints] tutorials.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "3fbad175-6060-40f2-a675-bdae20107698"/*FadeNearest*/,
      "Position": {
        "X": 2062.5884,
        "Y": 3953.3596
      },
      "Description": "Points closer to the camera than this distance fade out; they are fully visible at twice the distance. 0 disables the fade.",
      "AddPadding": "True"
    },
    {
      "InputId": "414c8045-5086-4449-9d9a-03f28c3966b3"/*PointSize*/,
      "Position": {
        "X": 2062.5884,
        "Y": 3883.3596
      },
      "Description": "Size of the points. A size of 1 results in a diameter of 0.2 world units.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 0.5,
      "ClampMin": true
    },
    {
      "InputId": "5df18658-ef86-4c0f-8bb4-4ac3fbbf9a33"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 1475.8118,
        "Y": 4734.13
      }
    },
    {
      "InputId": "64e75fea-c07f-4cb1-8ac0-0f8d05362664"/*UsePointsScale*/,
      "Position": {
        "X": 1919.2306,
        "Y": 4175.031
      },
      "Description": "Multiplies the size with the point's Scale.x and Scale.y.",
      "AddPadding": "True"
    },
    {
      "InputId": "7acc95ad-d317-42fc-97f8-85f48d7e516f"/*EnableZTest*/,
      "Position": {
        "X": 2480.7285,
        "Y": 4631.41
      },
      "Description": "Hides points behind other geometry."
    },
    {
      "InputId": "814fc516-250f-4383-8f20-c2a358bbe4e1"/*EnableZWrite*/,
      "Position": {
        "X": 2480.7285,
        "Y": 4666.41
      },
      "Description": "Writes the points to the depth buffer so they can hide geometry drawn later.",
      "AddPadding": "True"
    },
    {
      "InputId": "850e3a32-11ba-4ad2-a2b1-6164f077ddd6"/*Texture_*/,
      "Position": {
        "X": 1487.8793,
        "Y": 4263.588
      },
      "Description": "Replaces the default round shape. Multiplied with the point color.",
      "AddPadding": "True"
    },
    {
      "InputId": "8fab9161-48d4-43b0-a18f-5942b7071a49"/*BlendMode*/,
      "Position": {
        "X": 2480.7285,
        "Y": 4596.41
      },
      "GroupTitle": "Draw options"
    },
    {
      "InputId": "cc442161-e9ca-40ea-be3b-f87189d4e155"/*Color*/,
      "Position": {
        "X": 1922.5884,
        "Y": 3673.3596
      },
      "Description": "Multiplied with the point colors and the texture.",
      "AddPadding": "True"
    },
    {
      "InputId": "cce4048d-85b7-4d82-aec1-4379d1f0de61"/*AlphaCutOff*/,
      "Position": {
        "X": 2062.5884,
        "Y": 3918.3596
      },
      "Description": "Pixels with an alpha below this value are discarded. This avoids hard edges around transparent areas when depth writing is enabled."
    },
    {
      "InputId": "e40aeedd-49fe-467c-b886-064a1024cef3"/*ScaleFactor*/,
      "Position": {
        "X": 2059.2305,
        "Y": 4140.0303
      },
      "Description": "Point attribute that multiplies the size: None, F1 or F2."
    },
    {
      "InputId": "fe99f40a-607a-4f62-9949-17f4715db859"/*ColorField*/,
      "Position": {
        "X": 1781.4027,
        "Y": 3413.3674
      },
      "Description": "Optional field that multiplies the color depending on the world position of each point."
    }
  ],
