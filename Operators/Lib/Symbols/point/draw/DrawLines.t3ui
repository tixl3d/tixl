{
  "FormatVersion": 3,
  "Id": "836f211f-b387-417c-8316-658e0dc6e117"/*DrawLines*/,
  "Description": "Draws a point buffer as camera-facing lines connecting consecutive points.\n\nThe line width is LineWidth multiplied by each point's Scale.x and optionally its F1 or F2 attribute (see WidthFactor). Separator points (with NaN scale) split the buffer into multiple disconnected lines. The orientation of the points is ignored; use [DrawRibbons] or [DrawTubes] for oriented or 3D lines.\n\nLong segments that intersect the camera plane (one point in front of and one behind the camera) are not rendered correctly; use [DrawRayLines] for these.\n\nDrawing lines is fast: depending on the graphics card, millions of segments per frame are possible. Performance depends more on the screen area covered by the lines (render resolution and MSAA) than on the point count.\n\nSee also: [DrawClosedLines], [DrawLinesBuildup], [DrawPoints]\nAlso check out the [HowToUsePoints] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "00cb7dc1-edc7-4102-a6a0-6cc44a4f0e56"/*WidthFactor*/,
      "Position": {
        "X": 630.759,
        "Y": 220.82883
      },
      "Description": "Point attribute that multiplies the line width: None, F1 or F2.",
      "DisplayAs": "SegmentedSwitch"
    },
    {
      "InputId": "28f85ae9-ebae-4300-8aa0-738c6327cc44"/*TransitionProgress*/,
      "Position": {
        "X": 630.759,
        "Y": 54.1371
      },
      "Description": "Offsets the U texture coordinate, e.g. to scroll a texture along the lines."
    },
    {
      "InputId": "520c428e-77b0-44d7-95af-d1cbf9b7e4a7"/*UvScaleFX*/,
      "Position": {
        "X": 630.759,
        "Y": 185.82886
      },
      "Description": "Source of the U texture coordinate: Stretch maps 0..1 across the whole buffer, UFromFX1 and UFromFX2 use the point's F1 or F2 attribute."
    },
    {
      "InputId": "75419a73-8a3e-4538-9a1d-e3b0ce7f8561"/*Color*/,
      "Position": {
        "X": 350.75894,
        "Y": -155.8629
      },
      "Description": "Defines the color of the Lines.\nIf a Texture is used this color will be multiplied.",
      "AddPadding": "True"
    },
    {
      "InputId": "9ba2aa59-e55b-4ebe-aa98-0f79ed77c7aa"/*EnableZTest*/,
      "Position": {
        "X": 844.74316,
        "Y": 639.4281
      },
      "GroupTitle": "Draw Options",
      "Description": "Hides lines behind other geometry."
    },
    {
      "InputId": "ba83a66f-5a4c-4355-abb2-d4b7cd55d542"/*WrapMode*/,
      "Position": {
        "X": 630.7589,
        "Y": 496.41733
      },
      "Description": "How the texture repeats outside 0..1:\n\nWrap: Repeats continuously.\nMirror: Repeats mirrored.\nClamp: Stretches the edge pixels.\nBorder: Uses the border color.\nMirrorOnce: Mirrors once, then clamps."
    },
    {
      "InputId": "c10f9c6c-9923-42c6-848d-6b98097acc67"/*Texture_*/,
      "Position": {
        "X": 490.75897,
        "Y": 373.78
      },
      "Description": "Texture applied along the lines. U runs along the line, V across it."
    },
    {
      "InputId": "c78378f5-8306-4586-af6b-99cea40fa9a9"/*FadeOutTooLong*/,
      "Position": {
        "X": 630.759,
        "Y": 124.1371
      },
      "Description": "Segments longer than this length fade out and are hidden at twice the length. Negative values disable the fade.",
      "Min": -0.01,
      "Max": 1.0,
      "Scale": 0.001,
      "ClampMin": true
    },
    {
      "InputId": "c9cf2182-1297-463c-b5c1-d4ee7ad0895c"/*EnableZWrite*/,
      "Position": {
        "X": 844.74316,
        "Y": 674.4281
      },
      "Description": "Writes the lines to the depth buffer so they can hide geometry drawn later."
    },
    {
      "InputId": "d0919481-203a-4379-8094-187d6209e00d"/*ShrinkWithDistance*/,
      "Position": {
        "X": 630.759,
        "Y": 19.1371
      },
      "Description": "0 keeps a constant width on screen, 1 makes lines thinner with distance like regular geometry.",
      "AddPadding": "True"
    },
    {
      "InputId": "d90ff4e6-7d70-441f-a064-b40401025c36"/*BlendMod*/,
      "Position": {
        "X": 844.74316,
        "Y": 604.4281
      },
      "AddPadding": "True"
    },
    {
      "InputId": "df158fcf-3042-48cf-8383-7bf4c1bcb8a6"/*LineWidth*/,
      "Position": {
        "X": 630.759,
        "Y": -15.8629
      },
      "Description": "Width of the lines. Multiplied by each point's Scale.x and the attribute selected in WidthFactor.",
      "Scale": 0.001
    },
    {
      "InputId": "e15b6dc7-aaf9-4244-a4b8-4ac13ee7d23f"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 704.74335,
        "Y": 731.009
      }
    },
    {
      "InputId": "e797d93b-3847-4324-898e-09018267ea82"/*UvScale*/,
      "Position": {
        "X": 630.759,
        "Y": 89.1371
      },
      "Description": "Scales the U texture coordinate along the lines.",
      "AddPadding": "True"
    }
  ],
