{
  "FormatVersion": 3,
  "Id": "84a93ea9-98fb-4088-a1e9-87454f7292f1"/*DrawPointsShaded*/,
  "Description": "Draws a point buffer as PBR-shaded spheres using the material defined by [SetMaterial].\n\nThe size is PointSize multiplied by the point's Scale (see UsePointScale) and optionally its F1 or F2 attribute (see ScaleFactor).\n\nNote: This operator was previously called \"DrawMeshAsSpheres\".\n\nSee also: [DrawPoints], [DrawMeshAtPoints]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "2154f238-02d7-4635-aa26-17421352dca5"/*EnableZTest*/,
      "Position": {
        "X": 2630.4138,
        "Y": 4424.199
      },
      "Description": "Hides points behind other geometry."
    },
    {
      "InputId": "247d1fed-9897-486b-bcf0-39e6c98ccbd1"/*FadeNearest*/,
      "Position": {
        "X": 1619.0709,
        "Y": 3754.4053
      },
      "Description": "Points closer to the camera than this distance fade out; they are fully visible at twice the distance. 0 disables the fade."
    },
    {
      "InputId": "3472e004-210f-4cb7-aaab-dee0c5eab6eb"/*ColorField*/,
      "Position": {
        "X": 2205.8533,
        "Y": 3590.6753
      },
      "Description": "Optional field that multiplies the color depending on the world position of each point."
    },
    {
      "InputId": "4ca3418c-9542-4158-8a72-ba14c9c199ee"/*UsePointScale*/,
      "Position": {
        "X": 2205.8533,
        "Y": 3768.3735
      },
      "Description": "Multiplies the size with the point's Scale.x and Scale.y.",
      "AddPadding": "True"
    },
    {
      "InputId": "68ebd395-5e00-4aeb-acfb-312899c4907c"/*PointSize*/,
      "Position": {
        "X": 1619.0709,
        "Y": 3684.4053
      },
      "AddPadding": "True"
    },
    {
      "InputId": "92e069cf-d136-4a13-8bcd-243731f77a54"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 2339.4011,
        "Y": 4189.2515
      }
    },
    {
      "InputId": "9435c9b2-5237-4199-ac9c-93e9ddc5f8b3"/*EnableZWrite*/,
      "Position": {
        "X": 2630.4138,
        "Y": 4459.199
      },
      "GroupTitle": "Draw Options",
      "Description": "Writes the points to the depth buffer so they can hide geometry drawn later."
    },
    {
      "InputId": "bb8e9be9-1371-45fd-be67-93d183b1355e"/*BlendMode*/,
      "Position": {
        "X": 2630.4138,
        "Y": 4389.199
      }
    },
    {
      "InputId": "d72344f7-9862-47a1-ad25-135725430ca9"/*ScaleFactor*/,
      "Position": {
        "X": 2345.8533,
        "Y": 3733.3735
      },
      "Description": "Point attribute that multiplies the size: None, F1 or F2."
    },
    {
      "InputId": "f5b4e08b-a49a-47ac-838d-577b621005b2"/*Color*/,
      "Position": {
        "X": 1339.0709,
        "Y": 3544.4053
      },
      "AddPadding": "True"
    }
  ],
