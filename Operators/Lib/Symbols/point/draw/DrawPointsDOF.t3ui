{
  "FormatVersion": 3,
  "Id": "dcd04bb7-4531-40ab-bb18-26a3bc269dc4"/*DrawPointsDOF*/,
  "Description": "Draws a point buffer as camera-facing sprites sorted by their distance to the camera.\n\nBefore drawing, the points are sorted into SortBucketCount distance buckets of BucketSize, which reduces artifacts with transparent blending.\n\nSee also: [DrawPoints]",
  "SymbolTags": "1024",
  "InputUis": [
    {
      "InputId": "37e8a9f7-8496-4fca-90e9-b5ffc0cdf25e"/*Texture_*/,
      "Position": {
        "X": 2427.8235,
        "Y": 5204.0186
      }
    },
    {
      "InputId": "4d131da0-3a0b-4eb8-8040-24a5bd50bbbb"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": -2009.4397,
        "Y": 4253.188
      }
    },
    {
      "InputId": "539014bb-a672-4eaa-9c98-467b1f6ec81f"/*FadeNearest*/,
      "Position": {
        "X": 2421.6711,
        "Y": 4925.107
      },
      "Description": "Points closer to the camera than this distance fade out; they are fully visible at twice the distance. 0 disables the fade."
    },
    {
      "InputId": "74ab516a-f694-45ba-af2c-4f7c7171a560"/*PointSize*/,
      "Position": {
        "X": 2421.6711,
        "Y": 4855.107
      },
      "Min": 0.0,
      "Max": 0.5
    },
    {
      "InputId": "79f7f963-ea12-4ad2-ac4c-2e3ac6a8ed49"/*EnableZTest*/,
      "Position": {
        "X": 2281.6711,
        "Y": 5363.588
      },
      "Description": "Hides points behind other geometry."
    },
    {
      "InputId": "7e15e9be-6ec9-4975-af1d-9a3642bb5c70"/*InputField*/,
      "Position": {
        "X": 2421.6714,
        "Y": 4516.7314
      },
      "Description": "Optional field that multiplies the color depending on the world position of each point."
    },
    {
      "InputId": "7f568085-7c31-4017-a1bc-638aa9f3a1ae"/*DofShape*/,
      "Position": {
        "X": 1879.0603,
        "Y": 3740.616
      }
    },
    {
      "InputId": "8ae89721-6a8d-4d55-b742-736226dfa3a5"/*BucketSize*/,
      "Position": {
        "X": -2302.2664,
        "Y": 4576.394
      },
      "Description": "Distance range covered by one sorting bucket, in world units."
    },
    {
      "InputId": "98cb7c7b-97c4-4352-87d7-8222f500c56b"/*BlendMode*/,
      "Position": {
        "X": 2281.6711,
        "Y": 5328.588
      }
    },
    {
      "InputId": "9d0e1f78-cf04-4b3e-ab48-d81907650ace"/*AlphaCutOff*/,
      "Position": {
        "X": 2421.6711,
        "Y": 4890.107
      },
      "Description": "Pixels with an alpha below this value are discarded."
    },
    {
      "InputId": "aa874a05-b142-43c0-8db0-1bd6d57ecf19"/*ScaleFactor*/,
      "Position": {
        "X": 2314.0002,
        "Y": 4998.8496
      },
      "Description": "Point attribute that multiplies the size: None, F1 or F2."
    },
    {
      "InputId": "ad390566-379e-499b-bec8-5b8d2360cc90"/*Color*/,
      "Position": {
        "X": 2281.6711,
        "Y": 4645.107
      }
    },
    {
      "InputId": "dfe41042-6dad-46f7-9778-4de5d90a1400"/*UsePointsScale*/,
      "Position": {
        "X": 1973.4253,
        "Y": 5027.0815
      },
      "Description": "Multiplies the size with the point's Scale.x and Scale.y."
    },
    {
      "InputId": "e285bab3-01cd-46ec-8f22-aa5ac6d5f5dd"/*SortBucketCount*/,
      "Position": {
        "X": -1768.9087,
        "Y": 4411.025
      },
      "Description": "Number of distance buckets used for sorting (2 to 256)."
    },
    {
      "InputId": "f95cb054-e723-4ff1-bc6c-9b6efe7f5168"/*EnableZWrite*/,
      "Position": {
        "X": 2281.6711,
        "Y": 5398.588
      },
      "Description": "Writes the points to the depth buffer so they can hide geometry drawn later."
    }
  ],
