{
  "FormatVersion": 3,
  "Id": "c12cf584-f6db-4d24-a03a-7801736d2c50"/*DrawTubes*/,
  "Description": "Draws connected points as shaded 3D tubes.\n\nThe cross-section follows each line without twisting, so point rotations are not needed. Only the rotation of the first point of each line sets where the cross-section starts, which matters for textures and elliptic cross-sections. Separators (NaN points) split the buffer into separate tubes.\n\nFor rounder curves, subdivide or smooth the points before drawing them.\n\nSee also: [DrawLinesShaded], [DrawRibbons], [DrawLines]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "02f5e531-2579-4eca-8fef-a8586e6534cf"/*Width*/,
      "Position": {
        "X": 981.1759,
        "Y": 2532.7163
      },
      "Description": "Base radius of the tube in world units. Per-point Width Factor / Scale multiplies this value.",
      "Scale": 0.0001
    },
    {
      "InputId": "0a27f15b-81cc-473d-abb3-a7e85b4c03f7"/*TextureRange*/,
      "Position": {
        "X": 841.1759,
        "Y": 2847.7163
      },
      "Description": "Maps the texture coordinate along the tube from X to Y. For Distance, X offsets the texture and Y sets the repeats per world unit.",
      "UseVec2Control": "Range"
    },
    {
      "InputId": "0a6a91d1-be44-459a-94cd-49b48d755377"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 5.765747,
        "Y": 577.5115
      },
      "Description": "The point buffer to draw. Points are connected in order into a tube."
    },
    {
      "InputId": "196458c8-dfbc-4f23-829c-6c3549b8a5cf"/*CapInset*/,
      "Position": {
        "X": 981.1759,
        "Y": 2707.7163
      },
      "Description": "Moves the tip of a closed end from the end point towards the neighbouring ring: 0 gives a pointy cone, 1 a flat cap. Negative values stretch the tip beyond the end point, values above 1 dent the cap inwards.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d"/*UsePointScale*/,
      "Position": {
        "X": 841.1759,
        "Y": 2672.7163
      },
      "Description": "Scales the cross-section with the point's Scale.y and Scale.z. Different values give an elliptic tube."
    },
    {
      "InputId": "2d848beb-c753-4f9d-be08-097a3b1ab5a1"/*Miter*/,
      "Position": {
        "X": 981.1759,
        "Y": 2812.7163
      },
      "Description": "Keeps the full width at corners by stretching the joint along the bend (0: round joints that pinch at sharp corners, 1: mitered like bent pipe). Corners sharper than about 150 degrees are limited to 4 times the width. Negative values pinch the corners further.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "4b0ae46d-6798-4c5b-aaa0-2cabb83138dd"/*TextureMode*/,
      "Position": {
        "X": 981.1759,
        "Y": 1587.7163
      },
      "Description": "Source of the texture coordinate along the tube, mapped by TextureRange. Order: 0 at the first to 1 at the last point of the buffer. F1, F2: the attribute of the points. Distance: the distance along each line in world units, so adding points at the end does not move the texture before them. DistanceNormalized: the distance along each line from 0 at its start to 1 at its end, so adding points stretches the whole texture."
    },
    {
      "InputId": "51341757-a93b-4ca8-9e8d-be30124fc060"/*FlatAround*/,
      "Position": {
        "X": 981.1759,
        "Y": 2742.7163
      },
      "GroupTitle": "Shading",
      "Description": "Blends the shading around the tube from round (0) to flat facets, one per side (1). Values outside 0..1 exaggerate or invert the facets. Most visible with few Sides.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "8f609301-338d-45e0-82de-660963ec0174"/*Twist*/,
      "Position": {
        "X": 981.1759,
        "Y": 2602.7163
      },
      "Description": "Turns the cross-section along the tube, in degrees per unit of the TextureMode coordinate (before TextureRange): the total turn for Order and the normalized modes, degrees per world unit for the distance modes. A twisting texture stays aligned with it.",
      "Min": -180.0,
      "Max": 180.0,
      "Scale": 1.0
    },
    {
      "InputId": "9a486753-840e-4d53-9627-8a2ed02fd39e"/*Culling*/,
      "Position": {
        "X": 1051.1759,
        "Y": 2042.7163
      },
      "Description": "Face culling mode (None / Front / Back). Default Back culls back-facing triangles for a solid tube."
    },
    {
      "InputId": "ae484c37-1bf0-4e20-8698-3f7179ab7c24"/*Color*/,
      "Position": {
        "X": 841.1759,
        "Y": 2392.7163
      },
      "Description": "Base tint multiplied against each point's color and the shading result."
    },
    {
      "InputId": "b1bffdfb-fc45-4ec1-baac-39a3ef2f065a"/*EnableDepthWrite*/,
      "Position": {
        "X": 1051.1759,
        "Y": 2182.7163
      },
      "GroupTitle": "Rendering",
      "Description": "Whether the tube writes to the depth buffer. Disable for additive/transparent tubes that should not occlude."
    },
    {
      "InputId": "c3742de6-6720-4a18-a6da-063e05696f9d"/*Spin*/,
      "Position": {
        "X": 981.1759,
        "Y": 2567.7163
      },
      "Description": "Constant rotation of the cross-section around the line direction, in degrees.",
      "Min": -180.0,
      "Max": 180.0,
      "Scale": 1.0
    },
    {
      "InputId": "c43b1052-2942-43c7-aaf4-56c91dc8e521"/*WidthFactor*/,
      "Position": {
        "X": 841.1759,
        "Y": 2637.7163
      },
      "Description": "Selects the point attribute used as a per-point width weight. None = uniform width, F1/F2 = use the point's FX1/FX2 value (NaN falls back to 1)."
    },
    {
      "InputId": "c7562da2-b723-46fc-9f28-e12f7ed52bb0"/*FlatAlong*/,
      "Position": {
        "X": 981.1759,
        "Y": 2777.7163
      },
      "Description": "Blends the shading along the tube from smooth bends (0) to straight pieces between the points (1), so corners show as kinks. Values outside 0..1 exaggerate or invert the kinks.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "d74dafc3-69d5-4783-867c-edc9c4a0dc93"/*CloseEnds*/,
      "Position": {
        "X": 841.1759,
        "Y": 1622.7163
      },
      "GroupTitle": "Caps",
      "Description": "Closes each line end: the last ring collapses into a tip on the line, turning the end segment into a cone. Lines of only two points stay open."
    },
    {
      "InputId": "ec6a8011-f1da-413b-a9e4-f909859444b5"/*BlendMode*/,
      "Position": {
        "X": 1051.1759,
        "Y": 2112.7163
      },
      "Description": "Blending mode used when compositing the tube against what is behind it."
    },
    {
      "InputId": "f8fc2813-2156-4ffd-a546-38214b887e87"/*Sides*/,
      "Position": {
        "X": 561.1759,
        "Y": 1552.7163
      },
      "Description": "Number of sides around the tube cross-section.",
      "Min": 2,
      "Max": 100
    }
  ],
  "SymbolChildUis": [
