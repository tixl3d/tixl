{
  "FormatVersion": 3,
  "Id": "b7db2c0f-8ea7-4c90-afe3-31ec7cdcc92f"/*_DrawPointTriangles*/,
  "Description": "Draws every three points of a buffer as one filled triangle in the points' colors.\n\nA triangle that contains a separator point is skipped. Used by [Sketch] to draw filled shapes; parameters that only apply to lines are ignored.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "6096576a-4234-4037-b253-0cb544a2cc37"/*WidthFactor*/,
      "Position": {
        "X": 630.759,
        "Y": 220.82883
      },
      "Description": "Point attribute that multiplies the line width: None, F1 or F2."
    },
    {
      "InputId": "426696f2-55b0-4ecc-9638-342338b38d6e"/*TransitionProgress*/,
      "Position": {
        "X": 630.759,
        "Y": 54.1371
      },
      "Description": "Offsets the U texture coordinate, e.g. to scroll a texture along the lines."
    },
    {
      "InputId": "a7c18db7-3a61-420b-8627-7969693a74d7"/*UvScaleFX*/,
      "Position": {
        "X": 630.759,
        "Y": 185.82886
      },
      "Description": "Source of the U texture coordinate: Stretch maps 0..1 across the whole buffer, UFromFX1 and UFromFX2 use the point's F1 or F2 attribute."
    },
    {
      "InputId": "228e18b6-cd51-40f4-ba44-c7996ebe184e"/*Color*/,
      "Position": {
        "X": 350.75894,
        "Y": -155.8629
      },
      "Description": "Defines the color of the Lines.\nIf a Texture is used this color will be multiplied.",
      "AddPadding": "True"
    },
    {
      "InputId": "e1144012-ca01-4bfa-8581-7eb4e44c8638"/*EnableZTest*/,
      "Position": {
        "X": 844.74316,
        "Y": 639.4281
      },
      "GroupTitle": "Draw Options",
      "Description": "Hides lines behind other geometry."
    },
    {
      "InputId": "509929a0-745f-41cd-bc56-307ec9f3b606"/*WrapMode*/,
      "Position": {
        "X": 630.7589,
        "Y": 496.41733
      },
      "Description": "How the texture repeats outside 0..1:\n\nWrap: Repeats continuously.\nMirror: Repeats mirrored.\nClamp: Stretches the edge pixels.\nBorder: Uses the border color.\nMirrorOnce: Mirrors once, then clamps."
    },
    {
      "InputId": "4c92bcdd-3c11-4e14-ac8c-2f07474f4570"/*Texture_*/,
      "Position": {
        "X": 490.75897,
        "Y": 373.78
      },
      "Description": "Texture applied along the lines. U runs along the line, V across it."
    },
    {
      "InputId": "14d08738-f71d-49c1-be46-0dab75245e9e"/*FadeOutTooLong*/,
      "Position": {
        "X": 630.759,
        "Y": 124.1371
      },
      "Description": "Segments longer than this length fade out and are hidden at twice the length. Negative values disable the fade.",
      "Min": -0.01,
      "Max": 1.0,
      "Scale": 0.001,
      "ClampMin": true
    },
    {
      "InputId": "d8efac0b-92aa-401f-afc5-fa641aadb656"/*EnableZWrite*/,
      "Position": {
        "X": 844.74316,
        "Y": 674.4281
      },
      "Description": "Writes the lines to the depth buffer so they can hide geometry drawn later."
    },
    {
      "InputId": "4529319e-609d-449f-b320-f2c92c463bb5"/*ShrinkWithDistance*/,
      "Position": {
        "X": 630.759,
        "Y": 19.1371
      },
      "Description": "0 keeps a constant width on screen, 1 makes lines thinner with distance like regular geometry.",
      "AddPadding": "True"
    },
    {
      "InputId": "3fbe354e-7521-4442-bc7b-f36f1c613908"/*BlendMod*/,
      "Position": {
        "X": 844.74316,
        "Y": 604.4281
      },
      "AddPadding": "True"
    },
    {
      "InputId": "0c525f9c-fc55-4d6a-9b48-2942823cd306"/*LineWidth*/,
      "Position": {
        "X": 630.759,
        "Y": -15.8629
      },
      "Description": "Width of the lines. Multiplied by each point's Scale.x and the attribute selected in WidthFactor.",
      "Scale": 0.001
    },
    {
      "InputId": "d0125887-e5f9-422f-883d-0c34d9b38a4b"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 704.74335,
        "Y": 731.009
      }
    },
    {
      "InputId": "ebcd896d-3292-450a-a020-8cf8456d83ce"/*UvScale*/,
      "Position": {
        "X": 630.759,
        "Y": 89.1371
      },
      "Description": "Scales the U texture coordinate along the lines.",
      "AddPadding": "True"
    }
  ],
