{
  "FormatVersion": 3,
  "Id": "b7345438-f3f4-4ad3-9c57-6076ed0e9399"/*PrepareSvgLineTransition*/,
  "Description": "Writes a normalized progress offset into the F1 attribute of each line point so that line strokes (e.g. from [LoadSvg]) can be drawn in sequence.\n\nIt measures all strokes (lines separated by separators) and distributes their start and end across 0...1. [DrawLines] can then use F1 to animate the drawing of the strokes. Strokes need at least two points and there must be at least two strokes. Outputs the number of strokes as StrokeCount.\n\nSee also: [LoadSvg], [LineTextPoints]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "0bcfbd7a-c01b-409f-a661-135dd27e8580"/*RandomizeDuration*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "Blends each stroke duration towards a random duration (0...1)."
    },
    {
      "InputId": "5fd5eea5-b7ab-406f-8c10-8435d59297b5"/*Spread*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "0: all strokes are drawn simultaneously.\n1: strokes are drawn one after another."
    },
    {
      "InputId": "82b2e8d3-40c2-4a4c-a9ad-806d5097a8fd"/*SourcePoints*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "8cef763e-48e4-41f9-b429-0ad32b849adf"/*RandomizeStart*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Blends each stroke start time towards a random time (0...1)."
    },
    {
      "InputId": "c1fa1a4e-8884-4a6f-ac80-f22d3b5dfe2f"/*SpreadMode*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "IgnoreStrokeLengths: every stroke gets the same duration.\nUseStrokeLength: stroke durations depend on their length.\nWeird: experimental."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "adcfd192-23a3-48c1-ae21-e7d36e055673"/*ResultList*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "OutputId": "4e6983bb-482f-48e7-93b1-73c73f43c60a"/*StrokeCount*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    }
  ]
}