{
  "FormatVersion": 3,
  "Id": "0309e746-c356-4c7b-af05-93136a2607de"/*OpticalFlow*/,
  "Description": "Computes a motion vector field from two successive frames, for instance to drive particles or distortions by movement.\n\nThe previous frame can be provided with [KeepPreviousFrame]. The motion vectors are stored in the red and green channels; the blue channel holds the magnitude of the motion.\n\nThe shader implements the Lucas-Kanade method (https://en.wikipedia.org/wiki/Lucas%E2%80%93Kanade_method) and is based on a Shadertoy implementation by mds2 (https://www.shadertoy.com/view/XlBcRV).\n\nAKA: motion, flow, vectors\n\nSee also: [DetectMotion], [KeepPreviousFrame]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "394c0b8a-0d6e-4740-bd33-28c651b1471d"/*Image2*/,
      "Relevancy": "Required",
      "Position": {
        "X": 520.6738,
        "Y": -118.59213
      },
      "Description": "The previous frame, e.g. from [KeepPreviousFrame]."
    },
    {
      "InputId": "587e2f2b-fd6a-4382-b1c2-99a5963d41ac"/*VisualizationScale*/,
      "Position": {
        "X": 974.38513,
        "Y": 27.416473
      },
      "Description": "Density of the visualization grid: higher values draw more, smaller cells."
    },
    {
      "InputId": "93227e69-35c7-4db6-bc6e-e655f2f8226a"/*Image*/,
      "Relevancy": "Required",
      "Position": {
        "X": 520.6738,
        "Y": -163.59213
      },
      "Description": "The current frame."
    },
    {
      "InputId": "a1eba7f5-e2f1-46cb-8982-ae9cb1b7531b"/*Lod*/,
      "Position": {
        "X": 520.6738,
        "Y": -73.59213
      },
      "GroupTitle": "Settings",
      "Description": "Mipmap level of the input textures that is sampled. Higher values blur the result.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "c54cd59c-7b60-4044-b178-1faa9b279138"/*Amount*/,
      "Position": {
        "X": 520.6738,
        "Y": -23.494812
      },
      "Description": "Scales the magnitude of the detected motion.",
      "AddPadding": "True"
    },
    {
      "InputId": "dc54082f-0e94-471e-8aca-4573c167fda3"/*OutputMethod*/,
      "Position": {
        "X": 832.8757,
        "Y": -217.87488
      },
      "Description": "Signed outputs vectors in the range -1 to 1. GrayScale offsets them so that no motion is R 0.5, G 0.5, B 0."
    },
    {
      "InputId": "ea2841c1-62bf-4826-8861-6e1c482a0fcd"/*ClampRange*/,
      "Position": {
        "X": 832.8758,
        "Y": -287.87488
      },
      "Description": "Clamps and normalizes the results to avoid values that are too small or excessively large."
    },
    {
      "InputId": "fa54b5d3-5a98-4cc1-b848-6e5b3632af6c"/*VisualizeResult*/,
      "Position": {
        "X": 1049.7916,
        "Y": 197.54462
      },
      "Description": "Draws the motion vectors as small lines for debugging.",
      "AddPadding": "True"
    }
  ],
