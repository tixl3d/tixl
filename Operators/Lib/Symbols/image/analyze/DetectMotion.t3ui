{
  "FormatVersion": 3,
  "Id": "830df85c-51df-4d55-956c-e6810e8e3081"/*DetectMotion*/,
  "Description": "Detects changes between successive frames of an image or video, for instance to drive effects by movement.\n\nFrameDifference outputs the difference to the previous frame, MotionHistory accumulates differences over time, and OpticalFlow outputs motion vectors (see [OpticalFlow]).\n\nSee also: [RemoveStaticBackground], [KeepPreviousFrame]",
  "InputUis": [
    {
      "InputId": "0181b151-2601-4d65-9d69-5b0efd4044f3"/*RemapGradient*/,
      "Position": {
        "X": 671.0896,
        "Y": 356.42737
      },
      "Description": "Gradient used if RemapColor is enabled. Can be used to increase contrast, reduce noise or key colors."
    },
    {
      "InputId": "89e7a9a3-b73b-4296-aece-821e0c87362c"/*VideoTexture*/,
      "Relevancy": "Required",
      "Position": {
        "X": -406.90933,
        "Y": -8.568954
      }
    },
    {
      "InputId": "96f0f8da-bb16-439a-bc0c-41c18cc42a20"/*RemapColor*/,
      "Position": {
        "X": 879.1317,
        "Y": 398.16144
      },
      "GroupTitle": "Output options",
      "Description": "Recolors the result by its brightness using RemapGradient."
    },
    {
      "InputId": "d0f131d3-80d7-45a5-b827-dd9cd8a514f7"/*Method*/,
      "Position": {
        "X": 671.0896,
        "Y": 286.42737
      }
    },
    {
      "InputId": "e8ac51d9-1a0b-42c0-9695-f21ef7e7dcbc"/*VideoFrameIndex*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": -753.31836,
        "Y": -164.96545
      },
      "Description": "Connect the frame index of a video whose frame rate differs from the render frame rate. The previous frame is then only updated when the index changes, which prevents flickering."
    },
    {
      "InputId": "f0da83e6-cd5a-46e7-80cb-4ff4c995009d"/*BackgroundFade*/,
      "Position": {
        "X": -141.0106,
        "Y": 141.3941
      },
      "GroupTitle": "Motion History Option",
      "Description": "How quickly old motion fades out. Only used by MotionHistory.",
      "Min": 0.0,
      "Max": 0.1
    }
  ],
