{
  "FormatVersion": 3,
  "Id": "92e28e50-bd40-4f93-ba92-8f69cded6ec1"/*WaveForm*/,
  "Description": "Overlays a waveform and a vectorscope to visualize the brightness and color distribution of an image.\n\nThe waveform plots the distribution of the red, green and blue values of each image column (values above 1 are shown in the upper half). The vectorscope shows hue as angle and saturation as distance from the center. Both are common tools for color correction.\n\nAKA: scope, vectorscope\n\nSee also: [ImageLevels], [CompareImages], [ColorGrade]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "381d9aa5-2685-4509-9640-1dcca64746fa"/*DimBackground*/,
      "Position": {
        "X": -4236.861,
        "Y": -31.59829
      },
      "Description": "Darkens the image behind the overlays.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "3a226812-98bf-4fe9-b435-f84b154a41e8"/*OverrideSize*/,
