{
  "FormatVersion": 3,
  "Id": "9f43f769-d32a-4f49-92ac-e0be3ba250cf"/*Blend*/,
  "Description": "Blends one image on top of another with a blend mode like normal, screen or multiply.\n\nTo cross-fade between several images use [BlendImages].\n\nAKA: composite, layer, mix, over, screen, multiply\n\nSee also: [BlendImages], [BlendWithMask], [Combine3Images]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "6541c1ac-ba84-4a46-a6df-8ab52455c57b"/*ColorA*/,
      "Position": {
        "X": 403.5539,
        "Y": 183.61325
      },
      "Description": "Color multiplied with ImageA."
    },
    {
      "InputId": "70dc133e-800a-4cd0-a159-2cbab4c322cb"/*ColorB*/,
      "Position": {
        "X": 403.5539,
        "Y": 323.61325
      },
      "Description": "Color multiplied with ImageB. Its alpha can be used to fade out the image.\n\nConsider connecting a [SampleGradient]."
    },
    {
      "InputId": "93e63b73-e572-4bb2-bbbd-11bbffad89e7"/*Resolution*/,
      "Position": {
        "X": 543.5539,
        "Y": 603.6133
      },
      "Description": "Overrides the output resolution. If 0, the resolution of ImageA is used."
    },
    {
      "InputId": "abaa52e9-7d3d-4ae5-89d2-5251f61e5392"/*ImageA*/,
      "Relevancy": "Required",
      "Position": {
        "X": 543.5539,
        "Y": 113.61325
      },
      "Description": "The background image. Defines the resolution of the output."
    },
    {
      "InputId": "c7c524cf-e31e-4bac-8f77-58bd61b337de"/*ImageB*/,
      "Relevancy": "Required",
      "Position": {
        "X": 543.5539,
        "Y": 148.61325
      },
      "Description": "The image blended on top of the background image."
    },
    {
      "InputId": "cad32967-e91b-4bd1-af09-5fdfdeee630e"/*AlphaMode*/,
      "Position": {
        "X": 403.5539,
        "Y": 498.61325
      },
      "Description": "Various modes for how the alpha channels are combined.",
      "AddPadding": "True"
    },
    {
      "InputId": "cdc2cf4b-f788-4cb4-a3f5-8dfaa8bd54b3"/*NormalForUpperHalf*/,
      "Position": {
        "X": 403.5539,
        "Y": 533.6133
      },
      "GroupTitle": "Advanced Settings",
      "Description": "If used with blend modes other than normal, that blend mode will only be used if the alpha channel is below 0.5.\nAbove that, the image will be fully blended with normal mode.\n\nAs an example: If blended with Screen mode...\n- Alpha = 0.0: none of the image will be visible\n- Alpha = 0.5: the image will be fully visible with screen mode\n- Alpha = 1.0: the image will be fully visible with normal mode\n\n"
    },
    {
      "InputId": "d7b83780-c4be-4337-b1df-0c98310b1926"/*GenerateMips*/,
      "Position": {
        "X": 543.5539,
        "Y": 638.6133
      },
      "Description": "Generates mipmap levels."
    },
    {
      "InputId": "e8923e83-ce48-4b71-a1aa-46b9ff79780b"/*ScaleMode*/,
      "Position": {
        "X": 403.5539,
        "Y": 568.6133
      }
    },
    {
      "InputId": "fc5f1d08-3997-4ba3-ac59-d86e4e501fb0"/*BlendMode*/,
      "Position": {
        "X": 403.5539,
        "Y": 463.61325
      },
      "GroupTitle": "Settings",
      "Description": "How the colors of ImageB are combined with ImageA."
    }
  ],
