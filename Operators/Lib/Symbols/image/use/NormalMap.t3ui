{
  "FormatVersion": 3,
  "Id": "01458940-287f-4d31-9906-998efa9a2641"/*NormalMap*/,
  "Description": "Converts the brightness of an image into a normal map, e.g. for [SetMaterial].\n\nThe slope of the brightness between neighboring pixels defines the direction of the normals. Other modes output the slope as angle and magnitude or as a 2D offset for displacement effects.\n\nAKA: bump, normals, height, emboss\n\nSee also: [CombineMaterialChannels], [SetMaterial]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "3b04296a-14e5-40e0-91a2-eda0314b0490"/*LightMap*/,
      "Position": {
        "X": 204.9021,
        "Y": 283.4281
      },
      "Description": "Grayscale height image to convert."
    },
    {
      "InputId": "3e9bce35-7de1-42de-80e5-8eec29e92422"/*SampleRadius*/,
      "Position": {
        "X": 204.9021,
        "Y": 353.4281
      },
      "Description": "Distance in pixels to the neighboring samples used to compute the slope. Larger values give smoother normals."
    },
    {
      "InputId": "4d25b1db-daeb-4b5e-b2bc-8681f332b092"/*OutputFormat*/,
      "Position": {
        "X": 204.9021,
        "Y": 528.4281
      }
    },
    {
      "InputId": "82464caa-a407-4f6d-a062-cef322d131f0"/*Twist*/,
      "Position": {
        "X": 204.9021,
        "Y": 388.4281
      },
      "Description": "Rotates the normal directions in degrees.",
      "Min": -90.0,
      "Max": 90.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "ab21289c-f91c-4991-a7e5-ecb0c0954f02"/*Impact*/,
      "Position": {
        "X": 204.9021,
        "Y": 318.4281
      },
      "GroupTitle": "Settings",
      "Description": "Strength of the slopes.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "b16de87a-4099-42fe-9a73-97d8fa112d4d"/*Resolution*/,
      "Position": {
        "X": 204.9021,
        "Y": 458.4281
      },
      "AddPadding": "True"
    },
    {
      "InputId": "b79b3334-bce6-44a0-aa8c-d2db6a45afff"/*TextureRepeat*/,
      "Position": {
        "X": 204.9021,
        "Y": 493.42813
      },
      "Description": "How the image is sampled at its borders."
    },
    {
      "InputId": "cf7e6f41-cc6e-46dd-8779-1273326a5a53"/*Mode*/,
      "Position": {
        "X": 64.9021,
        "Y": 423.4281
      },
      "GroupTitle": "Advanced",
      "Description": "Gray_ToNormalizedRGB: normal map with directions encoded in the 0 to 1 range.\nGray_ToNormalizedRGBSigned: normal map with signed values.\nGray_ToAngleAndMagnitude: slope angle in red and magnitude in green.\nRed_ToRG_KeepBA: slope of the red channel as 2D offset in red and green; blue and alpha are kept."
    }
  ],
  "SymbolChildUis": [
    {
      "ChildId": "28e1c561-216a-4988-b59d-09a7109d3490",
      "SymbolName": "Lib.numbers.int.basic.IntToFloat",
      "Position": {
