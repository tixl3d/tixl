        "Y": 423.4281
      }
    },
    {
      "ChildId": "7cf1c6fe-79f7-47bf-9524-4405ab4218fd",
      "SymbolName": "Lib.render._dx11.fxsetup._ImageFxShaderSetupStatic",
      "Position": {
