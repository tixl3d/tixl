{
  "FormatVersion": 3,
  "Id": "085b7841-9502-4b49-896e-3b1fa023f1bf"/*CombineMaterialChannels*/,
  "Description": "Combines roughness, metallic and ambient occlusion maps into a single texture for PBR materials with [SetMaterial].\n\nThe maps are typically loaded with [LoadImage]. If no normal map is available, [NormalMap] can generate one.\n\nAKA: pbr, orm, roughness, metallic, occlusion\n\nSee also: [CombineMaterialChannels2], [SetMaterial]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "099eae25-7cca-4da2-956f-c1a5bd67e764"/*RemapRoughness*/,
      "Position": {
        "X": -514.44653,
        "Y": 790.6531
      },
      "Description": "Curve that remaps the values of the roughness map.\n\nTips:\n- Alt + click on the curve adds points; right-click a point for more options like interpolation.",
      "AddPadding": "True"
    },
    {
      "InputId": "16522565-e9aa-4295-b219-9724d656ced3"/*GenerateMips*/,
      "Position": {
        "X": -514.44653,
        "Y": 745.6531
      },
      "Description": "Generates mipmaps, which improve quality when the texture is seen from different distances and angles."
    },
    {
      "InputId": "34ba88b4-7fe0-4f40-9433-feab3b6e81f0"/*Resolution*/,
      "Position": {
        "X": -514.44653,
        "Y": 565.6531
      },
      "GroupTitle": "Settings",
      "Description": "Overrides the resolution of the input images."
    },
    {
      "InputId": "55ee3c9c-ffbc-4322-bb44-69d1b7001ff8"/*Occlusion*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": -515.9635,
        "Y": 463.74335
      },
      "Description": "Ambient occlusion map, e.g. from a [LoadImage]."
    },
    {
      "InputId": "ae7df1c8-ffd1-4a32-9f25-769fc7630f6f"/*Metallic*/,
      "Relevancy": "Required",
      "Position": {
        "X": -515.9635,
        "Y": 418.74335
      },
      "Description": "Metallic map, e.g. from a [LoadImage]."
    },
    {
      "InputId": "c697d838-f9a3-4ee7-af3d-713494f0ae93"/*Roughness*/,
      "Relevancy": "Required",
      "Position": {
        "X": -515.9635,
        "Y": 373.74335
      },
      "Description": "Roughness map, e.g. from a [LoadImage]."
    }
  ],
