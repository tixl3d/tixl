{
  "FormatVersion": 3,
  "Id": "4bf07ce8-b92b-4191-b14b-8c3862df9c01"/*BlendWithFactor*/,
  "Description": "Blend two images using a blending mode whose coefficient allows for interpolation between image A and f(A,B)\n\nFor more information watch https://en.wikipedia.org/wiki/Blend_modes\n\nSee also: [Blend], [BlendImages], [BlendWithMask], [Combine3Images]\n",
  "InputUis": [
    {
      "InputId": "18824d11-859c-4a2e-9853-2bea1fc94ff9"/*ColorA*/,
      "Position": {
        "X": 961.7299,
        "Y": -142.33188
      },
      "Description": "Color multiplied with image A.",
      "Scale": 0.01
    },
    {
      "InputId": "2bb75121-2bec-483a-8fc1-af7f25f29585"/*Resolution*/,
      "Position": {
        "X": 226.46643,
        "Y": 631.912
      },
      "Description": "Overrides the output resolution. If 0, the resolution of image A is used."
    },
    {
      "InputId": "5dfaade0-c157-4d8a-8bc5-6dfbae040ee0"/*GenerateMips*/,
      "Position": {
        "X": 1101.73,
        "Y": 417.66815
      },
      "Description": "Generates mipmap levels."
    },
    {
      "InputId": "60101b2c-46e6-4895-a3af-06d81bcd8463"/*AddImages*/,
      "Position": {
        "X": -808.746,
        "Y": -317.386
      },
      "GroupTitle": "Advanced Settings",
      "Description": "ImageA is at the indice X, ImageB is at the indice X+1. With addImage it is possible to add images C, D,... to the indices 2,3,... ."
    },
    {
      "InputId": "6049030b-6e3c-4e16-8166-5fab3418fac1"/*Factor*/,
      "Position": {
        "X": 1101.73,
        "Y": 277.66815
      },
      "Description": "Interpolation factor between A and f(A,B).",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "61c01e20-6e0b-4c38-9c91-988f0ea95aaf"/*InitFactor*/,
      "Position": {
        "X": -808.746,
        "Y": -210.97711
      },
      "Description": "Allows you to initialize X.",
      "Min": 0.0,
      "ClampMin": true
    },
    {
      "InputId": "66e6556e-138b-4e7c-9df1-55395fee3ca7"/*ImageMask*/,
      "Position": {
        "X": 1101.73,
        "Y": 452.66815
      },
      "Description": "Black areas of the mask show image A, white areas image B, and values in between interpolate between the two."
    },
    {
      "InputId": "889ff315-8794-4287-b409-f39e7dacbd4e"/*ClampFactor*/,
      "Position": {
        "X": 961.7299,
        "Y": 312.66815
      },
      "Description": "Clamp the Factor value between [0,1]"
    },
    {
      "InputId": "90b60dd5-ac4b-4291-8b93-853b74c81ac4"/*BlendMode*/,
      "Position": {
        "X": 961.7299,
        "Y": 137.66809
      },
      "GroupTitle": "Settings",
      "Description": "How the colors of image B are combined with image A:\n\n- Normal: B\n- Add: A+B\n- Sub: A-B\n- Difference: abs(A,B)\n- Multiply: A*B\n- Div: A/B\n- Overlay: 1-2(1-B)(1-A)\n- Color dodge: A/(1-B)\n- Color burn: 1-(1-A)/B\n- MixUsingImageB_A: lerp(A,B,B.alpha)\n- Linear light: (A+2*B)- 1\n- Soft light: (1-2B)*a^2+2AB\n- Darken: min(A,B)\n- Lighten: max(A,B)\n- Hue: preserves the luma and chroma of A, while adopting the hue of B\n- Saturation: preserves the luma and hue of A, while adopting the chroma of B\n- Color: blend mode preserves the luma of A, while adopting the hue and chroma of B\n- Luminosity: lend mode preserves the hue and chroma of A, while adopting the luma of B"
    },
    {
      "InputId": "9ad9834f-984a-441f-ae45-ababb164fd0a"/*ColorB*/,
      "Position": {
        "X": 961.7299,
        "Y": -2.3318787
      },
      "Description": "Color multiplied with image B.",
      "Scale": 0.01
    },
    {
      "InputId": "a6d4e532-706e-4ff5-a9b1-5a518d75a045"/*AlphaMode*/,
      "Position": {
        "X": 961.7299,
        "Y": 172.66809
      },
      "Description": "Various modes for how the alpha channels are combined.",
      "AddPadding": "True"
    },
    {
      "InputId": "abe2be55-1bb3-4612-ad3a-71fdf25d77d5"/*ImageA*/,
      "Relevancy": "Required",
      "Position": {
        "X": -808.746,
        "Y": -460.78802
      }
    },
    {
      "InputId": "c2195943-a74b-455e-8cb2-ab037a894d58"/*ImageB*/,
      "Relevancy": "Required",
      "Position": {
        "X": -808.746,
        "Y": -388.46002
      }
    },
    {
      "InputId": "dbc5fc3c-dd29-4b3d-9669-156a519ebd3c"/*NormalForUpperHalf*/,
      "Position": {
        "X": 961.7299,
        "Y": 207.66815
      },
      "Description": "If used with blend modes other than normal, that blend mode will only be used if the alpha channel is below 0.5.\nAbove that, the image will be fully blended with normal mode.\n\nAs an example: If blended with Screen mode...\n- Alpha = 0.0: none of the image will be visible\n- Alpha = 0.5: the image will be fully visible with screen mode\n- Alpha = 1.0: the image will be fully visible with normal mode\n\n"
    },
    {
      "InputId": "f70cdc3e-477a-4e00-81b8-9520fd51432a"/*ScaleMode*/,
      "Position": {
        "X": 961.7299,
        "Y": 242.66815
      }
    },
    {
      "InputId": "f711ae92-4697-409e-9de0-3d0c51973466"/*ClampOutput*/,
      "Position": {
        "X": 961.73,
        "Y": 347.66815
      },
      "Description": "Clamp the values of the output image between [0,1]"
    }
  ],
