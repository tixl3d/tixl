{
  "FormatVersion": 3,
  "Id": "0989e44b-f543-4b9a-a08e-5058d0032259"/*RenderWithMotionBlur*/,
  "Description": "Renders the incoming graph several times per frame with slightly offset local time and averages the results to create motion blur.\n\nIts main purpose is to increase the quality of rendered image sequences or videos. Depending on the complexity of the graph, this can be very slow. [HasTimeChanged] with Mode AdvancedWithMotionBlur can trigger updates only for the first pass, which is useful for simulations or feedback effects.\n\nAKA: motionblur, shutter, accumulation\n\nTips:\n- When rendering videos or sequences, the sample count can be overridden.\n\nSee also: [MotionBlur], [DepthOfField]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "27f2bbbd-a1d6-4489-9bb4-f856872ff5de"/*Passes*/,
      "Position": {
        "X": -174.97546,
        "Y": 61.53897
      },
      "Description": "Controls the fidelity of the effect.\nHigher numbers create smoother results at the cost of rendering speed.",
      "AddPadding": "True",
      "Min": -1,
      "Max": 128,
      "Scale": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "5305a99b-c9ee-41d8-b3e8-918b17ed2107"/*Strength*/,
      "Position": {
        "X": 527.9105,
        "Y": 18.111664
      },
      "Description": "Strength of the blur, i.e. the time range covered by the passes.\n\nTips:\n- For precise adjustment, reduce Passes to 2 to make the strength clearly visible.",
      "Min": 0.1,
      "Max": 3.0,
      "Scale": 0.001,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "a341c7d8-b324-4b5e-82e4-b9fae958e913"/*Texture*/,
      "Relevancy": "Required",
      "Position": {
        "X": 112.415405,
        "Y": -393.19165
      }
    }
  ],
