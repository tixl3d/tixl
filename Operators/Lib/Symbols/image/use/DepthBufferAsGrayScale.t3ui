{
  "FormatVersion": 3,
  "Id": "2d62dd4b-9597-4569-a09e-495abf880e34"/*DepthBufferAsGrayScale*/,
  "Description": "Converts a depth buffer into a grayscale texture of linear scene depth.\n\nNearFarRange must match the near and far clip planes of the camera that rendered the depth buffer.\n\nAKA: depth, zbuffer, distance\n\nSee also: [RenderTarget], [ColorGradeDepth]",
  "SymbolTags": "24",
  "InputUis": [
    {
      "InputId": "05359bf0-eef3-4322-b5cd-8df009e6a236"/*Mode*/,
      "Position": {
        "X": -230.82169,
        "Y": 689.33484
      },
      "Description": "0 outputs the linear scene depth. 1 uses a legacy normalized depth formula that was used for depth of field.",
      "AddPadding": "True"
    },
    {
      "InputId": "20f33d70-7599-4e71-993c-43464410182a"/*Texture2d*/,
      "Relevancy": "Required",
      "Position": {
        "X": -234.91547,
        "Y": 371.6969
      },
      "Description": "Depth buffer, e.g. the DepthBuffer output of a [RenderTarget]."
    },
    {
      "InputId": "379bee6d-ba65-4a53-9d9e-8dded21f351a"/*ClampOutput*/,
      "Position": {
        "X": -232.82065,
        "Y": 572.72107
      },
      "Description": "Clamps the result to the range 0 to 1.",
      "AddPadding": "True"
    },
    {
      "InputId": "41f15d72-577a-4e13-bfec-e60443930fd1"/*OutputRange*/,
      "Position": {
        "X": -232.82065,
        "Y": 527.72107
      },
      "Description": "Depth values mapped to 0 and 1 of the output. If both are 0, the linear depth is output unchanged."
    },
    {
      "InputId": "482e7931-cc65-49bd-ac56-8724b83a4e6a"/*NearFarRange*/,
      "Position": {
        "X": -234.91547,
        "Y": 461.6969
      },
      "GroupTitle": "Settings",
      "Description": "Near and far clip planes of the camera."
    }
  ],
