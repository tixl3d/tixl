      "Position": {
        "X": 172.47906,
        "Y": 256.0015
      },
      "GroupTitle": "Hue shifting",
      "Description": "Hue shift in full turns: 1 rotates the hue once around the color wheel.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "b1d28822-af80-4c22-8f18-e22fb16f6dcf"/*Exposure*/,
      "Position": {
        "X": 169.67125,
        "Y": 341.40356
      },
      "Description": "Multiplies the brightness.",
