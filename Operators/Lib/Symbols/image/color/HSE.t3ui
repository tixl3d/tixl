      "Max": 5.0,
      "Scale": 0.02
    },
    {
      "InputId": "b3b65a98-6eba-4a10-89bb-7999385b590c"/*FxTexture*/,
      "Position": {
        "X": 172.15663,
        "Y": 206.87686
      },
      "Description": "Optional texture whose green channel is added to the hue shift."
