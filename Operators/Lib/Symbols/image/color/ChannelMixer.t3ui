{
  "FormatVersion": 3,
  "Id": "51968877-03e7-472d-9b43-95bc8aeda3bc"/*ChannelMixer*/,
  "Description": "Computes each output channel as a weighted sum of the input RGBA channels plus an offset.\n\nEach Multiply parameter defines how much of the input R, G, B and A contributes to one output channel. Finally Add is added to each output component. This allows converting to grayscale, extracting the alpha channel, inverting an image or swapping color channels. Check the presets for examples.\n\nAKA: swizzle, matrix, channels\n\nSee also: [AdjustColors], [Combine3Images]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "17d67e72-9603-4dfa-8646-e8e2e9db7fbf"/*ClampResult*/,
      "Position": {
        "X": 442.4342,
        "Y": 530.55725
      },
      "Description": "Clamps negative colors and alpha to the range 0 to 1."
    },
    {
      "InputId": "1a0acd15-34d1-4b8f-9739-f78ba204f315"/*Add*/,
      "Position": {
        "X": 442.4342,
        "Y": 390.55728
      },
      "GroupTitle": "Settings",
      "Description": "Offset added to the output R, G, B and A channels."
    },
    {
      "InputId": "1f380edd-ed50-49a4-976d-cce13783851d"/*MultiplyB*/,
      "Position": {
        "X": 442.4342,
        "Y": 110.55728
      },
      "Description": "Weights of the input R, G, B and A channels for the output blue channel."
    },
    {
      "InputId": "28bb7ff9-190a-4624-9361-c4a530851bfd"/*Texture2d*/,
      "Relevancy": "Required",
      "Position": {
        "X": 582.4342,
        "Y": -204.44272
      }
    },
    {
      "InputId": "5f3e8fc7-5b51-4502-aac2-d4cc282c985a"/*MultiplyR*/,
      "Position": {
        "X": 442.4342,
        "Y": -169.44272
      },
      "GroupTitle": "Channels",
      "Description": "Weights of the input R, G, B and A channels for the output red channel."
    },
    {
      "InputId": "76e01cd7-15b8-4962-a96f-592e67ae51c5"/*MultiplyG*/,
      "Position": {
        "X": 442.4342,
        "Y": -29.442719
      },
      "Description": "Weights of the input R, G, B and A channels for the output green channel."
    },
    {
      "InputId": "8e25ab02-ef93-441c-8a16-78555093c5a6"/*GenerateMipmaps*/,
      "Position": {
        "X": 582.4342,
        "Y": 565.55725
      },
      "AddPadding": "True"
    },
    {
      "InputId": "e68ed87b-fb06-43b2-a51f-a37a85fb6d87"/*MultiplyA*/,
      "Position": {
        "X": 442.4342,
        "Y": 250.55728
      },
      "Description": "Weights of the input R, G, B and A channels for the output alpha channel."
    }
  ],
