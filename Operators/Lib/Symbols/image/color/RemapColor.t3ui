{
  "FormatVersion": 3,
  "Id": "da93f7d1-ef91-4b4a-9708-2d9b1baa4c14"/*RemapColor*/,
  "Description": "Replaces the colors of an image with a gradient based on their brightness.\n\nThis can emulate adjustment curves (with spline gradient interpolation), level adjustments or color cycling effects. The gradient's alpha becomes the output alpha unless DontColorAlpha is enabled.\n\nAKA: gradientmap, colorramp, lut, curves\n\nSee also: [Tint]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "58f9492f-7866-4fb0-a4d8-1b304f812a6f"/*GradientSteps*/,
      "Position": {
        "X": -414.2527,
        "Y": 513.4169
      },
      "Description": "Number of samples used to convert the gradient into a texture."
    },
    {
      "InputId": "7023f71c-1c13-4d66-85e7-b0918cb8b02c"/*Repeat*/,
      "Position": {
        "X": 79.535034,
        "Y": 787.2047
      },
      "Description": "Number of gradient repetitions over the brightness range. Use WrapMode to define how it repeats."
    },
    {
      "InputId": "7777f86d-dbf7-44d4-9da4-99a819038095"/*DontColorAlpha*/,
      "Position": {
        "X": -60.464966,
        "Y": 577.20465
      },
      "GroupTitle": "Options",
      "Description": "Keeps the alpha computed from the input instead of using the gradient alpha."
    },
    {
      "InputId": "876f6f64-7cb4-4060-8571-e0b78b437d41"/*Image*/,
      "Position": {
        "X": -298.18713,
        "Y": 344.4582
      }
    },
    {
      "InputId": "8a2cc68c-ec38-4bb5-a201-e5c06f0a38d1"/*Exposure*/,
      "Position": {
        "X": 79.535034,
        "Y": 682.2047
      },
      "Description": "Multiplies the brightness before the gradient lookup.",
      "Min": 0.0,
      "Max": 5.0
    },
    {
      "InputId": "97771732-56fb-4e0c-915d-c79321ba27b5"/*GainAndBias*/,
      "Position": {
        "X": -60.464966,
        "Y": 717.2047
      },
      "Description": "Applies gain (X) and bias (Y) to the brightness before the gradient lookup.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "UseVec2Control": "GainAndBias"
    },
    {
      "InputId": "b1763a8b-aa98-4e00-a47c-a5d0d750ae6e"/*Cycle*/,
      "Position": {
        "X": 79.535034,
        "Y": 647.2047
      },
      "GroupTitle": "Wrap and Cyle",
      "Description": "Offsets the gradient lookup. Animate it for color cycling."
    },
    {
      "InputId": "c45d487b-3221-44c7-bf9e-b982a65280f6"/*Gradient*/,
      "Position": {
        "X": -414.2527,
        "Y": 478.41687
      }
    },
    {
      "InputId": "cb52ff49-17de-4e36-b918-5de6973a234a"/*Resolution*/,
      "Position": {
        "X": 79.535034,
        "Y": 822.2047
      }
    },
    {
      "InputId": "e3363c0e-819a-45e2-8202-439bcce64d69"/*Mode*/,
      "Position": {
        "X": -60.464966,
        "Y": 612.2047
      },
      "Description": "UseGrayScale: maps the average RGB brightness to the gradient.\nIndividualChannels: maps each channel separately to the matching channel of the gradient."
    },
    {
      "InputId": "eb070a0b-703d-43cc-a877-cf9e371ebd05"/*WrapMode*/,
      "Position": {
        "X": 79.535034,
        "Y": 857.2047
      },
      "Description": "How the gradient is sampled outside the 0 to 1 range."
    }
  ],
