{
  "FormatVersion": 3,
  "Id": "55411442-d538-48bf-ab78-b8c24c85aa46"/*AdjustColors*/,
  "Description": "Adjusts exposure, contrast, brightness, hue and saturation of an image and can add a colorize tint and a vignette.\n\nAKA: levels, brightness, contrast, saturation, hue\n\nSee also: [ColorGrade], [ColorGradeDepth], [HSE], [Tint]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "008b025e-64eb-44c3-8959-dc8ac5dc2cbb"/*PreventClamping*/,
      "Position": {
        "X": 190.97151,
        "Y": 852.7887
      },
      "Description": "Softly compresses bright values instead of clipping them.\nX: size of the blend range below the clipping point.\nY: how far above 1 values are compressed.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 5.0
    },
    {
      "InputId": "090c56b2-bbed-447e-baa1-5993b4e12ddc"/*Vignette*/,
      "Position": {
        "X": 330.9715,
        "Y": 992.7887
      },
      "GroupTitle": "Additional Options",
      "Description": "Darkens the image toward the edges. 0 disables the vignette.",
      "Min": 0.0,
      "Max": 5.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "42d296cf-6c53-4da9-bef8-da36c4ca3aea"/*Hue*/,
      "Position": {
        "X": 330.9715,
        "Y": 957.7887
      },
      "Description": "Hue rotation in degrees.",
      "Min": -180.0,
      "Max": 180.0,
      "Scale": 0.1
    },
    {
      "InputId": "4a10edf1-9bb4-4bd5-8455-357618f68ca9"/*OrangeTeal*/,
      "Position": {
        "X": 330.9715,
        "Y": 817.7887
      },
      "Description": "Brightness of the complementary color used for the darks. Only used if Colorize alpha is above 0.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 2.0
    },
    {
      "InputId": "689fdfbe-e78d-42f8-af0b-ae8159dec216"/*Background*/,
      "Position": {
        "X": -15.378929,
        "Y": 1026.6075
      },
      "Description": "Color blended behind transparent areas of the result."
    },
    {
      "InputId": "74d63ccb-7ae5-45d9-af69-ad91b8582407"/*Exposure*/,
      "Position": {
        "X": 330.9715,
        "Y": 712.7887
      },
      "Min": -5.0,
