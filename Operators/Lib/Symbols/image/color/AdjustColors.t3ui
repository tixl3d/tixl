      "Scale": 0.02
    },
    {
      "InputId": "8cb24377-04ad-4bf3-b191-00a0f7af9989"/*Colorize*/,
      "Position": {
        "X": 190.9715,
        "Y": 432.7887
      },
      "GroupTitle": "Color Options",
      "Description": "Maps bright and mid tones toward this color and the darks toward its complementary hue. The alpha controls the amount; 0 disables the effect."
    },
