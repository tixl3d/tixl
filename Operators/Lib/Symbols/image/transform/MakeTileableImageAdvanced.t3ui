{
  "FormatVersion": 3,
  "Id": "613507c8-fe54-40b0-8434-d0c4b4f59b45"/*MakeTileableImageAdvanced*/,
  "Description": "Makes an image tileable by blending its edges with the opposite side using a linear falloff combined with an adjustable noise pattern.\n\nThe noise breaks up the straight transition that can be visible with the simpler [MakeTileableImage].\n\nAKA: seamless, tile, wrap\n\nSee also: [MakeTileableImage], [TileableNoise]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "2876b27b-31fc-468a-9ac0-84d994a8c67c"/*AddNoiseToTransition*/,
      "Position": {
        "X": -1198.5454,
        "Y": -22.297333
      },
      "GroupTitle": "NoiseTransition",
      "Description": "Adds a noise pattern to the transition."
    },
    {
      "InputId": "6f33e428-982f-4279-8b2b-0c8c2404c04d"/*FadeOut*/,
      "Position": {
        "X": -1198.5454,
        "Y": 22.702667
      },
      "Description": "Intensity of the noise pattern in the transition.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 0.9,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "70fa51a8-b683-4a17-ad2b-d6ee5ccda3c0"/*EdgeFallOff*/,
      "Position": {
        "X": -1198.5454,
        "Y": -112.29733
      },
      "Description": "Size of the blended transition at the edges.",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "8d45de22-edfa-4f34-8030-2b038666b501"/*Phase*/,
      "Position": {
        "X": -1198.5454,
        "Y": 112.70267
      },
      "Description": "Changes the noise pattern. Can be animated, for example with [Time].",
      "AddPadding": "True"
    },
    {
      "InputId": "9c2c30e4-3ebc-4fe3-8353-508c725a7418"/*Scale*/,
      "Position": {
        "X": -1198.5454,
        "Y": 67.70267
      },
      "Description": "Size of the noise pattern.",
      "Min": 0.001,
      "Max": 1.0,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "ce6c982d-8878-4fee-8f88-41d11e008ec2"/*ImageA*/,
      "Position": {
        "X": -1198.5454,
        "Y": -157.29733
      }
    },
    {
      "InputId": "fcdeedd3-e872-4b86-975c-de7159e0d5c1"/*TilingMode*/,
      "Position": {
        "X": -1198.5454,
        "Y": -67.29733
      },
      "Description": "0: no tiling\n1: horizontal tiling only\n2: vertical tiling only\n3: horizontal and vertical tiling"
    }
  ],
