{
  "FormatVersion": 3,
  "Id": "b5102fba-f05b-43fc-aa1d-613fe1d68ad2"/*Grain*/,
  "Description": "Adds animated pixel noise similar to analog TV noise or film grain.\n\nAKA: noise, film, static, dither\n\nTips:\n- The effect is cheap to render, but it strongly reduces the efficiency of video and image compression: video streams and files can lose quality or require more bandwidth and storage.\n\nSee also: [MotionBlur], [DepthOfField], [ChromaticAbberation], [Glow], [Blur]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "195da7e0-5279-4900-80cd-5635e96ab454"/*Amount*/,
      "Position": {
        "X": -123.48642,
        "Y": 40.43416
      },
      "GroupTitle": "Intensity",
      "Description": "Controls the intensity of the image noise.",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.001,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "36df2611-4f74-4cc5-a49d-c0aff65f738a"/*RandomPhase*/,
      "Position": {
        "X": -539.109,
        "Y": 214.45392
      }
    },
    {
      "InputId": "4525c76c-cdcf-47f3-aa96-335cfc5b5c1b"/*Image*/,
      "Position": {
        "X": -123.48642,
        "Y": 5.4341583
      }
    },
    {
      "InputId": "61bb0df6-6c8a-4f3a-b7f4-9d979377cab8"/*Resolution*/,
      "Position": {
        "X": -123.48642,
        "Y": 285.43414
      },
      "Description": "Can be used to override the default render size.",
      "AddPadding": "True"
    },
    {
      "InputId": "74ca5916-20ee-4a1f-a41e-342c12d2126a"/*GenerateMipmaps*/,
      "Position": {
        "X": -123.48642,
        "Y": 320.43414
      },
      "Description": "Generates mipmaps. This improves quality if the grain is applied to a surface rendered at different distances and angles, e.g. a TV screen during a camera fly-through.",
      "AddPadding": "True"
    },
    {
      "InputId": "87a78859-5f0c-41af-8564-ac691b8f1950"/*Brightness*/,
      "Position": {
        "X": -123.48642,
        "Y": 145.43416
      }
    },
    {
      "InputId": "87b8eeac-14d7-4cb5-8669-4c8bb8f54419"/*CleanMode*/,
      "Position": {
        "X": -263.48642,
        "Y": 250.43414
      },
      "Description": "Removes stripes that become visible at large scales."
    },
    {
      "InputId": "903c0270-dc46-402e-8088-8db8368a6dfb"/*Color*/,
      "Position": {
        "X": -123.48642,
        "Y": 75.43416
      },
      "GroupTitle": "Appearance",
      "Description": "Saturation of the noise.\n0: monochromatic noise.\n5: colored noise as in old TV sets.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "d24cce46-dd3f-4047-a33f-50abbca89cc4"/*Exponent*/,
      "Position": {
        "X": -123.48642,
        "Y": 110.43416
      }
    },
    {
      "InputId": "edb719cd-be40-4758-9c13-98cf14d1a5c5"/*Scale*/,
      "Position": {
        "X": -123.48642,
        "Y": 215.43416
      },
      "GroupTitle": "Size",
      "Description": "Changes the size of the generated noise pattern / pixels."
    },
    {
      "InputId": "f1334f45-4335-4198-9b6e-ab9e8384aa32"/*Animate*/,
      "Position": {
        "X": -679.10895,
        "Y": 109.45392
      },
      "GroupTitle": "Motion",
      "Description": "Speed of the animation.\nLow values can look like noise in liquids, high values (50 and above) like TV static or film grain.",
      "Min": 0.0,
      "Max": 20.0,
      "Scale": 0.01
    }
  ],
