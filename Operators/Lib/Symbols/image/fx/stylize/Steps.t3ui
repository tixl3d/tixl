{
  "FormatVersion": 3,
  "Id": "4cdc0f90-6ce9-4a03-9cd0-efeddee70567"/*Steps*/,
  "Description": "Quantizes the brightness of the input image into a number of steps that are colored with gradients. The steps can be shaded and animated.\n\nAKA: posterize, quantize, contour, isolines, terraces\n\nSee also: [DetectEdges], [DistortAndShade], [Displace], [FakeLight]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "16745545-84e5-4290-a6c1-7df513c6a828"/*Highlight*/,
      "Position": {
        "X": -204.75685,
        "Y": 358.8786
      },
      "Description": "Color blended over the step at HighlightIndex, using its alpha.",
      "AddPadding": "True"
    },
    {
      "InputId": "3fa998ee-becf-4a32-948f-5c5be67d7728"/*Resolution*/,
      "Position": {
        "X": -198.16037,
        "Y": 32.122437
      }
    },
    {
      "InputId": "4ceccd98-d61e-4870-9b57-1c9ca84f3e23"/*Offset*/,
      "Position": {
        "X": -204.75685,
        "Y": 268.8786
      },
      "Description": "Shifts the steps in units of one step. Animate it with Repeat enabled for moving bands."
    },
    {
      "InputId": "7ccb8243-a6c6-4d95-a667-cb4abd396caf"/*SmoothRadius*/,
      "Position": {
        "X": -204.75685,
        "Y": 313.8786
      },
      "AddPadding": "True"
    },
    {
      "InputId": "7d057162-4fbd-4a78-8869-4dc459253f53"/*HighlightIndex*/,
      "Position": {
        "X": -204.75685,
        "Y": 403.8786
      },
      "Description": "Index of the step that is blended with the Highlight color."
    },
    {
      "InputId": "82c7d336-9a0b-40e0-938c-9e2007019b82"/*Edge*/,
      "Position": {
        "X": -194.92776,
        "Y": 531.60254
      },
      "Description": "Blended over each step from its start (left) to its end (right), useful for shading the step edges."
    },
    {
      "InputId": "85d5e801-f9f2-41d6-9d7b-3fbfda781fca"/*Bias*/,
      "Position": {
        "X": -204.75685,
        "Y": 223.87848
      },
      "Description": "Shifts the distribution of the steps towards dark or bright values."
    },
    {
      "InputId": "bea7eaac-91f0-4001-864f-2ddda0330cbd"/*Repeat*/,
      "Position": {
        "X": -194.92776,
        "Y": 576.60254
      },
      "GroupTitle": "Output",
      "Description": "Wraps the steps around instead of clamping, so animating Offset cycles them endlessly."
    },
    {
      "InputId": "c550629c-b200-4c66-954f-d1d50ef5c542"/*Ramp*/,
      "Position": {
        "X": -194.92776,
        "Y": 486.6025
      },
      "GroupTitle": "Refine",
      "Description": "Color of each step, picked by its index from left to right."
    },
    {
      "InputId": "c5c7888a-294d-4a51-a68d-446cc7f1444c"/*Image*/,
      "Relevancy": "Required",
      "Position": {
        "X": -198.16037,
        "Y": -12.877563
      }
    },
    {
      "InputId": "dc99dcb5-481e-4b43-afdf-ad6d318ed24f"/*Count*/,
      "Position": {
        "X": -186.66785,
        "Y": 112.67677
      },
      "GroupTitle": "Steps",
      "Description": "Number of brightness steps."
    },
    {
      "InputId": "eae96c29-6f21-43b2-b17e-eb9e140863ab"/*UseSuperSampling*/,
      "Position": {
        "X": -194.92776,
        "Y": 621.60254
      },
      "Description": "Renders 4 samples per pixel to smooth the step edges."
    }
  ],
