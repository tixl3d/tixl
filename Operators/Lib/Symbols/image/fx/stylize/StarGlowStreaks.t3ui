        "Y": -15.624207
      },
      "Description": "Length of the streaks."
    },
    {
      "InputId": "dd0e21b8-91a6-4853-9907-e0f675a05a5d"/*BlendMode*/,
      "Position": {
        "X": 132.69783,
        "Y": 209.3758
