{
  "FormatVersion": 3,
  "Id": "ecbb40c4-aef4-49a8-ac89-e82c3a09862f"/*StarGlowStreaks*/,
  "Description": "Renders star-shaped glow streaks from bright areas of the incoming image.\n\nUse Threshold to limit which areas create streaks. Also check out the presets.\n\nAKA: starglow, glint, lensflare, sparkle, cross\n\nSee also: [Glow], [Bloom], [LightRaysFx]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "069a3776-3084-4a13-aee3-dd9fe6c6c9e1"/*GlareModes*/,
      "Position": {
        "X": 132.69783,
        "Y": 344.3758
      },
      "Description": "Shape of the streaks: Diagonals, Cross, Star, Horizontal or Vertical."
    },
    {
      "InputId": "68e16fd7-fabf-446e-9553-a737422c026b"/*Brightness*/,
      "Position": {
        "X": 132.69783,
        "Y": 29.375793
      }
    },
    {
      "InputId": "6bc1a296-1a17-44a2-ba41-2c51c192090c"/*OriginalColor*/,
      "Position": {
        "X": 132.69783,
        "Y": 254.3758
      },
      "Description": "Multiplied with the original image.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "87148268-6d28-4d71-a2b5-b1ec0fb66685"/*Color*/,
      "Position": {
        "X": 132.69783,
        "Y": -60.624207
