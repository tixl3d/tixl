    },
    {
      "InputId": "8c1d41ff-02e8-481b-a21a-56d1c519d920"/*Threshold*/,
      "Position": {
        "X": 132.69783,
        "Y": 74.37579
      }
    },
    {
      "InputId": "943f048f-4938-4cde-9ac3-c7de5242450e"/*Quality*/,
      "Position": {
        "X": 132.69783,
        "Y": 299.3758
      },
      "Description": "Experimental. 0 = best quality, 7 = lowest quality.\nLower qualities sample lower mip levels and should be cheaper. They require GenerateMips to be enabled on the RenderTarget of the incoming image."
    },
    {
      "InputId": "afcba3d4-b7db-40bd-919a-d4f49b1bf7fc"/*Image*/,
