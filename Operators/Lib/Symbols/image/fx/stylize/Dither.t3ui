{
  "FormatVersion": 3,
  "Id": "299e9912-2a6a-40ea-aa31-4c357bbec125"/*Dither*/,
  "Description": "Converts an image to two colors using ordered (Bayer) or random dithering.\n\nThe image is divided into cells of Scale pixels. For each cell the brightness is compared against a dither pattern to pick ShadowColor or HighlightColor.\n\nAKA: halftone, bayer, 1bit, retro\n\nSee also: [MosiacTiling], [VoronoiCells], [SubdivisionStretch], [HoneyCombTiles], [AsciiRender], [Pixelate]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0a3e1e60-39c1-4cb7-a6c1-6442ef0fe9cd"/*ShadowColor*/,
      "Position": {
        "X": 131.75464,
        "Y": 46.275253
      },
      "Description": "Color selection for all dark pixels.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "0fb3a599-897f-4d38-a284-50374118810f"/*BlendMethod*/,
      "Position": {
        "X": 120.35292,
        "Y": 718.9912
      },
      "Description": "How the dithered colors are blended onto the original image."
    },
    {
      "InputId": "1c8ca868-0d54-4776-92bd-5c4183660216"/*GrayScaleWeights*/,
      "Position": {
        "X": 132.46725,
        "Y": 252.84007
      },
      "GroupTitle": "Advanced Settings",
      "Description": "Currently ignored. The brightness is taken from the red channel.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "3a6f87d6-913b-4200-807c-bb4da3f64fb7"/*GainAndBias*/,
      "Position": {
        "X": 128.1916,
        "Y": 315.1541
      },
      "Description": "Shapes the brightness before dithering.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "Format": "{0:0.000}",
      "UseVec2Control": "GainAndBias"
    },
    {
      "InputId": "4167d4a6-7f8c-4bc9-9424-a54388d2560b"/*Image*/,
      "Relevancy": "Required",
      "Position": {
        "X": 132.69783,
        "Y": -15.624207
      }
    },
    {
      "InputId": "41d59091-a974-43ed-b45b-0849fb91f6d1"/*Scale*/,
      "Position": {
        "X": 132.46725,
        "Y": 404.83698
      },
      "GroupTitle": "Size",
      "Description": "Size of the dither cells in pixels.",
      "Min": 1.0,
      "Max": 15.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "50335511-3b96-4c23-a604-3bc3dacae062"/*Offset*/,
      "Position": {
        "X": 132.46725,
        "Y": 449.83698
      },
      "Description": "Shifts the dither grid in cells.",
      "Min": -2.0,
      "Max": 2.0,
      "UseVec2Control": "Position"
    },
    {
      "InputId": "703cf883-ece6-42d6-9e8c-0248b58eca2d"/*HighlightColor*/,
      "Position": {
        "X": 131.75464,
        "Y": 102.27525
      },
      "Description": "Color selection for all bright pixels.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "9364f41d-0700-4c43-ad16-569081f510cf"/*Method*/,
      "Position": {
        "X": 131.75464,
        "Y": 147.27525
      },
      "Description": "FloydSteinberg: Uses an ordered Bayer matrix pattern (despite the name).\nDiffusion: Uses random noise per cell.",
      "AddPadding": "True"
    }
  ],
