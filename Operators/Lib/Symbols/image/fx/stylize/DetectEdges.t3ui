{
  "FormatVersion": 3,
  "Id": "2a5475c8-9e16-409f-8c40-a3063e045d38"/*DetectEdges*/,
  "Description": "Detects edges in the incoming image by comparing each pixel with its neighbors.\n\nTry the presets.\n\nAKA: outline, sobel, contour, lines\n\nSee also: [Steps], [DistortAndShade], [Displace], [FakeLight], [Sharpen]\nAlso check out the [HowToUseImageEffects] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "4041b6d8-15e5-428c-9967-7105975a46f7"/*Image*/,
      "Relevancy": "Required",
      "Position": {
        "X": 371.94128,
        "Y": -102.45227
      }
    },
    {
      "InputId": "6d10c73c-37b8-443b-94d9-854b04027a3c"/*Color*/,
      "Position": {
        "X": 231.94124,
        "Y": -67.45227
      },
      "GroupTitle": "Result Settings",
      "Description": "Multiplied with the edges, or used as edge color if OutputAsTransparent is enabled."
    },
    {
      "InputId": "7f66aa8d-fbdd-47d6-ba38-07e257e19401"/*SampleRadius*/,
      "Position": {
        "X": 371.94125,
        "Y": 72.54773
      },
      "GroupTitle": "Edge Detection",
      "Description": "Distance of the neighbor samples in pixels."
    },
    {
      "InputId": "921b8a04-d3b5-408e-ad3e-311a4c9890b1"/*OutputAsTransparent*/,
      "Position": {
        "X": 231.94124,
        "Y": 212.54773
      },
      "Description": "Outputs Color with the edge strength as alpha instead of grayscale edges.",
      "AddPadding": "True"
    },
    {
      "InputId": "9dae724d-7be8-4f82-8907-28550ddbf6e6"/*Contrast*/,
      "Position": {
        "X": 371.94125,
        "Y": 142.54773
      },
      "Description": "Added to the edge value. Negative values hide weak edges."
    },
    {
      "InputId": "c0a17636-f75b-45c0-ab63-cb0f9130a7ac"/*MixOriginal*/,
      "Position": {
        "X": 371.94125,
        "Y": 177.54773
      },
      "Description": "Blends from the edges (0) to the original image (1)."
    },
    {
      "InputId": "d3197979-b418-4182-b1c9-f3126b175f8d"/*Strength*/,
      "Position": {
        "X": 371.94125,
        "Y": 107.54773
      },
      "Description": "Multiplies the detected color difference."
    }
  ],
