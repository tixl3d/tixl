{
  "FormatVersion": 3,
  "Id": "1fa725a1-dab6-4a2a-8a4d-6efdfba5cf05"/*Pixelate*/,
  "Description": "Reduces the image to a grid of uniform tiles, each filled with the color at its center.\n\nUnlike [MosiacTiling], this gives \"pixel perfect\" control: either define the tile count in X and Y with TileAmount, or set Divisor to derive square tiles from the source resolution. A Shape image can be repeated in every tile.\n\nAKA: pixelate, mosaic, lowres, pixelart, retro, grid\n\nSee also: [MosiacTiling], [Dither], [AsciiRender]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "047db178-dab3-4123-90ec-becb4f439f4e"/*Divisor*/,
      "Position": {
        "X": 132.69783,
        "Y": 74.37579
      },
      "Description": "If greater than 0, the tiles are 2 x Divisor pixels of the source image wide and TileAmount is ignored.",
      "Min": 0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "25711dcb-4b53-4a00-8b9d-7b653f8eaf59"/*Color*/,
      "Position": {
        "X": 132.69783,
        "Y": 29.375793
      },
      "Description": "Multiplied with the result."
    },
    {
      "InputId": "7db8987c-f128-476f-93bb-d79e761caecc"/*Image*/,
      "Relevancy": "Required",
      "Position": {
        "X": 132.69783,
        "Y": -15.624207
      }
    },
    {
      "InputId": "824bd327-4c52-422b-bd83-c568db8c0ea9"/*TileAmount*/,
      "Position": {
        "X": 132.69783,
        "Y": 119.37579
      },
      "Description": "Number of tiles in X and Y. Only used if Divisor is 0."
    },
    {
      "InputId": "f8a8381b-3a8c-4468-b66b-0a5be6f040bd"/*Shape*/,
      "Position": {
        "X": 132.69783,
        "Y": 299.3758
      },
      "GroupTitle": "Extra feature",
      "Description": "Image repeated in each tile and multiplied with its color, e.g. a circle for LED looks."
    }
  ],
