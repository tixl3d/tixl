{
  "FormatVersion": 3,
  "Id": "33424f7f-ea2d-4753-bbc3-8df00830c4b5"/*AdvancedFeedback*/,
  "Description": "A more versatile but harder to control version of [FluidFeedback] that also amplifies edges and shifts colors of the feedback buffer each frame.\n\nIt keeps the feedback buffer within a meaningful value range, avoiding images that drift to black or overly bright values.\n\nAKA: feedback, trails, echo, smear\n\nSee also: [FluidFeedback], [AdvancedFeedback], [AdvancedFeedback2], [AfterGlow2]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0f29ca23-b5fb-484e-8ae6-8ed70d67d623"/*Command*/,
      "Relevancy": "Required",
      "Position": {
        "X": 1051.6638,
        "Y": -324.39157
      },
      "Description": "The 2D or 3D content rendered on top of the feedback buffer each frame."
    },
