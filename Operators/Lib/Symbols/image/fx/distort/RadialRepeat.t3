{
  "FormatVersion": 3,
  "Id": "d07a12c2-2c1a-4c88-95a2-53db21e66bac"/*RadialRepeat*/,
  "Inputs": [
    {
      "Id": "30ec3cb0-9977-4b03-8be1-10cbeb31bbe0"/*RotateImage*/,
      "DefaultValue": 0.0
    },
    {
      "Id": "42451d9d-d1b1-49e2-813c-de01876ab8c5"/*Image*/,
      "DefaultValue": null
    },
    {
      "Id": "787b9749-ebc5-4dcf-ac4e-c2226049e0ea"/*RotateSlice*/,
      "DefaultValue": 0.0
    },
    {
      "Id": "7cf442ea-5382-42d0-a111-5293f7f2fc57"/*Zoom*/,
      "DefaultValue": 1.0
    },
    {
      "Id": "e9cb8bdb-ba6f-454a-bac7-c2eeb7a89d0d"/*Slices*/,
      "DefaultValue": 8.0
    },
    {
      "Id": "f3050fbe-b1f5-467d-bed3-f19b3b5570ca"/*Offset*/,
      "DefaultValue": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "Id": "f7067892-e0b4-45a9-969e-94c180d1ad91"/*Resolution*/,
      "DefaultValue": {
        "X": 0,
        "Y": 0
      }
    }
  ],
  "Children": [
    {
      "Id": "e7b5b7c2-e51a-4d07-a720-4008acdb9001"/*CustomPixelShader*/,
      "SymbolId": "46daab0e-e957-413e-826c-0699569d0e07",
      "SymbolName": "Lib.image.use.CustomPixelShader",
      "InputValues": [
        {
          "Id": "3d84725a-594b-46d8-aa21-eec99026115d"/*A*/,
          "Type": "System.Single",
          "Value": 200.0
        },
        {
          "Id": "8c3ffefe-8721-4dde-b252-22eb8be02d3f"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "float aspectRatio = width / height;\nuv -= 0.5;\nuv.x *= aspectRatio;\n\nfloat2 p = uv;\n\np = radial_repeat(p, A, B, C, D);\np += Offset;\np.x /= aspectRatio;\n\np += 0.5;\nc = ImageA.Sample(Sampler, p);\n"
        },
        {
          "Id": "c9a801ec-13fb-4ad4-b0cd-d125b5db500a"/*AdditionalCode*/,
          "Type": "System.String",
          "Value": "\nstatic const float tau = radians(360.0);\n\nfloat2 radial_repeat(float2 p, float n, float zoom, float rotateMirror, float rotateReflection)\n{\n\n    float r2 = 1.05;\n    float angle = atan2(p.y, p.x);\n    float radius = length(p)*zoom;\n    \n    float sector = tau / n;\n    \n    angle = fmod(angle - rotateMirror, tau);\n    if (angle < 0.0) angle += tau;\n    \n    angle = fmod(angle, sector);\n    \n    angle -= sector * rotateReflection;\n    \n    float2 q = float2(cos(angle), sin(angle)) * radius;\n    \n    return q;\n}"
        }
      ],
      "Outputs": []
    }
  ],
  "Connections": [
