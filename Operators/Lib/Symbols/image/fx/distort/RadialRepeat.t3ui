{
  "FormatVersion": 3,
  "Id": "6dc6bfa3-ba30-4987-96c3-78b0da3ada62"/*RadialRepeat*/,
  "Description": "Simple effect similar to [MirrorRepeat] and [KochSnowflake]. The input image will be mirrored with radial symmetry on the central axis by the specified number of slices.",
  "InputUis": [
    {
      "InputId": "0d05623b-d71a-47fa-ad7c-7be339cc52bf"/*Resolution*/,
      "Position": {
        "X": -345.57733,
        "Y": 485.7539
      },
      "GroupTitle": "Advanced",
      "Description": "Output resolution. Set to 0 for dynamic scaling."
    },
    {
      "InputId": "29014e97-bd03-4371-8ce9-334a6f474ab4"/*Slices*/,
      "Position": {
        "X": -345.57733,
        "Y": 203.95569
      },
      "Description": "The number of radial mirror slices",
      "Scale": 0.01
    },
    {
      "InputId": "2e1a24f6-63b4-42ac-8a33-cb6e79ff2a7e"/*Zoom*/,
      "Position": {
        "X": -345.57733,
        "Y": 328.16364
      },
      "Scale": 0.01
    },
