      "Position": {
        "X": -345.57733,
        "Y": 126.16928
      },
      "GroupTitle": "Radial Symmetry Settings",
      "Scale": 0.01,
      "UseVec2Control": "Position"
    },
    {
      "InputId": "a0a55a6d-5b1f-4a38-94cf-478413eef3ed"/*RotateSlice*/,
      "Position": {
        "X": -345.57733,
