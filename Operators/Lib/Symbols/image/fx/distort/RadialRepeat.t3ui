{
  "FormatVersion": 3,
  "Id": "6dc6bfa3-ba30-4987-96c3-78b0da3ada62"/*RadialRepeat*/,
  "Description": "Simple effect similar to [MirrorRepeat] and [KochKaleidoskope]. The input image will be mirrored with radial symmetry on the central axis by the specified number of slices.",
