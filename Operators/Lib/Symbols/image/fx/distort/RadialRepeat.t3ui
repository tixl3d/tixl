{
  "FormatVersion": 3,
  "Id": "6dc6bfa3-ba30-4987-96c3-78b0da3ada62"/*RadialRepeat*/,
  "Description": "Mirrors the input image with radial symmetry around a center into the given number of slices.\n\nAKA: kaleidoscope, mirror, symmetry\n\nSee also: [MirrorRepeat], [KochKaleidoskope]",
  "InputUis": [
    {
      "InputId": "0d05623b-d71a-47fa-ad7c-7be339cc52bf"/*Resolution*/,
      "Position": {
        "X": 73.386856,
        "Y": 368.96735
      },
      "GroupTitle": "Advanced",
      "Description": "Overrides the output resolution. 0 uses the resolution of the input image."
    },
    {
      "InputId": "241f95fb-12e0-45cf-9901-d7d857feacaf"/*WrapMode*/,
      "Position": {
        "X": -206.61314,
        "Y": 403.96735
      }
    },
    {
      "InputId": "29014e97-bd03-4371-8ce9-334a6f474ab4"/*Slices*/,
      "Position": {
        "X": 73.386856,
        "Y": 158.96735
      },
      "Description": "The number of radial mirror slices.",
      "Scale": 0.01
    },
    {
      "InputId": "2e1a24f6-63b4-42ac-8a33-cb6e79ff2a7e"/*Zoom*/,
      "Position": {
        "X": 73.386856,
        "Y": 228.96735
      },
      "Scale": 0.01
    },
    {
      "InputId": "43b610e7-7623-471b-b105-8008cba34a17"/*Image*/,
      "Position": {
        "X": 73.386856,
        "Y": 53.967354
      }
    },
    {
      "InputId": "4cd2aef5-52dc-4025-bd16-ab5987caeaac"/*Offset*/,
      "Position": {
        "X": -66.613144,
        "Y": 88.96735
      },
      "GroupTitle": "Radial Symmetry Settings",
      "Description": "Shifts the image that is sampled into each slice.",
      "Min": -1.0,
      "Max": 1.0,
      "Scale": 0.01,
      "UseVec2Control": "Position"
    },
    {
      "InputId": "a0a55a6d-5b1f-4a38-94cf-478413eef3ed"/*RotateSlice*/,
      "Position": {
        "X": 73.386856,
        "Y": 193.96735
      },
      "Description": "Rotates the image within each slice.",
      "Min": -180.0,
      "Max": 180.0,
      "Scale": 3.6,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "c8409905-5074-40e6-9536-04b37c124d62"/*CenterPosition*/,
      "Position": {
        "X": -66.613144,
        "Y": 298.96735
      },
      "Description": "Center of the symmetry.",
      "Min": -1.0,
      "Max": 1.0,
      "UseVec2Control": "Position"
    },
    {
      "InputId": "e3bf3deb-8230-486e-9f19-30cb3753be5a"/*Rotate*/,
      "Position": {
        "X": 73.386856,
        "Y": 263.96735
      },
      "GroupTitle": "Output",
      "Description": "Rotates the final image.",
      "Min": -180.0,
      "Max": 180.0,
      "Scale": 3.6,
      "Format": "{0:0.0}°"
    }
  ],
