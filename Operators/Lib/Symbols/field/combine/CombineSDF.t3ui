{
  "FormatVersion": 3,
  "Id": "82270977-07b5-4d86-8544-5aebc638d46c"/*CombineSDF*/,
  "Description": "Combines two or more connected SDFs with the selected boolean or blend method.\n\nThe fields are combined in the order they are connected. Colors defined with [SetSDFMaterial] are blended along.\n\nSee also: [StairCombineSDF], [BlendSDFWithSDF]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "4648e514-b48c-4a98-a728-3ebf9bcfa0b7"/*CombineMethod*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Union, CutOut (subtracts the following fields) and Intersect have Round and Chamfer variants that bevel the seam with radius K. UnionSoft and UnionSmooth blend the shapes smoothly.\nPipe only keeps a pipe of radius K along the intersection. Engrave cuts a v-shaped groove of size K where the fields meet."
    },
    {
      "InputId": "7248c680-7279-4c1d-b968-3864cb849c77"/*InputFields*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "9e4f5916-722d-4c4b-b1ca-814958a5b836"/*K*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Size of the blend, round, chamfer, pipe or engraving in world units. Also controls the width of the color blending."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "db0bbde0-18b6-4c53-8cf7-a294177d2089"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ],
  "Links": [
    {
      "Id": "f30c5dd4-2bf0-4378-bc64-78e803c2434b",
      "Title": "hg SDF lib by Mercury",
      "Description": "The original code is taken from the hq SDF library",
      "LinkUrl": "https://mercury.sexy/hg_sdf/",
      "LinkType": "Source"
    }
  ]
}