{
  "FormatVersion": 3,
  "Id": "dbef3c50-ada6-437d-adac-62824daa9b6b"/*BlendSDFWithSDF*/,
  "Description": "Switches between two SDFs depending on a third field used as mask.\n\nWhere the WeightField distance (minus Offset) is negative FieldA is used, where it is positive FieldB. Range controls the width of the smooth transition. Colors are blended accordingly. All three inputs must be connected.\n\nSee also: [CombineSDF]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "3301f9bb-8938-40e4-b3fc-501bcfa140a3"/*Offset*/,
      "Position": {
        "X": -200.0,
        "Y": 300.0
      },
      "Description": "Shifts the switching border by offsetting the mask distance."
    },
    {
      "InputId": "78ec0731-e155-4c09-83b8-9b8e98a1f0ab"/*FieldB*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 75.0
      }
    },
    {
      "InputId": "9ae430e4-a09d-46d2-8aa4-fcb6a2d6fcdd"/*WeightField*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Field used as mask. Its distance decides which field is used."
    },
    {
      "InputId": "eb8e21ff-6ca3-406c-b88a-f9caec9272d0"/*FieldA*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "f245899e-aa95-4540-9600-6e761ad430ef"/*Range*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Width of the transition in world units. 0 gives a hard switch."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "2844a064-50cf-4d03-8b2a-644ab3b15087"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}