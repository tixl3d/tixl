{
  "FormatVersion": 3,
  "Id": "88926602-4694-4632-9fd7-04c8d6ddd728"/*SetSDFMaterial*/,
  "Description": "Sets the color of an SDF, either with a constant color or with a connected color field.\n\nColors of several fields are blended when they are combined with [CombineSDF]. [RaymarchField] uses this color as albedo.\n\nSee also: [Raster3dField], [SDFToColor]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "7c656067-ef12-4990-b094-7f8160a242d1"/*SdfField*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "93d0ee54-b2f6-41ea-bbaa-ef06bca1f1a0"/*ColorField*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Optional color field such as [Raster3dField] that defines the color per position."
    },
    {
      "InputId": "d2a64234-c7ef-424b-822c-addce0b84e69"/*Color*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Albedo color. If a ColorField is connected, its color is multiplied with this.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "51c8b9dd-9798-44e6-a9d0-0baecfc9c9a5"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}