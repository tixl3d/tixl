{
  "FormatVersion": 3,
  "Id": "5b911a78-8cad-4dbd-9f74-afccb0cb0787"/*AbsoluteSDF*/,
  "Description": "Takes the absolute value of an SDF's distance, turning every solid into an infinitely thin shell at its surface.\n\nThe inside of the shape gets positive distances, so the surface becomes a hollow boundary. Combine with [PushPullSDF] to give that shell a thickness.\n\nSee also: [InvertSDF], [CombineSDF]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "e60a6857-2be5-4236-b506-43c9e84b8d1e"/*InputField*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "386b568b-0818-4d3e-adb7-d3adc41d3240"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}