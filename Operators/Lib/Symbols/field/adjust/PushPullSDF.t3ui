{
  "FormatVersion": 3,
  "Id": "0ff18a32-c1e9-406d-b3e3-23700e2453a0"/*PushPullSDF*/,
  "Description": "Makes the incoming SDF volume thinner or thicker by adding a constant to its distance.\n\nPositive Amount values shrink the shape, negative values grow it and round its edges. An optional AmountField modulates the offset per position, which can be used for displacement effects.\n\nSee also: [AbsoluteSDF], [NoiseDisplaceSDF]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "463149fa-b53b-4d43-b4e7-57dcb045bba0"/*StepScale*/,
      "Position": {
        "X": -200.0,
        "Y": 195.0
      },
      "Description": "Only used with a connected AmountField: the resulting distance is divided by 1 + StepScale to reduce raymarching artifacts."
    },
    {
      "InputId": "91c09fac-0b50-4f62-97ca-18461801b442"/*AmountField*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Optional field whose red channel is multiplied with Amount and added to the distance.\n\nThis breaks the Lipschitz continuity of the field and can cause raymarching artifacts.",
      "AddPadding": "True"
    },
    {
      "InputId": "9cd1120d-81fa-43ab-b023-c462fe651ffb"/*Amount*/,
      "Position": {
        "X": -200.0,
        "Y": 120.0
      },
      "Description": "Distance added to the field. Positive values shrink the shape, negative values grow it.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "c57d91b6-a26a-4e69-be1f-dc04f86594b6"/*SdfField*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "ffbb6690-d57e-4dea-8aa7-fbf0101b9c96"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}