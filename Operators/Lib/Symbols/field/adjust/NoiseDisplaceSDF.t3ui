{
  "FormatVersion": 3,
  "Id": "54f28d0a-d367-4b59-8480-5b762b8f2a9c"/*NoiseDisplaceSDF*/,
  "Description": "Displaces the surface of an SDF by adding 3D simplex noise to its distance.\n\nThis breaks the Lipschitz continuity of the field and can cause artifacts when raymarching. Lowering StepFactor (or StepSize in [RaymarchField]) reduces them at the cost of performance.\n\nSee also: [SpatialDisplaceSDF], [PushPullSDF]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "1799f18f-92c5-4885-b6c1-6a196eee805f"/*InputField*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "285d7cd9-1057-4ea8-bd0b-20ff52adc562"/*Amount*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Strength of the distance offset in world units. Negative values invert the bumps.",
      "AddPadding": "True"
    },
    {
      "InputId": "2d258b34-d45a-475e-987f-ea16cd4d5292"/*StepFactor*/,
      "Position": {
        "X": -200.0,
        "Y": 360.0
      },
      "GroupTitle": "Raymarching",
      "Description": "Multiplies the resulting distance. Values below 1 reduce raymarching artifacts but need more steps.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "6cd7b3ca-323c-4a69-989b-1b10009b8a90"/*Offset*/,
      "Position": {
        "X": -200.0,
        "Y": 285.0
      },
      "Description": "Offset of the noise field. Animate it to make the noise flow, e.g. with [AnimVec3]."
    },
    {
      "InputId": "b7a2e12b-9e55-43a5-be79-510f4a28a1f4"/*Scale*/,
      "Position": {
        "X": -200.0,
        "Y": 210.0
      },
      "Description": "Size of the noise features. Larger values give smoother, larger bumps."
    },
    {
      "InputId": "ee1c1993-3968-45a6-bbfc-9e4e6032ae7b"/*UseLocalSpace*/,
      "Position": {
        "X": -200.0,
        "Y": 435.0
      },
      "Description": "If enabled, the noise is sampled with the position after the transformations of the input field, so it sticks to the transformed object. Otherwise it is sampled with the incoming position."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "dbf31b38-5221-414c-83b1-800770fcfaa6"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}