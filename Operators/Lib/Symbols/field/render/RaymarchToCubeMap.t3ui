{
  "FormatVersion": 3,
  "Id": "0102bb5f-f874-4f4b-a833-c610c9e7fdf3"/*RaymarchToCubeMap*/,
  "Description": "Raymarches an SDF field into a cube map, e.g. for [DrawStageCanvas] or [SetEnvironment].\n\nEvery texel casts its own ray from Position, so the faces need no camera. With EquiAngular the texels are spaced evenly by angle, which evens out the resolution across each face; the cube map is marked as such, and consumers that support it decode it automatically.\n\nWith a TileSize above 1x1, each frame raymarches only one texel per tile and refines the rest over the following frames, from a coarse grid to every texel. Afterwards jittered samples keep accumulating, which anti-aliases the result. Moving the cube reprojects what was accumulated. Changes to the field are not detected; use Reset after editing it.\n\nThe field is shaded like in [RaymarchField]. Material overrides the material from the context; lights and fog come from where the cube map is used.\n\nAKA: cubemap, environment map, skybox, reflection probe, 360, EAC\n\nSee also: [RaymarchField], [RenderToCubeMap], [TextureToCubeMap]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "02ff65d1-0f72-4faa-b70c-2a32bb556f0d"/*Color*/,
      "Position": {
        "X": 1060.3239,
        "Y": 1169.2522
      },
      "Description": "Color multiplier. Alternatively use [SetSDFMaterial] or [SetMaterial]."
    },
    {
      "InputId": "11fea42c-3529-4e04-aeb8-11d6cd566e8d"/*SdfField*/,
      "Relevancy": "Required",
      "Position": {
        "X": 574.1129,
        "Y": 382.27707
      }
    },
    {
      "InputId": "165a2e29-f25c-4c1d-965a-9e0b59cc01a7"/*MinDistance*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1099.2522
      },
      "Description": "The distance threshold when the raymarching is marked as completed.",
      "Min": 0.0,
      "Max": 0.01,
      "Scale": 0.001
    },
    {
      "InputId": "31298feb-7887-4fa7-8556-8f74e69b513d"/*StepSize*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1064.2522
      },
      "Description": "An initial scaling factor. Lowering this can be useful to reduce artifacts caused by invalid Lipschitz continuities (e.g. by applying noise).",
      "Min": 0.9,
      "Max": 1.1
    },
    {
      "InputId": "39c62c6b-911c-49ee-8f71-abb3a7fc4ad6"/*Resolution*/,
      "Position": {
        "X": 2353.499,
        "Y": 645.27277
      },
      "Description": "Width and height of each cube face in pixels."
    },
    {
      "InputId": "3bc4d148-6ace-4e75-b940-4e9498e8195c"/*UVMapping*/,
      "Position": {
        "X": 261.91522,
        "Y": 491.31775
      },
      "Description": "Defines how texture coordinates for [SetMaterial] are generated: global or local triplanar, or a planar projection in local space."
    },
    {
      "InputId": "5c700dc8-adee-4094-947e-b95e984dbe3f"/*AoDistance*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1484.252
      },
      "GroupTitle": "Appearance",
      "Description": "Controls the distance and intensity of the Ambient Occlusion."
    },
    {
      "InputId": "64fbb6c8-08e9-4599-8615-1a7cbdd5f276"/*AmbientOcclusion*/,
      "Position": {
        "X": 1200.3239,
        "Y": 1309.2522
      },
      "Description": "Will apply an ambient occlusion color depending on the AO Distance parameter.\nYou can use the alpha channel to control the intensity.\nAlso try light colors to add some kind of inner glow effect.",
      "AddPadding": "True"
    },
    {
      "InputId": "6c66b93f-0ab4-4a48-a1ad-e045fd3759bf"/*Reset*/,
      "Position": {
        "X": 2353.499,
        "Y": 960.27277
      },
      "Description": "Discards the accumulated samples, e.g. after changing the field."
    },
    {
      "InputId": "6c92f61f-cf24-4eaa-a72e-382b25b8aa07"/*MaxSteps*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1029.2522
      },
      "GroupTitle": "Quality",
      "Description": "The number of raymarching steps. This has a major impact on the quality and performance. Normal values are between 50 and 150.\n",
      "Min": 0.0,
      "Max": 150.0,
      "ClampMin": true
    },
    {
      "InputId": "71641e7a-e7cb-43d5-af82-6a55d8d67b82"/*Rotation*/,
      "Position": {
        "X": 2353.499,
        "Y": 785.27277
      },
      "Description": "Rotation of the cube map in degrees. Keep at zero for reflections and environment lookups, which expect world-aligned cube maps."
    },
    {
      "InputId": "857855d9-713c-43e1-9bf5-6a8364269f30"/*MaxSamples*/,
      "Position": {
        "X": 2353.499,
        "Y": 925.27277
      },
      "Description": "Number of samples averaged per texel. Higher values smooth the result further but react slower to changes. 1 disables the accumulation."
    },
    {
      "InputId": "8a7b385c-2346-4ff9-94f7-7e8de315f5d6"/*NormalSamplingD*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1519.2522
      },
      "Description": "Defines the look-up distance when calculating the surface normal. This controls how sharp objects appear.\nToo small values will cause artifacts. Larger values will apply some sort of smoothing effect.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 0.1
    },
    {
      "InputId": "90c4b4d6-ef09-48f1-ac8d-0d9763ce895a"/*GenerateMips*/,
      "Position": {
        "X": 2353.499,
        "Y": 715.27277
      },
      "Description": "Generates mip levels, e.g. for blurred reflections."
    },
    {
      "InputId": "94014f67-3e79-4a4b-b6ed-3fb59966ef6e"/*TileSize*/,
      "Position": {
        "X": 2353.499,
        "Y": 890.27277
      },
      "Description": "Raymarches one texel per tile each frame and refines the rest over the following frames. 8x8 costs 1/64 of a full render and needs 64 frames until every texel has a sample."
    },
    {
      "InputId": "982f00a7-b57f-4aa5-8784-0bb5b340c2be"/*EquiAngular*/,
      "Position": {
        "X": 709.21265,
        "Y": 903.22
      },
      "Description": "Spaces texels evenly by angle (EAC). Consumers have to support it."
    },
    {
      "InputId": "9cec66d9-b274-4f34-89df-ec99994982e5"/*Position*/,
      "Position": {
        "X": 2353.499,
        "Y": 750.27277
      },
      "Description": "Origin of all rays in world space."
    },
    {
      "InputId": "bc2060a0-edde-4691-86ae-1658e64abe02"/*DistToColor*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1554.2522
      },
      "Description": "Blends the edges of the surface into the background to reduce artifacts when compositing."
    },
    {
      "InputId": "cb08b59b-0863-4e87-aaf1-4e90962bffa0"/*MaxDistance*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1134.2522
      },
      "Description": "A threshold after which the raymarching is aborted.",
      "Min": 0.0,
      "Max": 1000.0
    },
    {
      "InputId": "d62dc70b-700d-4aaf-aa1c-c716792184df"/*ClearColor*/,
      "Position": {
        "X": 2353.499,
        "Y": 680.27277
      },
      "Description": "Color where rays miss the field."
    },
    {
      "InputId": "e2d60235-bbea-45da-8f7a-9d11d76253a4"/*Material*/,
      "Position": {
        "X": 2353.499,
        "Y": 820.27277
      },
      "Description": "Optional material that overrides the one from the context."
    },
    {
      "InputId": "f4c0abdd-004f-4c9a-b062-044f94ee25b4"/*NeighborhoodClipping*/,
      "Position": {
        "X": 104.6602,
        "Y": 1649.2522
      },
      "Description": "Limits the accumulated colors to what this frame's coarse samples around each texel allow, so animation and moving edges stop ghosting. 0 disables it; around 1 is tight, higher values keep more fine detail. Detail smaller than a tile can flicker when it is tight.",
      "Min": 0.0,
      "Max": 4.0
    },
    {
      "InputId": "fab31a66-baf8-4bed-b364-91dde35e0ef9"/*TextureScale*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1449.252
      },
      "Description": "Scales the texture defined by [SetMaterial]."
    },
    {
      "InputId": "fe0f0372-4a57-454e-9f6a-b65ad1d283a2"/*SpecularAA*/,
      "Position": {
        "X": 1340.3239,
        "Y": 1589.2522
      },
      "Description": "Increases roughness where normals change quickly to reduce flickering highlights.",
      "Min": 0.0,
      "Max": 5.0,
      "ClampMin": true
    }
  ],
