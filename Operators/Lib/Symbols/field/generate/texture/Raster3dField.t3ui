{
  "FormatVersion": 3,
  "Id": "edfc71fc-2d54-4226-b819-0340bb1fdd65"/*Raster3dField*/,
  "Description": "Generates a 3D grid pattern as a color field.\n\nSpace is divided into cells of the given Scale. Each cell gets a cube of ColorB with the size LineWidth (relative to the cell), the rest of the cell is ColorA, which forms the grid lines. Connect it to the ColorField of [SetSDFMaterial] or to the FragmentField input of [DrawMesh].\n\nSee also: [SubDivPattern3d]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "1108ec25-8d77-4c0b-8f17-5308ea017df4"/*Feather*/,
      "Position": {
        "X": -200.0,
        "Y": 210.0
      },
      "Description": "Softness of the transition."
    },
    {
      "InputId": "21092a7f-01b8-47b4-ba37-c0b1dc6affc4"/*ColorB*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Color of the cell interiors.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "3938188b-41ba-4efe-b7e1-9720d2e58cd4"/*Offset*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "Transform",
      "Description": "Offset of the grid in cell units."
    },
    {
      "InputId": "606584e3-2c4a-432f-a7a4-c3093a34685e"/*LineWidth*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Size of the ColorB cube relative to the cell. 1 fills the whole cell, smaller values make the ColorA lines thicker.",
      "AddPadding": "True"
    },
    {
      "InputId": "9b324ca4-2116-489d-a829-8348a9984235"/*Scale*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Size of the grid cells in world units."
    },
    {
      "InputId": "d3d51c3c-9dd7-4f9b-849d-59e94abff605"/*ColorA*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "Color",
      "Description": "Color of the grid lines.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "096ef8a1-c5bb-4cc1-a4a9-fdc8ab1214ae"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}