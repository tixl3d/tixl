{
  "FormatVersion": 3,
  "Id": "a54e0946-71d0-4985-90bc-184cdb1b6b34"/*TorusSDF*/,
  "Description": "Generates a torus as an SDF.\n\nRender the result with [RaymarchField] and inspect it with [VisualizeFieldDistance]. Modify it with [TransformField], [BendField], [RepeatPolar] and other field operators.\n\nAKA: donut, ring\n\nSee also: [CappedTorusSDF], [ChainLinkSDF], [TorusMesh]",
  "SymbolTags": "1",
  "InputUis": [
