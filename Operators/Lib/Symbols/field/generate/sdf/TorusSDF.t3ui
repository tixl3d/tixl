      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Radius of the ring's cross section."
    },
    {
      "InputId": "dbc72bd7-6191-4145-a69f-d17b3808b3ab"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
