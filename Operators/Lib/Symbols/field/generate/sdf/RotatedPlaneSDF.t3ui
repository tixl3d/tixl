{
  "FormatVersion": 3,
  "Id": "cc6100a4-73ed-45e4-87ab-601e7956fb36"/*RotatedPlaneSDF*/,
  "Description": "Generates an infinite plane defined by a point and a normal vector as an SDF.\n\nSimilar to [PlaneSDF], but the normal can point in any direction. Render the result with [RaymarchField] and inspect it with [VisualizeFieldDistance].",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "1a154ff5-6fa7-4ee1-9b1e-99c5d47e9493"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Point on the plane."
    },
    {
      "InputId": "bfed14a7-7a97-4379-9419-222bb7a2ba57"/*Normal*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Direction the plane faces. It is normalized; everything behind the plane is inside."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "b42a945e-9842-4f76-8f1f-bb73cfd14be4"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}