{
  "FormatVersion": 3,
  "Id": "883e01f5-44ee-4724-9e6e-f885255c17e5"/*PlaneSDF*/,
  "Description": "Generates an infinite flat plane as an SDF.\n\nEverything below the plane (opposite to its normal) is inside. Render the result with [RaymarchField] and inspect it with [VisualizeFieldDistance]. Modify it with [TransformField], [BendField], [RepeatPolar] and other field operators.\n\nSee also: [RotatedPlaneSDF], [QuadMesh]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "76d4c422-399a-4b68-b0ea-5d2d2f54a667"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Position on the plane."
    },
    {
      "InputId": "99fca01a-e0a6-49dc-9535-ebde0f5f8744"/*Axis*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Direction of the plane normal. The Neg variants flip the inside and outside."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "82527072-beb2-492f-b737-faf9ed454e3f"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}