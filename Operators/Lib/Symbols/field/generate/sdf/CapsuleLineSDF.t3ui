{
  "FormatVersion": 3,
  "Id": "752e4358-05e0-4651-a147-f141138f5244"/*CapsuleLineSDF*/,
  "Description": "Generates a capsule connecting two points as an SDF.\n\nRender the result with [RaymarchField] and inspect it with [VisualizeFieldDistance]. Modify it with [TransformField], [BendField], [RepeatPolar] and other field operators.\n\nSee also: [CylinderSDF], [ChainLinkSDF]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "0b4fde07-5439-4dbd-af37-32e5c6dc9315"/*EndPoint*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "End of the capsule, relative to Center."
    },
    {
      "InputId": "50a47ea6-a941-4ff4-9b87-14ddd2791fe4"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Offsets both points."
    },
    {
      "InputId": "808c44ff-44e2-4a22-91f1-f459f298e6eb"/*Thickness*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Radius of the capsule."
    },
    {
      "InputId": "ace2fa64-382c-4386-b623-5b1051f4bcf4"/*StartingPoint*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Start of the capsule, relative to Center.",
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "1d6a73c3-1a6a-452a-a4a2-ddee308aa0ae"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 200.0
      }
    }
  ]
}