{
  "FormatVersion": 3,
  "Id": "860da1cd-b341-4bc5-965a-4a9c295831f4"/*BoxSDF*/,
  "Description": "Generates a box with optionally rounded edges as an SDF.\n\nRender the result with [RaymarchField] and inspect it with [VisualizeFieldDistance]. Modify it with [TransformField], [BendField], [RepeatPolar] and other field operators.\n\nAKA: cube\n\nSee also: [CylinderSDF], [BoxFrameSDF], [OctahedronSDF], [CubeMesh]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "734179fa-aaf8-46d0-b827-e71555dad6a0"/*UniformScale*/,
      "Position": {
        "X": -200.0,
        "Y": -45.0
      },
      "Description": "Multiplies Size."
    },
    {
      "InputId": "787e5d70-0aba-400f-8616-6ece6c5895bc"/*EdgeRadius*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Radius of the rounded edges.",
      "AddPadding": "True"
    },
    {
      "InputId": "951b2983-1359-41e4-8fb0-8d97c50ed8d6"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "c4ef07b4-853b-48d4-9ade-c93ee849071a"/*Size*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Width, height and depth of the box.",
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "9153c53c-0b19-4ce4-b086-e448d78ef032"/*Result*/,
