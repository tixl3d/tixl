{
  "FormatVersion": 3,
  "Id": "1e1e65cd-3564-45e1-88f8-6cb4b4b18c5a"/*PrismSDF*/,
  "Description": "Generates a 3- or 6-sided prism as an SDF.\n\nThe triangular prism does not support rounded edges. Render the result with [RaymarchField] and inspect it with [VisualizeFieldDistance]. Modify it with [TransformField], [BendField], [RepeatPolar] and other field operators.\n\nSee also: [CylinderSDF]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "356e85dd-bf81-4a1c-96a4-1d2983916a4b"/*EdgeRadius*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Radius of the rounded edges. Only used with 6 sides."
    },
    {
      "InputId": "522a9640-ca8c-47e6-ad36-5c316a9092ae"/*Axis*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Axis along which the prism is aligned."
    },
    {
      "InputId": "b5e445df-88d0-4b1f-a583-3c4ea83d6526"/*Sides*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "GroupTitle": "Shader Variations",
      "Description": "Number of sides: 3 or 6."
    },
    {
      "InputId": "cfc6f8f3-94b4-46f6-9501-11d7b7916bb7"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "dd33f05b-6c98-4740-a218-a0e8a4922ac3"/*Length*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Total length of the prism."
    },
    {
      "InputId": "ef023a17-cd92-47c5-b2fd-4db7ac4bebac"/*Radius*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Size of the cross section.",
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "e3d6161a-68bd-41e6-882c-5092a61fc449"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 200.0
      }
    }
  ]
}