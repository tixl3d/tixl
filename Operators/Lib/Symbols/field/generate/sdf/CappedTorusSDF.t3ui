{
  "FormatVersion": 3,
  "Id": "b85198a8-6475-45e1-b2d2-83ec8f59d6ed"/*CappedTorusSDF*/,
  "Description": "Generates a torus that can be cut open to an arc, with rounded ends, as an SDF.\n\nRender the result with [RaymarchField] and inspect it with [VisualizeFieldDistance]. Modify it with [TransformField], [BendField], [RepeatPolar] and other field operators.\n\nSee also: [TorusSDF], [ChainLinkSDF], [TorusMesh]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "00cec9de-3be4-403f-8677-dcc2ef473708"/*Radius*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Radius of the ring."
    },
    {
      "InputId": "01dec852-5b80-4705-8648-c6fd68199e83"/*Axis*/,
      "Position": {
        "X": -200.0,
        "Y": 210.0
      },
      "Description": "Axis around which the ring is oriented."
    },
    {
      "InputId": "d37914dd-7bbd-47fa-ad90-9921621afb9e"/*Fill*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Opening angle of the arc. Around 0.93 the ring disappears completely, around 3.22 it is closed. Values in between show an arc.",
      "AddPadding": "True"
    },
    {
      "InputId": "e1dc5cdc-24d2-409f-9ea6-6dd14fdb70d3"/*Thickness*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Radius of the ring's cross section."
    },
    {
      "InputId": "f5a24e80-741a-49c5-9a0b-d7074e80940a"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "170b545f-c7c0-47d9-8b19-d8d8e8a3d2fa"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}