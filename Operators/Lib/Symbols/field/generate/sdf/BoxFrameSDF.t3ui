{
  "FormatVersion": 3,
  "Id": "f393bb49-bea5-42f7-a437-c6896bdfd7d8"/*BoxFrameSDF*/,
  "Description": "Generates the edges of a box as an SDF.\n\nRender the result with [RaymarchField] and inspect it with [VisualizeFieldDistance]. Modify it with [TransformField], [BendField], [RepeatPolar] and other field operators. Use [RepeatFieldLimit] to build chains or lattices.\n\nSee also: [BoxSDF], [OctahedronSDF], [PyramidSDF]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "26389c32-410e-4240-9cf7-9ed0908b9cf8"/*Thickness*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Thickness of the frame bars.",
      "AddPadding": "True",
      "Min": -0.002,
      "Max": 0.5,
      "ClampMin": true
    },
    {
      "InputId": "993a74e6-87fc-4193-9dc1-8cd9447a1c49"/*Size*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Width, height and depth of the box.",
      "AddPadding": "True"
    },
    {
      "InputId": "a53ab420-7bcf-4d98-8440-abcf00d7db19"/*UniformScale*/,
      "Position": {
        "X": -200.0,
        "Y": -45.0
      },
      "Description": "Multiplies Size."
    },
    {
      "InputId": "c811ef83-e183-4b14-a1e6-3ea2fd840596"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
