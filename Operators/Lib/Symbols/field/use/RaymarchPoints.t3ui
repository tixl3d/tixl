{
  "FormatVersion": 3,
  "Id": "a914c462-b707-4240-b57b-ed0e24e80a94"/*RaymarchPoints*/,
  "Description": "Moves points along their negative Z axis until they hit the surface of an SDF, optionally reflecting them.\n\nEach input point produces a line of points (start, hits and reflections) followed by a separator, which can be drawn with [DrawLines]. This can be used to visualize raymarching or to simulate rays reflected from an SDF surface.\n\nSee also: [SdfReflectionLinePoints], [RaymarchField]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "000617c3-709d-49e1-953e-55d45b565504"/*MinDistance*/,
      "Position": {
        "X": 973.82806,
        "Y": 1474.262
      },
      "Description": "Distance at which a ray counts as hitting the surface.",
      "Min": 0.0
    },
    {
      "InputId": "3ea2d4c9-35f4-49d4-b26f-1e12bfd71fbe"/*MaxDistance*/,
      "Position": {
        "X": 973.82806,
        "Y": 1579.262
      },
      "Description": "Distance after which a ray stops."
    },
    {
      "InputId": "685b1c07-4696-4a87-bb24-3103122db557"/*WriteStepCountTo*/,
      "Position": {
        "X": 976.59106,
        "Y": 1778.2859
      },
      "Description": "Writes the step or reflection index into F1 or F2."
    },
    {
      "InputId": "71d7f5a5-f13c-40fd-9a28-fbdd64ae07b6"/*MaxSteps*/,
      "Position": {
        "X": 164.88193,
        "Y": 1747.0396
      },
      "Description": "Maximum number of raymarching steps per ray, clamped to 1..100."
    },
    {
      "InputId": "75b28b25-02bf-4926-8d27-2a547231f40a"/*Mode*/,
      "Position": {
        "X": 164.88193,
        "Y": 1800.6741
      },
      "Description": "Raymarch: outputs only the start point and the hit points. KeepSteps: outputs every raymarching step."
    },
    {
      "InputId": "81855333-ab3a-4543-b68c-0eb2f62427b0"/*StepDistanceFactor*/,
      "Position": {
        "X": 973.82806,
        "Y": 1509.262
      },
      "Description": "Multiplies each step. Values below 1 reduce overshooting for fields with artifacts.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "86fbda4c-5c1b-42b0-a35f-ebcccd6cc648"/*MaxReflectionCount*/,
      "Position": {
        "X": 164.88193,
        "Y": 1903.8231
      },
      "Description": "Number of reflections, clamped to 0..10."
    },
    {
      "InputId": "a21ebc40-ae79-439b-a3e7-d90a50b71ca7"/*Field*/,
      "Relevancy": "Required",
      "Position": {
        "X": 469.7932,
        "Y": 978.14343
      }
    },
    {
      "InputId": "a8f8ed3f-01e4-48c9-beaa-4a2833d50863"/*NormalSamplingDistance*/,
      "Position": {
        "X": 973.8282,
        "Y": 1544.262
      },
      "Description": "Offset used to compute the surface normal for reflections."
    },
    {
      "InputId": "b1dc8336-33e0-4856-ba18-eaac052c5f43"/*Points*/,
      "Relevancy": "Required",
      "Position": {
        "X": 469.7932,
        "Y": 1143.6428
      }
    },
    {
      "InputId": "cf27f634-039e-4500-acdb-b0523ea2d198"/*WriteDistanceTo*/,
      "Position": {
        "X": 976.59106,
        "Y": 1743.2859
      },
      "Description": "Writes the travelled distance into F1 or F2."
    }
  ],
