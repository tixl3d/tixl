{
  "FormatVersion": 3,
  "Id": "4af7bbd1-9231-4ef3-bb7a-1d643c7d16cf"/*SdfReflectionLinePoints*/,
  "Description": "Shoots rays from points along their negative Z axis and reflects them on the surface of an SDF, outputting the ray paths as lines.\n\nEach input point produces a line of points followed by a separator, which can be drawn with [DrawLines].\n\nSee also: [RaymarchPoints], [RaymarchField]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "0d73ebd5-c76b-46c2-b15f-96ff2ec498bd"/*MaxReflectionCount*/,
      "Position": {
        "X": 477.1128,
        "Y": 1375.6528
      },
      "Description": "Number of reflections, clamped to 0..10."
    },
    {
      "InputId": "403f823d-043b-4009-b00f-e90aa154f30f"/*MinDistance*/,
      "Position": {
        "X": 973.82806,
        "Y": 1474.262
      },
      "Description": "Distance at which a ray counts as hitting the surface.",
      "Min": 0.0,
      "Scale": 0.01
    },
    {
      "InputId": "5613c80e-a0a5-4996-a864-362d021fc056"/*Field*/,
      "Relevancy": "Required",
      "Position": {
        "X": 643.13354,
        "Y": 883.8391
      }
    },
    {
      "InputId": "818886bf-cc7d-49ce-9294-fda1d6a17177"/*WriteDistanceTo*/,
      "Position": {
        "X": 973.8281,
        "Y": 1826.3635
      },
      "Description": "Writes the travelled distance into F1 or F2."
    },
    {
      "InputId": "94c84de7-ac0c-48c1-9a45-f2d39ab6513f"/*MaxDistance*/,
      "Position": {
        "X": 973.82806,
        "Y": 1579.262
      },
      "Description": "Distance after which a ray stops.",
      "Scale": 0.01
    },
    {
      "InputId": "a3d0717d-7afd-48cb-a43c-72701bcc1393"/*StepDistanceFactor*/,
      "Position": {
        "X": 973.82806,
        "Y": 1509.262
      },
      "Description": "Multiplies each step. Values below 1 reduce overshooting for fields with artifacts.",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "c33c3db6-fb51-4ed3-b986-5580d2ceb539"/*NormalSamplingDistance*/,
      "Position": {
        "X": 973.8282,
        "Y": 1544.262
      },
      "Description": "Offset used to compute the surface normal for reflections.",
      "Scale": 0.01
    },
    {
      "InputId": "c444a71a-5760-49a7-bfc8-3b97449a0343"/*MaxSteps*/,
      "Position": {
        "X": 833.8282,
        "Y": 1756.3635
      },
      "Description": "Maximum number of raymarching steps per ray, clamped to 1..100."
    },
    {
      "InputId": "c4e2297a-dd91-4162-8f2c-e968d8529158"/*Points*/,
      "Relevancy": "Required",
      "Position": {
        "X": 477.11273,
        "Y": 1163.6362
      }
    },
    {
      "InputId": "c7a5d340-cf58-43dd-9bef-eb8c417e9d2e"/*WriteStepCountTo*/,
      "Position": {
        "X": 973.8281,
        "Y": 1861.3635
      },
      "Description": "Writes the step or reflection index into F1 or F2."
    }
  ],
