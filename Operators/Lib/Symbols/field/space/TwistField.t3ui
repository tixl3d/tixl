{
  "FormatVersion": 3,
  "Id": "d7c6e980-6766-4f83-a32c-677e3713e8a6"/*TwistField*/,
  "Description": "Twists the incoming field around the given axis.\n\nThis works best for small shapes near the origin. Space deformations break the Lipschitz continuity of the field. Lower StepFactor if the raymarched result shows artifacts.\n\nIt needs an incoming field like [BoxSDF] or [TorusSDF]. Render the result with [RaymarchField] and inspect it with [VisualizeFieldDistance].\n\nSee also: [BendField], [RepeatPolar]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "195f4642-52f7-4c95-9127-07f6175549f5"/*Axis*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "GroupTitle": "Shader Variation",
      "Description": "Axis around which the field is twisted."
    },
    {
      "InputId": "4935f569-8d23-495d-bb87-9a39e5b3981e"/*Amount*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Twist angle in degrees per world unit.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "84dd59ce-4726-4604-afee-92ffdec0e3f5"/*InputField*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "ad43a4c4-3439-46c5-986d-c654a56d296a"/*StepFactor*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "GroupTitle": "Raymarching",
      "Description": "Multiplies the resulting distance. Values below 1 reduce raymarching artifacts but need more steps.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "0125a816-2885-4e83-97f9-357e24f8afc3"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ],
  "Links": [
    {
      "Id": "8f486b3a-142b-4e0a-aa41-bd6b9d4b9cea",
      "Title": "Reference",
      "Description": "original code by iq",
      "LinkUrl": "https://iquilezles.org/articles/distfunctions/",
      "LinkType": "Reference"
    }
  ]
}