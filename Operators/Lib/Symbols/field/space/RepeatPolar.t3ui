{
  "FormatVersion": 3,
  "Id": "1d9f133d-eba6-4b28-9dfd-08f6c5417ed6"/*RepeatPolar*/,
  "Description": "Repeats the incoming field radially around an axis.\n\nIt needs an incoming field like [BoxSDF] or [TorusSDF]. Render the result with [RaymarchField] and inspect it with [VisualizeFieldDistance].\n\nSee also: [RepeatAxis], [ReflectField], [TwistField]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "02e4130f-8a0c-4efb-b75f-f7da29cc95eb"/*Axis*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Axis around which the field is repeated."
    },
    {
      "InputId": "57f25302-ea5e-40ab-9c54-9d7c3411e467"/*Mirror*/,
      "Position": {
        "X": -200.0,
        "Y": 195.0
      },
      "Description": "Mirrors every other copy."
    },
    {
      "InputId": "7248c680-7279-4c1d-b968-3864cb849c77"/*InputField*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "a0231b91-8ab8-4591-a3da-3cd7f3980d2f"/*Offset*/,
      "Position": {
        "X": -200.0,
        "Y": 120.0
      },
      "Description": "Rotates the copies around the axis.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "b4c551a3-28c1-418a-83b4-ebdd61ed599c"/*Repetitions*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Number of copies around the axis."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "de78d5d8-b232-44f6-ab18-cc765f81eb38"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}