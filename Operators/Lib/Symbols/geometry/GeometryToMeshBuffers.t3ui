    {
      "InputId": "57469ea6-f0c5-4e8d-a53c-40e8ac495bc3"/*Geometry*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "4bf00eb5-a39c-4567-a81e-46c2276d1418"/*Buffers*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}
