{
  "FormatVersion": 3,
  "Id": "55b64ede-9730-457c-8d3c-981a9fe6120e"/*SelectGeometry*/,
  "Description": "Selects elements of a geometry by index pattern or a C# snippet and writes the result as a float attribute.\n\nThe selection is a named attribute (default `Selection`) with a weight from 0 to 1 on the chosen domain: points, vertices, primitives or parts. It flows with the geometry, so downstream ops such as [TransformGeometry] act on it by name. An existing selection of the same name can be extended, reduced or intersected.\n\nTips\n- After [SubdivideCurves], points are numbered along each curve, so Every 2 selects every second point of an outline.\n- In Custom mode a snippet can return a bool, e.g. `return p.Y > A;`, or a float weight for soft selections.",
  "InputUis": [
    {
      "InputId": "10342312-f3b9-4a53-9413-ab358860eed4"/*Geometry*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "2f24c52a-0a48-4c4e-a359-0b6012016270"/*Code*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "GroupTitle": "Custom",
      "Description": "Body of a C# method that returns a bool (selected or not) or a float weight from 0 to 1. In scope: index i, element count, position p (a primitive's center, a part's pivot) and the parameters Center, A and B. System.MathF is imported, e.g. `return p.Y > A;`. Attributes of the input geometry are read as @Name, e.g. `@Normal.Y` or `@Selection` after an upstream [SelectGeometry]; the Table tab of the input lists them. Attributes of other domains are converted: a primitive averages its vertices or points, a vertex takes its point or primitive, a point averages the vertices around it; ints take the first value, and averaged normals need Normalize(). @P is the position.",
      "Usage": "Code",
      "CodeLanguage": "CSharp"
    },
    {
      "InputId": "3adc4760-5ba6-46ec-b8c1-2ad4ec3d25cc"/*Center*/,
      "Position": {
        "X": 0.0,
        "Y": 390.0
      },
      "Description": "A point for the Custom snippet, movable with the transform gizmo, e.g. `return (p - Center).Length() < A;` selects a sphere around it."
    },
    {
      "InputId": "427919c7-6b02-4009-a9cc-938986ad1053"/*Domain*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Which elements to select: points, vertices, primitives (polygons and curves) or parts.",
      "DisplayAs": "SegmentedSwitch"
    },
    {
      "InputId": "4dba7742-653a-4ad5-9e21-0ea557865bcd"/*Offset*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Index of the first selected element in the pattern.",
      "Min": 0,
      "Max": 10
    },
    {
      "InputId": "53192fa7-eeec-462f-9ed8-c56d90d4fd82"/*GainAndBias*/,
      "Position": {
        "X": 0.0,
        "Y": 540.0
      },
      "Description": "Applies gain (X) and bias (Y) to the weights, after Clamp Result. 0.5 leaves them unchanged; weights outside 0..1 pass through.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "Format": "{0:0.000}",
      "UseVec2Control": "GainAndBias"
    },
    {
      "InputId": "6355884b-d2a9-4892-9698-944c8ab3a0de"/*Name*/,
      "Position": {
        "X": 0.0,
        "Y": 450.0
      },
      "Description": "Name of the float attribute to write. Downstream ops pick their selection by this name.",
      "Usage": "Default"
    },
    {
      "InputId": "738d7eae-2dfa-4c56-a85d-a25c00143f6e"/*B*/,
      "Position": {
        "X": 0.0,
        "Y": 315.0
      },
      "Description": "Free parameter for the Custom snippet."
    },
    {
      "InputId": "7b777d3d-1bec-4297-94c3-f7450a162aeb"/*Every*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "GroupTitle": "Pattern",
      "Description": "Selects every Nth element: 2 selects every second one.",
      "Min": 1,
      "Max": 10,
      "ClampMin": true
    },
    {
      "InputId": "7bac9932-a892-4d15-909d-ded6f6c90564"/*Count*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "How many elements the pattern selects, starting at Offset and wrapping past the end; animate Offset to move them. 0 selects every match.",
      "Min": 0,
      "Max": 20
    },
    {
      "InputId": "952ea8f6-51f4-46b8-94af-83dda89159b0"/*Invert*/,
      "Position": {
        "X": 0.0,
        "Y": 405.0
      },
      "Description": "Selects what the pattern or snippet doesn't."
    },
    {
      "InputId": "959c2660-ea9c-4c3a-8f00-d4b571d777a6"/*A*/,
      "Position": {
        "X": 0.0,
        "Y": 270.0
      },
      "Description": "Free parameter for the Custom snippet."
    },
    {
      "InputId": "b481e8e6-3730-4253-88ee-c04ea20184bd"/*ClampResult*/,
      "Position": {
        "X": 0.0,
        "Y": 465.0
      },
      "Description": "Saturates the weights to 0..1 before Gain And Bias. Off lets a Custom snippet write weights outside that range."
    },
    {
      "InputId": "d82c7cd6-f36b-4ca9-97a7-db120670e5c1"/*Mode*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "IndexPattern selects every Nth element from Offset, optionally only Count of them. Custom runs the C# snippet in Code for each element.",
      "DisplayAs": "SegmentedSwitch"
    },
    {
      "InputId": "ec982690-0ef4-4b25-83d8-ddddb2c2d24e"/*Combine*/,
      "Position": {
        "X": 0.0,
        "Y": 360.0
      },
      "Description": "How the new selection combines with an existing one of the same name: Replace, Add (maximum), Remove or Intersect (minimum).",
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "aa5016f3-1c6a-4978-a56d-3567c65c9610"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}