{
  "FormatVersion": 3,
  "Id": "d7e8318c-b5d2-4ca1-b228-bb70d6add820"/*ColorFromField*/,
  "Description": "Writes a corner Color attribute by sampling a ScalarField at each corner position, remapping from ValueRange and blending ColorA to ColorB.\n\nNote: the built-in mesh shaders don't display vertex colors yet.",
  "InputUis": [
    {
      "InputId": "7ff90229-3731-4a5f-adc3-2abab11d3d46"/*Geometry*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "5c50c45e-dbe4-4f2a-a1fa-863e3d8e2023"/*Field*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "aa992691-1a1c-4c52-9024-341812603d35"/*ColorA*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      }
    },
    {
      "InputId": "3f412276-cbc9-4b0d-a5a5-5a02ef1ac230"/*ColorB*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "a42f59fa-1d30-4d68-a350-00300f9726c8"/*ValueRange*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "d86945c8-9889-4102-9632-e6dda2dc0e20"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}
