{
  "FormatVersion": 3,
  "Id": "b6e3f8d1-4a27-4c95-9d0e-7f2c5a1b8e63"/*CurvesToGeometry*/,
  "Description": "Fills closed curves into solid geometry and optionally extrudes them with a bevel - the way from [TextToCurves] to solid 3D text. The result is CPU geometry, so put [GeometryToMesh] after it to draw it.

Depth 0 gives a flat fill; with Depth, front and back caps are joined by walls, and Bevel rounds (or with BevelSegments 1 chamfers) the edges. Overlapping and nested contours are resolved by the fill rule (non-zero by default, EvenOdd as option), so variable-font overlaps disappear. One mesh part per curve part (glyph), with the curve's part attributes carried over for [ColorFacesFromAttribute] and [GeometryToMeshChunks]; the face attribute IsSide marks walls and bevels. Walls and bevels are smooth shaded along round outlines and hard at corners sharper than SmoothAngle; FlatShading makes every wall and bevel facet flat. Weight offsets the outline outwards (negative: inwards) for a faux bold or light look; it thickens stems and shrinks counters, so it stays convincing only for small amounts. Tolerance is the flattening precision. Keep Bevel below half of the thinnest stroke: a larger bevel folds the inset outline over itself and opens the surface.

AKA: extrude text, 3d text, fill curves, tessellate, curves to mesh",
  "InputUis": [
    { "InputId": "4a7e2c9f-6d15-4b83-a0e6-9c3f8b1d5e27"/*Curves*/, "Relevancy": "Required", "Position": { "X": 0.0, "Y": 0.0 } },
    { "InputId": "c1f5b8e3-2a94-4d67-8e0b-7d3a9f6c2b14"/*Depth*/, "Position": { "X": 0.0, "Y": 45.0 } },
    { "InputId": "9e3a7d1c-5b48-4f26-b9c0-1a6e4d8f3c72"/*Bevel*/, "Position": { "X": 0.0, "Y": 90.0 } },
    { "InputId": "2b8d5f7a-e319-4c60-a5d8-6f0c3e9a1b48"/*BevelSegments*/, "Position": { "X": 0.0, "Y": 135.0 } },
    { "InputId": "5c0e9b3d-7a41-4f28-b6d3-2e8f1a4c7d95"/*Weight*/, "Position": { "X": 0.0, "Y": 157.0 }, "Scale": 0.01 },
    { "InputId": "8d4b2e6f-1c93-4a57-9f0e-6b3d5c8a2e41"/*FlatShading*/, "Position": { "X": 0.0, "Y": 165.0 } },
    { "InputId": "1f7a3c5e-9b62-4d18-a4c7-3e0f8b6d2a59"/*SmoothAngle*/, "Position": { "X": 0.0, "Y": 170.0 }, "Min": 0.0, "Max": 180.0, "Clamp": true },
    { "InputId": "7d4c1a9e-8f52-4b37-9e6a-3c1b5d7f2a80"/*Tolerance*/, "Position": { "X": 0.0, "Y": 180.0 } },
    { "InputId": "e5b2d8c4-1a76-4f93-b0d5-8c4e7a2f9b16"/*Front*/, "Position": { "X": 0.0, "Y": 225.0 } },
    { "InputId": "3f9c6e2b-d485-4a10-8b7e-5d2a1c8f4e63"/*Back*/, "Position": { "X": 0.0, "Y": 270.0 } },
    { "InputId": "a8e1c4f7-2b93-4d58-9a6c-0e5d3b7f1c29"/*Sides*/, "Position": { "X": 0.0, "Y": 315.0 } },
    { "InputId": "6c2f9b5e-7d31-4a84-b1e0-4f8c2a6d9e75"/*EvenOdd*/, "Position": { "X": 0.0, "Y": 360.0 } }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    { "OutputId": "1c9a5e7d-3b62-4f08-a4d1-8e6b0c2f7a95"/*Result*/, "Position": { "X": 300.0, "Y": 0.0 } }
  ]
}
