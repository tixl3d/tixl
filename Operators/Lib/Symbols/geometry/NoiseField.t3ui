{
  "FormatVersion": 3,
  "Id": "b3e267ad-4c71-45e9-9a05-e9e1d3f6c882"/*NoiseField*/,
  "Description": "A ScalarField of 3D gradient noise sampled at the field position.\n\nOctaves are summed as fBm and normalized, so values stay roughly within -Amplitude..Amplitude, centered at zero. Use [RemapFieldValues] with a [GainAndBiasCurve] to shape the result.\n\nAKA: perlin, fbm, turbulence",
  "InputUis": [
    {
      "InputId": "c5f19a44-8b0e-4d63-a7d8-2f6b3e9c0a51"/*Frequency*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "e8a2d1b7-3c94-4f28-b6e0-9d5c7a41f382"/*Octaves*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "1b6e4f92-a8d3-45c7-9e21-c4b8d0f7a635"/*Amplitude*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      }
    },
    {
      "InputId": "9f3c8e15-d762-4b09-a4f8-6e1a2c5d9b74"/*Offset*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "4d91b7c3-6f28-4e5a-8c07-b3f9e6a1d258"/*Seed*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "7d7af99a-05cc-4e5d-9b12-3e2b8f6a1c47"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}
