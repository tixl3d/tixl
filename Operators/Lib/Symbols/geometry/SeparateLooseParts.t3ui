{
  "FormatVersion": 3,
  "Id": "ec6f1a69-9d76-4a46-a7a7-2248989ec386"/*SeparateLooseParts*/,
  "Description": "- Splits a Geometry into separate parts based on connected components (loose parts)\n- Sets the pivot of each new part to its volume centroid.\n\nWorks very well with [GeometryToMeshChunks]",
  "InputUis": [
    {
      "InputId": "52e9e7cb-c0e3-430c-b182-a5ea2e9c0270"/*Geometry*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "5fbce231-efe4-4c19-957d-72b996f133ad"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 200.0
      }
    },
    {
      "OutputId": "417e4ff5-71aa-4ab8-aa0c-a379ffc3fac4"/*PartCount*/,
      "Position": {
        "X": 300.0,
        "Y": 300.0
      }
    }
  ]
}