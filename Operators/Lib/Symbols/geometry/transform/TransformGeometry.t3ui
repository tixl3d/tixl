{
  "FormatVersion": 3,
  "Id": "634da8e3-0772-4f5a-816b-35b492e50938"/*TransformGeometry*/,
  "Description": "Scales, rotates and translates geometry, as a whole or each point in its own orientation.\n\nIn Object space the geometry is transformed around the origin. In Point space every point is transformed in its own orientation, so translating along Y moves points across an outline and rotating turns their curve handles. A selection attribute weights the transform per point for partial or soft edits.\n\nEvery attribute follows its type: positions like points, vectors such as curve handles by rotation and scale, normals corrected for non-uniform scale, orientations by rotation. Topology and other attributes are passed through.\n\nTips\n- [SubdivideCurves] → [SelectGeometry] (Every 2) → TransformGeometry (Point space, Translation Y) turns an outline into a zigzag.",
  "InputUis": [
    {
      "InputId": "3497c025-efaf-4191-8621-ade40d377ee9"/*Translation*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "80aa5810-3fbd-4d95-96d1-72647d8af302"/*Scale*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "85c720c4-8d9e-46a8-aae7-eb77fc581d3a"/*Selection*/,
      "Position": {
        "X": 0.0,
        "Y": 270.0
      },
      "Description": "Name of a float selection attribute whose weight blends the transform per point; vertex, primitive and part selections apply to their points. Empty uses the Selection from an upstream [SelectGeometry] if there is one, and otherwise transforms everything. <All> ignores any selection.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "86c1f762-9d7d-4f9c-bfb3-fc0d75bedf03"/*Space*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Description": "Object transforms the geometry as a whole around the origin. Point transforms every point in its own orientation: X along its curve, Z along the curve's or surface's normal, Y across, or an Orientation point attribute. Translating along Y in point space moves points across an outline."
    },
    {
      "InputId": "90343fe1-bee7-4ec5-a29d-c44b68a3a37c"/*Geometry*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "a3096995-909c-42f4-9519-99b25f1c330e"/*UniformScale*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Multiplies Scale."
    },
    {
      "InputId": "b478cdd9-14c5-486b-be7b-4c70bd8f667c"/*Rotation*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Rotation in degrees around X, Y and Z.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "895d2fd4-c40f-4200-89af-395253275b0a"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}