{
  "FormatVersion": 3,
  "Id": "dbaeebea-8d46-416f-9624-867af10d9c07"/*BevelGeometry*/,
  "Description": "Bevels the edges of a geometry: faces are inset, edges become rounded profile strips, vertices become corner patches.\n\nEdges between faces that meet at less than FlatAngle are skipped: those faces are merged into one polygon first and points on straight edges are dropped, which keeps the polygon count low on fractured or triangulated input without changing its look. Method decides how short edges and thin faces limit the width. Works on polygons; curve primitives pass through unchanged and come after all parts.\n\nAKA: chamfer, round edges, fillet",
  "InputUis": [
    {
      "InputId": "091c932c-a7bb-487e-97c5-093e9838a700"/*Roundness*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Blends the profile between a straight chamfer (0) and a circular arc (1)."
    },
    {
      "InputId": "3f8b1c4d-92e6-4a17-b5d0-6a4c8e2f7d19"/*RoundCorners*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Description": "Builds rounded patches at the vertices instead of flat fans. Needs more than one segment."
    },
    {
      "InputId": "46a2c9e2-7b5d-45ce-9955-b1c0b1bb01db"/*Geometry*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "5c23fb6d-c4c7-4256-a2d4-3ddd76aed6e4"/*Method*/,
      "Position": {
        "X": 0.0,
        "Y": 315.0
      },
      "Description": "Fast limits the width per point: a corner uses at most about half of each adjacent edge, so a short edge only narrows the bevel around it. Straight Skeleton shrinks each face and removes edges that shrink to nothing, so the bevel keeps its full width past short edges; slower, and concave faces stop short where a corner would split them.",
      "DisplayAs": "SegmentedSwitch"
    },
    {
      "InputId": "88b2db34-b099-4fa6-8875-743dc40fd367"/*FlatAngle*/,
      "Position": {
        "X": 0.0,
        "Y": 360.0
      },
      "Min": 0.0,
      "Max": 10.0,
      "Description": "Faces meeting at less than this angle (degrees) are merged and their shared edge gets no bevel. 0 bevels every edge."
    },
    {
      "InputId": "8d5c2a97-40e1-4b68-93fd-6b0e8c4a2d75"/*Async*/,
      "Position": {
        "X": 0.0,
        "Y": 270.0
      },
      "Description": "Computes the result on a background thread. The previous result stays visible until the new one is ready."
    },
    {
      "InputId": "c86a32c2-feeb-4c05-b2c0-cf54076247bb"/*FlatShading*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Uses flat normals for every bevel facet."
    },
    {
      "InputId": "ce40061f-b853-41be-bbef-0db172bbad7f"/*Width*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Bevel width in world units. Narrowed locally where edges are short or faces are thin, see Method."
    },
    {
      "InputId": "e9085eac-dc15-4ecf-862d-869e66981418"/*Segments*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Number of segments of the bevel profile, clamped to 1..16."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "48342188-0139-4ea4-943d-a5b5d59b7a4a"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}