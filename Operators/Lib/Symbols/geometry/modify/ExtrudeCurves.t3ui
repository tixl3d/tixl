{
  "FormatVersion": 3,
  "Id": "b6e3f8d1-4a27-4c95-9d0e-7f2c5a1b8e63"/*ExtrudeCurves*/,
  "Description": "Fills closed curves into solid geometry and optionally extrudes them with a bevel - the way from [StringToCurves] to solid 3D text. The result is CPU geometry, so put [GeometryToMesh] after it to draw it.\n\nDepth 0 gives a flat fill; with Depth, front and back caps are joined by walls, and Bevel rounds (or with BevelSegments 1 chamfers) the edges. Overlapping and nested contours are resolved by the fill rule (non-zero by default, EvenOdd as option), so variable-font overlaps disappear. One part per input part (glyph), with the input's part attributes carried over for [ColorFacesFromAttribute] and [GeometryToMeshChunks]; the primitive attribute IsSide marks walls and bevels. Point attributes of the curves (a selection, colors, your own) carry over too: outline points take the value at their place on the curve, lattice points inside the caps blend between the outlines to their left and right, so a selection made on the curves can bend the extruded letters with [TransformGeometry]. Walls get their curve's primitive attributes. KeepCurves leaves the source curves in each part. Walls and bevels are smooth shaded along round outlines and hard at corners sharper than SmoothAngle; FlatShading makes every wall and bevel facet flat. Weight offsets the outline outwards (negative: inwards) for a faux bold or light look; it thickens stems and shrinks counters, so it stays convincing only for small amounts. Tolerance is the flattening precision. Keep Bevel below half of the thinnest stroke: a larger bevel folds the inset outline over itself and opens the surface.\n\nAKA: CurvesToGeometry, extrude text, 3d text, fill curves, tessellate, curves to mesh",
  "InputUis": [
    {
      "InputId": "1f7a3c5e-9b62-4d18-a4c7-3e0f8b6d2a59"/*SmoothAngle*/,
      "Position": {
        "X": 0.0,
        "Y": 170.0
      },
      "Description": "Corners sharper than this angle (degrees) are shaded hard.",
      "Min": 0.0,
      "Max": 180.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "2b8d5f7a-e319-4c60-a5d8-6f0c3e9a1b48"/*BevelSegments*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Number of bevel segments, clamped to 1..16. 1 gives a chamfer."
    },
    {
      "InputId": "3f9c6e2b-d485-4a10-8b7e-5d2a1c8f4e63"/*Back*/,
      "Position": {
        "X": 0.0,
        "Y": 270.0
      },
      "Description": "Generates the back cap."
    },
    {
      "InputId": "4a7e2c9f-6d15-4b83-a0e6-9c3f8b1d5e27"/*Curves*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "532a6559-788f-44f4-ba03-7ce2b3e7561d"/*KeepCurves*/,
      "Position": {
        "X": 0.0,
        "Y": 405.0
      },
      "Description": "Keeps the source curves in each part, after its polygons, as a sketch stays beside the body it was extruded from."
    },
    {
      "InputId": "5c0e9b3d-7a41-4f28-b6d3-2e8f1a4c7d95"/*Weight*/,
      "Position": {
        "X": 0.0,
        "Y": 157.0
      },
      "Description": "Offsets the outline outwards (positive) or inwards (negative) for a bolder or lighter look.",
      "Scale": 0.01
    },
    {
      "InputId": "5c7feaba-714e-4134-bc65-e8438ef6839d"/*DepthAttribute*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "Optional float attribute that scales Depth per part, e.g. Depth written per letter by [CustomGeometryAttribute] for a depth wave across a text. A primitive or point attribute uses the part's largest value; a missing one leaves Depth as it is.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "6c2f9b5e-7d31-4a84-b1e0-4f8c2a6d9e75"/*EvenOdd*/,
      "Position": {
        "X": 0.0,
        "Y": 360.0
      },
      "Description": "Uses the even-odd fill rule instead of non-zero."
    },
    {
      "InputId": "7d4c1a9e-8f52-4b37-9e6a-3c1b5d7f2a80"/*Tolerance*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Maximum deviation when flattening the curves into polygons. Smaller values give smoother outlines and more faces."
    },
    {
      "InputId": "8d4b2e6f-1c93-4a57-9f0e-6b3d5c8a2e41"/*FlatShading*/,
      "Position": {
        "X": 0.0,
        "Y": 165.0
      },
      "Description": "Uses flat normals for all walls and bevels."
    },
    {
      "InputId": "9bf01fa0-e722-4caa-9130-18578a0db485"/*Lattice*/,
      "Position": {
        "X": 0.0,
        "Y": 450.0
      },
      "Min": 0.0,
      "Max": 0.2,
      "Description": "Cell size of a grid that splits the flat caps into regular quads (0: off), so [SubdivideGeometry] and deformers don't produce long thin triangles. Where the outline crosses a grid line it gets a point, unless a corner is within a tenth of a cell. Not combined with a bevel."
    },
    {
      "InputId": "9e3a7d1c-5b48-4f26-b9c0-1a6e4d8f3c72"/*Bevel*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Size of the bevel at the front and back edges. Keep it below half of the thinnest stroke."
    },
    {
      "InputId": "a8e1c4f7-2b93-4d58-9a6c-0e5d3b7f1c29"/*Sides*/,
      "Position": {
        "X": 0.0,
        "Y": 315.0
      },
      "Description": "Generates the walls and bevels. Only used with Depth > 0."
    },
    {
      "InputId": "c1f5b8e3-2a94-4d67-8e0b-7d3a9f6c2b14"/*Depth*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Extrusion depth. 0 gives a flat fill."
    },
    {
      "InputId": "e5b2d8c4-1a76-4f93-b0d5-8c4e7a2f9b16"/*Front*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Description": "Generates the front cap."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "1c9a5e7d-3b62-4f08-a4d1-8e6b0c2f7a95"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}