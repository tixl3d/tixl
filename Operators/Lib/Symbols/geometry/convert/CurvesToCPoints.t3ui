{
  "FormatVersion": 3,
  "Id": "6a1d8c3f-2b57-4e90-a4f6-c8e2d5b7f019"/*CurvesToCPoints*/,
  "Description": "Flattens curves into a CPU point list, one polyline per contour, separated by separator points.\n\nThis is the bridge from curve geometry to the CPoints ops, e.g. [TransformCPoints] or [RepeatAtCPoints]; upload the result with [UploadToGpu]. To draw the curves directly, use [CurvesToPoints], which outputs GPU points. Tolerance is the maximum distance between the polyline and the true curve. A Color attribute on the part or contour domain lands in the point color; By default F1 is 1 and F2 carries the part index; Set F1 To and Set F2 To can fill them with an index, the normalized position along the curve or a float or int attribute instead, e.g. the SliceIndex of [SliceGeometryToCurves]. Each point is rotated so its Z axis points away from the filled area (holes point inward), its Y axis along the curve plane's normal and its X axis along the contour, ready for [DrawRibbons], oriented sprites or instancing. CloseLoops repeats the first point of closed contours so line strips close.\n\nAKA: flatten curves, curve to line, outline points, CurvesToPoints",
  "InputUis": [
    {
      "InputId": "246c6a25-be64-4d99-8452-b0fd9ac66f2f"/*SharpAngle*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Description": "For PolygonEdges Sharp: faces meeting at a larger angle (degrees) get their shared edge drawn.",
      "Min": 0.0,
      "Max": 90.0
    },
    {
      "InputId": "3562289a-5c5f-4229-8e2d-46304b460017"/*SetF2To*/,
      "Position": {
        "X": 0.0,
        "Y": 315.0
      },
      "Description": "What F2 of each point gets. <Default> keeps the part index (the curve index without parts). The other options work as for Set F1 To.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "4e9a6c1b-d872-4f35-b0e8-7a2d5f9c3e61"/*Tolerance*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Maximum distance between the polyline and the true curve. Smaller values give more points."
    },
    {
      "InputId": "91c96818-ba39-4cec-af54-ae005c8610a5"/*PolygonEdges*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Also outputs the edges of polygons as two-point lines, after the curves: All for every edge, Sharp only for open borders and edges whose faces meet at more than SharpAngle, e.g. the outline of extruded text without the lines across its caps."
    },
    {
      "InputId": "b7f2d9c4-5a13-4e86-9d0b-3c6e8a1f5d27"/*Curves*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "c03fec01-bbc9-4d95-a5d4-9f1a0d7abe1f"/*SetF1To*/,
      "Position": {
        "X": 0.0,
        "Y": 270.0
      },
      "GroupTitle": "Point Fields",
      "Description": "What F1 of each point gets. <Default> keeps 1. <Index> counts the points along each curve, <NormalizedIndex> runs from 0 to 1 by point count and <NormalizedLength> from 0 to 1 by distance along the curve, e.g. to taper lines in [DrawLines]. <CurveIndex> and <PartIndex> number the curves and parts. Any float or int attribute can be picked too: point and vertex values are interpolated along the curve, primitive and part values fill the whole curve.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "d2c8e5a3-1f64-4b97-8e3a-c5b0d7f4a916"/*CloseLoops*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Repeats the first point of closed contours so line strips are closed."
    },
    {
      "InputId": "f9897a6d-acb2-4291-a3e0-aa2fee90cfd7"/*Sampling*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Flattened samples each curve into a polyline for drawing lines. Points emits only the curves' own points, without separators, e.g. to mark or instance on them. AllPoints outputs every point of the geometry once, also points without primitives, e.g. a selection of points.",
      "DisplayAs": "SegmentedSwitch"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "e3c5a7f1-9d24-4b68-8f0e-a1b3c6d9e274"/*Points*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}