{
  "FormatVersion": 3,
  "Id": "d955fd1d-af90-480b-b4e6-9142a1daf0a9"/*CurvesToPoints*/,
  "Description": "Flattens curves into GPU points for drawing lines, one polyline per contour, separated by separator points.\n\nFeed it to [DrawLines], [DrawPoints] or any other point op. It samples like [CurvesToCPoints], which outputs a CPU list instead, and uploads the result like [UploadToGpu]. Tolerance is the maximum distance between the polyline and the true curve. A Color attribute on the part or contour domain lands in the point color; F2 carries the part index. Each point is rotated so its Z axis points away from the filled area (holes point inward), its Y axis along the curve plane's normal and its X axis along the contour, ready for [DrawRibbons], oriented sprites or instancing. CloseLoops repeats the first point of closed contours so line strips close.\n\nAKA: flatten curves, curve to line, outline points, curves to gpu",
  "InputUis": [
    {
      "InputId": "126f23f9-158b-468f-ba25-dd55c665a63c"/*Curves*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "682bab73-6b13-4f0d-9162-a464b1889b56"/*Tolerance*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Maximum distance between the polyline and the true curve. Smaller values give more points."
    },
    {
      "InputId": "b766fe96-2b4b-4a9e-b8e8-f3ba646970fe"/*CloseLoops*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Repeats the first point of closed contours so line strips are closed."
    },
    {
      "InputId": "bbbca9ff-7678-4549-82e0-aa2a988b49de"/*PolygonEdges*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Also outputs the edges of polygons as two-point lines, after the curves: All for every edge, Sharp only for open borders and edges whose faces meet at more than SharpAngle, e.g. the outline of extruded text without the lines across its caps."
    },
    {
      "InputId": "d6da84fa-512f-480f-b6db-8bf777f5a3b2"/*Sampling*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Flattened samples each curve into a polyline for drawing lines. Points emits only the curves' own points, without separators, e.g. to mark or instance on them. AllPoints outputs every point of the geometry once, also points without primitives, e.g. a selection of points.",
      "DisplayAs": "SegmentedSwitch"
    },
    {
      "InputId": "f48316ce-a09a-4599-8d60-3fe0fcf24bfe"/*SharpAngle*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Description": "For PolygonEdges Sharp: faces meeting at a larger angle (degrees) get their shared edge drawn.",
      "Min": 0.0,
      "Max": 90.0
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "8c437c4a-72a2-4f86-a7e0-ef8003851bd2"/*OutBuffer*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}