{
  "FormatVersion": 3,
  "Id": "6a1d8c3f-2b57-4e90-a4f6-c8e2d5b7f019"/*CurvesToPoints*/,
  "Description": "Flattens curves into a CPU point list, one polyline per contour, separated by separator points.\n\nThis is the bridge from curve geometry to every line and point op ([DrawLines], [ListToBuffer], the CPoints family). Tolerance is the maximum distance between the polyline and the true curve. A Color attribute on the part or contour domain lands in the point color; F2 carries the part index. Each point is rotated so its Z axis points away from the filled area (holes point inward), its Y axis along the curve plane's normal and its X axis along the contour, ready for [DrawRibbons], oriented sprites or instancing. CloseLoops repeats the first point of closed contours so line strips close.\n\nAKA: flatten curves, curve to line, outline points",
  "InputUis": [
    {
      "InputId": "246c6a25-be64-4d99-8452-b0fd9ac66f2f"/*SharpAngle*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Min": 0.0,
      "Max": 90.0,
      "Description": "For PolygonEdges Sharp: faces meeting at a larger angle (degrees) get their shared edge drawn."
    },
    {
      "InputId": "4e9a6c1b-d872-4f35-b0e8-7a2d5f9c3e61"/*Tolerance*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Maximum distance between the polyline and the true curve. Smaller values give more points."
    },
    {
      "InputId": "91c96818-ba39-4cec-af54-ae005c8610a5"/*PolygonEdges*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Also outputs the edges of polygons as two-point lines, after the curves: All for every edge, Sharp only for open borders and edges whose faces meet at more than SharpAngle, e.g. the outline of extruded text without the lines across its caps."
    },
    {
      "InputId": "b7f2d9c4-5a13-4e86-9d0b-3c6e8a1f5d27"/*Curves*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "d2c8e5a3-1f64-4b97-8e3a-c5b0d7f4a916"/*CloseLoops*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Repeats the first point of closed contours so line strips are closed."
    },
    {
      "InputId": "f9897a6d-acb2-4291-a3e0-aa2fee90cfd7"/*Sampling*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Flattened samples each curve into a polyline for drawing lines. Points emits only the curves' own points, without separators, e.g. to mark or instance on them. AllPoints outputs every point of the geometry once, also points without primitives, e.g. a selection of points.",
      "DisplayAs": "SegmentedSwitch"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "e3c5a7f1-9d24-4b68-8f0e-a1b3c6d9e274"/*Points*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}