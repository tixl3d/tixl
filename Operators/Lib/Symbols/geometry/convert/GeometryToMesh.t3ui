{
  "FormatVersion": 3,
  "Id": "4fea8c0e-cb7f-41fe-a410-df1d3886bf98"/*GeometryToMesh*/,
  "Description": "Compiles CPU-side procedural geometry into GPU mesh buffers for rendering with [DrawMesh].\n\nTriangulates N-gon faces, resolves corner attributes (normals, UVs, colors) into packed vertices, and computes the tangent basis. Closed curves, e.g. text from [StringToCurves], are filled flat and drawn as well (FillCurves); parts that already have polygons, like extruded text that kept its curves, aren't filled again. Buffers are reused and only re-uploaded when the input geometry changes.",
  "InputUis": [
    {
      "InputId": "57469ea6-f0c5-4e8d-a53c-40e8ac495bc3"/*Geometry*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "Geometry whose polygons are compiled. Closed curves are filled flat with FillCurves; open curves are ignored."
    },
    {
      "InputId": "94d5cf91-080f-44f4-9c8c-80a81ebd88f6"/*FillCurves*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Fills closed curves flat and draws them with the polygons, e.g. text from [StringToCurves] without an extrusion. Turn off to draw only polygons; for control over the fill use [FillCurves]."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "4bf00eb5-a39c-4567-a81e-46c2276d1418"/*Buffers*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}