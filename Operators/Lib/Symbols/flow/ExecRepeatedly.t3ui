{
  "FormatVersion": 3,
  "Id": "46420979-1e56-4de3-a6ca-0447be1b9813"/*ExecRepeatedly*/,
  "Description": "Controls how often the connected subgraph is executed per frame.\n\nThe subgraph is executed RepeatCount times, but only every SkipFrameCount+1 evaluations. This can be useful for speeding up or slowing down simulations.\n\nSee also: [Loop], [Execute]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "4ca4cf19-975e-479a-bd43-c49c96ce51b6"/*SkipFrameCount*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Number of evaluations to skip between executions. 0 executes every frame."
    },
    {
      "InputId": "d9de54b8-6d05-4cad-a1eb-bfa770a4520d"/*Command*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "fb4c2356-5fa9-4beb-a909-805323d5f7c1"/*RepeatCount*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Number of executions per update, clamped to 0..100. 0 disables execution."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "5008c453-89ae-456b-9468-917abcb0af2e"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}