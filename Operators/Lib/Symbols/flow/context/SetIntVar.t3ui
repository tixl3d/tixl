        "X": -200.0,
        "Y": 90.0
      },
      "Description": "None: no logging.\nWarnings: warns about an empty variable name.\nChanges: logs when a previous value is overridden.\nAllUpdates: also logs newly set variables.",
      "AddPadding": "True"
    },
    {
