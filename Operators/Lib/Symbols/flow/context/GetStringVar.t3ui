{
  "FormatVersion": 3,
  "Id": "15012739-97b0-49e6-8bdc-cd45cd262560"/*GetStringVar*/,
  "Description": "Reads a string variable from the evaluation context.\n\nThe variable has to be set further right in the graph with [SetStringVar]. If it is not defined, FallbackDefault is returned.\n\nSee also: [SetStringVar]",
  "InputUis": [
    {
      "InputId": "d19b0483-cdd4-4684-852d-ef5ee8393dfc"/*VariableName*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Name of the context variable. The dropdown lists variables currently defined in the context.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "fafdbd5d-ec66-4210-beab-6b9ac010191c"/*FallbackDefault*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Returned if the variable is not defined in the current context.",
      "Usage": "Default"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "1a3ed40a-655b-4604-868d-1f037f7306c7"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}