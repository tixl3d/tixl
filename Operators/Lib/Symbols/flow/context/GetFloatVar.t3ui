{
  "FormatVersion": 3,
  "Id": "e6072ecf-30d2-4c52-afa1-3b195d61617b"/*GetFloatVar*/,
  "Description": "Reads a float variable from the evaluation context.\n\nThe variable has to be set further right in the graph with [SetFloatVar] or [Loop]. If it is not defined, FallbackDefault is returned.\n\nTips:\n- With [Loop], the normalized progress variable is \"f\" and the index is \"i\" by default.\n\nSee also: [SetFloatVar], [GetIntVar]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "015d1ea0-ea51-4038-893a-4af2f8584631"/*VariableName*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Name of the context variable. The dropdown lists variables currently defined in the context.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "ae76829b-d17d-4443-9cf1-63e3c44b90c8"/*FallbackDefault*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Returned if the variable is not defined in the current context."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "e368ba33-827e-4e08-aa19-ba894b40906a"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}