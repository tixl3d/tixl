{
  "FormatVersion": 3,
  "Id": "3631c727-36a0-4f26-ae76-ee9c100efc33"/*Loop*/,
  "Description": "Executes the subgraph multiple times. This can be useful for iterating a drawing function.\n\nFor each iteration the index (as int and float) and a normalized progress (0..1) are written to context variables that can be read with [GetIntVar] and [GetFloatVar].\n\nEach iteration creates its own draw calls and invalidates the subgraph, so this is not meant for loop counts exceeding 1000 or more. For many instances, point-based instancing is far more efficient.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "1f6e2adb-cff8-4dc4-9cb4-a26e3ad8b087"/*Count*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "GroupTitle": "Settings"
    },
    {
      "InputId": "49552a0c-2060-4f03-ad39-388293bb6871"/*Command*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "cde7dd76-0356-48b1-9082-00828c0af386"/*ProgressVariable*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Name of the float variable holding the normalized progress from 0 to 1. Default is \"f\".",
      "Usage": "Default"
    },
    {
      "InputId": "f9aebe04-dd82-459f-8175-7139c7b2e468"/*IndexVariable*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Name of the int and float variable holding the iteration index. Default is \"i\".",
      "AddPadding": "True",
      "Usage": "Default"
    }
  ],
