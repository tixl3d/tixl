{
  "FormatVersion": 3,
  "Id": "98bd1491-6e69-4ae0-9fc1-0be8e6a72d32"/*BlendStrings*/,
  "Description": "Blends between connected strings with a scrambling animation similar to an airport flight display board.\n\nEach character rolls through the Characters set from the character of one string to the next. Line breaks are kept.\n\nSee also: [BuildRandomString], [AnimRandomString]",
  "SymbolTags": "9",
  "InputUis": [
    {
      "InputId": "2efd4a0c-958c-49f6-86cb-f8d9fd6fb308"/*Blend*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "GroupTitle": "Blend Settings",
      "Description": "Float index into the connected strings. 1.5 blends halfway between the second and third string."
    },
    {
      "InputId": "3197934e-d0ed-4a81-9dc1-2cc63d97ac6f"/*InputTextA*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "GroupTitle": "String A",
      "Description": "Not used.",
      "Usage": "Multiline"
    },
    {
      "InputId": "48de52f6-9b8d-4c12-9336-40091824be43"/*Characters*/,
      "Position": {
        "X": 0.0,
        "Y": 345.0
      },
      "Description": "Ordered set of characters to roll through. Characters not in the set are treated as the first one. Empty uses a default set of letters, digits and symbols.",
      "Usage": "Default"
    },
    {
      "InputId": "c3e0cde4-fecf-4802-a287-a173a6a12518"/*BlendSpread*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "How much the transition is spread across the characters from left to right."
    },
    {
      "InputId": "ccc21ecc-2877-4fe7-8d78-f7e2a708d762"/*InputTextB*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "GroupTitle": "String B",
      "Description": "Not used.",
      "Usage": "Multiline"
    },
    {
      "InputId": "d70da276-c047-42db-a921-5c1263613cbb"/*MaxLength*/,
      "Position": {
        "X": 0.0,
        "Y": 270.0
      },
      "Description": "Maximum number of characters, clamped to 1..10000.",
      "AddPadding": "True"
    },
    {
      "InputId": "d95e112f-b89a-4aa1-954b-10521c0a3815"/*ScrambleSeed*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      }
    },
    {
      "InputId": "dc4e5b79-53e5-463a-92ad-d9bb1f2b0495"/*Scramble*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Fraction (0..1) of characters that get a random offset during the transition.",
      "AddPadding": "True"
    },
    {
      "InputId": "eb2d968d-0ce0-48f1-a014-29475a3f0b04"/*InputStrings*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Strings to blend between. Blend selects the position within this list.",
      "Usage": "Default"
    }
  ],
