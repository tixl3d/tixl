{
  "FormatVersion": 3,
  "Id": "7b21f10b-3548-4a23-95df-360addaeb03d"/*BuildRandomString*/,
  "Description": "Builds up a string by repeatedly inserting or overwriting text, producing a wide selection of text writer effects.\n\nOn each frame with Insert enabled, InsertString and Separator are written at the current position, which then advances. This can be driven by audio reactions or triggers.\n\nTips:\n- Connect [MockStrings] or [PickStringPart] to InsertString for interesting results.\n\nSee also: [BlendStrings], [StringBuilderToString]",
  "SymbolTags": "72",
  "InputUis": [
    {
      "InputId": "095202bf-118f-4c4c-802e-7916bc290a60"/*Insert*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Writes InsertString on every update while true."
    },
    {
      "InputId": "1559c0e9-ba56-447f-8241-03d8d59ac205"/*OverwriteOffset*/,
      "Position": {
        "X": -200.0,
        "Y": 270.0
      },
      "Description": "Position step per insertion in OverwriteAtFixedOffset mode."
    },
    {
      "InputId": "38ce7f47-c117-47a2-aeea-609716c60555"/*MaxLength*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Maximum length of the result. 0 or less returns an empty string."
    },
    {
      "InputId": "3ea4f12e-7184-45bc-a523-ef6a2e1c5c3d"/*ScrambleSeed*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      }
    },
    {
      "InputId": "77a5604a-034a-4352-bd46-be3cb57f90b7"/*Clear*/,
      "Position": {
        "X": -200.0,
        "Y": 405.0
      },
      "Description": "Clears the string while true.",
      "AddPadding": "True"
    },
    {
      "InputId": "7dabd7c8-5c2b-4be2-b1b6-bf8b8fcbfd8d"/*ScrambleRatio*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Fraction (0..1) of characters that get scrambled per update.",
      "AddPadding": "True"
    },
    {
      "InputId": "875cbfa9-ffa8-4204-810c-c04f5f421441"/*WrapLines*/,
      "Position": {
        "X": -200.0,
        "Y": 360.0
      },
      "Description": "DontWrap, WrapAtWords, WrapAtCharacters, WrapToFillBlock or SolidBlock.",
      "AddPadding": "True"
    },
    {
      "InputId": "8eee8067-1a4e-4372-93d0-2dbc368aa45a"/*Separator*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "Appended after each insertion. Use \"\\n\" for line breaks.",
      "Usage": "Default"
    },
    {
      "InputId": "9253b148-325b-427a-819e-1ae1b1019ade"/*Scramble*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "Enables scrambling of existing characters."
    },
    {
      "InputId": "960179bd-286f-4629-bbcb-cd31aa9c9ae2"/*InsertString*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "GroupTitle": "Settings",
      "Description": "Text written at the current position.",
      "Usage": "Default"
    },
    {
      "InputId": "bd941c4b-18a8-4687-85a8-3fe53b4f6213"/*WrapLineColumn*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Line length for wrapping, clamped to 1..1000."
    },
    {
      "InputId": "ccfac8a9-0954-4869-a47c-b66c714f6545"/*OverrideBuilder*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Optional external string builder to write into instead of the internal one.",
      "AddPadding": "True"
    },
    {
      "InputId": "ce436e27-05a5-431d-9aa2-920dbff639a7"/*WriteMode*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Insert: inserts at the current position.\nOverwrite: overwrites existing characters.\nOverwriteAtFixedOffset: overwrites and advances the position by OverwriteOffset."
    },
    {
      "InputId": "f977faaf-1840-4a75-9bc5-43176f2e88e9"/*JumpToRandomPos*/,
      "Position": {
        "X": -200.0,
        "Y": 315.0
      },
      "Description": "Moves the write position to a random location before each insertion."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
