{
  "FormatVersion": 3,
  "Id": "dd3d7e16-f33e-4fb0-89c6-4d8cbc9d702f"/*LoadObjEdges*/,
  "Description": "Loads a Wavefront .obj file and outputs its unique edges as a point list for line rendering.\n\nEach edge becomes two points followed by a separator, so the list can be drawn as individual line segments, e.g. [LoadObjEdges] -> [ListToBuffer] -> [DrawLines]. Edges shared by several faces are only output once. Meshes with more than 65535 vertices are not supported.\n\nSee also: [LoadObj]",
  "SymbolTags": "72",
  "InputUis": [
    {
      "InputId": "b6932cbd-e6b6-447b-b416-701326227864"/*Path*/,
      "Position": {
        "X": 51.512096,
        "Y": 46.995968
      },
      "Usage": "FilePath"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "c0d0420d-84e6-4c57-8e88-d2b04db26b89"/*Data*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    }
  ]
}