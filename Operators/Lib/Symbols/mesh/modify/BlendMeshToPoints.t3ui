{
  "FormatVersion": 3,
  "Id": "109b1ca2-7b4c-4535-9cc6-8f176c4207dd"/*BlendMeshToPoints*/,
  "Description": "Blends the vertices of a mesh towards the positions, orientations and colors of a point buffer.\n\nUseful to deform a mesh with point operators: convert it with [MeshVerticesToPoints], modify the points and blend the mesh back to them. The results are predictable only if the point count matches the vertex count.\n\nSee also: [BlendMeshVertices], [MeshVerticesToPoints]",
  "SymbolTags": "64",
  "InputUis": [
    {
      "InputId": "09bd1214-a53c-4632-a64b-85476d74f44c"/*Points*/,
      "Position": {
        "X": -144.60248,
        "Y": 1341.071
      },
      "Description": "Target points, ideally one per vertex."
    },
    {
      "InputId": "0e54a6e8-07ac-45e1-9005-819a599e2b8a"/*BlendValue*/,
      "Position": {
        "X": 168.51639,
        "Y": 821.5459
      },
      "Description": "Blend factor between the mesh (0) and the points (1). For the RangeBlend modes it moves the transition along the vertex order.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "2d2c8c8b-a197-4834-b8da-7aa8f715b763"/*BlendMode*/,
      "Position": {
        "X": 28.516388,
        "Y": 856.5459
      },
      "GroupTitle": "Options",
      "Description": "Blend: uses BlendValue for all vertices.\nUseSelectedAsWeight: uses the vertex selection.\nUseF1AsWeight: uses 1 - F1 of the points.\nUseF2AsWeight: uses F2 of the points.\nRangeBlend: a linear transition moving along the vertex order.\nRangeBlendSmooth: a smooth transition along the vertex order that loops back and forth with BlendValue."
    },
    {
      "InputId": "4ed67387-8b51-4292-af31-0846b18389f4"/*Mesh*/,
      "Relevancy": "Required",
      "Position": {
        "X": -419.36392,
        "Y": 970.077
      }
    },
    {
      "InputId": "937f2e7a-87f8-4f87-87d0-729c3134c4bc"/*Pairing*/,
      "Position": {
        "X": 28.516388,
        "Y": 891.5459
      },
      "Description": "How vertices are paired if the counts differ.\n\nWrapAround: pairs by index.\nAdjust: pairs by relative position in the buffer, so both lists are spread over each other.",
      "AddPadding": "True"
    },
    {
      "InputId": "c5dba0b7-9911-440c-9945-0e5ab907c456"/*Scatter*/,
      "Position": {
        "X": 168.51639,
        "Y": 961.5459
      },
      "Description": "Adds random noise to the blend factor of each vertex during the transition.",
      "Scale": 0.01
    },
    {
      "InputId": "c7aa442e-6a67-40d3-92a7-981d59f5176e"/*RangeWidth*/,
      "Position": {
        "X": 168.51639,
        "Y": 926.5459
      },
      "Description": "Width of the transition zone for the RangeBlend modes, relative to the vertex count.",
      "Scale": 0.01
    }
  ],
