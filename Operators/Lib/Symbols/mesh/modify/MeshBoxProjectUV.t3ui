{
  "FormatVersion": 3,
  "Id": "19c9fafe-12c2-4c1d-a154-94af400a6140"/*MeshBoxProjectUV*/,
  "Description": "Overwrites the UV coordinates of a mesh with a box projection.\n\nEach vertex is projected onto the face of a projection box that its normal points to most, so walls, floors and ceilings all receive an undistorted texture. Faces are mapped as seen from outside the box, so the texture is never mirrored, and the +Z face matches [MeshProjectUV]. The box is transformed by the Translate, Rotate, Scale and Stretch settings.\n\nVertices shared between faces of different orientations get a single projection, which stretches the texture across those triangles. Use [SplitMeshVertices] before this operator to get clean seams.\n\nAKA: uv, box mapping, cube mapping, triplanar, three planar projection, box project\n\nSee also: [MeshProjectUV], [TransformMeshUVs], [SplitMeshVertices]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "2c9ff254-39d8-41b3-b9e9-2a9042a73dbd"/*Scale*/,
      "Position": {
        "X": -1598.1094,
        "Y": 1105.2872
      },
      "Description": "Uniformly scales the mapping",
      "AddPadding": "True"
    },
    {
      "InputId": "4c043452-332d-473c-9d1a-0bb56359d345"/*Stretch*/,
      "Position": {
        "X": -1600.9689,
        "Y": 1012.0342
      },
      "Description": "Scales the mapping of the individual axes"
    },
    {
      "InputId": "537cf376-1151-4802-b64c-2d3e918536e5"/*Mesh*/,
      "Position": {
        "X": -1609.5471,
        "Y": 308.72067
      }
    },
    {
      "InputId": "749851ce-e149-441d-be7c-8f66c1aa8869"/*Rotate*/,
      "Position": {
        "X": -1598.8242,
        "Y": 814.76904
      },
      "Description": "Rotates the projection plane in degrees."
    },
    {
      "InputId": "97cf607a-b83f-472d-ade0-767f8a79cdd9"/*ToTexCoord2*/,
      "Position": {
        "X": -1598.1094,
        "Y": 1180.2872
      },
      "Description": "Writes the projection to TexCoord2 instead of TexCoord.",
      "AddPadding": "True"
    },
    {
      "InputId": "faa8d4e0-8420-4907-b677-ebb3ed6ccc15"/*Translate*/,
      "Position": {
        "X": -1600.9688,
        "Y": 568.1786
      },
      "GroupTitle": "UV Settings",
      "Description": "Moves the position of the planar mapping"
    }
  ],
