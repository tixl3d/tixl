{
  "FormatVersion": 3,
  "Id": "a8fd7522-7874-4411-ad8d-b2e7a20bc4ac"/*DeformMesh*/,
  "Description": "Deforms a mesh with spherize, taper and twist effects.\n\nThe effects are applied in that order. Smooth results require a densely subdivided mesh, e.g. a [CubeMesh] with 64 segments per axis. Normals are not updated; use [RecomputeNormals] afterwards for correct shading.\n\nAKA: bend, spherify, twist, taper\n\nSee also: [TransformMesh], [DisplaceMesh]",
  "SymbolTags": "64",
  "InputUis": [
    {
      "InputId": "10d0502e-1a9d-4d8f-a516-2b2b465849bf"/*Taper*/,
      "Position": {
        "X": 406.76312,
        "Y": 1218.147
      },
      "GroupTitle": "Taper ",
      "Description": "Overall taper amount. The scale changes linearly with the distance along TaperAxis."
    },
    {
      "InputId": "161f293c-1d7f-4543-befe-0b4bd676483a"/*Radius*/,
      "Position": {
        "X": 406.76312,
        "Y": 1183.147
      },
      "Description": "Radius of the spherize target sphere."
    },
    {
      "InputId": "3af8bfb8-a2d8-4919-98f5-5431798d927a"/*UseVertexSelection*/,
      "Position": {
        "X": 266.76312,
        "Y": 1113.147
      },
      "Description": "Weights all effects by the vertex selection, e.g. from [SelectVertices]."
    },
    {
      "InputId": "408f6526-8fef-41b9-8de6-a20ae81a2037"/*AmountPerAxis*/,
      "Position": {
        "X": 266.76312,
        "Y": 1673.147
      },
      "Description": "Taper factors for the two axes perpendicular to TaperAxis."
    },
    {
      "InputId": "6323532f-f548-4faa-9c21-826ee4d44090"/*TwistPivot*/,
      "Position": {
        "X": -43.32721,
        "Y": 1886.6138
      },
      "Description": "Origin of the twist."
    },
    {
      "InputId": "a53aad5d-7bc5-4cbb-8a59-90cf8c346992"/*TaperAxis*/,
      "Position": {
        "X": 266.76312,
        "Y": 1288.147
      },
      "Description": "Axis along which the mesh is tapered."
    },
    {
      "InputId": "aa003a1b-929d-4776-b816-608771242177"/*ShowPivots*/,
      "Position": {
        "X": 1117.6637,
        "Y": 1681.0876
      },
      "GroupTitle": "Obsolete",
      "Description": "Obsolete. Has no effect."
    },
    {
      "InputId": "b3593825-1ff5-4a5f-86cb-379a23471a4d"/*Mesh*/,
      "Relevancy": "Required",
      "Position": {
        "X": 65.99179,
        "Y": 722.89325
      }
    },
    {
      "InputId": "c67fa5cb-97b2-4146-a6c1-0ea84a03f703"/*Twist*/,
      "Position": {
        "X": 406.76312,
        "Y": 1253.147
      },
      "GroupTitle": "Twist",
      "Description": "Twist angle in degrees per unit along TwistAxis.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "cf8e1065-164d-4ba9-8c60-9ab545aaaee2"/*Pivot*/,
      "Position": {
        "X": -43.327206,
        "Y": 1809.0547
      },
      "Description": "Center of the spherize effect."
    },
    {
      "InputId": "ebf1167b-1519-4ca9-bfa6-87472889966b"/*TwistAxis*/,
      "Position": {
        "X": 266.76312,
        "Y": 1323.147
      },
      "Description": "Axis around which the mesh is twisted.",
      "Min": 0,
      "Max": 2,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "f6efc4a6-5267-40aa-82d3-e1b67d852fa8"/*Spherize*/,
      "Position": {
        "X": 406.76312,
        "Y": 1148.147
      },
      "GroupTitle": "Spherize",
      "Description": "Blends the vertices towards a sphere with the given Radius. 1 creates a sphere."
    }
  ],
