{
  "FormatVersion": 3,
  "Id": "ca6fc28d-5dc5-4162-9f85-954e65e65738"/*FilterMeshFaces*/,
  "Description": "Picks a subset of the faces of a mesh based on start index, step and count or percentage.\n\nEvery picked face gets its own three vertices, so the result has no shared vertices (like after [SplitMeshVertices]) and its size is known without reading back from the GPU. Vertices that are not used by any picked face are dropped. Count can exceed the number of incoming faces; indices then wrap around and faces are repeated.\n\nAKA: delete faces, remove faces, reduce mesh, thin out\n\nSee also: [FilterPoints], [SplitMeshVertices], [ScatterMeshFaces], [MeshFacesPoints]",
  "InputUis": [
    {
      "InputId": "1aafe02d-7d25-4d7d-a3f3-e1be54d6012f"/*InputMesh*/,
      "Relevancy": "Required",
      "Position": {
        "X": -700.0,
        "Y": 300.0
      }
    },
    {
      "InputId": "3e3dd39d-20a6-47f2-9037-ae861b88484a"/*StartIndex*/,
      "Position": {
        "X": -700.0,
        "Y": 10.0
      },
      "Description": "Index of the first picked face."
    },
    {
      "InputId": "692037a3-1f93-4255-bb19-d8f60e2a5b74"/*Percentage*/,
      "Position": {
        "X": -700.0,
        "Y": -25.0
      },
      "Description": "Fraction of the incoming faces to keep. When 0 or larger it replaces Count; 1 keeps as many faces as the input has, -1 disables it.",
      "Min": -1.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "8c24b384-7e36-4b54-ad6c-e47341169450"/*Count*/,
      "Position": {
        "X": -700.0,
        "Y": -60.0
      },
      "GroupTitle": "Selection",
      "Description": "Number of faces in the result. Ignored while Percentage is 0 or larger."
    },
    {
      "InputId": "a4acd677-5777-483f-a375-b7409982bd26"/*Seed*/,
      "Position": {
        "X": -700.0,
        "Y": 115.0
      },
      "Min": 0,
      "Max": 100
    },
    {
      "InputId": "e728c014-1387-4a5f-bfb6-f03fea682b25"/*Step*/,
      "Position": {
        "X": -700.0,
        "Y": 45.0
      },
      "Description": "Distance in face indices between picked faces.",
      "Min": 0.0,
      "Max": 10.0
    },
    {
      "InputId": "f3d48104-cedc-48e5-82db-c54bfb6b77be"/*ScatterSelect*/,
      "Position": {
        "X": -700.0,
        "Y": 80.0
      },
      "GroupTitle": "Scattering",
      "Description": "Randomly offsets the picked face indices.",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.001,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
