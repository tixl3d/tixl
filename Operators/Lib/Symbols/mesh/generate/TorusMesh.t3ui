{
  "FormatVersion": 3,
  "Id": "a835ab86-29c1-438e-a7f7-2e297108bfd5"/*TorusMesh*/,
  "Description": "Generates a torus mesh.\n\nIt can be rendered with [DrawMesh], [DrawMeshUnlit], [DrawMeshHatched] and others, or used as a source for points with [MeshVerticesToPoints] or [PointsOnMesh]. To import meshes from other programs use [LoadObj].\n\nAKA: donut, ring\n\nSee also: [CylinderMesh]\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "2d083dc4-1576-4a44-8744-e0896424a6a9"/*SmoothAngle*/,
      "Position": {
        "X": -200.0,
        "Y": 270.0
      },
      "GroupTitle": "Smoothing groups",
      "Description": "If the angle between adjacent segments exceeds this value (in degrees), the torus is shaded flat instead of smooth.",
      "Scale": 1.0
    },
    {
      "InputId": "608de038-6c7a-43fc-ba89-374c7b1a318e"/*Radius*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "Torus Parameters",
      "Description": "Radius of the ring."
    },
    {
      "InputId": "770a164b-10e7-4145-b1c9-dad1f564ec6b"/*Spin*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Rotates the geometry in degrees.\nX: around the ring.\nY: around the tube.",
      "AddPadding": "True",
      "Scale": 0.1
    },
    {
      "InputId": "99f5d952-8490-4930-b8ab-9d8e968183c6"/*Segments*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "GroupTitle": "Tesselation",
      "Description": "X: subdivisions around the ring.\nY: subdivisions around the tube."
    },
    {
      "InputId": "f3e7341c-0c81-42af-ba48-b43d345188c1"/*Fill*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "Angle of the generated part in degrees, 360 closes the shape.\nX: around the ring.\nY: around the tube.",
      "Scale": 0.1
    },
    {
      "InputId": "fdbad44a-2504-453b-bfae-976828372cc0"/*Thickness*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Radius of the tube."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "f8f17f87-56f2-4411-b9bf-b9193b9aa90d"/*Data*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}