{
  "FormatVersion": 3,
  "Id": "be52b670-9749-4c0d-89f0-d8b101395227"/*LoadObj*/,
  "Description": "Loads a mesh from a Wavefront .obj file.\n\nThe result can be rendered with [DrawMesh], [DrawMeshUnlit], [DrawMeshHatched] and others, or used as a source for points with [MeshVerticesToPoints] or [PointsOnMesh]. All surfaces must have valid UVs, otherwise they appear black. For importing meshes together with their materials use [LoadGltfScene] with [DrawScene].\n\nAKA: import, model, wavefront\n\nSee also: [CubeMesh], [CylinderMesh], [QuadMesh], [SphereMesh], [TorusMesh]\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "7d576017-89bd-4813-bc9b-70214efe6a27"/*Path*/,
      "Position": {
        "X": 51.512096,
        "Y": 46.995968
      },
      "GroupTitle": "Select file",
      "Description": "Path to the Wavefront .obj file.",
      "Usage": "FilePath",
      "FileFilter": "obj"
    },
    {
      "InputId": "aa19e71d-329c-448b-901c-565bf8c0da4f"/*SortVertices*/,
      "Position": {
        "X": 51.512096,
        "Y": 136.99597
      },
      "Description": "Sorts the vertex order along an axis, which affects the order of points created with [MeshVerticesToPoints]. Ignore keeps the file order."
    },
    {
      "InputId": "c39a61b3-fb6b-4611-8f13-273f13c9c491"/*ScaleFactor*/,
      "Position": {
        "X": 51.512096,
        "Y": 181.99597
      },
      "GroupTitle": "Scaling",
      "Min": 0.001,
      "Max": 1000.0,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "ddd22736-a600-4c97-a4a4-ad3526b8b35c"/*ClearGPUCache*/,
      "Position": {
        "X": 51.512096,
        "Y": 181.99597
      },
      "Description": "While enabled, the shared mesh cache is cleared on every update."
    },
    {
      "InputId": "ffd22736-a600-4c97-a4a4-ad3526b8b35c"/*UseGPUCaching*/,
      "Position": {
        "X": 51.512096,
        "Y": 91.99597
      },
      "GroupTitle": "Advanced Options...",
      "Description": "Shares the loaded mesh between all LoadObj operators using the same file. A cached mesh ignores later changes of ScaleFactor and SortVertices."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "1f4e7cac-1f62-4633-b0f3-a3017a026753"/*Data*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}