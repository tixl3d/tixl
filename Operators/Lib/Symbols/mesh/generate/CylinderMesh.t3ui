{
  "FormatVersion": 3,
  "Id": "5777a005-bbae-48d6-b633-5e998ca76c91"/*CylinderMesh*/,
  "Description": "Generates a cylinder or cone mesh with optional caps.\n\nHeight, Fill and RadiusOffset allow shapes like pie charts, ring diagrams and cones. Check the presets. It can be rendered with [DrawMesh], [DrawMeshUnlit], [DrawMeshHatched] and others, or used as a source for points with [MeshVerticesToPoints] or [PointsOnMesh].\n\nAKA: cone, tube, pipe\n\nTips:\n- Set CapSegments to 0 to skip drawing the caps.\n\nSee also: [NGonMesh], [TorusMesh]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "1d1ce8c4-fd3c-4d69-be0e-679247a811c9"/*Twist*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Rotates the top relative to the bottom in degrees.",
      "Min": -90.0,
      "Max": 90.0,
      "Scale": 1.0,
      "Format": "{0:0.000}°"
    },
    {
      "InputId": "321693a5-4e2c-47a0-a42e-95cbdc6ebf80"/*Columns*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Subdivisions around the circumference."
    },
    {
      "InputId": "4c7e0f67-a35b-4a23-b640-b0375c1a3259"/*Rotation*/,
      "Position": {
        "X": -200.0,
        "Y": 360.0
      },
      "Description": "Rotation in degrees.",
      "AddPadding": "True",
      "Min": -180.0,
      "Max": 180.0,
      "Scale": 1.0,
      "Format": "{0:0.000}°"
    },
    {
      "InputId": "4c91b66c-670d-45ff-94cc-01d1a68cd040"/*RadiusOffset*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Added to Radius for the top. Use -Radius to create a cone."
    },
    {
      "InputId": "4dd4c4f0-c6b7-4ee8-92e2-cb8df6131e0a"/*Rows*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "GroupTitle": "Tesselation",
      "Description": "Subdivisions along the height."
    },
    {
      "InputId": "57f3310c-6ed2-4a52-af72-43e083f73360"/*Height*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "66332a91-e0c2-442a-99f6-347dedaed72e"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "AddPadding": "True"
    },
    {
      "InputId": "6ddf5966-9140-4bea-a56b-20690f9f436f"/*BasePivot*/,
      "Position": {
        "X": -200.0,
        "Y": 315.0
      },
      "GroupTitle": "Pivot",
      "Description": "Vertical position of the pivot relative to the height. 0 places it at the bottom, 0.5 at the center.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "8d290afb-2574-4afa-a545-a0d3588f89f6"/*Radius*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "Size",
      "Description": "Radius of the bottom.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "91fd4fbf-1cec-4d89-8014-ceed0021a5ee"/*Fill*/,
      "Position": {
        "X": -200.0,
        "Y": 270.0
      },
      "Description": "Angle of the circumference in degrees. 360 is a closed cylinder, smaller values create pie segments.",
      "Min": 0.0,
      "Max": 360.0,
      "Scale": 1.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "c29b5881-85bc-4d29-bc72-6dd36730fa8f"/*Spin*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "GroupTitle": "Advanced Settings",
      "Description": "Rotates the geometry around its axis in degrees.",
      "Min": -90.0,
      "Max": 90.0,
      "Scale": 1.0,
      "Format": "{0:0.000}°"
    },
    {
      "InputId": "db5e3c51-5765-44d8-a61b-a7b552fce5b3"/*CapSegments*/,
      "Position": {
        "X": -200.0,
        "Y": 315.0
      },
      "Description": "Radial subdivisions of the caps. 0 removes the caps.",
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "b4bed6e3-bef5-4601-99bd-f85bf1a956f5"/*Data*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}