{
  "FormatVersion": 3,
  "Id": "c47ab830-aae7-4f8f-b67c-9119bcbaf7df"/*CubeMesh*/,
  "Description": "Generates a box mesh with configurable subdivisions and UV layouts.\n\nIt can be rendered with [DrawMesh], [DrawMeshUnlit], [DrawMeshHatched] and others, or used as a source for points with [MeshVerticesToPoints] or [PointsOnMesh]. To import meshes from other programs use [LoadObj].\n\nAKA: box\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "573b74e2-8ab9-4364-9de7-605248528cee"/*Margin*/,
      "Position": {
        "X": -200.0,
        "Y": 125.0
      },
      "Description": "Padding around the UV islands of TexCoord.",
      "Min": 0.0,
      "Max": 0.01
    },
    {
      "InputId": "97c9849e-751c-49a9-823d-0af839fa503e"/*Stretch*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "GroupTitle": "Scaling",
      "Description": "Size along X (width), Y (height) and Z (depth)."
    },
    {
      "InputId": "9a7d34a1-ca39-48bc-b977-9a786d23f3b1"/*Scale*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "ba355fc0-0f1c-41d9-842e-d8ae9bee162a"/*Margin2*/,
      "Position": {
        "X": -200.0,
        "Y": 125.0
      },
      "Description": "Padding around the UV islands of TexCoord2.",
      "Min": 0.0,
      "Max": 0.01
    },
    {
      "InputId": "e1adb865-42f5-46a9-a4ac-bfae00b03caa"/*TexCoord*/,
      "Position": {
        "X": -200.0,
        "Y": 125.0
      },
      "GroupTitle": "Uv Mapping",
      "Description": "UV layout of the faces.\n\nDefault: each side uses the full 0..1 range.\nRows: unwraps the six sides into a 3x2 grid.\nCubeMap: unwraps the sides into a cross layout.\nCubeMapForSquare: cross layout fitted into a square texture."
    },
    {
      "InputId": "e445a6da-0b66-46ae-ad2b-650e9cc50798"/*Segments*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "Tesselation",
      "Description": "Number of subdivisions along X, Y and Z."
    },
    {
      "InputId": "e641c244-9dc8-444d-8dee-c3e9b710f9db"/*Rotation*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Rotation in degrees.",
      "AddPadding": "True",
      "Scale": 0.1,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "f4a78f77-8d8c-4b7b-8545-ea80947b428d"/*Center*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Moves the mesh after rotation."
    },
    {
      "InputId": "f946d7a1-8bb6-4ba1-a3bb-f2f95fc2242d"/*TexCoord2*/,
      "Position": {
        "X": -200.0,
        "Y": 125.0
      },
      "Description": "UV layout written to the second UV set. Same modes as TexCoord."
    },
    {
      "InputId": "febfae90-13e8-4f0a-8ccf-b8825ea525f8"/*Pivot*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "GroupTitle": "Position and Rotation",
      "Description": "Offsets the mesh relative to its rotation and scaling center, in units of the box size.\n\nE.g. 0, 0.5, 0 places the bottom of the box at the center so it grows upwards."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "35660e2b-5005-44a2-bf57-db9a3f1b791d"/*Data*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}