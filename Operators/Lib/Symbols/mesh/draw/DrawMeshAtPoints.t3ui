{
  "FormatVersion": 3,
  "Id": "42cb88bc-beb8-4d89-ac99-44b77be5f03e"/*DrawMeshAtPoints*/,
  "Description": "Draws a PBR shaded instance of a mesh at each point of a point buffer.\n\nEach instance uses the position, rotation and color of its point. It uses the current material, point lights, fog and environment settings. The size can additionally be scaled by the point's F1 or F2 attribute, and a texture atlas can assign different texture cells to instances.\n\nSee also: [DrawMesh], [RepeatMeshAtPoints], [CustomDrawMesh]\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0af05ab4-0d77-4f01-a79b-691f58f702ef"/*Size*/,
      "Position": {
        "X": 2056.3213,
        "Y": 3335.53
      },
      "Description": "Uniform scale of each instance.",
      "Min": 0.0,
      "Max": 1.0,
      "Format": "{0:0.000} ×"
    },
    {
      "InputId": "22b0817f-3149-4713-b87b-89c54300cde8"/*FillMode*/,
      "Position": {
        "X": 2000.9934,
        "Y": 4252.8496
      },
      "GroupTitle": "Draw Style",
      "Description": "Solid or wireframe rendering."
    },
    {
      "InputId": "329d8248-5f9f-4ad3-9b97-0f142e91ba05"/*Mesh*/,
      "Relevancy": "Required",
      "Position": {
        "X": 1468.0251,
        "Y": 3814.7598
      },
      "GroupTitle": "Input"
    },
    {
      "InputId": "408ae7c7-9aa8-4537-8c55-b5689f8f9b56"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 1442.1204,
        "Y": 3581.1616
      }
    },
    {
      "InputId": "59420e45-cbe2-48d8-961c-3dea5e55b182"/*Shading*/,
      "Position": {
        "X": 1916.3214,
        "Y": 3405.53
      },
      "Description": "Default: uses the mesh normals.\nFlat: computes facet normals per pixel, giving a faceted look."
    },
    {
      "InputId": "69e1f021-4db2-43a1-a4e6-837024350dc1"/*UsePointScale*/,
      "Position": {
        "X": 1916.3212,
        "Y": 3499.9988
      },
      "Description": "If enabled, instances are stretched non-uniformly by the points' Scale attribute.",
      "AddPadding": "True"
    },
    {
      "InputId": "6c36bf68-e22f-419d-9ec0-f60a83d6a560"/*BlendMode*/,
      "Position": {
        "X": 2000.9934,
        "Y": 4297.8496
      }
    },
    {
      "InputId": "70f4cc27-f901-4faa-aa2e-b4cd2a50ff73"/*EnableZTest*/,
      "Position": {
        "X": 2000.9934,
        "Y": 4367.8496
      },
      "Description": "If enabled, fragments hidden behind already drawn geometry (according to the depth buffer) are discarded."
    },
    {
      "InputId": "8af68894-0a5f-4fef-b7c9-41badeb1db16"/*AtlasMode*/,
      "Position": {
        "X": 1916.3212,
        "Y": 3644.9988
      },
      "Description": "How the atlas cell of each instance is selected.\n\nBufferOrder: by the index of the point.\nF1: by the point's F1 attribute.\nF2: by the point's F2 attribute."
    },
    {
      "InputId": "998e0e5b-fccf-430c-b799-aacc8b0cbb28"/*ScaleFactor*/,
      "Position": {
        "X": 2056.3213,
        "Y": 3534.9988
      },
      "Description": "Additionally scales each instance by a point attribute.\n\nNone: no extra scaling.\nF1: scales by the point's F1.\nF2: scales by the point's F2."
    },
    {
      "InputId": "9ec6c311-22de-411b-9821-0d458f33df7a"/*SpecularAA*/,
      "Position": {
        "X": 2056.3213,
        "Y": 3440.53
      },
      "Description": "Reduces specular aliasing on silhouettes and in high-frequency normal map regions.",
      "Min": 0.0,
      "Max": 2.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "a7cb95c4-fb81-49c7-9503-a45589713415"/*ColorField*/,
      "Position": {
        "X": 1851.9666,
        "Y": 3055.6702
      },
      "Description": "Optional field whose color is multiplied with each fragment, evaluated at the world position.\n\nTry [SphereSDF] -> [SDFToColor] -> FragmentField."
    },
    {
      "InputId": "a8590e4f-2edf-42c9-8bc2-e7b521f8cafc"/*AlphaCutOff*/,
      "Position": {
        "X": 2056.3213,
        "Y": 3370.53
      },
      "Description": "Fragments with an alpha below this value are discarded. 0 disables alpha testing.",
      "AddPadding": "True"
    },
    {
      "InputId": "ba7befdf-270b-4ac0-bfc2-7543e2c3097b"/*Color*/,
      "Position": {
        "X": 1776.3212,
        "Y": 3230.53
      },
      "GroupTitle": "Appearance",
      "Description": "Tints the mesh. Multiplied with the material colors set by [SetMaterial]."
    },
    {
      "InputId": "c0351f55-ad27-4fbd-b3d5-668ff49f0ea0"/*CullMode*/,
      "Position": {
        "X": 2000.9934,
        "Y": 4217.8496
      },
      "Description": "Which faces are hidden.\n\nNone: both sides are drawn.\nFront: front faces are hidden, only back faces are visible.\nBack: back faces are hidden (default)."
    },
    {
      "InputId": "c4adbb96-8838-4c7f-be20-bb464f0eea4c"/*AtlasSize*/,
      "Position": {
        "X": 1916.3212,
        "Y": 3569.9988
      },
      "GroupTitle": "Texture Coordinates",
      "Description": "Number of columns and rows of the texture atlas. 1x1 disables the atlas."
    },
    {
      "InputId": "dd511aab-0472-4109-9c10-cc1ab5042499"/*EnableZWrite*/,
      "Position": {
        "X": 2000.9934,
        "Y": 4332.8496
      },
      "Description": "If enabled, the mesh writes into the depth buffer so it can occlude itself and geometry drawn later.",
      "AddPadding": "True"
    }
  ],
