{
  "FormatVersion": 3,
  "Id": "0e313329-74fb-4f2a-b1c2-136e1ecf9b3e"/*DrawMeshChunksAtPoints*/,
  "Description": "Draws one chunk of a multi-chunk mesh at each point, with PBR shading and optional shadows.\n\nThe mesh needs chunk definitions, e.g. from [GeometryToMeshChunks] or [LoadGltfScene]. ChunkIndices selects the chunk for each point (repeated if shorter than the point list, wrapped by the chunk count); without it, point n draws chunk n. Shadows are rendered when used with [SetShadow].\n\nSee also: [DrawMeshAtPoints]",
  "SymbolTags": "192",
  "InputUis": [
    {
      "InputId": "010d4e6c-26b8-444e-8d22-3be0d93222ef"/*AlphaCutOff*/,
      "Position": {
        "X": 3413.2158,
        "Y": 4348.5107
      },
      "GroupTitle": "Advanced",
      "Description": "Fragments with an alpha below this value are discarded. 0 disables alpha testing."
    },
    {
      "InputId": "271ffc87-bf9a-4958-ab9f-387f27744aee"/*ShadowBias*/,
      "Position": {
        "X": 3413.2158,
        "Y": 4418.511
      },
      "Description": "Depth tolerance when comparing against the shadow map. Increase it to remove shadow acne, decrease it if shadows detach from objects.",
      "Min": -0.01,
      "Max": 0.01,
      "Format": "{0:0.0000}"
    },
    {
      "InputId": "2ba5d5a0-2292-409a-b603-867bc2c347c7"/*ShadowOffset*/,
      "Position": {
        "X": 3413.2158,
        "Y": 4383.5107
      },
      "Description": "Offsets the shadow lookup position along the surface normal. Helps against self-shadowing artifacts.",
      "AddPadding": "True",
      "Min": -0.01,
      "Max": 0.01,
      "Scale": 0.001,
      "Format": "{0:0.0000}"
    },
    {
      "InputId": "3ba54ff1-0c53-4f8d-92f0-20de48144b82"/*CullMode*/,
      "Position": {
        "X": 3773.1292,
        "Y": 5391.681
      },
      "Description": "Which faces are hidden.\n\nNone: both sides are drawn.\nFront: front faces are hidden, only back faces are visible.\nBack: back faces are hidden (default)."
    },
    {
      "InputId": "40e840c7-b707-4f63-8ae8-bd7498d34f54"/*GPoints*/,
      "Relevancy": "Required",
      "Position": {
        "X": 2776.8105,
        "Y": 4893.3477
      }
    },
    {
      "InputId": "43527e99-7da1-459a-b51d-0addeeb6786a"/*Color*/,
      "Position": {
        "X": 3133.2158,
        "Y": 4208.511
      },
      "GroupTitle": "Settings"
    },
    {
      "InputId": "5ff607e0-a3db-4ece-93dc-3713669def9e"/*UseF1ForSize*/,
      "Position": {
        "X": 3273.2158,
        "Y": 4741.787
      },
      "Description": "Scales each instance by the point's F1 attribute."
    },
    {
      "InputId": "7d609639-d9f3-4c7c-9fde-91c71a29aedc"/*UseStretch*/,
      "Position": {
        "X": 3273.2158,
        "Y": 4776.787
      },
      "Description": "Stretches each instance by the point's Scale attribute.\n\nOff by default: points from [GeometryToMeshChunks] with WriteSizeToScale, and particles emitted from them, carry the fragment size in Scale, which would scale each chunk by its own size."
    },
    {
      "InputId": "821e86ce-9118-429d-94d8-d30f5df9e455"/*Mesh*/,
      "Relevancy": "Required",
      "Position": {
        "X": 3308.8044,
        "Y": 5230.5854
      }
    },
    {
      "InputId": "8613e460-b7c3-47d7-9bc6-01fff9150ec0"/*EnableZWrite*/,
      "Position": {
        "X": 3773.1292,
        "Y": 5504.547
      },
      "Description": "If enabled, the mesh writes into the depth buffer so it can occlude itself and geometry drawn later.",
      "AddPadding": "True"
    },
    {
      "InputId": "8cdea8a6-7e39-433d-a616-2f64e5e04ed7"/*ChunkIndices*/,
      "Relevancy": "Required",
      "Position": {
        "X": 3913.1292,
        "Y": 5669.718
      },
      "Description": "Optional int buffer with one chunk index per point.",
      "AddPadding": "True"
    },
    {
      "InputId": "93561534-b33e-4e72-9601-36216031e5d2"/*Size*/,
      "Position": {
        "X": 3413.2158,
        "Y": 4313.5107
      },
      "Description": "Uniform scale of each instance.",
      "Min": 0.0,
      "Max": 5.0
    },
    {
      "InputId": "c159c08f-ceef-43b3-8e69-91bfb943c226"/*FillMode*/,
      "Position": {
        "X": 3773.1292,
        "Y": 5426.681
      },
      "Description": "Solid or wireframe rendering."
    },
    {
      "InputId": "c54759f0-759d-470e-8000-03cdfe609f1c"/*ShadowColor*/,
      "Position": {
        "X": 3273.2158,
        "Y": 4453.5117
      },
      "Description": "Color of shadowed areas. Alpha controls the shadow intensity.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "f3c88d15-a33e-4d44-bf13-27f76a1e7a50"/*BlendMode*/,
      "Position": {
        "X": 3773.1292,
        "Y": 5469.547
      },
      "AddPadding": "True"
    },
    {
      "InputId": "f758666a-4716-446e-8ad3-a9e7b2a05ff6"/*EnableZTest*/,
      "Position": {
        "X": 3773.1292,
        "Y": 5539.547
      },
      "Description": "If enabled, fragments hidden behind already drawn geometry (according to the depth buffer) are discarded."
    },
    {
      "InputId": "fc846c4a-ac50-4260-8267-4484ced2d22f"/*UpdateDrawData*/,
      "Position": {
        "X": 3913.1292,
        "Y": 5704.718
      },
      "Description": "Rebuilds the per-point draw records every frame. Not needed for chunk indices written on the GPU: the records are rebuilt whenever the mesh, ChunkIndices or the point count change. Kept for measuring; the rebuild costs one small compute pass.",
      "AddPadding": "True"
    }
  ],
