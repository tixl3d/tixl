{
  "FormatVersion": 3,
  "Id": "a3c5471e-079b-4d4b-886a-ec02d6428ff6"/*DrawMesh*/,
  "Description": "Draws a mesh with PBR shading using the current material, lights, fog and environment.\n\nIf no [SetEnvironment] or lights are defined, the render target provides a default reflection and two point lights attached to the camera. These can be overridden with [SetEnvironment], [SetMaterial], [SetPointLight] and [SetFog] further up the graph. Fill mode and culling allow wireframe or double-sided rendering.\n\nSee also: [DrawMeshUnlit], [DrawMeshHatched], [DrawMeshAtPoints], [DrawMeshWithShadow]\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "05e0b0e3-6e79-48bd-a356-3dcb65c9040f"/*Shading*/,
      "Position": {
        "X": 1526.489,
        "Y": 3627.165
      },
      "Description": "Default: uses the mesh normals.\nFlat: computes facet normals per pixel, giving a faceted look."
    },
    {
      "InputId": "155c2396-0e05-4437-8171-288048b1158a"/*Filter*/,
      "Position": {
        "X": 2089.872,
        "Y": 3905.177
      },
      "GroupTitle": "Texture Options",
      "Description": "Texture filtering mode."
    },
    {
      "InputId": "2c4b5f3a-e9ec-432e-b1ae-6d999ae44f1b"/*FillMode*/,
      "Position": {
        "X": 2404.7104,
        "Y": 4099.43
      },
      "GroupTitle": "Draw Style",
      "Description": "Solid or wireframe rendering."
    },
    {
      "InputId": "2fdf0184-1459-4589-9633-2c739462ed66"/*FragmentField*/,
      "Position": {
        "X": 1816.4573,
        "Y": 3098.7122
      },
      "GroupTitle": "Field Overrides...",
      "Description": "Optional field whose color is multiplied with each fragment, evaluated at the world position.\n\nTry [SphereSDF] -> [SDFToColor] -> FragmentField."
    },
    {
      "InputId": "4748d9ab-58a4-41d7-a2ee-6f7dfed86211"/*AlphaCutOff*/,
      "Position": {
        "X": 1824.954,
        "Y": 3585.8855
      },
      "Description": "Fragments with an alpha below this value are discarded. 0 disables alpha testing."
    },
    {
      "InputId": "8c9dee45-d165-48c8-b8dd-b7f47e77fd00"/*Color*/,
      "Position": {
        "X": 1544.9539,
        "Y": 3445.8855
      },
      "GroupTitle": "Appearance",
      "Description": "Tints the mesh. Multiplied with the material colors set by [SetMaterial]."
    },
    {
      "InputId": "96df9e72-189f-4efc-82a6-b2f482166e34"/*ShaderDefines*/,
      "Position": {
        "X": 1816.4573,
        "Y": 3133.7122
      },
      "Description": "Additional HLSL code inserted into the generated shader, e.g. #define statements or helper functions. Invalid code breaks rendering.",
      "Usage": "Multiline"
    },
    {
      "InputId": "97429e1f-3f30-4789-89a6-8e930e356ee6"/*Mesh*/,
      "Relevancy": "Required",
      "Position": {
        "X": 1339.876,
        "Y": 3887.7703
      }
    },
    {
      "InputId": "9c17fa15-35f1-49d4-802f-a3a796cad96a"/*BlendMode*/,
      "Position": {
        "X": 2404.7104,
        "Y": 4175.523
      }
    },
    {
      "InputId": "9e957f4a-6502-4905-8d97-331f8b54097c"/*Culling*/,
      "Position": {
        "X": 2404.7104,
        "Y": 4064.43
      },
      "Description": "Which faces are hidden.\n\nNone: both sides are drawn.\nFront: front faces are hidden, only back faces are visible.\nBack: back faces are hidden (default)."
    },
    {
      "InputId": "b50b3fc7-35e1-421d-be0a-b3008a54c33c"/*EnableZTest*/,
      "Position": {
        "X": 2404.7104,
        "Y": 4210.523
      },
      "Description": "If enabled, fragments hidden behind already drawn geometry (according to the depth buffer) are discarded.",
      "AddPadding": "True"
    },
    {
      "InputId": "cf8fe9a6-f9f7-4485-9ca5-ae96326ae25f"/*SpecularAA*/,
      "Position": {
        "X": 1824.9539,
        "Y": 3655.8855
      },
      "Description": "Reduces specular aliasing on silhouettes and in high-frequency normal map regions.",
      "Min": 0.0,
      "Max": 20.0,
      "ClampMin": true
    },
    {
      "InputId": "d1db33ea-1739-4323-9105-7b236a0e240f"/*WrapMode*/,
      "Position": {
        "X": 2039.8054,
        "Y": 4026.683
      },
      "Description": "How the texture is sampled outside the 0..1 UV range.\n\nWrap: repeats.\nMirror: repeats mirrored.\nClamp: extends the edge pixels.\nBorder: uses the sampler border color.\nMirrorOnce: mirrors once, then clamps."
    },
    {
      "InputId": "d7bd3003-8589-4537-92e8-e95c5eb2bfab"/*UseMaterialId*/,
      "Position": {
        "X": 1332.4364,
        "Y": 4254.673
      },
      "Description": "Selects a material by name from the materials available in the current context, instead of the active default material.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "dfad3400-885a-4f83-8c39-ec6520f4e2aa"/*EnableZWrite*/,
      "Position": {
        "X": 2404.7104,
        "Y": 4245.523
      },
      "Description": "If enabled, the mesh writes into the depth buffer so it can occlude itself and geometry drawn later."
    }
  ],
