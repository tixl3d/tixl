{
  "FormatVersion": 3,
  "Id": "dcacc281-92c6-4e47-8eea-91fa8954ed86"/*DrawMeshCelShading*/,
  "Description": "Draws a mesh with gradient-based toon shading and dark silhouette edges.\n\nThe summed brightness of the point lights is mapped onto the Shading gradient, so the gradient defines the color bands. Set the gradient interpolation to Hold for hard cel bands, or use smooth interpolation for soft transitions. Surfaces facing away from the camera beyond EdgeThresold are drawn with EdgeColor.\n\nAKA: toon, cel\n\nTips:\n- Add at least one [PointLight] and balance its intensity with Brightness.\n\nSee also: [DrawMesh], [DrawMeshHatched]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "3d2eaff6-9b02-4bc9-9ebc-76f5888943f6"/*Shading*/,
      "Position": {
        "X": 635.04663,
        "Y": 5083.9478
      },
      "Description": "Gradient that maps the light brightness (left: dark, right: bright) to colors."
    },
    {
      "InputId": "44720f79-d2c5-4da7-98df-334539153eac"/*EnableZTest*/,
      "Position": {
        "X": 635.04663,
        "Y": 5173.9478
      },
      "Description": "If enabled, fragments hidden behind already drawn geometry (according to the depth buffer) are discarded."
    },
    {
      "InputId": "5455e5b1-d48a-45d5-bbb8-e205ea75c796"/*EnableZWrite*/,
      "Position": {
        "X": 635.04663,
        "Y": 5218.9478
      },
      "Description": "If enabled, the mesh writes into the depth buffer so it can occlude itself and geometry drawn later."
    },
    {
      "InputId": "8cda736b-a316-4188-9130-182cfe78b25b"/*Culling*/,
      "Position": {
        "X": 635.04663,
        "Y": 5128.9478
      },
      "Description": "Which faces are hidden.\n\nNone: both sides are drawn.\nFront: front faces are hidden, only back faces are visible.\nBack: back faces are hidden (default)."
    },
    {
      "InputId": "8fa2a214-8b1d-4182-b4c8-145c3e168f87"/*Color*/,
      "Position": {
        "X": 639.3811,
        "Y": 4680.332
      },
      "Description": "Multiplied with the gradient color."
    },
    {
      "InputId": "a9a04304-2af3-49e8-a28e-bcac8361b17e"/*EdgeThresold*/,
      "Position": {
        "X": 633.7131,
        "Y": 4840.601
      },
      "Description": "Pixels whose normal faces the camera less than this value (0..1) are drawn with EdgeColor. Higher values give thicker edges."
    },
    {
      "InputId": "aaca0bae-9943-45d5-8389-45343ad86e39"/*ColorMap*/,
      "Position": {
        "X": 628.75635,
        "Y": 5276.926
      },
      "Description": "Optional albedo texture multiplied with the gradient color."
    },
    {
      "InputId": "ada7f290-b23f-4b50-87b4-0e9b91c66fbf"/*Mesh*/,
      "Relevancy": "Required",
      "Position": {
        "X": 628.75635,
        "Y": 5321.926
      }
    },
    {
      "InputId": "cff8d554-12b4-402f-8be9-98bba5ec406b"/*Brightness*/,
      "Position": {
        "X": 633.7131,
        "Y": 4795.601
      },
      "Description": "Multiplies the light brightness before it is looked up in the gradient."
    },
    {
      "InputId": "e1e45d58-4aa1-4bf4-8e9d-3b64cf82fd89"/*EdgeColor*/,
      "Position": {
        "X": 633.7131,
        "Y": 4750.601
      },
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
