{
  "FormatVersion": 3,
  "Id": "7eefe668-d290-4673-b766-39c98b9ba12e"/*SnapToAnglesForce*/,
  "Description": "Gradually aligns the particle velocities to fixed angle steps within a plane.\n\nThis creates angular, circuit-like motion paths. The plane can be the camera view or one of the world planes. The velocity component perpendicular to the plane is kept unless KeepPlanar is increased.\n\nTips:\n- Combine with [TurbulenceForce] and draw with [PointTrail] and [DrawLines].\n- It has no effect on particles without velocity or with velocity only perpendicular to the plane.\n\nSee also: [AxisStepForce]",
  "SymbolTags": "64",
  "InputUis": [
    {
      "InputId": "098f4485-7aa7-4ae8-a2b5-e59fa2c2309c"/*KeepPlanar*/,
      "Position": {
        "X": -514.92114,
        "Y": 443.39877
      },
      "GroupTitle": "Options",
      "Description": "Removes the velocity component perpendicular to the plane (0..1). Useful to emphasize the angled directions.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "1ad4c103-a0ab-4477-94ec-520d5bf16903"/*AngleCount*/,
      "Position": {
        "X": -508.1693,
        "Y": 249.70999
      },
      "Description": "Size of the angle steps in degrees, e.g. 90 for four directions or 45 for eight.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 360.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "8dabcbb3-2aa6-4213-82c9-e92c774c13f7"/*Twist*/,
      "Position": {
        "X": -516.99866,
        "Y": 536.7369
      },
      "Description": "Rotates the snapped directions. Might lead to unpredictable but interesting effects.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "a54ed62a-a6a3-4b7b-a68c-82691467aa6f"/*VariationThreshold*/,
      "Position": {
        "X": -508.1693,
        "Y": 339.70987
      },
      "GroupTitle": "Random turns",
      "Description": "How frequently random rotations occur: 0 never. 1 always.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "afd8fd12-8b3b-462b-a117-90981ddfccc6"/*Variation*/,
      "Position": {
        "X": -514.92114,
        "Y": 398.39877
      },
      "Description": "If a random threshold is exceeded, define the amount of random rotation the particle will do.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "d3c58957-611e-46aa-87b5-08f4aecc5da2"/*Mode*/,
      "Position": {
        "X": -516.99866,
        "Y": 611.7369
      },
      "Description": "Plane in which the angles are snapped.\n\nCameraSpace: the view plane of the camera.\nWorldSpaceXY, WorldSpaceXZ, WorldSpaceYZ: the corresponding world plane."
    },
    {
      "InputId": "e596a8ec-3681-4f45-b72c-d50a97240270"/*Amount*/,
      "Position": {
        "X": -508.1693,
        "Y": 204.71024
      },
      "Description": "How strongly the direction is snapped to the nearest step (0..1).",
      "Min": 0.0,
      "Max": 10.0,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
