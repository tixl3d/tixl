{
  "FormatVersion": 3,
  "Id": "2cc44046-2702-40d5-ab42-8b36ff3d6ca7"/*AxisStepForce*/,
  "Description": "Kicks randomly selected particles along a random X, Y or Z axis direction.\n\nWhenever ApplyTrigger is active, a random ratio of the particles is selected and gets a new velocity along one of the axes. This creates stepped, technical looking motion paths.\n\nTips:\n- Increase the Drag of the [ParticleSystem] so the particles stop between the steps.\n- With AxisSpace set to RotationSpace, the axes follow the particle orientation, which depends on OrientTowardsVelocity of the [ParticleSystem].\n\nSee also: [SnapToAnglesForce], [VelocityForce]",
  "SymbolTags": "192",
  "InputUis": [
    {
      "InputId": "1f642c68-fca9-4552-bb23-9d066f4b2dda"/*RandomizeStrength*/,
      "Position": {
        "X": -540.1571,
        "Y": 287.20462
      },
      "Description": "Random variation of the strength per particle."
    },
    {
      "InputId": "25e77db3-6ccb-4857-8dd6-e5c19395d85b"/*AddOriginalVelocity*/,
      "Position": {
        "X": -541.1749,
        "Y": 451.7198
      },
      "Description": "How much of the previous velocity is kept. 0 replaces it, 1 adds the step to it.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "42501a2b-4b10-43ff-8774-1e34fb868417"/*SelectRatio*/,
      "Position": {
        "X": -540.1571,
        "Y": 332.20456
      },
      "GroupTitle": "Axis Settings",
      "Description": "Ratio of particles (0..1) that are affected by each step.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "4701df38-3ec8-4133-ba40-afdf859e8f2f"/*AxisDistribution*/,
      "Position": {
        "X": -540.1571,
        "Y": 377.20456
      },
      "Description": "Relative probability of the X, Y and Z axes being chosen.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "7a0aaade-2cf4-45f8-85aa-1133278899ad"/*ApplyTrigger*/,
      "Position": {
        "X": -540.1571,
        "Y": 197.20462
      },
      "Description": "Applies the step while true. Connect a trigger, e.g. synced to the beat."
    },
    {
      "InputId": "a28e97a1-8bcf-4701-a8bb-97d69f91bc4b"/*Strength*/,
      "Position": {
        "X": -540.1571,
        "Y": 242.20462
      },
      "GroupTitle": "Settings",
      "Description": "Velocity of the step."
    },
    {
      "InputId": "ab591dbc-b521-4ef0-b1e2-d03ff27b959e"/*AxisSpace*/,
      "Position": {
        "X": -541.097,
        "Y": 617.51074
      },
      "Description": "ObjectSpace: uses the world axes.\nRotationSpace: uses the axes of each particle's orientation.",
      "AddPadding": "True"
    },
    {
      "InputId": "f5e93296-efe1-42e0-add8-f8b6298fe183"/*StrengthDistribution*/,
      "Position": {
        "X": -541.1749,
        "Y": 496.7198
      },
      "Description": "Scales the strength per axis.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "f6e3e1df-6f72-4c5f-a10e-771e5d7c9fa0"/*Seed*/,
      "Position": {
        "X": -790.11786,
        "Y": 898.2902
      },
      "Description": "Random seed for the particle selection. If 0, the current frame is used, so a new selection is made every step."
    }
  ],
