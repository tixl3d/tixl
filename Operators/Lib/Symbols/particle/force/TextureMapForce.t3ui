{
  "FormatVersion": 3,
  "Id": "4f5999c9-8ade-4e31-8379-afb7db56e170"/*TextureMapForce*/,
  "Description": "Accelerates particles by the vectors of a signed normal map that is stretched over the camera view.\n\nEach particle is projected into the camera view and samples the map at that position. The R and G channels accelerate it along the screen X and Y axes, the alpha channel scales the effect. This can create particles flowing along images or tracing contours.\n\nThe map needs negative values. One option is [NormalMap] with the Gray_ToNormalizedRGBSigned mode, which works especially well together with the Twist parameter. ViewConfinement and DepthConcentration keep the particles within the visible area of the camera.\n\nTips:\n- Use [ImageLevels] to verify that the texture contains negative values.\n\nSee also: [VectorFieldForce], [TurbulenceForce]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0de3d1e6-63d4-4dbf-a426-cbd4e6019c45"/*ViewConfinement*/,
      "Position": {
        "X": 219.55301,
        "Y": 1028.7299
      },
      "GroupTitle": "Push into view",
      "Description": "Applies a force to push particles back into view."
    },
    {
      "InputId": "331843a6-f634-45ef-b9ad-21baf8612642"/*Twist*/,
      "Position": {
        "X": 219.55301,
        "Y": 1308.7299
      },
      "Description": "Rotates the vectors of the map in degrees.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "41491794-082d-4394-b6c2-efb4780623ea"/*VariationGainAndBias*/,
      "Position": {
        "X": 79.55301,
        "Y": 1238.7299
      },
      "Description": "Shapes the random distribution used by the variation parameters.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "Format": "{0:0.000}",
      "UseVec2Control": "GainAndBias"
    },
    {
      "InputId": "4a438635-1d96-4526-a154-626a6286a65a"/*Colorization*/,
      "Position": {
        "X": 79.55301,
        "Y": 1343.7299
      },
      "Description": "Color the particles are blended towards where the force is strong.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "87264af4-0939-4aad-9a15-b79d067b9fcb"/*DepthConcentration*/,
      "Position": {
        "X": 219.55301,
        "Y": 1063.7299
      },
      "Description": "Applies force to push particles towards distance from the camera that is defined by CenterDepth.",
      "Min": 0.0,
      "Max": 0.1
    },
    {
      "InputId": "a63a10bb-b0c5-46bc-8f9d-8b0b3f4cd037"/*Spin*/,
      "Position": {
        "X": 219.55301,
        "Y": 1133.7299
      },
      "GroupTitle": "Spin",
      "Description": "Rotates the particle velocity around the Z axis in degrees each frame.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "b04d0d69-f322-4481-9166-ca812eb35d99"/*AmountXY*/,
      "Position": {
        "X": 79.55301,
        "Y": 923.72986
      },
      "Description": "Scales the acceleration along the screen X and Y axes.",
      "Min": -5.0,
      "Max": 5.0,
      "Format": "{0:0.000} ×",
      "UseVec2Control": "Position"
    },
    {
      "InputId": "b4ffa587-f6f0-47c2-af60-f8660ad1882e"/*TwistVariation*/,
      "Position": {
        "X": 219.55301,
        "Y": 1518.7299
      },
      "Description": "Random variation of Twist per particle in degrees.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "b61b695e-593d-4d7a-bb76-b15cbc0913d9"/*SpinVariation*/,
      "Position": {
        "X": 219.55301,
        "Y": 1168.7299
      },
      "Description": "Random variation of Spin per particle in degrees. VariationGainAndBias shapes the distribution.",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "b79534be-d4ab-4a9b-93ac-3652f3ccf19d"/*ShowGizmo*/,
      "Position": {
        "X": 754.8252,
        "Y": 1882.6652
      },
      "GroupTitle": "Options"
    },
    {
      "InputId": "d5038c16-3920-48fc-8cd8-9346b63dad7a"/*CenterDepth*/,
      "Position": {
        "X": 219.55301,
        "Y": 1098.7299
      },
      "Description": "Target distance from the camera plane when applying DepthConcentration."
    },
    {
      "InputId": "e9194e55-d0e8-4a97-8808-768cac23ce37"/*Colorize*/,
      "Position": {
        "X": 219.55301,
        "Y": 1483.7299
      },
      "Description": "Amount of colorization relative to the strength of the force. 0 disables it."
    },
    {
      "InputId": "eddf467a-d96e-4639-aa09-b49dc1775c1b"/*Amount*/,
      "Position": {
        "X": -79.60657,
        "Y": 1657.7941
      },
      "GroupTitle": "Amount",
      "Description": "How much are the particles accelerated by the signed normal map.\nYou can use negative values to invert the direction.",
      "Min": -5.0,
      "Max": 5.0,
      "Scale": 0.01
    },
    {
      "InputId": "faad9c30-9500-49bd-9b62-3f00ab536f35"/*AmountVariation*/,
      "Position": {
        "X": 219.55301,
        "Y": 1203.7299
      },
      "Description": "Add random variation to the amount of the effect. \nYou can use the BiasAndGain parameter to control the variation distribution."
    },
    {
      "InputId": "fcb4c9ff-b8b7-4fa3-b1ab-d8af6dbedc96"/*SignedNormalMap*/,
      "Relevancy": "Required",
      "Position": {
        "X": 788.8622,
        "Y": 1484.7836
      },
      "Description": "Signed normal map whose RG channels define the acceleration."
    }
  ],
  "SymbolChildUis": [
