{
  "FormatVersion": 3,
  "Id": "599ada75-b2ac-4f6c-ac98-f7b4bb6cf47d"/*FieldVolumeForce*/,
  "Description": "Uses a signed distance field as a volume that particles collide with, are attracted to or repelled from.\n\nParticles crossing the surface bounce off it. Particles outside are attracted towards the surface, particles inside are pushed out. With InvertVolume the inside and outside are swapped, e.g. to keep particles within a volume. Needs an SDF like [SphereSDF] or [CylinderSDF].\n\nAKA: collider, container\n\nSee also: [FieldDistanceForce], [MeshVolumeForce]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "02eb5c6b-3995-409b-bd18-9e5c3d58364a"/*Attraction*/,
      "Position": {
        "X": 574.5167,
        "Y": 566.03577
      },
      "GroupTitle": "Behaviour",
      "Description": "Acceleration towards the surface for particles outside the volume.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "0f929afe-8ba0-479f-adae-d96f89f86266"/*Repulsion*/,
      "Position": {
        "X": 714.5168,
        "Y": 636.03577
      },
      "Description": "Acceleration outwards for particles inside the volume.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "212064e0-7adb-467d-91d7-9b8890d854bc"/*RandomizeReflection*/,
      "Position": {
        "X": 714.5168,
        "Y": 741.0366
      },
      "Description": "Random variation of the reflection direction.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "57ddd456-78f1-486c-a28f-9cfc02f8a989"/*RandomizeBounce*/,
      "Position": {
        "X": 714.5168,
        "Y": 706.03613
      },
      "Description": "Random variation of the bounciness per particle.",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "637f406f-7cd2-496b-89b1-13945c14f637"/*NormalSamplingDistance*/,
      "Position": {
        "X": 714.5168,
        "Y": 811.0366
      },
      "Description": "Offset used to sample the field gradient for the surface normal. Larger values give smoother normals.",
      "Min": -0.1,
      "Max": 0.1
    },
    {
      "InputId": "64fb0a6f-8a7b-4121-ae71-3b028953df28"/*ApplyColorOnCollision*/,
      "Position": {
        "X": 574.5168,
        "Y": 969.58826
      },
      "Description": "Sets the particle color to the field color on collision."
    },
    {
      "InputId": "86f4bbf4-26a4-4dd7-9a23-3ef1a6c5a13b"/*Amount*/,
      "Position": {
        "X": 714.5168,
        "Y": 531.03577
      },
      "Description": "Overall strength of the force and of the bounce.",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.001
    },
    {
      "InputId": "8eac0a70-00ad-45cf-a72a-d58593475151"/*Bounciness*/,
      "Position": {
        "X": 714.5168,
        "Y": 671.036
      },
      "Description": "Velocity factor applied on collision.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 1.0
    },
    {
      "InputId": "97334c3a-7d1b-4990-a541-70f6ef040197"/*ReflectOnCollision*/,
      "Position": {
        "X": 574.5168,
        "Y": 934.58826
      },
      "GroupTitle": "Collision",
      "Description": "Reflects the particle velocity at the surface when a particle crosses it."
    },
    {
      "InputId": "bf4f4938-e8ca-4b64-aa8b-6247527ad2fd"/*InvertVolume*/,
      "Position": {
        "X": 574.5168,
        "Y": 776.0366
      },
      "GroupTitle": "Options",
      "Description": "Swaps inside and outside, e.g. to contain particles inside the volume."
    },
    {
      "InputId": "dba5f4e3-cbdc-4e12-b174-dd9b7d91bea8"/*AttractionDecay*/,
      "Position": {
        "X": 714.5168,
        "Y": 601.03577
      },
      "Description": "How quickly the attraction decreases with the distance from the surface.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "e24a0dca-504f-4fa9-8a1d-272611506613"/*Field*/,
      "Relevancy": "Required",
      "Position": {
        "X": 308.94855,
        "Y": 61.771713
      },
      "Description": "Signed distance field, e.g. from [SphereSDF] or [BoxSDF]."
    }
  ],
