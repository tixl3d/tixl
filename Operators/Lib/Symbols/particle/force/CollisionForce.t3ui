{
  "FormatVersion": 3,
  "Id": "ed0bc47a-31ef-400b-b4e4-5552a859b309"/*CollisionForce*/,
  "Description": "Simulates collisions between particles treated as spheres.\n\nThe radius of each particle is set on emission by the Scale of its emit point multiplied by the RadiusFactor of the [ParticleSystem]. Neighbors are found with a spatial hash grid, so only particles within about one CellSize are considered.\n\nTips:\n- Increase the radius (via the emit point scale or RadiusFactor) and adjust the size of [DrawPoints] accordingly.\n- Increase the Drag of the [ParticleSystem] to stabilize the simulation.\n\nSee also: [FieldVolumeForce]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "0724bf0c-8f97-44de-bf42-6a89b89f1632"/*CellSize*/,
      "Position": {
        "X": 1963.3588,
        "Y": 349.04147
      },
      "Description": "Size of the grid cells used to find neighboring particles. Should be at least twice the particle radius.",
      "Min": 0.001,
      "Max": 100.0,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "5b3fcf3c-7155-401f-b3ac-3a4ac9d921df"/*AttractionDecay*/,
      "Position": {
        "X": 2489.1,
        "Y": 617.99634
      },
      "Description": "How quickly the attraction decreases with distance (exponent).",
      "AddPadding": "True"
    },
    {
      "InputId": "78566405-8dee-4661-9cb7-489c8d322f64"/*IsEnabled*/,
      "Position": {
        "X": 3248.8274,
        "Y": 83.25409
      },
      "AddPadding": "True"
    },
    {
      "InputId": "91459607-22c1-4536-a384-8b1f1d8ecb64"/*CollisionResolve*/,
      "Position": {
        "X": 2489.1,
        "Y": 652.9964
      },
      "Description": "How strongly overlapping particles are pushed apart per frame (0..1)."
    },
    {
      "InputId": "91966b2c-342a-420a-bad1-cbcf4d6af1ae"/*Attraction*/,
      "Position": {
        "X": 2489.1,
        "Y": 547.99634
      },
      "Description": "Attraction between particles that are not touching. Negative values repel."
    },
    {
      "InputId": "d0036a34-d7e4-4542-b231-5d1b687b0028"/*Bounciness*/,
      "Position": {
        "X": 2489.1,
        "Y": 512.99634
      },
      "Description": "Velocity factor applied when particles bounce off each other.",
      "AddPadding": "True"
    }
  ],
