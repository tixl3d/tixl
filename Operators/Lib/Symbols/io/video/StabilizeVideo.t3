        {
          "Id": "e5a7649f-684e-4938-8ae3-7289f5b9ff45"/*B*/,
          "Type": "System.Single",
          "Value": 0.089
        },
        {
          "Id": "e9712b03-e7aa-4fe5-b5cf-f2c5d0c0b0df"/*ShaderCode*/,
          "Type": "System.String",
          "Value": "// f - normalized position in buffer\n// C: Marker Count\n\nint mCount = (int)(C+0.5);\n\np.Position = float3(f*A - 1, -0.9,0);\n\nPoint prev = SourcePoints[idx - mCount];\n\nfloat d = length(prev.Position - p.Position);\n\np.Color = SampleGradient(d * B);"
        }
      ],
