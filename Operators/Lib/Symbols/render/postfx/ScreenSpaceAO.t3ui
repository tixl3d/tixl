{
  "FormatVersion": 3,
  "Id": "8e2f6b14-a7c3-4d59-b0e8-3c91f5d27a66"/*ScreenSpaceAO*/,
  "Description": "Darkens creases and contact areas by tracing short rays through the depth and normal buffers of the rendered scene.\n\nEach pixel traces a few random rays around its normal and is darkened by the share that hit something nearby. The noisy result is accumulated over frames, following the camera motion. Compared to [SSAO] it measures Radius in world units and respects the surface direction, but it requires normals and the camera reference.\n\nRequirements:\n\nRender the scene with [RenderScene] and connect only Image: depth, normals, velocity and the camera come with it, and the result passes them on to the next effect. Connected inputs override them.\n\nWith a plain [RenderTarget], enable WithNormalBuffer and connect its buffers and the scene camera to the matching inputs.\n\nColorBleeding also tints surfaces with the color of what those rays hit.\n\nOnly content visible on screen can cause occlusion or bleeding. Moving objects need velocity (rendered by [RenderScene]); their shadows on still surfaces fade within a few frames, faster with a lower BlendFactor.\n\nAKA: ambient occlusion, HBAO, GTAO, contact shadows\n\nTips:\n\n- Use the Occlusion output to tint the shading or apply it to a part of the image.\n- Set Radius to match the scale of the details that should be shaded.",
  "SymbolTags": "1216",
  "InputUis": [
    {
      "InputId": "06a7e39c-2f4b-45d1-b860-b4197d5af2ee"/*Radius*/,
      "Position": {
        "X": 235.85425,
        "Y": -844.05286
      },
      "Description": "How far surfaces can darken each other, in world units. Larger values give wider, softer shading and need more steps.",
      "Min": 0.0,
      "Max": 2.0,
      "ClampMin": true
    },
    {
      "InputId": "17b8f4ad-305c-46e2-8971-c52a8e6b03ff"/*Thickness*/,
      "Position": {
        "X": 235.85425,
        "Y": -809.05286
      },
      "GroupTitle": "Ray Tracing",
      "Description": "How deep an object is assumed to be behind its visible surface, in world units. Too high darkens the background around objects, too low loses contact shadows.",
      "Min": 0.0,
      "Max": 2.0,
      "ClampMin": true
    },
    {
      "InputId": "28c905be-416d-47f3-9a82-d63b9f7c1400"/*RaysPerPixel*/,
      "Position": {
        "X": 95.85425,
        "Y": -774.05286
      },
      "Description": "Rays per pixel and frame. This has the largest performance cost. More rays reduce noise during motion.",
      "Min": 1,
      "Max": 16,
      "ClampMin": true
    },
    {
      "InputId": "39da16cf-527e-4804-ab93-e74ca08d2511"/*StepsPerRay*/,
      "Position": {
        "X": 95.85425,
        "Y": -739.05286
      },
      "Description": "Samples along each ray. Increase it for a large Radius when thin details are missed.",
      "Min": 2,
      "Max": 32,
      "ClampMin": true
    },
    {
      "InputId": "4aeb27d0-638f-4915-bca4-f85db19e3622"/*BlendFactor*/,
      "Position": {
        "X": 235.85425,
        "Y": -704.05286
      },
      "GroupTitle": "Temporal Accumulation",
      "Description": "Share of the history kept each frame while the image changes. Higher values are smoother but react slower.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "5bfc38e1-7490-4a26-8db5-096ec2af4733"/*NeighborhoodClamp*/,
      "Position": {
        "X": 235.85425,
        "Y": -669.05286
      },
      "Description": "How far the history may differ from the current frame. Lower values follow changes more closely but leave more noise.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "6c0d49f2-85a1-4b37-9ec6-1a7fd3b05844"/*DepthRejection*/,
      "Position": {
        "X": 235.85425,
        "Y": -634.05286
      },
      "Description": "Relative camera distance difference above which history is rejected as disoccluded.",
      "Min": 0.0,
      "Max": 0.2,
      "ClampMin": true
    },
    {
      "InputId": "7d1e5a03-96b2-4c48-afd7-2b80e4c16955"/*Reset*/,
      "Position": {
        "X": 95.85425,
        "Y": -599.05286
      },
      "Description": "Ignores the history while enabled, for example after a hard camera cut."
    },
    {
      "InputId": "9956cb84-af49-406f-80e3-38000482ddec"/*VelocityMap*/,
      "Position": {
        "X": -330.2635,
        "Y": -802.50977
      }
    },
    {
      "InputId": "b1529e47-daf6-408c-a31b-6fc42805ad99"/*Image*/,
      "Relevancy": "Required",
      "Position": {
        "X": -348.11636,
        "Y": -192.74579
      },
      "Description": "The rendered scene color. It must come from the same render pass and camera as DepthMap and NormalMap."
    },
    {
      "InputId": "c263af58-eb07-419d-b42c-70d53916beaa"/*DepthMap*/,
      "Relevancy": "Required",
      "Position": {
        "X": -330.26337,
        "Y": -872.50977
      },
      "Description": "The scene depth buffer. Only content that writes depth casts or receives occlusion."
    },
    {
      "InputId": "c59e38d7-204b-4fa1-b6e8-7d13f9a02c54"/*MaxAccumulatedFrames*/,
      "Position": {
        "X": 95.85425,
        "Y": -529.05286
      },
      "Description": "How many frames a still pixel averages before it stops changing. Higher values settle to a cleaner result but take longer, and a moving shadow reaches settled areas later.",
      "Min": 1,
      "Max": 1024,
      "ClampMin": true
    },
    {
      "InputId": "d374b069-fc18-42ae-853d-81e64a27cfbb"/*NormalMap*/,
      "Relevancy": "Required",
      "Position": {
        "X": -330.26337,
        "Y": -837.50977
      },
      "Description": "The NormalBuffer output of the [RenderTarget], which needs WithNormalBuffer enabled. Pixels without a normal use one reconstructed from depth, which looks faceted."
    },
    {
      "InputId": "d6af49e8-315c-4ab2-97f9-8e24a0b13d65"/*ColorBleeding*/,
      "Position": {
        "X": 235.85425,
        "Y": -494.05286
      },
      "GroupTitle": "Color Bleeding",
      "Description": "Adds light picked up from nearby surfaces that the rays hit. It estimates surface colors from the rendered image, so it gives a soft tint rather than accurate indirect light. 0 disables it.",
      "Min": 0.0,
      "Max": 4.0,
      "ClampMin": true
    },
    {
      "InputId": "e485c17a-0d29-43bf-964e-92f75b38d0cc"/*CameraReference*/,
      "Relevancy": "Required",
      "Position": {
        "X": -330.26337,
        "Y": -767.50977
      },
      "Description": "Reference output of the scene camera ([Camera] or [OrbitCamera])."
    },
    {
      "InputId": "e7b05af9-426d-4bc3-a80a-9f35b1c24e76"/*HighlightThreshold*/,
      "Position": {
        "X": 235.85425,
        "Y": -459.05286
      },
      "Description": "Brightness above which occlusion fades out, gone at twice this value, so that glowing HDR materials stay bright. Strongly lit surfaces above it lose occlusion too. Raise it if that happens.",
      "Min": 0.0,
      "Max": 8.0,
      "ClampMin": true
    },
    {
      "InputId": "f596d28b-1e3a-44c0-a75f-a3086c49e1dd"/*Intensity*/,
      "Position": {
        "X": 235.85425,
        "Y": -879.05286
      },
      "GroupTitle": "Occlusion",
      "Description": "Strength of the darkening. 1 applies the measured occlusion, higher values deepen it.",
      "Min": 0.0,
      "Max": 3.0,
      "ClampMin": true
    }
  ],
  "SymbolChildUis": [
