{
  "FormatVersion": 3,
  "Id": "8e2f6b14-a7c3-4d59-b0e8-3c91f5d27a66",
  "Description": "Darkens creases and contact areas by tracing short rays through the depth and normal buffers of a [RenderTarget].\n\nEach pixel traces a few random rays around its normal and is darkened by the share that hit something nearby. The noisy result is accumulated over frames, following the camera motion. Compared to [SSAO] it measures Radius in world units and respects the surface direction, but it requires normals and the camera reference.\n\nRequirements:\n\n- Enable WithNormalBuffer on the source [RenderTarget].\n- The scene camera must be connected to CameraReference.\n\nColorBleeding also tints surfaces with the color of what those rays hit.\n\nOnly content visible on screen can cause occlusion or bleeding. Moving objects are only handled by the clamp on the history, so they can show a slight delay.\n\nAKA: ambient occlusion, HBAO, GTAO, contact shadows\n\nTips:\n\n- Use the Occlusion output to tint the shading or apply it to a part of the image.\n- Set Radius to match the scale of the details that should be shaded.",
  "SymbolTags": "1216",
  "InputUis": [
    {
      "InputId": "b1529e47-daf6-408c-a31b-6fc42805ad99",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 0.0
      },
      "Description": "The rendered scene color. It must come from the same render pass and camera as DepthMap and NormalMap."
    },
    {
      "InputId": "c263af58-eb07-419d-b42c-70d53916beaa",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 40.0
      },
      "Description": "The scene depth buffer. Only content that writes depth casts or receives occlusion."
    },
    {
      "InputId": "d374b069-fc18-42ae-853d-81e64a27cfbb",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 80.0
      },
      "Description": "The NormalBuffer output of the [RenderTarget], which needs WithNormalBuffer enabled. Pixels without a normal use one reconstructed from depth, which looks faceted."
    },
    {
      "InputId": "e485c17a-0d29-43bf-964e-92f75b38d0cc",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 120.0
      },
      "Description": "Reference output of the scene camera ([Camera] or [OrbitCamera])."
    },
    {
      "InputId": "f596d28b-1e3a-44c0-a75f-a3086c49e1dd",
      "Position": {
        "X": -600.0,
        "Y": 160.0
      },
      "Description": "Strength of the darkening. 1 applies the measured occlusion, higher values deepen it.",
      "Min": 0,
      "Max": 3,
      "ClampMin": true,
      "GroupTitle": "Occlusion"
    },
    {
      "InputId": "06a7e39c-2f4b-45d1-b860-b4197d5af2ee",
      "Position": {
        "X": -600.0,
        "Y": 200.0
      },
      "Description": "How far surfaces can darken each other, in world units. Larger values give wider, softer shading and need more steps.",
      "Min": 0,
      "Max": 2,
      "ClampMin": true
    },
    {
      "InputId": "d6af49e8-315c-4ab2-97f9-8e24a0b13d65",
      "Position": {
        "X": -600.0,
        "Y": 220.0
      },
      "GroupTitle": "Color Bleeding",
      "Description": "Adds light picked up from nearby surfaces that the rays hit. It estimates surface colors from the rendered image, so it gives a soft tint rather than accurate indirect light. 0 disables it.",
      "Min": 0,
      "Max": 4,
      "ClampMin": true
    },
    {
      "InputId": "17b8f4ad-305c-46e2-8971-c52a8e6b03ff",
      "Position": {
        "X": -600.0,
        "Y": 240.0
      },
      "Description": "How deep an object is assumed to be behind its visible surface, in world units. Too high darkens the background around objects, too low loses contact shadows.",
      "Min": 0,
      "Max": 2,
      "ClampMin": true,
      "GroupTitle": "Ray Tracing"
    },
    {
      "InputId": "28c905be-416d-47f3-9a82-d63b9f7c1400",
      "Position": {
        "X": -600.0,
        "Y": 280.0
      },
      "Description": "Rays per pixel and frame. This has the largest performance cost. More rays reduce noise during motion.",
      "Min": 1,
      "Max": 16,
      "ClampMin": true
    },
    {
      "InputId": "39da16cf-527e-4804-ab93-e74ca08d2511",
      "Position": {
        "X": -600.0,
        "Y": 320.0
      },
      "Description": "Samples along each ray. Increase it for a large Radius when thin details are missed.",
      "Min": 2,
      "Max": 32,
      "ClampMin": true
    },
    {
      "InputId": "4aeb27d0-638f-4915-bca4-f85db19e3622",
      "Position": {
        "X": -600.0,
        "Y": 360.0
      },
      "Description": "Share of the history kept each frame while the image changes. Higher values are smoother but react slower.",
      "Min": 0,
      "Max": 1,
      "ClampMin": true,
      "ClampMax": true,
      "GroupTitle": "Temporal Accumulation"
    },
    {
      "InputId": "c59e38d7-204b-4fa1-b6e8-7d13f9a02c54",
      "Position": {
        "X": -600.0,
        "Y": 380.0
      },
      "Description": "How many frames a still pixel averages before it stops changing. Higher values settle to a cleaner result but take longer, and a moving shadow reaches settled areas later.",
      "Min": 1,
      "Max": 1024,
      "ClampMin": true
    },
    {
      "InputId": "5bfc38e1-7490-4a26-8db5-096ec2af4733",
      "Position": {
        "X": -600.0,
        "Y": 400.0
      },
      "Description": "How far the history may differ from the current frame. Lower values follow changes more closely but leave more noise.",
      "Min": 0,
      "Max": 1,
      "ClampMin": true
    },
    {
      "InputId": "6c0d49f2-85a1-4b37-9ec6-1a7fd3b05844",
      "Position": {
        "X": -600.0,
        "Y": 440.0
      },
      "Description": "Relative camera distance difference above which history is rejected as disoccluded.",
      "Min": 0,
      "Max": 0.2,
      "ClampMin": true
    },
    {
      "InputId": "7d1e5a03-96b2-4c48-afd7-2b80e4c16955",
      "Position": {
        "X": -600.0,
        "Y": 480.0
      },
      "Description": "Ignores the history while enabled, for example after a hard camera cut."
    }
  ],
