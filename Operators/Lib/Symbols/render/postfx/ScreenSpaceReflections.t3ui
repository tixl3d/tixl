{
  "FormatVersion": 3,
  "Id": "c3e7a1d4-5b82-4f06-9a3e-1d6c8b2f7e40",
  "Description": "Adds reflections of what is visible on screen to surfaces, using the depth and normal buffers of a [RenderTarget].\n\nRays are traced through the depth buffer from each pixel. Hits are accumulated over frames with the camera motion, following the reflected image rather than the surface so that mirror reflections stay stable while the camera moves. As with [TXAA], moving objects are only handled by the color clamp.\n\nRequirements:\n\n- Enable WithNormalBuffer on the source [RenderTarget]. Only shaders that output normals reflect, such as [DrawMesh] and [DrawPointsShaded].\n- The scene camera must be connected to CameraReference.\n\nOnly content visible on screen can be reflected. Where a ray finds nothing, the original image remains, including any reflections from [SetEnvironment].\n\nThe whole scene is treated as one material. To limit reflections to certain surfaces, combine the Reflections output with the image through a mask.\n\nAKA: SSR, screen space reflections, realtime reflections\n\nTips:\n\n- Place [TXAA] after this operator to clean up the remaining edges.\n- Keep MaxSteps low and raise it only when reflections break apart.",
  "SymbolTags": "1216",
  "InputUis": [
    {
      "InputId": "1f8c3a60-7d24-4e91-85b3-6a0d2e9c4f17",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 0.0
      },
      "Description": "The rendered scene color. It must come from the same render pass and camera as DepthMap and NormalMap."
    },
    {
      "InputId": "2a9d4b71-8e35-4fa2-96c4-7b1e3fad5028",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 40.0
      },
      "Description": "The scene depth buffer. All content that should appear in reflections must write depth."
    },
    {
      "InputId": "3bae5c82-9f46-40b3-a7d5-8c2f40be6139",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 80.0
      },
      "Description": "The NormalBuffer output of the [RenderTarget], which needs WithNormalBuffer enabled. Pixels without a normal do not reflect."
    },
    {
      "InputId": "4cbf6d93-a057-41c4-b8e6-9d3051cf724a",
      "Relevancy": "Required",
      "Position": {
        "X": -600.0,
        "Y": 120.0
      },
      "Description": "Reference output of the scene camera ([Camera] or [OrbitCamera])."
    },
    {
      "InputId": "5dc07ea4-b168-42d5-89f7-ae4162d0835b",
      "Position": {
        "X": -600.0,
        "Y": 160.0
      },
      "Description": "Multiplier for the reflection strength after the Fresnel term.",
      "Min": 0,
      "Max": 2,
      "GroupTitle": "Reflection",
      "ClampMin": true
    },
    {
      "InputId": "6ed18fb5-c279-43e6-9a08-bf5273e1946c",
      "Position": {
        "X": -600.0,
        "Y": 200.0
      },
      "Description": "Reflection strength when looking straight at a surface. It rises toward 1 at grazing angles. Dielectrics are near 0.04, polished metals near 1.",
      "Min": 0,
      "Max": 1,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "7fe290c6-d38a-44f7-ab19-c06384f2a57d",
      "Position": {
        "X": -600.0,
        "Y": 240.0
      },
      "Description": "Scatters the rays. Accumulation averages the noise into blurred reflections, so higher values take longer to settle.",
      "Min": 0,
      "Max": 1,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "80f3a1d7-e49b-4508-bc2a-d17495a3b68e",
      "Position": {
        "X": -600.0,
        "Y": 280.0
      },
      "Description": "Longest reflection ray in world units. Reflections fade out toward this distance.",
      "Min": 0,
      "Max": 50,
      "GroupTitle": "Ray Tracing",
      "ClampMin": true
    },
    {
      "InputId": "9104b2e8-f5ac-4619-8d3b-e285a6b4c79f",
      "Position": {
        "X": -600.0,
        "Y": 320.0
      },
      "Description": "How far behind a surface in the depth buffer a ray still counts as hitting it, in world units. Too low lets rays pass through objects, too high makes reflections smear behind them.",
      "Min": 0,
      "Max": 2,
      "ClampMin": true
    },
    {
      "InputId": "a215c3f9-06bd-472a-9e4c-f396b7c5d8a0",
      "Position": {
        "X": -600.0,
        "Y": 360.0
      },
      "Description": "Number of ray steps per pixel. This is the main performance control. Increase it when long rays miss thin objects.",
      "Min": 8,
      "Max": 128,
      "ClampMin": true
    },
    {
      "InputId": "b326d40a-17ce-483b-af5d-04a7c8d6e9b1",
      "Position": {
        "X": -600.0,
        "Y": 400.0
      },
      "Description": "Screen margin over which reflections fade out, because a ray leaving the image has nothing to show.",
      "Min": 0,
      "Max": 0.5,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "c437e51b-28df-494c-806e-15b8d9e7fac2",
      "Position": {
        "X": -600.0,
        "Y": 440.0
      },
      "Description": "Share of the history kept each frame while the image changes. Higher values are smoother but react slower.",
      "Min": 0,
      "Max": 1,
      "GroupTitle": "Temporal Accumulation",
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "b48d27c6-1f3a-4e90-a5d7-6c02e8f91b43",
      "Position": {
        "X": -600.0,
        "Y": 460.0
      },
      "Description": "How many frames a still pixel averages before it stops changing. Higher values settle to a cleaner result but take longer, and a moving shadow reaches settled areas later.",
      "Min": 1,
      "Max": 1024,
      "ClampMin": true
    },
    {
      "InputId": "d548f62c-39e0-4a5d-917f-26c9eaf80bd3",
      "Position": {
        "X": -600.0,
        "Y": 480.0
      },
      "Description": "Widens the color range the history is allowed to differ from the current frame. Higher values smooth rough reflections at the risk of ghosting.",
      "Min": 0,
      "Max": 1,
      "ClampMin": true
    },
    {
      "InputId": "e659073d-4af1-4b6e-a280-37dafb091ce4",
      "Position": {
        "X": -600.0,
        "Y": 520.0
      },
      "Description": "Relative camera distance difference above which history is rejected as disoccluded.",
      "Min": 0,
      "Max": 0.1,
      "ClampMin": true
    },
    {
      "InputId": "f76a184e-5b02-4c7f-b391-48eb0c1a2df5",
      "Position": {
        "X": -600.0,
        "Y": 560.0
      },
      "Description": "Ignores the history while enabled, for example after a hard camera cut."
    }
  ],
