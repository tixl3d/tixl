{
  "FormatVersion": 3,
  "Id": "196e14c7-3a71-4afd-a53b-e51d0fe8f414"/*MotionBlur*/,
  "Description": "Blurs moving parts of a rendered image along their motion, like a camera with an open shutter.\n\nEach pixel's motion comes from the velocity buffer that [RenderScene] renders. Where nothing wrote velocity, the camera motion is reconstructed from the depth buffer, which only blurs static geometry. Fast objects smear over the background and the background shows through their edges.\n\nRender the scene with [RenderScene] and connect only Image. With a plain [RenderTarget], connect DepthMap, VelocityMap and the scene camera.\n\nPlace it after [TXAA] or [ScreenSpaceLighting], whose temporal history needs the unblurred image.\n\nOnly what is visible on screen can smear, and rotations blur along straight lines. For exports use [RepeatFrame], which renders the scene several times per frame.\n\nAKA: velocity blur, shutter\n\nSee also: [RepeatFrame], [DirectionalBlur], [DepthOfField]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "3d99ccde-2bc3-4a25-962d-dab4fc6c554a"/*DepthMap*/,
      "Position": {
        "X": -451.32935,
        "Y": 272.5277
      },
      "Description": "Overrides the depth buffer from the image's bundle."
    },
    {
      "InputId": "4e7b2d90-6a1c-4f38-b5d2-e09a8c3f7165"/*Shutter*/,
      "Position": {
        "X": -40.0,
        "Y": 375.0
      },
      "Description": "Share of the frame the shutter is open: 0.5 is a 180° shutter as in film, 1 blurs over a whole frame of motion. Higher values exaggerate. The length stays steady when frame times vary.",
      "Min": 0.0,
      "Max": 2.0,
      "ClampMin": true
    },
    {
      "InputId": "619c2684-8495-4c19-a5b2-673728feaa00"/*Image*/,
      "Relevancy": "Required",
      "Position": {
        "X": -311.32935,
        "Y": 202.52771
      },
      "Description": "The rendered image. An image from [RenderScene] brings depth, velocity and camera along."
    },
    {
      "InputId": "8f1c6e2a-b374-4d59-9a0e-5c7d3b21f846"/*VelocityMap*/,
      "Position": {
        "X": -451.32935,
        "Y": 307.5277
      },
      "Description": "Overrides the velocity buffer from the image's bundle. Pixels without velocity use the camera motion."
    },
    {
      "InputId": "b2a95f07-3d4e-4c61-8e7b-19f6d0c2a538"/*MaxBlur*/,
      "Position": {
        "X": -40.0,
        "Y": 410.0
      },
      "Description": "Longest blur in each direction, in pixels. Larger values cost more, because the tiles grow with it.",
      "Min": 1.0,
      "Max": 128.0,
      "ClampMin": true
    },
    {
      "InputId": "d757058a-a31e-487f-b002-cc06bc478535"/*CameraReference*/,
      "Position": {
        "X": -451.32935,
        "Y": 342.5277
      },
      "Description": "Overrides the camera from the image's bundle. Needed for the camera motion where no velocity was written."
    },
    {
      "InputId": "df8bf08c-e576-4310-95b5-e34c6a001959"/*SampleCount*/,
      "Position": {
        "X": -40.0,
        "Y": 445.0
      },
      "Description": "Samples along the motion. More samples reduce the grain in long blurs.",
      "Min": 2,
      "Max": 64,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
  "SymbolChildUis": [
