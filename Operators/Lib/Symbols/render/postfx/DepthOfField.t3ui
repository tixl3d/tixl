{
  "FormatVersion": 3,
  "Id": "53d3eebd-4ead-4965-b26d-10a8bbd48182"/*DepthOfField*/,
  "Description": "Blurs a rendered image depending on the distance to a focus plane, simulating the depth of field of a camera lens.\n\nIt requires the color and depth buffer of the same [RenderTarget].\n\nAKA: dof, bokeh, focus, defocus, lensblur\n\nTips:\n- Use a [Locator] and its DistanceToCamera output for a visible focus target.\n- Temporarily increase Amount to make it easier to see which areas are in focus.\n\nSee also: [MotionBlur], [ChromaticAbberation], [Glow], [Grain], [Blur]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "3655d507-96b3-4ded-9cef-886ea703ca89"/*Amount*/,
      "Position": {
        "X": 386.16498,
        "Y": -133.21191
      },
      "Description": "Controls the intensity of the blur.\n\nAreas that are further away from the focus point are proportionally more blurred.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 20.0
    },
    {
      "InputId": "40de51d8-91dd-461d-a7be-d4096313eec2"/*NearFarRange*/,
      "Position": {
        "X": 206.6908,
        "Y": -757.60004
      },
      "Description": "Near and far clip planes used to linearize the depth buffer. Should match the clip planes of the camera."
    },
    {
      "InputId": "493c40f0-21e6-466b-afc2-eff570229c86"/*MaxSamples*/,
      "Position": {
        "X": 246.16498,
        "Y": -28.211914
      },
      "Description": "Controls the fidelity of the effect.\nHigher numbers create smoother results at the cost of rendering speed.",
      "AddPadding": "True"
    },
    {
      "InputId": "97b76d02-e735-4e93-88ad-5c9b8766a63c"/*FocusDistance*/,
      "Position": {
        "X": 246.16498,
        "Y": -168.21191
      },
      "Description": "Distance from the camera that stays sharp."
    },
    {
      "InputId": "bc1685a8-0a92-460f-85ca-7f096db965f0"/*TextureBuffer*/,
      "Relevancy": "Required",
      "Position": {
        "X": -153.90164,
        "Y": -606.87604
      },
      "Description": "Color buffer of the rendered scene, e.g. from [RenderTarget]."
    },
    {
      "InputId": "c2e7ebf7-5056-4380-9a9f-850b350804c9"/*DepthBuffer*/,
      "Relevancy": "Required",
      "Position": {
        "X": 72.37915,
        "Y": -432.52582
      },
      "Description": "Depth buffer of the same [RenderTarget]."
    }
  ],
