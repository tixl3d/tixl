{
  "FormatVersion": 3,
  "Id": "3dae14a8-3d0b-432f-b951-bdd7afd7e5f8"/*ApplyCamMatrices*/,
  "Description": "Internal helper. Applies a camera view matrix, given as Vector4 rows, to the object transform of the connected commands.\n\nThe X and Y axes are divided by the projection scale factors of CamToClipSpaceRows. [DrawCamGizmos] uses this to draw a camera frustum.",
  "SymbolTags": "16",
  "InputUis": [
    {
      "InputId": "6dd0ec68-5b73-4c19-8043-1ca91bbd0af3"/*CamToClipSpaceRows*/,
      "Relevancy": "Required",
      "Position": {
        "X": 15.714638,
        "Y": 102.57604
      },
      "Description": "Camera-to-clip-space matrix as four Vector4 rows. Only its X and Y scale factors are used."
    },
    {
      "InputId": "86fa7a95-c6df-4bb8-a447-e92882a99037"/*WorldToCamRows*/,
      "Relevancy": "Required",
      "Position": {
        "X": 15.714638,
        "Y": 57.576042
      },
      "Description": "World-to-camera matrix as four Vector4 rows."
    },
    {
      "InputId": "aad90ca4-5085-4b90-bf58-b87bdc852d62"/*Command*/,
      "Relevancy": "Required",
      "Position": {
        "X": 15.714638,
        "Y": 12.576044
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "bd6cd982-c99e-4366-906a-2f0280cf32de"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}