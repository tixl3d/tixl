{
  "FormatVersion": 3,
  "Id": "0ed2bee3-641f-4b08-8685-df1506e9af3c"/*SetMaterial*/,
  "Description": "Sets the physically based rendering (PBR) material for the connected subgraph, used by [DrawMesh], [DrawScene] and other PBR draw operators.\n\nEach material property can be controlled by a value and/or a texture, e.g. from [LoadImage]. Colors are multiplied with their textures, so for an emissive texture to be visible, EmissiveColor must not be black. Roughness and Metal are added to the values of the RoughnessMetallicOcclusionMap. The roughness rendering requires an environment set by [SetEnvironment]; without it a predefined default environment is used.\n\nThe Reference output can be used with [UseMaterial] or [DefineMaterials].\n\nAKA: pbr, shader, surface, texture\n\nTips:\n- Use [CombineMaterialChannels] to combine roughness, metallic and occlusion textures into a single texture.\n- If no normal map is available, [NormalMap] can be used to generate one.\n\nSee also: [UseMaterial], [DefineMaterials], [SetEnvironment]\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0eb51df1-570a-4ac6-bae6-5e03d6e66ceb"/*BaseColorMap*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Base color (albedo) texture, e.g. from [LoadImage]."
    },
    {
      "InputId": "108ff533-f205-4989-b894-acf48e3cc1db"/*Metal*/,
      "Position": {
        "X": -200.0,
        "Y": 270.0
      },
      "Description": "Defines how metallic the surface reacts to light and reflects the environment. Added to the green channel of the RoughnessMetallicOcclusionMap.\n\nA value of 1 can create a look similar to chrome.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "2a585a23-b60c-4c8b-8cfa-9ab2a8b04c7a"/*SubTree*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "2c91c306-1815-4b22-a70f-746232f024d7"/*EmissiveColor*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "Description": "Color and brightness of the light emitted by the surface. Multiplied with the EmissiveColorMap.\n\nEmissive materials do not illuminate other objects; scenes are lit with [SetEnvironment] and [PointLight].",
      "AddPadding": "True"
    },
    {
      "InputId": "600bbc24-6b3a-4ac4-9ceb-702e71c839e9"/*NormalMap*/,
      "Position": {
        "X": -200.0,
        "Y": 315.0
      },
      "GroupTitle": "Additional Maps",
      "Description": "Tangent space normal map texture."
    },
    {
      "InputId": "6d859756-0243-42c5-973d-6de2dcdc5609"/*EmissiveColorMap*/,
      "Position": {
        "X": -200.0,
        "Y": 405.0
      },
      "Description": "Emissive texture. EmissiveColor must not be black for it to be visible."
    },
    {
      "InputId": "71e289f0-382b-4d0f-a2e0-701c7019a360"/*MaterialId*/,
      "Position": {
        "X": -200.0,
        "Y": 405.0
      },
      "Description": "Name of the material, used to select it in [DrawScene] when defined with [DefineMaterials].",
      "Usage": "Default"
    },
    {
      "InputId": "9d5ca726-28b0-4f3d-a5aa-f0ae3e2043a9"/*Specular*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "GroupTitle": "Material Settings",
      "Description": "Intensity of the highlights of light sources."
    },
    {
      "InputId": "9ff5ade2-cfa7-4616-ad89-356f3248e04f"/*BaseColor*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "GroupTitle": "Color Maps",
      "Description": "Multiplied with the BaseColorMap."
    },
    {
      "InputId": "c8003fbd-c6ce-440c-9f1f-6b15b5ee5274"/*RoughnessMetallicOcclusionMap*/,
      "Position": {
        "X": -200.0,
        "Y": 360.0
      },
      "Description": "Texture with roughness in the red, metallic in the green and ambient occlusion in the blue channel."
    },
    {
      "InputId": "e14dcc43-7c18-4ed7-ad39-dfeab10e3d33"/*Roughness*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Defines how much reflections and highlights are blurred. Added to the red channel of the RoughnessMetallicOcclusionMap.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "d80e1028-a48d-4171-8c8c-e6856bd2143d"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "OutputId": "51612678-3573-4d40-a423-9e23fc72ea44"/*Reference*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    }
  ]
}