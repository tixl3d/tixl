{
  "FormatVersion": 3,
  "Id": "8e9ddaba-ef3f-4268-a8c4-e72ef9e45aed"/*DirectionalLight*/,
  "Description": "Adds a directional light, like sunlight, with an arrow gizmo to the connected subgraph.\n\nAll surfaces are lit along the direction from Position to Target with the same Intensity, independent of distance. Position only places the gizmo. With the operator selected, the move gizmo moves the arrow and the rotate gizmo swings Target around it. It shares the limit of 8 lights with point and spot lights.\n\nAKA: sun, sunlight, distant light, parallel light\n\nSee also: [SetDirectionalLight], [SpotLight], [PointLight], [SetEnvironment]",
  "SymbolTags": "16",
  "InputUis": [
    {
      "InputId": "1637524b-a338-4bf7-bc30-ee48f9d9d4f9"/*GizmoSize*/,
      "Position": {
        "X": 770.0,
        "Y": 455.0
      },
      "Description": "Size of the drawn arrow.",
      "Min": 0.0,
      "Max": 5.0,
      "ClampMin": true
    },
    {
      "InputId": "314cf0cf-3804-4a48-83b1-1e065aa1006f"/*Intensity*/,
      "Position": {
        "X": 840.0,
        "Y": 245.0
      },
      "Description": "Brightness of the light.",
      "Min": 0.0,
      "Max": 10.0,
      "ClampMin": true
    },
    {
      "InputId": "343cf9ba-aad6-423a-a341-0fb95bd458da"/*Color*/,
      "Position": {
        "X": 140.0,
        "Y": 280.0
      },
      "Description": "Sets the color of the light and the gizmo."
    },
    {
      "InputId": "6fce9306-80c8-4c94-bb60-bdcd2ff6dd73"/*IsEnabled*/,
      "Position": {
        "X": 910.0,
        "Y": 70.0
      },
      "Description": "Turns the light on or off. The connected subgraph is drawn in both cases.",
      "AddPadding": "True"
    },
    {
      "InputId": "70bfb720-55ff-4936-b3f5-f894b3a4fa71"/*Command*/,
      "Position": {
        "X": 770.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "a67fdfb7-f18e-44b8-aee8-d112070f5f98"/*Position*/,
      "Position": {
        "X": 770.0,
        "Y": 175.0
      },
      "Description": "Where the gizmo is drawn. Only the direction from Position to Target affects the light.",
      "AddPadding": "True"
    },
    {
      "InputId": "ca8eaafd-94ee-431e-8f33-d7234a3258e7"/*ShowGizmo*/,
      "Position": {
        "X": 980.0,
        "Y": 490.0
      },
      "GroupTitle": "Gizmo",
      "Description": "Off = The gizmo is never visible\nOn = The gizmo is always visible\nIfSelected = The gizmo is visible while the operator is selected\nInherit = Follows the setting of the Output window"
    },
    {
      "InputId": "d49db40d-47d7-4a07-be8a-5a29ed0cd2a1"/*Target*/,
      "Position": {
        "X": 560.0,
        "Y": 210.0
      },
      "Description": "The light travels from Position toward this point. With the operator selected, the rotate gizmo swings it around Position."
    }
  ],
