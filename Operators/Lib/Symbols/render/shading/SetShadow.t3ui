{
  "FormatVersion": 3,
  "Id": "facb7925-176a-4eae-bedc-cdbf532ff6ff"/*SetShadow*/,
  "Description": "Renders a shadow map of the connected subgraph from a light, so that [DrawMesh] operators inside it receive cast shadows.\n\nPut it below a [SpotLight] or [DirectionalLight] (FromLight mode) and the shadow follows that light. All draws in the subgraph cast shadows, but only [DrawMesh] receives them. The shadow pass draws depth only and hides gizmos. The ShadowMap output shows the depth map for checking resolution and range.\n\nAKA: shadowmap, castshadow\n\nSee also: [DrawMesh], [SpotLight], [DirectionalLight]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "11ff37c1-46f4-4b5c-a12a-22c25c73fa38"/*SourceLight*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "The light that casts the shadow. \"1st Light\" is the light operator closest above, \"2nd Light\" the next one further up. Picking a light by name keeps the shadow on that light when other lights are added.",
      "Usage": "CustomDropdown"
    },
    {
      "InputId": "244b972a-2d18-4c2d-bcba-a2b480ecbada"/*ShadowBias*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "How much deeper than the occluder a surface must be to count as shadowed. Increase it if lit surfaces show striped self-shadowing (acne).",
      "Min": 0.0,
      "Max": 0.001,
      "ClampMin": true
    },
    {
      "InputId": "298be67d-77eb-49b3-a65a-dc3e2d5bef7c"/*ShadowColor*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "GroupTitle": "Look",
      "Description": "Color that shadowed surfaces are blended towards. Alpha is the strength of the shadow, 0 disables it."
    },
    {
      "InputId": "3ee1e726-b5b8-4479-92cc-1a46886ddfd2"/*Resolution*/,
      "Position": {
        "X": -200.0,
        "Y": 270.0
      },
      "GroupTitle": "Shadow Map",
      "Description": "Width and height of the shadow map in pixels. Higher values give sharper shadows and cost more memory and fill rate.",
      "Min": 256,
      "Max": 4096,
      "ClampMin": true
    },
    {
      "InputId": "5fb309a1-f164-4fe0-95e2-3bfc37823f78"/*DepthRange*/,
      "Position": {
        "X": -200.0,
        "Y": 315.0
      },
      "Description": "Near and far distance of the shadow camera. Geometry outside this range casts no shadow; a tighter range gives more precise shadows.",
      "UseVec2Control": "Range"
    },
    {
      "InputId": "6196074f-4770-4e81-812a-012fcaab207b"/*LightPosition*/,
      "Position": {
        "X": -200.0,
        "Y": 360.0
      },
      "GroupTitle": "Manual and Fallback",
      "Description": "Position the shadow is cast from in Manual mode, or when no matching light is found."
    },
    {
      "InputId": "75814c4f-ca49-4103-9096-32c9f8326830"/*Mode*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "FromLight: the shadow is cast from the light picked in SourceLight. Spot lights use their cone, directional lights cover AreaSize around LightTarget, point lights shine towards LightTarget within FieldOfView. Without a matching light it falls back to Manual.\n\nManual: the shadow is cast from LightPosition towards LightTarget within FieldOfView.",
      "DisplayAs": "SegmentedSwitch"
    },
    {
      "InputId": "76a6a0e4-168d-4172-9946-e843df9d0ca0"/*LightTarget*/,
      "Position": {
        "X": -200.0,
        "Y": 405.0
      },
      "Description": "Point the shadow camera looks at in Manual mode and for point lights. For directional lights, the center of the area that receives shadows."
    },
    {
      "InputId": "76cd5b13-b23c-4cbc-bdab-c7d1d6222f48"/*AreaSize*/,
      "Position": {
        "X": -200.0,
        "Y": 495.0
      },
      "Description": "Width and height, in world units, of the area around LightTarget that receives shadows from a directional light.",
      "Min": 1.0,
      "Max": 50.0,
      "ClampMin": true
    },
    {
      "InputId": "be6dc055-d4c8-4c75-a084-12c22a268034"/*Command*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "The scene that casts and receives shadows."
    },
    {
      "InputId": "d903772c-8dff-4147-868c-a461edaf3f9f"/*FieldOfView*/,
      "Position": {
        "X": -200.0,
        "Y": 450.0
      },
      "Description": "Opening angle of the shadow camera in degrees, in Manual mode and for point lights. Spot lights use their cone.",
      "Min": 10.0,
      "Max": 150.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "df4d2b87-2ec0-457f-ba69-8ae0ae684a02"/*NormalOffset*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Moves the shadow lookup along the surface normal, in shadow map texels, so it scales with resolution, area and distance. Removes striped self-shadowing (acne); too large values detach shadows from their casters.",
      "Min": 0.0,
      "Max": 8.0
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "86d41b9d-fde7-41da-91e9-3708625b8b81"/*ShadowMap*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    },
    {
      "OutputId": "a0a1b038-8637-45af-89b5-dcef99f872f7"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}