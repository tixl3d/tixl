{
  "FormatVersion": 3,
  "Id": "9c67a8c8-839f-4f67-a949-08cb38b9dffd"/*PointLight*/,
  "Description": "Adds a point light with a transform gizmo to the connected subgraph.\n\nThe light illuminates geometry drawn with PBR and other shaded draw operators using Color, Intensity, Range and Decay. Up to 8 point lights can be used at the same time, e.g. by chaining several of them before the camera.\n\nNote that scenes are also lit by an environment map. Without a [SetEnvironment], a default environment is used.\n\nAKA: light, lamp, omni, bulb\n\nSee also: [SetPointLight], [SetEnvironment], [Locator]\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "3babb43d-afe6-4c34-a4c6-950d1e3971cc"/*GizmoSize*/,
      "Position": {
        "X": 723.3138,
        "Y": 193.17346
      },
      "Description": "Size of the drawn gizmo."
    },
    {
      "InputId": "55dc52d8-51a6-497a-9624-b118e0e27c65"/*Command*/,
      "Position": {
        "X": 526.27625,
        "Y": -158.63472
      }
    },
    {
      "InputId": "7d6e2f4b-cd5b-446d-b63e-1fd8780bf0fd"/*Range*/,
      "Position": {
        "X": 386.27625,
        "Y": 16.36528
      },
      "Description": "Distance at which the light intensity has dropped to half. The intensity falls off as Intensity / ((distance / Range) ^ Decay + 1).",
      "Min": 0.01,
      "Max": 1000.0,
      "Scale": 0.001,
      "ClampMin": true
    },
    {
      "InputId": "98155900-1bb9-427a-9c4e-0988fec806cd"/*Intensity*/,
      "Position": {
        "X": -33.625046,
        "Y": 165.16278
      },
      "Description": "Brightness of the light.",
      "Min": 0.0,
      "ClampMin": true
    },
    {
      "InputId": "b5ee1e4b-3c8c-48df-bbcf-aac614de6ec9"/*ShowGizmo*/,
      "Position": {
        "X": 723.3138,
        "Y": 403.17346
      },
      "GroupTitle": "Gizmo Settings",
      "Description": "Off = The gizmo is never visible\nOn = The gizmo is always visible\nIfSelected = The gizmo is visible while the operator is selected\nInherit = Follows the \"Toggle gizmos and floor grid\" setting of the output window"
    },
    {
      "InputId": "d6f6838c-4b36-41a8-86c5-1b1fe5dcece1"/*Decay*/,
      "Position": {
        "X": 386.27625,
        "Y": 51.36528
      },
      "GroupTitle": "Decay",
      "Description": "Exponent of the falloff beyond Range. Higher values make the light fade faster with distance.",
      "Scale": 0.01
    },
    {
      "InputId": "f3ca8d13-4e24-4718-a59c-6a1b9a2a3c04"/*IsEnabled*/,
      "Position": {
        "X": 745.2842,
        "Y": -85.07857
      },
      "Description": "Turns the light on or off. The connected subgraph is drawn in both cases.",
      "AddPadding": "True"
    },
    {
      "InputId": "f6d96a01-dc90-49c7-9152-a6a42bb05218"/*Position*/,
      "Position": {
        "X": -29.352737,
        "Y": 95.74985
      },
      "Description": "World space position of the light.",
      "AddPadding": "True"
    },
    {
      "InputId": "ff3442c5-95c8-4bd6-a492-cb4a9a597ea1"/*Color*/,
      "Position": {
        "X": -32.709534,
        "Y": 229.38791
      },
      "Description": "Sets the color of the light."
    }
  ],
