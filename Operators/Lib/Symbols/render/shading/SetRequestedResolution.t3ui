{
  "FormatVersion": 3,
  "Id": "5b3a0c1d-87d6-4d88-ae20-ff9f95049ecf"/*SetRequestedResolution*/,
  "Description": "Sets the requested resolution for the operators connected to the Texture input, similar to the resolution dropdown of the output window.\n\nImage operators with a resolution of 0 use the requested resolution, so this can be used to render a whole image subgraph at a different resolution.\n\nSee also: [RequestedResolution], [SetRequestedResolutionCmd]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "c545b200-b3a8-42a8-ac83-d85c3b6e58ee"/*ScaleResolution*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Factor applied to either the new or the incoming requested resolution."
    },
    {
      "InputId": "d6303c59-5ea2-43b3-8e73-218b99d7df5f"/*Resolution*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "New resolution. Ignored unless both components are greater than 0."
    },
    {
      "InputId": "dd52dd4f-84ee-421b-91e9-da0b90adb1a6"/*Texture*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "The image subgraph that is evaluated with the new resolution."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "2abe986a-6a21-4ceb-b907-5b6e317e34a1"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 600.0
      }
    }
  ]
}