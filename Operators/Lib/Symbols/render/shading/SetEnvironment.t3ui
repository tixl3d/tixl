{
  "FormatVersion": 3,
  "Id": "f3b66187-34b2-4018-8380-279f9f296ded"/*SetEnvironment*/,
  "Description": "Sets the environment map used for image-based lighting (IBL) and reflections by PBR draw operators in the connected subgraph, and optionally draws it as background.\n\nThe Texture can be an equirectangular image (e.g. an HDRI loaded with [LoadImage]), which is converted to a cube map internally, or a cube map from [TextureToCubeMap]. The environment is prefiltered into mip levels for different roughness values: sharp reflections in the highest resolution and blurry diffuse light in the lower levels. Because a single very bright pixel (e.g. the sun) can brighten the complete diffuse reflection, this computation is expensive and should not be done every frame for high resolution maps.\n\nFor the background to be aligned correctly, the camera must come after the environment, e.g. [DrawMesh] -> [SetMaterial] -> [PointLight] -> [SetEnvironment] -> [Camera].\n\nAKA: ibl, hdri, skybox, reflection, cubemap\n\nSee also: [TextureToCubeMap], [SetMaterial], [PointLight]\n\nAlso check out the [HowToDrawThings] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "0299761d-7397-4a2f-b591-81fadb404a92"/*BackgroundDistance*/,
      "Position": {
        "X": 2017.085,
        "Y": 362.39032
      },
      "Description": "Sets the radius for the sphere mesh that surrounds the scene.\n\nProTip: Clipping of the background can be prevented either by this setting or by the \"NearFarClip\" settings in the used camera."
    },
    {
      "InputId": "46d76d8a-5fb6-4138-a88b-950a2e5b8529"/*QualityFactor*/,
      "Position": {
        "X": 297.4892,
        "Y": 1345.1274
      },
      "Description": "Factor applied to the sample count used for prefiltering the roughness levels.\nWith UpdateLive enabled this has a significant impact on performance, so reduce it until artifacts become visible."
    },
    {
      "InputId": "486f4f09-2e4e-43b8-bfbc-2722e77d5dbd"/*Orientation*/,
      "Position": {
        "X": 1.7190475,
        "Y": 561.354
      },
      "Description": "Rotates an equirectangular Texture around the vertical axis."
    },
    {
      "InputId": "4f573afe-8815-4fd3-a655-89ec40bf3c22"/*RenderBackground*/,
      "Position": {
        "X": 1877.085,
        "Y": 642.3904
      },
      "GroupTitle": "Render Background",
      "Description": "If turned on the environment will be visible to the camera by being mapped on a sphere mesh around the scene."
    },
    {
      "InputId": "5c042a08-74b3-4a6b-a420-2fcfa0fc01ee"/*Texture*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": -25.607101,
        "Y": 926.63995
      },
      "Description": "Equirectangular image or cube map. If not connected, the Fallback environment is used."
    },
    {
      "InputId": "650aa9a6-4aa6-4928-be76-3f1f825aa773"/*BackgroundColor*/,
      "Position": {
        "X": 1877.085,
        "Y": 502.39038
      },
      "Description": "Tints the background with the selected color.\n\nDoes not affect the color of the light and/or reflection.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "71c54c8e-a95f-47e8-b126-0cdaa89ae49b"/*Exposure*/,
      "Position": {
        "X": -51.30281,
        "Y": 1070.1595
      },
      "Description": "Brightness with which the scene is lit by the environment.\n\nChanges are only applied while UpdateLive is enabled."
    },
    {
      "InputId": "96094239-9d82-4a32-bbb0-e9da7f6501da"/*BackgroundBlur*/,
      "Position": {
        "X": 1877.085,
        "Y": 572.3904
      },
      "Description": "Defines how much the image on the sphere in the background is blurred.\n",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "c3c815fa-8672-4d99-99a7-986844f2fc45"/*UpdateLive*/,
      "Position": {
        "X": 297.4892,
        "Y": 1164.3557
      },
      "Description": "Recomputes the prefiltered environment when the image or exposure changes. This allows animated Exposure values and live images but can significantly decrease rendering performance.",
      "AddPadding": "True"
    },
    {
      "InputId": "de6b9cb3-69ce-4b23-add6-a564648ec3a8"/*Fallback*/,
      "Position": {
        "X": 317.14874,
        "Y": 199.64827
      },
      "Description": "Environment used if no Texture is connected: 0 = studio, 1 = church interior, 2 = black."
    },
    {
      "InputId": "e4482cab-f20c-4f9f-9179-c64944164509"/*SubTree*/,
      "Relevancy": "Required",
      "Position": {
        "X": 1877.085,
        "Y": 817.39014
      }
    }
  ],
