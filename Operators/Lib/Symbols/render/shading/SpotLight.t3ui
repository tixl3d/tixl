{
  "FormatVersion": 3,
  "Id": "9dc0b2de-1f79-4d8b-8d87-6f3764875220"/*SpotLight*/,
  "Description": "Adds a spot light with a cone gizmo to the connected subgraph.\n\nThe light shines from Position toward Target in a cone of ConeAngle degrees. Distance falloff uses Range and Decay like [PointLight]. With the operator selected, the move gizmo moves the light and the rotate gizmo swings Target around it, so the cone keeps its aim while you move it. Spot, point and directional lights share the limit of 8 lights.\n\nOperators with their own lighting (cel shading, hatching, tubes, ribbons) treat it as a point light for now.\n\nAKA: spotlight, cone light, stage light, lamp\n\nSee also: [SetSpotLight], [PointLight], [DirectionalLight], [SetShadow]",
  "InputUis": [
    {
      "InputId": "0d4c855d-4122-4f68-8cd4-a8c30cfa850f"/*ConeAngle*/,
      "Position": {
        "X": 78.02582,
        "Y": 155.93604
      },
      "GroupTitle": "Cone",
      "Description": "Full opening angle of the cone in degrees.",
      "Min": 1.0,
      "Max": 120.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "1acd0b18-378a-4337-8089-4e07ddc79989"/*Target*/,
      "Position": {
        "X": 78.02582,
        "Y": -127.043304
      },
      "Description": "The light points at this point. The rotate gizmo swings it around Position."
    },
    {
      "InputId": "31b0cc5b-2351-4b49-8af6-ad74bc793ad9"/*Command*/,
      "Position": {
        "X": 875.94586,
        "Y": -273.27655
      }
    },
    {
      "InputId": "49e9bdd3-6930-41a1-8c25-f94a24dcd61a"/*Position*/,
      "Position": {
        "X": 78.02582,
        "Y": -35.99173
      },
      "Description": "World space position of the light.",
      "AddPadding": "True",
      "Scale": 0.01
    },
    {
      "InputId": "6889c5f5-3431-4800-ac75-8128b23ce57f"/*Range*/,
      "Position": {
        "X": 735.94586,
        "Y": -28.27655
      },
      "Description": "Distance at which the light intensity has dropped to half. The intensity falls off as Intensity / ((distance / Range) ^ Decay + 1).",
      "Min": 0.01,
      "Max": 1000.0,
      "Scale": 0.001,
      "ClampMin": true
    },
    {
      "InputId": "86c6c87c-5e8d-4e59-b047-2eec0a55059a"/*Decay*/,
      "Position": {
        "X": 735.94586,
        "Y": 6.7234497
      },
      "GroupTitle": "Decay",
      "Description": "Exponent of the falloff beyond Range. Higher values make the light fade faster with distance.",
      "Scale": 0.01
    },
    {
      "InputId": "9c4db6b3-bccf-4045-ad8e-cf200244aa9d"/*IsEnabled*/,
      "Position": {
        "X": 1073.454,
        "Y": -83.55928
      },
      "Description": "Turns the light on or off. The connected subgraph is drawn in both cases.",
      "AddPadding": "True"
    },
    {
      "InputId": "a93b2a2d-676c-4dad-a2fc-1433bce4662b"/*ShowGizmo*/,
      "Position": {
        "X": 735.9458,
        "Y": 462.68475
      },
      "GroupTitle": "Gizmo Settings",
      "Description": "Off = The gizmo is never visible\nOn = The gizmo is always visible\nIfSelected = The gizmo is visible while the operator is selected\nInherit = Follows the \"Toggle gizmos and floor grid\" setting of the output window"
    },
    {
      "InputId": "c10e20ae-ceb8-47d4-bb93-5ac38368210f"/*Intensity*/,
      "Position": {
        "X": 78.02582,
        "Y": 33.421204
      },
      "Description": "Brightness of the light.",
      "Min": 0.0,
      "Scale": 0.01,
      "ClampMin": true
    },
    {
      "InputId": "ddf6d27a-4e9b-4097-944f-f1042ef60f3f"/*GizmoSize*/,
      "Position": {
        "X": 735.94586,
        "Y": 392.68475
      },
      "Description": "Size of the drawn cone. Its opening follows ConeAngle.",
      "Min": 0.0,
      "Scale": 0.01,
      "ClampMin": true
    },
    {
      "InputId": "f3c26d77-de8a-4383-a24b-ab5d1063f62a"/*Color*/,
      "Position": {
        "X": 78.02582,
        "Y": 100.618744
      },
      "Description": "Sets the color of the light.",
      "Scale": 0.01
    }
  ],
