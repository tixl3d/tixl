{
  "FormatVersion": 3,
  "Id": "4912ba82-460a-4229-884d-6b647d64b08c"/*SetPointLight*/,
  "Description": "Adds a point light without a gizmo to the connected subgraph.\n\nThe light illuminates geometry drawn with PBR and other shaded draw operators using Color, Intensity, Range and Decay. Up to 8 point lights can be used at the same time. For a light with an interactive gizmo use [PointLight].\n\nNote that scenes are also lit by an environment map. Without a [SetEnvironment], a default environment is used.\n\nAKA: light, lamp, omni, bulb\n\nSee also: [PointLight], [SetEnvironment]",
  "SymbolTags": "16",
  "InputUis": [
    {
      "InputId": "0318dcc8-3e8a-4a3e-a0fd-239b55183ee9"/*Decay*/,
      "Position": {
        "X": -199.39244,
        "Y": 238.36653
      },
      "Description": "Exponent of the falloff beyond Range. Higher values make the light fade faster with distance.",
      "AddPadding": "True"
    },
    {
      "InputId": "747e043b-39e9-420c-8314-b7d1ba5d61de"/*Intensity*/,
      "Position": {
        "X": -199.39244,
        "Y": 103.36653
      },
      "Description": "Brightness of the light."
    },
    {
      "InputId": "7b77b6fb-e8bd-42a7-8fb9-5d411f9a0da6"/*Color*/,
      "Position": {
        "X": -199.39244,
        "Y": 148.36653
      },
      "Description": "Sets the color of the light."
    },
    {
      "InputId": "d46d2cb6-9ab9-4640-a3d4-e70e643bd3b4"/*Command*/,
      "Position": {
        "X": -199.39244,
        "Y": 13.366531
      }
    },
    {
      "InputId": "e825e0b5-4c04-4ce6-9aef-7d099e9d2430"/*Range*/,
      "Position": {
        "X": -199.39244,
        "Y": 193.36653
      },
      "Description": "Distance at which the light intensity has dropped to half. The intensity falls off as Intensity / ((distance / Range) ^ Decay + 1).",
      "AddPadding": "True"
    },
    {
      "InputId": "f46ed192-1f6c-415e-8fe3-6d4909859f6b"/*Position*/,
      "Position": {
        "X": -199.39244,
        "Y": 58.36653
      },
      "Description": "World space position of the light.",
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
