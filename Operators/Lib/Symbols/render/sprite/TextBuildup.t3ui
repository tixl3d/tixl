{
  "FormatVersion": 3,
  "Id": "09adcf34-0afe-46a2-b55a-24275ae7c32c"/*TextBuildup*/,
  "Description": "Animates text from [TextSprites] in and out, one character or group at a time.\n\nEach unit (a character, or a group defined by the separator of [TextSprites]) transitions from a hidden state defined by position, rotation, scale and color offsets to its resting state when RangeEnd passes its index, and back when RangeStart passes it. Rotation and scale pivot around a point within the unit's bounds.\n\nAKA: text animator, range selector, typewriter, reveal, build in\n\nTips:\n- Connect both the points and sprites of [TextSprites], and draw the result with [DrawPointSprites].\n- Enable UsePointScale on [DrawPointSprites] to scale the glyphs themselves.\n- Animate RangeStart behind RangeEnd for a moving window of visible words. OutDirection sets which way they leave.\n\nSee also: [TextSprites], [DrawPointSprites], [DrawLinesBuildup]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "0fc0df7c-ff8c-413f-a218-93a1a1a8cc42"/*Randomize*/,
      "Position": {
        "X": -500.0,
        "Y": 915.0
      },
      "Description": "Blends the order of the units towards a random shuffle.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "0fdd6dd6-2594-48f4-a96b-d5efb0d13618"/*Rotation*/,
      "Position": {
        "X": -500.0,
        "Y": 1050.0
      },
      "Description": "Rotation in degrees around the pivot before a unit is built in.",
      "Min": -180.0,
      "Max": 180.0
    },
    {
      "InputId": "144de0c1-93c2-4e1f-a6fa-4c632006af13"/*Points*/,
      "Relevancy": "Required",
      "Position": {
        "X": -500.0,
        "Y": 600.0
      }
    },
    {
      "InputId": "20d19099-d693-488f-bc7f-5a9c269c391e"/*OutDirection*/,
      "Position": {
        "X": -500.0,
        "Y": 1230.0
      },
      "Description": "Multiplies the position and rotation offsets while units build out. -1 lets them leave the opposite way they came in, 1 the way they came in.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "30d9bb95-1577-461b-9199-5ccf754d36cd"/*Sprites*/,
      "Relevancy": "Required",
      "Position": {
        "X": -500.0,
        "Y": 645.0
      },
      "Description": "The sprite buffer from [TextSprites]. Provides the group index and bounds of each glyph."
    },
    {
      "InputId": "36be48ba-ee05-4370-a8a8-58f18cc90a98"/*Scale*/,
      "Position": {
        "X": -500.0,
        "Y": 1095.0
      },
      "Description": "Scale around the pivot before a unit is built in. The glyphs themselves only scale if [DrawPointSprites] uses the point scale.",
      "Min": 0.0,
      "Max": 2.0
    },
    {
      "InputId": "38b4009b-7f3f-4ec6-87ee-0928e2f01d0f"/*GainAndBias*/,
      "Position": {
        "X": -500.0,
        "Y": 870.0
      },
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "UseVec2Control": "GainAndBias"
    },
    {
      "InputId": "62aa1538-7fe3-45b7-9e7b-7fd4ade3de69"/*Position*/,
      "Position": {
        "X": -500.0,
        "Y": 1005.0
      },
      "GroupTitle": "Hidden State",
      "Description": "Offset of a unit before it is built in.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "8a3f6d2e-41c7-4b8e-9a52-6c1e0f7d9b34"/*Gradient*/,
      "Position": {
        "X": -500.0,
        "Y": 1275.0
      },
      "GroupTitle": "Color",
      "Description": "Multiplied with the point color over a unit's whole life: the left edge before the build-in, the center while fully visible, the right edge after the build-out."
    },
    {
      "InputId": "8fd700f3-875a-4412-ad1d-2b8e867aa6f6"/*Unit*/,
      "Position": {
        "X": -500.0,
        "Y": 690.0
      },
      "GroupTitle": "Range",
      "Description": "Animates single characters, or the groups defined by the separator of [TextSprites]."
    },
    {
      "InputId": "98d520ff-5fe1-4787-89f6-a081eb742f7b"/*Pivot*/,
      "Position": {
        "X": -500.0,
        "Y": 1185.0
      },
      "Description": "Center of rotation and scale within the bounds of the unit. (0,0) is the center, (-1,-1) the bottom left corner.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "be8618a5-388b-469f-831d-8b5dbf8a6863"/*Color*/,
      "Position": {
        "X": -500.0,
        "Y": 1140.0
      },
      "Description": "Multiplied with the point color before a unit is built in. The default alpha of 0 fades the units in.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "c3bf5524-8487-4603-bff9-6aed9246aa61"/*RangeStart*/,
      "Position": {
        "X": -500.0,
        "Y": 780.0
      },
      "ExcludedFromPresets": "True",
      "Description": "Units with an index below this value are built out again.",
      "Min": 0.0,
      "Max": 20.0
    },
    {
      "InputId": "cd867336-0aca-47e1-a8fd-7559c143b8c2"/*RangeEnd*/,
      "Position": {
        "X": -500.0,
        "Y": 735.0
      },
      "ExcludedFromPresets": "True",
      "Description": "Units with an index below this value are built in. Animate it from 0 to the unit count to reveal the text.",
      "Min": 0.0,
      "Max": 20.0
    },
    {
      "InputId": "e1a048e7-81e5-4ec6-a822-c6af9d8a0476"/*Seed*/,
      "Position": {
        "X": -500.0,
        "Y": 960.0
      }
    },
    {
      "InputId": "ff39bf17-e051-4bc7-92a6-bc9685b25cca"/*Spread*/,
      "Position": {
        "X": -500.0,
        "Y": 825.0
      },
      "Description": "Length of each unit's transition, in units. 1 plays them one after another, larger values overlap them, smaller values leave pauses.",
      "Min": 0.0,
      "Max": 5.0,
      "ClampMin": true
    }
  ],
