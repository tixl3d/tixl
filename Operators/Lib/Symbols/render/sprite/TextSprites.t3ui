{
  "FormatVersion": 3,
  "Id": "1a6a58ea-c63a-4c99-aa9d-aeaeb01662f4"/*TextSprites*/,
  "Description": "Creates points and sprites from text that can be animated and then rendered with [DrawPointSprites] or [DrawPointSpritesShaded].\n\nThis operator loads a BMFont font definition with the matching MSDF (multichannel signed distance field) texture and generates a set of buffers that can be modified and combined with other operators.\n\nThe point buffer includes position, orientation, color, F1, F2 and scale for each character. The sprite buffer contains additional attributes for rendering like texture coordinates, pivot, size and layout information.\n\nAKA: typography, font, glyphs, letters, msdf\n\nTips:\n- The point buffer can be replaced with another buffer (e.g. from [RadialPoints]).\n- For basic text rendering, consider using [Text].\n\nSee also: [Text], [DrawPointSprites]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "14829eac-ba59-4d31-90dc-53c7fc56cc30"/*VerticalAlign*/,
      "Position": {
        "X": -200.0,
        "Y": 315.0
      },
      "GroupTitle": "Align"
    },
    {
      "InputId": "1cde902d-5eaa-4144-b579-85f54717356b"/*Color*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "GroupTitle": "Appearance",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "5008e9b4-083a-4494-8f7c-50fe5d80fc35"/*Size*/,
