        "X": -200.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "7094d22f-dcf9-4fd0-9570-7243e3284cf4"/*OffsetBaseLine*/,
      "Position": {
        "X": -200.0,
        "Y": 405.0
      },
      "Description": "Shifts the characters vertically relative to the baseline, in font pixel units.",
      "AddPadding": "True"
    },
    {
