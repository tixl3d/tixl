{
  "FormatVersion": 3,
  "Id": "dfd4c912-4c4f-44b1-88aa-f27aa66b57af"/*ActionCamera*/,
  "Description": "Interactively flies a camera like in a game, starting from a connected reference camera.\n\nThe movement and rotation inputs are velocities: they are integrated over time each frame, so connecting them to a game controller, MIDI or keyboard input steers the camera continuously. A value of 0 stops the motion.\n\nAKA: flythrough, walkthrough, fps, pov, navigation\n\nSee also: [BlendCameras], [Camera], [OrbitCamera]",
  "InputUis": [
    {
      "InputId": "37bbaf47-5985-42d7-801e-0bf099036d5f"/*UpDown*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Description": "Movement speed along the world up axis.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "3857258a-ca2d-4dad-b926-28530e8a25b0"/*BlendToReferenceCamera*/,
      "Position": {
        "X": 0.0,
        "Y": 300.0
      },
      "Description": "Smoothly pulls the camera back towards the reference camera. 0 keeps the current flight position, 1 jumps to the reference."
    },
    {
      "InputId": "44ed03fc-3551-4519-8b4c-dfdc1ddd1713"/*Speed*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "Move",
      "Description": "Multiplier for Forward, Sideways, UpDown and Roll."
    },
    {
      "InputId": "773f0b8f-16d4-4302-b26d-43cf4d4adce8"/*Yaw*/,
      "Position": {
        "X": 0.0,
        "Y": 300.0
      },
      "Description": "Rotation speed around the world y-axis.",
      "AddPadding": "True",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "832cd0d8-66be-4f45-9aea-6e439be5a285"/*Pitch*/,
      "Position": {
        "X": 0.0,
        "Y": 375.0
      },
      "Description": "Rotation speed around the side axis.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "8ac6c739-3741-4816-8bad-57bd2a226e02"/*TriggerReset*/,
      "Position": {
        "X": 0.0,
        "Y": 375.0
      },
      "Description": "Jumps back to the reference camera."
    },
    {
      "InputId": "a93aa4ac-487c-4441-b501-742cd38a5f5e"/*Forward*/,
      "Position": {
        "X": 0.0,
        "Y": 75.0
      },
      "AddPadding": "True",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "b117d2dc-eb4c-408e-9ab7-909d17ac3069"/*RotationSpeed*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "GroupTitle": "Rotation",
      "Description": "Multiplier for Yaw and Pitch."
    },
    {
      "InputId": "c529af20-2e52-4a29-b558-cd518bdc539d"/*Roll*/,
      "Position": {
        "X": 0.0,
        "Y": 450.0
      },
      "Description": "Roll speed. The roll accumulates over time and does not affect the movement direction.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "c5daddd7-a832-40d1-aec3-3886803a3899"/*Sideways*/,
      "Position": {
        "X": 0.0,
        "Y": 150.0
      },
      "Description": "Movement speed perpendicular to the view direction and the world up axis.",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "cb55671f-a20d-42a3-b19c-7c8ee5d7f865"/*FOV*/,
      "Position": {
        "X": 0.0,
        "Y": 525.0
      },
      "Description": "Rate of change of the field of view per second. The field of view is clamped to a valid range."
    },
    {
      "InputId": "d46ee53d-887b-4e37-b5ba-4ee0ba50c711"/*ReferenceCamera*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 450.0
      },
      "Description": "Reference output of a camera (e.g. [Camera]) that defines the starting point. Required."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "66784a52-d003-4c7d-b3cf-bdca4acb041e"/*Reference*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    }
  ]
}