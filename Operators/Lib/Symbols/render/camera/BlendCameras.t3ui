{
  "FormatVersion": 3,
  "Id": "e3ff58e2-847a-4c97-947c-cfbcf8f9c79d"/*BlendCameras*/,
  "Description": "Smoothly blends between multiple cameras by using a floating point index.\n\nThe position, target, roll, field of view and other camera properties of the two neighboring cameras are interpolated. The result is applied to the connected Command and is also available as a camera reference output, e.g. for [ActionCamera] or [ReuseCamera].\n\nAKA: switcher, cut, crossfade\n\nSee also: [Camera], [ReuseCamera]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "3b71fdbf-cb2d-45f1-84dd-7ac66763e6ae"/*Index*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Selects the camera. Fractional values blend between neighboring cameras, e.g. 1.5 is halfway between the second and third camera. Clamped to the number of connected cameras."
    },
    {
      "InputId": "c7ee5d97-86c1-442f-91d0-b60e6cfe24c7"/*Command*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "ff2ed90b-38bd-4ba8-af07-23be87eabcc3"/*CameraReferences*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Reference outputs of the cameras to blend between, e.g. from [Camera]. Their own Command inputs do not need to be connected."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "d0a6f926-c4ed-4cc9-917d-942f8c34fd65"/*Output*/,
      "Position": {
        "X": 15.503039,
        "Y": -76.40784
      }
    },
    {
      "OutputId": "2dd98046-f80c-4cfb-8a90-ae46515ee07f"/*CameraReference*/,
      "Position": {
        "X": 15.503039,
        "Y": 23.592163
      }
    }
  ]
}