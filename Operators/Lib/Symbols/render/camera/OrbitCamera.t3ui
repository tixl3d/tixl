{
  "FormatVersion": 3,
  "Id": "6415ed0e-3692-45e2-8e70-fe0cf4d29ebc"/*OrbitCamera*/,
  "Description": "Sets a camera that orbits around the scene with optional random wobble for an easy dynamic camera setup.\n\nEach angle input combines a base value in degrees (X) with a random wobble range (Y) that is animated with Perlin noise controlled by WobbleSpeed, WobbleComplexity and Seed. The Reference output can be used like that of a [Camera].\n\nThis operator was previously known as RandomCamera.\n\nAKA: turntable, orbit, random, shake, handheld\n\nSee also: [Camera], [ActionCamera]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "066cd0e7-de72-4e04-bf13-686ccc301c5a"/*AimYawAngleAndWobble*/,
      "Position": {
        "X": -224.62245,
        "Y": -129.46722
      },
      "Description": "X = Turns the view direction left or right in degrees\nY = Random wobble range in degrees",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "0ad10e15-06ef-4dde-8eb3-ed7fe989c88e"/*WobbleComplexity*/,
      "Position": {
        "X": -224.62245,
        "Y": 5.532776
      },
      "Description": "Number of noise octaves for the wobble (1 to 8)."
    },
    {
      "InputId": "11b13db2-3c91-4199-8245-50af200e3a9d"/*PositionOffset*/,
      "Position": {
        "X": -224.62245,
        "Y": 230.53278
      },
      "Description": "Offsets the camera position, rotated with the orbit."
    },
    {
      "InputId": "1af76b2e-cffe-4e3f-8793-c7a59d00430b"/*AimRollAngleAndWobble*/,
      "Position": {
        "X": -224.62245,
        "Y": -219.46722
      },
      "Description": "X = Rolls the camera in degrees\nY = Random wobble range in degrees",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "21f595ad-0808-48f1-bdd8-118d1527944c"/*FOV*/,
      "Position": {
        "X": -224.62245,
        "Y": -474.98328
      },
      "Description": "Defines the field of view (fov) or focal length of the camera in degrees"
    },
    {
      "InputId": "33752356-8348-4938-8f73-6257e6bb1c1f"/*Command*/,
      "Relevancy": "Required",
      "Position": {
        "X": -224.62245,
        "Y": -564.9833
      },
      "Description": "Scene input"
    },
    {
      "InputId": "353e2f08-a55f-48ce-ae65-53d5d081b6f0"/*NearFarClip*/,
      "Position": {
        "X": -224.62245,
        "Y": 140.53278
      },
      "GroupTitle": "Advanced Camera Settings",
      "Description": "Defines the start and end of the area in which objects are rendered by the camera."
    },
    {
      "InputId": "46aa9ce1-ec54-43c5-ad5e-2ca679a254fd"/*OverrideTime*/,
      "Position": {
        "X": -224.62245,
        "Y": 320.53278
      },
      "Description": "If connected, replaces the local time used for spinning and wobble."
    },
    {
      "InputId": "4d2d2d2d-00bd-4df9-b209-62f0c7926c38"/*AimPitchAngleAndWobble*/,
      "Position": {
        "X": -224.62245,
        "Y": -174.46722
      },
      "Description": "X = Turns the view direction up or down in degrees\nY = Random wobble range in degrees",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "7412e22c-1f15-4471-883b-4fcd792146f7"/*SpinAngleAndWobble*/,
      "Position": {
        "X": -224.62245,
        "Y": -84.467224
      },
      "Description": "X = Additional orbit angle in degrees, same as SpinOffset\nY = Random wobble range in degrees",
      "Min": -180.0,
      "Max": 180.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "8b75047f-03b7-4619-8869-2906e66731d1"/*OrbitAngleAndWobble*/,
      "Position": {
        "X": -224.62245,
        "Y": -264.46722
      },
      "GroupTitle": "Wobble Ranges",
      "Description": "X = Elevation angle of the orbit in degrees\nY = Random wobble range in degrees",
      "Min": -89.0,
      "Max": 89.0,
      "Scale": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "8c4dab88-68cb-40cc-b576-ca3f3ea8461f"/*SpinOffset*/,
      "Position": {
        "X": -224.62245,
        "Y": -309.46722
      },
      "Description": "Orbit angle offset in degrees.",
      "Min": -360.0,
      "Max": 360.0,
      "Scale": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "acf14901-3373-4b0c-8567-03ea0051a21f"/*CameraTargetPosition*/,
      "Position": {
        "X": -224.62245,
        "Y": -519.9833
      },
      "Description": "Point the camera looks at. Note that the orbit itself stays centered around the world origin.",
      "AddPadding": "True"
    },
    {
      "InputId": "b6bf6fe1-6733-46c0-a274-fab2a950f606"/*WobbleSpeed*/,
      "Position": {
        "X": -224.62245,
        "Y": -39.467224
      },
      "GroupTitle": "Wobble Settings",
      "Description": "Speed of the random wobble of all angle inputs."
    },
    {
      "InputId": "bd1bc8a5-72ce-42b0-8914-4f6e124a18ae"/*AspectRatio*/,
      "Position": {
        "X": -224.62245,
        "Y": 230.53278
      },
      "Description": "For values of 0 or below, the aspect ratio of the current render resolution is used."
    },
    {
      "InputId": "c81b91c6-2d06-4e3e-97bd-01d60f5f0f7d"/*RotationOffset*/,
      "Position": {
        "X": -224.62245,
        "Y": 185.53278
      },
      "Description": "Additional aim rotation in degrees (X: yaw, Y: pitch, Z: roll).",
      "AddPadding": "True"
    },
    {
      "InputId": "dd81b2aa-3252-4130-8def-a5b399d3e283"/*Seed*/,
      "Position": {
        "X": -224.62245,
        "Y": 95.532776
      },
      "Description": "Random seed for the wobble and the initial orbit angle.",
      "AddPadding": "True"
    },
    {
      "InputId": "dd92fb0a-4b3e-4492-bf59-437d914a1ad3"/*DistanceToTarget*/,
      "Position": {
        "X": -224.62245,
        "Y": -399.46722
      },
      "Description": "Radius of the orbit around the world origin.",
      "Scale": 0.01
    },
    {
      "InputId": "df65e717-e2fd-4e4f-9e41-d6bcd3fe67f1"/*SpinRate*/,
      "Position": {
        "X": -224.62245,
        "Y": -354.46722
      },
      "GroupTitle": "Rotation",
      "Description": "Orbit revolutions per time unit (bar).",
      "Min": -1.0,
      "Max": 1.0
    },
    {
      "InputId": "f51b38d7-2380-457f-897d-2429b2ad6ac3"/*Up*/,
      "Position": {
        "X": -224.62245,
        "Y": 275.53278
      },
      "Description": "Up vector of the camera before the roll is applied."
    },
    {
      "InputId": "fb113fd1-3edf-4db6-9dfb-800c62070d69"/*Damping*/,
      "Position": {
        "X": -224.62245,
        "Y": 50.532776
      },
      "Description": "Smooths the camera motion over time. 0 = no damping, values close to 1 are very smooth."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "14a63b62-5fbb-4f82-8cf3-d0faf279eff8"/*Output*/,
      "Position": {
        "X": 46.534637,
        "Y": -529.58466
      }
    },
    {
      "OutputId": "451245e2-ac0b-435a-841e-7c9edc804606"/*Reference*/,
      "Position": {
        "X": 126.08783,
        "Y": 124.374084
      }
    }
  ]
}