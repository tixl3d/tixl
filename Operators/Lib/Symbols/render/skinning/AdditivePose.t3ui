{
  "FormatVersion": 3,
  "Id": "6b3f8d92-a541-4c78-b0e6-29d7c14f85a3"/*AdditivePose*/,
  "Description": "Layers an additive pose on top of a base pose.\n\nThe additive contribution is the difference between the Additive pose and the skeleton's rest pose, scaled by Weight. Joints where the additive pose equals the rest pose stay untouched, so additive clips can target only a few joints.",
  "InputUis": [
    {
      "InputId": "04c7f2e9-8b35-4d61-a9f0-57e3d18c46b2"/*Setup*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      }
    },
    {
      "InputId": "38e6c0a4-d19b-4572-9fe8-b25a41c6d793"/*BasePose*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "5df03a86-27c4-4b91-8e35-fa1608d92c47"/*Weight*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      }
    },
    {
      "InputId": "92b5e731-4f0c-48a6-bd27-c690f5a3e814"/*SkeletonIndex*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "f90d54b7-6a28-4e13-85cf-1c74b09e62d8"/*Additive*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "c48a17e6-95d3-4f20-8b6c-e07d3a92f514"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}