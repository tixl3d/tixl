{
  "FormatVersion": 3,
  "Id": "cc11774e-82dd-409f-97fb-5be3f2746f9d"/*CalcInt2DispatchCount*/,
  "Description": "Converts a 2D size (e.g. a texture resolution) into a thread group dispatch count for a compute shader.\n\nThe result is Size / ThreadGroups + 1 groups in X and Y.\n\nSee also: [CalcDispatchCount]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "714e7c0d-0137-4bc6-9e5b-93386b2efe13"/*Size*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "71fe6847-b8e3-4cc7-895c-b10db0136e1c"/*ThreadGroups*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Thread group size of the compute shader. Only X and Y are used."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "3b0f7d82-3254-4b4d-baea-bc9aa003768a"/*DispatchCount*/,
      "Position": {
        "X": 300.0,
        "Y": 200.0
      }
    }
  ]
}