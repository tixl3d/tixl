{
  "FormatVersion": 3,
  "Id": "0b8f2d4e-6a1c-47d3-9f5e-8c2a1b7d4e60"/*SendToOutput*/,
  "Description": "Supplies a texture to the project's active output setup.\n\nRouting lives in the setup, not on this op: the setup holds a content source standing 1:1 with this node, slices cut rectangles from it, and surfaces name the slice they show. So one render can be sliced across many surfaces without this op knowing about any of them.\n\nThis is a sink: it needs no output connection.\n\nAKA: corner pin, perspective, map, warp, projector output, send, sink, slice, atlas",
  "InputUis": [
    {
      "InputId": "1a50c781-1a20-4736-9ec4-60ff2254a537"/*ExposeToParents*/,
      "Position": {
        "X": -200.0,
        "Y": 300.0
      },
      "Description": "Makes this send visible to parent compositions when it sits inside a nested composition."
    },
    {
      "InputId": "1d83a6f2-49c0-4e17-8b5d-c72e90fa4b36"/*Color*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "3125e84e-8644-46a9-8fae-e88ed06731f4"/*SizeFrom*/,
      "Position": {
        "X": -200.0,
        "Y": 270.0
      },
      "Description": "Where the render size comes from. Resolution: the Resolution input, or the size of the output this content is routed to when that is 0×0. Surface: the aspect of the surface or region showing this content, at a pixel per output pixel where it is projected densest, so a [Layer2d] fills it without distortion and nothing is upscaled. A surface on no output yet uses its pixels per metre."
    },
    {
      "InputId": "fd8d094d-dd51-4659-8aab-ca9a028bee33"/*ResolutionFactor*/,
      "Position": {
        "X": -200.0,
        "Y": 345.0
      },
      "Description": "Scales a size this op works out on its own: the surface's size, or the output's size while Resolution is 0×0. 0.5 renders at half size for heavy content, 2 renders sharper fine text. A Resolution you type in is used exactly.",
      "Min": 0.25,
      "Max": 2.0,
      "ClampMin": true
    },
    {
      "InputId": "3c7f1e58-0a94-4d62-b8f3-2e5d9a0c4b17"/*Resolution*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Resolution the content is rendered at. 0x0 uses the resolution of the output it is routed to."
    },
    {
      "InputId": "8a4dd1b3-2e6f-4c25-9d0a-7f3b61c8e942"/*Texture*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "9a1c4f7e-2d38-4b6a-8e50-1f7c3d9b0a24"/*Update*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": []
}