        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "e6192d45-6f70-4c8b-bd04-528319e36c27"/*OutputRef*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Usage": "OutputSetupEntities"
    }
  ],
