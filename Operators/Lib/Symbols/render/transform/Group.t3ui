{
  "FormatVersion": 3,
  "Id": "a3f64d34-1fab-4230-86b3-1c3deba3f90b"/*Group*/,
  "Description": "Groups several draw commands and applies a transform and color to all of them.\n\nSimilar to [Execute], but it also allows to transform the subgraph like [Transform] and multiplies the color of all draw operators within it. If the alpha of Color is 0, the group is not drawn at all.\n\nAKA: null, parent, layer, folder, container\n\nSee also: [Execute], [Transform], [SpreadLayout]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "25eb87f8-43b6-46fa-8066-3fdc1efb5e01"/*UniformScale*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Uniformly scales the subgraph.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 1.0,
      "Format": "{0:0.000} ×"
    },
    {
      "InputId": "35a18838-b095-431f-a3af-2dba81dcc16f"/*ForceColorUpdate*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "GroupTitle": "Additional Options",
      "Description": "Invalidates the connected subgraph every frame, so that animated colors are applied by operators that would otherwise cache their result. This can be expensive."
    },
    {
      "InputId": "4e15eb7a-3872-4f26-93e3-1dd38bce01a5"/*Rotation*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "Rotation in degrees around the x-axis (horizontal), y-axis (vertical) and z-axis (forward).",
      "Min": -90.0,
      "Max": 90.0,
      "Format": "{0:0.0}°"
    },
    {
      "InputId": "7db56b09-350e-4831-9620-fe68e0617b86"/*Scale*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "Scales the subgraph along the individual axes."
    },
    {
      "InputId": "83d80b87-df2e-4a7e-8bb3-6d5f041a60e4"/*IsEnabled*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "GroupTitle": "Settings",
      "Description": "If disabled, the connected commands are not drawn."
    },
    {
      "InputId": "996bd2d7-3741-4ade-b1b6-18eb3d884081"/*Color*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Multiplied with the color of all operators in the group. An alpha of 0 skips drawing the group.",
      "AddPadding": "True",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "9e24c5d1-191a-4c1a-b88e-03df826fffc0"/*Translation*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "GroupTitle": "Transformations",
      "Description": "Moves the subgraph."
    },
    {
      "InputId": "9e961f73-1ee7-4369-9ac7-5c653e570b6f"/*Commands*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "b864bb2d-a9fd-4e63-8d3d-b0cc8da6a13c"/*EnableProfiling*/,
      "Position": {
        "X": 0.0,
        "Y": 225.0
      },
      "Description": "Measures the time it takes to update the content of this group.\nThe measurements are shown in the IO window."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "977ca2f4-cddb-4b9a-82b2-ff66453bbf9b"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}