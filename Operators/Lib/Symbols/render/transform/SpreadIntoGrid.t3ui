{
  "FormatVersion": 3,
  "Id": "50cc7ae4-7064-436e-862e-b8f2a709409c"/*SpreadIntoGrid*/,
  "Description": "Distributes the connected draw commands into a grid, centered around the origin.\n\nEach connected command is placed in its own grid cell, filled row by row.\n\nAKA: layout, arrange, distribute, tile\n\nSee also: [SpreadLayout], [Group]",
  "InputUis": [
    {
      "InputId": "7c3e1be9-0ee5-4762-9abf-8ab908fed1b1"/*SpreadScale*/,
      "Position": {
        "X": -200.0,
        "Y": 120.0
      },
      "Description": "Uniform factor multiplied with Spread."
    },
    {
      "InputId": "8ed3e486-134a-4047-8f8c-7427f1bde6b9"/*Spread*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Total size of the grid along each axis.",
      "Scale": 0.01
    },
    {
      "InputId": "bf7c70a5-7b3b-4245-8066-ad17b4eb72cf"/*Commands*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Draw commands to distribute. Each connection gets its own cell."
    },
    {
      "InputId": "e7c44d76-44a1-47d7-b31d-7f3a8ed759f7"/*GridSize*/,
      "Position": {
        "X": -200.0,
        "Y": 195.0
      },
      "Description": "Number of columns, rows and layers of the grid."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "24fd79e3-ad3a-4c27-9b97-48226dd990e0"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}