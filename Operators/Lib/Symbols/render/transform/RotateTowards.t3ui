{
  "FormatVersion": 3,
  "Id": "8373c170-a140-4ce4-b59b-47f42fb71700"/*RotateTowards*/,
  "Description": "Rotates the connected subgraph so that its positive z-axis points towards the camera or a target position.\n\nThe rotation is computed from the current position of the subgraph's origin.\n\nAKA: lookat, aim, billboard, face, track\n\nTips:\n- Use the Pos output of a [Locator] as AlternativeTarget for a visible target with an interactive gizmo.\n\nSee also: [RotateAroundAxis], [Transform], [Locator]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "1ce44784-db0d-42ab-b00b-09a1ef2e9042"/*AlternativeTarget*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "World space target position used in TowardsPosition mode, e.g. from a [Locator].",
      "AddPadding": "True"
    },
    {
      "InputId": "a000747f-578f-4367-bc47-e8bb56252043"/*RotationOffset*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "Additional rotation in degrees applied before aiming.",
      "Min": -90.0,
      "Max": 90.0
    },
    {
      "InputId": "ae8b45e6-e72f-40fe-8ff9-34cd9fffc164"/*Command*/,
      "Relevancy": "Required",
      "Position": {
        "X": 15.714638,
        "Y": 12.576044
      },
      "Description": "The subgraph to rotate."
    },
    {
      "InputId": "ccd2cc62-ad7b-420a-95d4-243257291619"/*LookTowards*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "TowardsCamera = Points at the position of the current camera\nTowardsPosition = Points at AlternativeTarget",
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "772609fe-ec92-43a9-b8c6-9055bbf0310b"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}