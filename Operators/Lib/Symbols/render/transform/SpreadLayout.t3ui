{
  "FormatVersion": 3,
  "Id": "e07550cf-033a-443d-b6f3-73eb71c72d9d"/*SpreadLayout*/,
  "Description": "Distributes the connected draw commands along a line and applies a common transform and color to them.\n\nEach connected command is moved by an equal fraction of Spread, in the order of the connections.\n\nAKA: layout, arrange, distribute, row, stack\n\nSee also: [SpreadIntoGrid], [Group]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "2d59d002-838e-4150-ae8f-ff97bb19bd78"/*Translation*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "GroupTitle": "Transform All"
    },
    {
      "InputId": "2dae39aa-141c-4fd2-8367-4895df85cceb"/*Rotation*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Scale": 0.1
    },
    {
      "InputId": "2f112e29-beb3-4b78-a9e6-5d4ed55b49c7"/*Commands*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Draw commands to distribute."
    },
    {
      "InputId": "5f2c1b38-4b0c-45e4-810f-8f126084b285"/*Pivot*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Alignment of the distribution relative to Translation. 0.5 centers it, 1 places the first command and 0 the last command at Translation."
    },
    {
      "InputId": "84c700dc-17da-4e4b-b636-dbb040bceefa"/*Color*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Multiplied with the color of the connected operators.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "938e7f13-c78f-4474-abe1-38e413fb74e6"/*ForceColorUpdate*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Invalidates the connected subgraph every frame, so that animated colors are applied by operators that would otherwise cache their result. This can be expensive."
    },
    {
      "InputId": "a46dba34-0a69-4a9e-8e76-5dc01054fbb4"/*Spread*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "GroupTitle": "Distribute",
      "Description": "Distance between the first and the last command."
    },
    {
      "InputId": "b89c93b7-2051-4458-9a86-fe51ba2c15d9"/*UniformScale*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "d0e0058c-5d46-41f4-a280-42befd5a5570"/*IsEnabled*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "GroupTitle": "Additional Options...",
      "Description": "If disabled, nothing is drawn."
    },
    {
      "InputId": "d730dc2f-0cd4-46eb-b917-ae886a319eeb"/*Scale*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
