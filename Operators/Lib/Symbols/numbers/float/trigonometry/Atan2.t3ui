{
  "FormatVersion": 3,
  "Id": "7636bb3c-9f12-4323-b9be-e05f0eb561c5"/*Atan2*/,
  "Description": "Returns the angle of a 2D vector in radians.\n\nComputes atan2(X, Y), so the angle is measured from the positive Y axis towards the positive X axis, in the range -π to π. Note that this argument order differs from the common atan2(y, x).\n\nAKA: angle, arctan\n\nSee also: [Sin], [Cos]",
  "SymbolTags": "9",
  "InputUis": [
    {
      "InputId": "00770dc9-40a7-421c-a2fb-2d6bc1845387"/*Vector*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "ce5e7140-442d-4541-8596-c24a58e74111"/*Result*/,
      "Position": {
        "X": 133.0,
        "Y": 38.0
      }
    }
  ]
}