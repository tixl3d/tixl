      "Position": {
        "X": 36.0,
        "Y": 334.0
      },
      "Description": "Selection between 0 (first rate) and 1 (last rate).",
      "Min": 0.0,
      "Max": 1.0,
      "Scale": 0.01,
      "ClampMin": true,
      "ClampMax": true
    }
  ],
