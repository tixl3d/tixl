{
  "FormatVersion": 3,
  "Id": "90b2c6d2-e9a6-4910-b42d-94202f07be27"/*Accumulator*/,
  "Description": "Accumulates a value with the incoming increment.\n\nIn PerFrame mode the increment is added once per frame. In PerSeconds mode it is a rate: with an increment of 1 the value grows by 1 unit per second of playback.\n\nAKA: integrate, counter\n\nSee also: [Time], [Counter] (counts in steps)",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "052f9cd1-4b3e-483f-b628-c356f58ff87e"/*Increment*/,
      "Position": {
        "X": 36.0,
        "Y": 334.0
      },
      "Description": "Amount added per frame or per second, depending on Accumulate.",
      "AddPadding": "True",
      "Min": -100.0,
      "Max": 100.0
    },
    {
      "InputId": "26f05385-3c48-499a-bc30-69bad0a2218c"/*StartValue*/,
      "Position": {
        "X": 197.0,
        "Y": 328.0
      },
      "Description": "Value the accumulator starts with and is reset to.\n\nChanges are only applied after the reset trigger has been used.",
      "AddPadding": "True",
      "Min": -100.0,
      "Max": 100.0,
      "Scale": 0.01
    },
    {
      "InputId": "4d90cd4b-8e11-4b86-a668-26810af029b3"/*Modulo*/,
      "Position": {
        "X": 197.0,
        "Y": 418.0
      },
      "Description": "Wraps the output to loop the value. Ignored when 0 or below.",
      "AddPadding": "True"
    },
    {
      "InputId": "7caf37ec-ed34-4711-b02c-e136d070fff7"/*Running*/,
      "Position": {
        "X": 197.0,
        "Y": 373.0
      },
      "Description": "Pauses accumulation while disabled."
    },
    {
      "InputId": "8e4e25e5-df86-4211-831b-fc834de156ec"/*Range*/,
      "Position": {
        "X": 197.0,
        "Y": 493.0
      },
      "Description": "Limits the accumulated value to X (min) and Y (max). 0, 0 means unlimited."
    },
    {
      "InputId": "9f1d76d2-c3dd-4035-a37c-300eb011331b"/*ResetTrigger*/,
      "Position": {
        "X": 197.0,
        "Y": 373.0
      },
      "Description": "Resets the accumulator to StartValue."
    },
    {
      "InputId": "f647a803-1635-4dcd-bb4d-a7817789a3e2"/*Accumulate*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "PerFrame: add the increment each frame.\nPerSeconds: multiply the increment with the frame duration in seconds."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "a999f93c-e51a-4325-bae2-bfab830b868d"/*Result*/,
      "Position": {
        "X": 133.0,
        "Y": 138.0
      }
    }
  ]
}