{
  "FormatVersion": 3,
  "Id": "6e29bd11-7927-4f74-a35e-a6b129464a55"/*Ease*/,
  "Description": "Creates smooth eased transitions whenever the input value changes.\n\nWhen Value changes, the output animates from its current value to the new one within Duration, using the selected easing curve such as cubic, exponential or back. This works best with input values that change in steps.\n\nAKA: tween, transition\n\nSee also: [Damp], [Spring], [EaseKeys], [EaseVec2], [EaseVec3]",
  "InputUis": [
    {
      "InputId": "5580eee8-db7b-4e9b-898d-5c7680b0c302"/*UseAppRunTime*/,
      "Position": {
        "X": 36.0,
        "Y": 469.0
      },
      "Description": "Uses the application run time instead of the playback time. Transitions then continue while playback is paused."
    },
    {
      "InputId": "bc388ea3-e1e6-4773-95e5-b8a649c3344f"/*Interpolation*/,
      "Position": {
        "X": 36.0,
        "Y": 514.0
      },
      "Description": "Shape of the easing curve."
    },
    {
      "InputId": "c2107af4-7b4f-43ef-97fe-934833790032"/*Value*/,
      "Relevancy": "Required",
      "Position": {
        "X": 36.0,
        "Y": 334.0
      }
    },
    {
      "InputId": "da40ddcd-cef8-494a-a7f8-cd8ddfbd7603"/*Duration*/,
      "Position": {
        "X": 36.0,
        "Y": 379.0
      },
      "Description": "Length of the transition in bars, or in seconds when UseAppRunTime is enabled.",
      "Min": 0.001,
      "Max": 999.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "fe0231d9-03b6-466f-82e9-852b892adf2e"/*Direction*/,
      "Position": {
        "X": 36.0,
        "Y": 604.0
      },
      "Description": "Which end of the transition is eased: In, Out or InOut."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "75ff4efa-7ca7-4989-bd9c-42302cb248ca"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 200.0
      }
    }
  ],
  "Links": [
    {
      "Id": "11312bc4-15f5-4e8e-8b42-fdaa59c77645",
      "Title": "easings.net",
      "Description": "This page helps you choose the right easing function.",
      "LinkUrl": "https://easings.net/",
      "LinkType": "Reference"
    }
  ]
}