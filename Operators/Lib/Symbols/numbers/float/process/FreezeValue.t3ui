  "Id": "587dbb73-fd79-4481-a79e-f77055abda9a"/*FreezeValue*/,
  "Description": "Holds the input value depending on the Freeze input.\n\nThis can be useful for building interactive features like stopwatches. The second output gives the difference between the current and the frozen value.\n\nAKA: hold, sampleandhold, latch",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "7d64e809-3280-47fa-ad0f-218c6081534f"/*Value*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "9ad1267b-6d0a-43f4-a4e9-0f77659ddd44"/*Mode*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "FreezeWhileTrue: the output stops changing while Freeze is true.\nUpdateWhenSwitchingToTrue: the value is captured each time Freeze switches to true and held otherwise."
    },
    {
      "InputId": "b53df009-a0eb-46c9-90db-04d8ccdb0ae4"/*Freeze*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
