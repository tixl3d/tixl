{
  "FormatVersion": 3,
  "Id": "a1341063-f893-4447-93cd-63cfe514495e"/*BlendValues*/,
  "Description": "Blends between a number of connected values with a float index.\n\nThe integer part of F selects a value, the fractional part blends towards the next one. F wraps around, so the last value blends back to the first.\n\nSee also: [Lerp], [PickFloat]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "03ce9de0-2fd3-4900-84f7-2510f39dff2a"/*F*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Position in the list of values, e.g. 1.5 blends halfway between the second and third value."
    },
    {
      "InputId": "1c15cce3-3054-47f8-96b5-b8b741df40be"/*Values*/,
      "Relevancy": "Required",
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Min": -100.0,
      "Max": 100.0
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "b9e4e703-f797-4750-8a1d-d82c6953ea09"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}