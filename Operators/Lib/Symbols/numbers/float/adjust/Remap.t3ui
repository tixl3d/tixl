{
  "FormatVersion": 3,
  "Id": "f0acd1a4-7a98-43ab-a807-6d1bd3e92169"/*Remap*/,
  "Description": "Remaps a value from an input range to an output range. Optionally applies bias and gain, clamping, or modulo.\n\nAKA: map, fit, rescale, range\n\nSee also: [Lerp], [RemapFloatList], [SmoothStep]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "23548048-e373-4fd6-9c83-1cf7398f952d"/*BiasAndGain*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "X: gain, Y: bias. Shapes the curve for values inside the input range. 0.5, 0.5 keeps it linear.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "UseVec2Control": "GainAndBias"
    },
    {
      "InputId": "252276fb-8de1-42cc-ba41-07d6862015bd"/*RangeOutMax*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "40606d4e-acaf-4f23-a845-16f0eb9b73cf"/*Value*/,
      "Position": {
        "X": 36.0,
        "Y": 334.0
      }
    },
    {
      "InputId": "406f6476-eb25-4493-aaea-3899e84de50f"/*Mode*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Normal: no limits, values outside the input range extrapolate.\nClamped: the result is limited to the output range.\nModulo: the result wraps by the size of the output range."
    },
    {
      "InputId": "cd369755-5062-4934-8f37-e3a5cc9963df"/*RangeInMax*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "Description": "Input value that maps to RangeOutMax."
    },
    {
      "InputId": "edb98f34-d019-47f6-b275-e5a80061e1f7"/*RangeInMin*/,
      "Position": {
        "X": 197.0,
        "Y": 328.0
      },
      "Description": "Input value that maps to RangeOutMin.",
      "AddPadding": "True"
    },
    {
      "InputId": "f2baf278-adde-42de-afce-336b6c8d0387"/*RangeOutMin*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      },
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "de6e6f65-cb51-49f1-bb90-34ed1ec963c1"/*Result*/,
      "Position": {
        "X": 133.0,
        "Y": 38.0
      }
    }
  ]
}