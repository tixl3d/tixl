{
  "FormatVersion": 3,
  "Id": "baa8cd75-5621-42ba-a79c-b008b7caa141"/*RoundVec3*/,
  "Description": "Rounds each component of a Vector3 to steps of 1 / Precision.\n\nThis can be useful for snapping positions onto a grid.",
  "InputUis": [
    {
      "InputId": "158ff4f8-7470-4402-b16e-54a3a252fe7a"/*Value*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "93a69b1c-365f-495f-8cdf-7ca1e78407e2"/*Precision*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Steps per unit for each axis, e.g. 2 snaps to 0.5. 0 results in invalid values."
    },
    {
      "InputId": "acb38b7f-d466-40b4-9d59-201babff00aa"/*Mode*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Round to nearest, Floor (down) or Ceiling (up)."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "610e09be-54e8-40a6-9cef-e4da953a4e78"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}