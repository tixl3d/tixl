{
  "FormatVersion": 3,
  "Id": "e9dc80e1-8898-4b77-b515-bf6d589302de"/*Vector3Gizmo*/,
  "Description": "Shows a 3D gizmo in the output view and outputs its position as a Vector3.\n\nUseful to control the position of anything in 3D space that does not have a built-in gizmo. It can also drive any other Vector3 parameter, e.g. RGB colors.\n\nSee also: [Locator]",
  "InputUis": [
    {
      "InputId": "059ceeaa-8683-4d6e-aca3-c95d411663f0"/*ShowGizmo*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "AddPadding": "True"
    },
    {
      "InputId": "a2025ddf-423f-4683-a4ce-ec8c7bda42ee"/*Position*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "75ca1280-f3af-4c08-b19b-90b0eff05fbd"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}