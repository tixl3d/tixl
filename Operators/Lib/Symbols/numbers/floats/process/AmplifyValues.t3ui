{
  "FormatVersion": 3,
  "Id": "4def850e-3627-46d8-ae2b-58b513843885"/*AmplifyValues*/,
  "Description": "Smooths or amplifies each value of a float list over time. This can be used to extract beats in an audio spectrum.\n\nFor each entry a running average is kept. The output mixes the current value, the average, and the part of the value that is above the average. The values are only updated when the incoming list changes.\n\nSee also: [DampFloatList], [DampPeakDecay]",
  "InputUis": [
    {
      "InputId": "2c6c16e9-2037-4b5e-a4ac-6c5aab0fc582"/*Smoothing*/,
      "Position": {
        "X": 0.0,
        "Y": 45.0
      },
      "Description": "Damping of the running average, between 0 and 1. Higher values react more slowly.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true
    },
    {
      "InputId": "38d415d3-2ac1-4256-929d-cfdb3fa5c7a9"/*MixCurrent*/,
      "Position": {
        "X": 0.0,
        "Y": 135.0
      },
      "Description": "Amount of the current value in the output."
    },
    {
      "InputId": "813a6eab-947d-47a0-af8e-7a92c880d338"/*Input*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "c8f0b975-676f-46a4-b7ef-39d385c82cef"/*MixAboveAverage*/,
      "Position": {
        "X": 0.0,
        "Y": 180.0
      },
      "Description": "Amount of the difference above the running average in the output. Useful to emphasize sudden rises."
    },
    {
      "InputId": "dcf2d659-7b51-4a87-8378-ca01419e4b7c"/*MixAverage*/,
      "Position": {
        "X": 0.0,
        "Y": 90.0
      },
      "Description": "Amount of the running average in the output."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "341496d9-d292-41ba-b2e7-468f03fe0bbb"/*Output*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}