{
  "FormatVersion": 3,
  "Id": "a7b3c2d1-8e9f-4a5b-9c6d-7e8f9a0b1c2d"/*MergeFloatLists*/,
  "Description": "Merges multiple lists of floats into a single list.\n\nThis is particularly useful for assembling data packets for protocols like DMX, or processing multiple float data streams where different parts are generated by separate logic.\n\nAKA: combine, join, concatenate\n\nTips:\n- Use StartIndices to specify where each input list is placed in the output list (Append mode only).\n- MaxSize defines the total size of the output list (Append mode only).\n\nSee also: [CombineFloatLists]",
  "InputUis": [
    {
      "InputId": "a3b4c5d6-e7f8-4a9b-0c1d-2e3f4a5b6c7d"/*StartIndices*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Optional start index for each input list (Append mode only). Without it, lists are written one after another."
    },
    {
      "InputId": "b3c4d5e6-f7a8-4b9c-8d7e-9f0a1b2c3d4e"/*Enabled*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Enables the merge modes. When disabled, Append mode is used."
    },
    {
      "InputId": "c5d6e7f8-a9b0-4c1d-8e9f-0a1b2c3d4e5f"/*InputLists*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 75.0
      }
    },
    {
      "InputId": "d7e8f9a0-b1c2-4d3e-8f9a-0b1c2d3e4f5a"/*MaxSize*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Total size of the output list in Append mode. Unused entries are 0, longer data is truncated. -1 means no limit."
    },
    {
      "InputId": "e9f0a1b2-c3d4-4e5f-9a0b-1c2d3e4f5a6b"/*MergeMode*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Append: lists are written one after another.\nHTP (highest takes precedence): per index, the highest value of all lists.\nLTP (latest takes precedence): per index, the value of the last list that provides one; previous values persist.\nFailOver: outputs the first list whose content changed recently.\nAverage: per index, the average of all lists."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "f1a2b3c4-d5e6-4f7a-8b9c-0d1e2f3a4b5c"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 200.0
      }
    }
  ]
}