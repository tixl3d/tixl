{
  "FormatVersion": 3,
  "Id": "44cee07e-2a71-4dd5-9ded-8274e8e19332"/*DefineIqGradient*/,
  "Description": "Defines a gradient with the procedural cosine palette by Inigo Quilez.\n\nEach color channel is computed as A + B * cos(2π * (C * t + D)). It takes some experimentation to get under control, but can be very useful to find ABCD combinations for shaders.\n\nSee also: [SampleGradient]",
  "InputUis": [
    {
      "InputId": "12d9b558-c83c-4d7b-b366-481d09e54501"/*C_Frequency*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "C: number of cosine cycles across the gradient per channel.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "133f0d11-9de9-49f6-9c76-bbaf6bed82f4"/*B_Contrast*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "B: amplitude of the cosine per channel.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "750e53f0-5ddb-4be1-bef0-da2e48231553"/*A_Brightness*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "A: base value per channel (RGBA).",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "85f98834-7921-46e6-9f63-9da18b2a7bf8"/*Phase*/,
      "Position": {
        "X": -200.0,
        "Y": 300.0
      },
      "Description": "Shifts the whole gradient."
    },
    {
      "InputId": "887c0b40-c71f-4e0e-bff2-0fdff64f8c82"/*D_Phase*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "D: phase offset per channel.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    },
    {
      "InputId": "918c99f2-2197-467d-a991-2f69ef81440c"/*Interpolation*/,
      "Position": {
        "X": -200.0,
        "Y": 255.0
      }
    },
    {
      "InputId": "96961db2-d597-4658-b0c0-fa1301a2fcdc"/*NumOfSteps*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "Number of gradient steps, 1 to 256."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "0dbde53c-92d3-4a21-80f0-62df913460cf"/*Gradient*/,
      "Position": {
        "X": 300.0,
        "Y": 200.0
      }
    }
  ]
}