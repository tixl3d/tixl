{
  "FormatVersion": 3,
  "Id": "55cc0f79-96c9-482e-9794-934dc0f87708"/*ValuesToTexture*/,
  "Description": "Converts lists of values into pixels of a float texture in real time.\n\nEach pixel is computed as ((value + Offset) * Gain) ^ Pow, then shaped by GainAndBias where the result lies between 0 and 1. See the example of how this can be used to create audio reactive visualizers with [PlaybackFFT] and [LinearSamplePointAttributes].\n\nSee also: [ValuesToTexture2], [CurvesToTexture]",
  "InputUis": [
    {
      "InputId": "092c8d1f-a70e-4298-b5df-52c9d62f8e04"/*Values*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "GroupTitle": "Values",
      "Description": "One or more float lists. Each list becomes one row (Horizontal) or column (Vertical)."
    },
    {
      "InputId": "51545316-69fc-441f-b59f-44979e32972c"/*Pow*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "Exponent applied to each value. Values near 0 stop updating the texture."
    },
    {
      "InputId": "3b6e0f2a-8c41-4d7e-9a15-6f2c8e4b7d90"/*GainAndBias*/,
      "Position": {
        "X": -200.0,
        "Y": 200.0
      },
      "Description": "X: gain, Y: bias. Shapes results between 0 and 1 after Pow; values outside that range are left unchanged. 0.5 / 0.5 has no effect.",
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true,
      "ClampMax": true,
      "Format": "{0:0.000}",
      "UseVec2Control": "GainAndBias"
    },
    {
      "InputId": "63e90d86-5ad5-4333-8b99-7f8d285c4913"/*Direction*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Horizontal: one row per list. Vertical: one column per list.",
      "AddPadding": "True"
    },
    {
      "InputId": "748fe756-c7ee-4cc1-929e-078f99bea628"/*Offset*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      }
    },
    {
      "InputId": "cc812393-f080-4e17-a525-15b09f8acdd0"/*Gain*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      },
      "AddPadding": "True"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "f01099a0-a196-4689-9900-edac07908714"/*ValuesTexture*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}