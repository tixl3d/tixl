{
  "FormatVersion": 3,
  "Id": "8211249d-7a26-4ad0-8d84-56da72a5c536"/*SampleGradient*/,
  "Description": "Defines a gradient and samples a color from it.\n\nThe first output returns the color at SamplePos, the second output the gradient itself, which can be used by [GradientsToTexture] or other operators.\n\nTips:\n- Left-click on the gradient in the graph or parameter window to add a color step.\n- Drag a color step to the lower border to remove it.\n- Right-click the gradient in the parameter window to change the interpolation mode or save presets.\n\nSee also: [BuildGradient], [DefineGradient]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "11657d72-6ad9-41d9-ab5a-de7177af5be4"/*OverrideInterpolation*/,
      "Position": {
        "X": 197.0,
        "Y": 448.0
      }
    },
    {
      "InputId": "76cf4a72-2d25-48cb-a1ec-08d0ddabb053"/*Interpolation*/,
      "Position": {
        "X": 197.0,
        "Y": 373.0
      },
      "Description": "Interpolation between the color steps. Only used if OverrideInterpolation is enabled."
    },
    {
      "InputId": "a4527e01-f19a-4200-85e5-00144f3ce061"/*SamplePos*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": 197.0,
        "Y": 328.0
      },
      "Description": "Normalized position (0…1) on the gradient.",
      "Min": -100.0,
      "Max": 100.0,
      "Scale": 0.01
    },
    {
      "InputId": "eff10fad-cf95-4133-91db-efc41258cd1b"/*Gradient*/,
      "Position": {
        "X": 197.0,
        "Y": 373.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "963611e7-f55e-4c94-96e6-34e195558a2b"/*Color*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "OutputId": "9f3d0701-86e8-436e-8652-918ba23b2cef"/*OutGradient*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}