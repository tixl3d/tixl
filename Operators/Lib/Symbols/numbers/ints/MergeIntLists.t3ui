{
  "FormatVersion": 3,
  "Id": "ca6f09ec-bbc4-4365-8210-bc10cd8d9f94"/*MergeIntLists*/,
  "Description": "Merges multiple lists of integers into a single list.\n\nUseful for assembling data packets for protocols like Art-Net or sACN, where different parts of a DMX universe are generated by separate logic.\n\nAKA: combine, join, concatenate, htp, ltp\n\nTips:\n- Use StartIndices to place each input list at a specific position in the output (Append mode).\n- Set MaxSize to define a fixed output length, e.g. 512 for a DMX universe.\n\nSee also: [IntsToList], [MergeFloatLists]",
  "InputUis": [
    {
      "InputId": "24855d2a-595b-4e3e-81c5-65481c262f64"/*Enabled*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Enables the MergeMode. If disabled, lists are always appended."
    },
    {
      "InputId": "387fb1db-944f-4eb1-bb6f-b149e4a51a42"/*StartIndices*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Optional list of start indices, one per input list (Append mode only). Without it, lists are concatenated one after another. Gaps are filled with -1 if MaxSize is not set."
    },
    {
      "InputId": "9e60f3e7-a891-4e3e-81c5-65481c262f64"/*MaxSize*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Fixed length of the output list in Append mode; unused entries are 0 and longer data is truncated. -1 means no limit."
    },
    {
      "InputId": "bdfe5576-2f45-473d-bb9d-95fc453fc774"/*InputLists*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 75.0
      }
    },
    {
      "InputId": "e3315721-2853-449a-af6a-43cd18400470"/*MergeMode*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Append: concatenate lists (uses StartIndices and MaxSize).\nHtp: highest value per index wins.\nLtp: later lists overwrite earlier ones; values beyond shorter inputs persist from previous frames.\nFailOver: outputs the first list whose content is changing, preferring the first input.\nAverage: integer average per index."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "f28370f0-f0c6-418f-8fbf-167a7d1035fe"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 200.0
      }
    }
  ]
}