      "Relevancy": "Relevant",
      "Position": {
        "X": 36.0,
        "Y": 334.0
      },
      "GroupTitle": "Time",
      "Description": "Position on the curve's horizontal axis at which it is sampled.",
      "Min": -100.0,
      "Max": 100.0
    }
  ],
