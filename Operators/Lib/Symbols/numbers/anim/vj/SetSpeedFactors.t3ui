{
  "FormatVersion": 3,
  "Id": "61dc8ba5-8aa6-4003-8d8c-8bce27f56a67"/*SetSpeedFactors*/,
  "Description": "Sets speed factors for animation operators in the connected subgraph.\n\nThis adjusts the pace of visuals while staying beat-synced. SpeedFactorA is used by [Counter], SpeedFactorB by [AnimValue], [AnimVec2] and [AnimVec3] (see their AllowSpeedFactor parameter). Both Commands and Texture subgraphs are supported, but only one per instance.",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "038fb60f-0ef9-45ec-839f-c533a93ad124"/*Commands*/,
      "Relevancy": "Required",
      "Position": {
        "X": 446.54126,
        "Y": 362.82013
      }
    },
    {
      "InputId": "14a0ee21-309a-44cc-bc00-3d7d5594de01"/*ApplyAs*/,
      "Position": {
        "X": -100.99625,
        "Y": 141.14243
      },
      "Description": "- NormalizedRates: 0.5 is neutral (factor 1); lower values give 1/2, 1/4, 1/8, 1/16 down to frozen; higher values give ×2, ×4, ×8, ×16, ×32.\n- Factor: The value is used as a multiplier."
    },
    {
      "InputId": "3ba30914-444c-43a9-b936-87d5d98898cd"/*Texture*/,
