{
  "FormatVersion": 3,
  "Id": "2443b2fd-c397-4ea6-9588-b595f918cf01"/*HasTimeChanged*/,
  "Description": "Returns true when the selected time jumped forward or backward by more than Threshold since the last frame.\n\nThis can detect scrubbing back in the timeline or looping. The DeltaTime output returns the time difference to the last frame.\n\nAKA: DidTimeChange, rewind\n\nSee also: [HasValueChanged]",
  "SymbolTags": "8",
  "InputUis": [
    {
      "InputId": "5ac02169-6b75-4176-ae0a-04cab6c4ce13"/*WhichTime*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      }
    },
    {
      "InputId": "aa73cdba-f295-446d-9693-53055ca4edc6"/*Threshold*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Minimal time change in the selected time unit to count as a change."
    },
    {
      "InputId": "bc112889-77a8-4967-a9b7-683b7c7017fe"/*Mode*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "- DidRewind: Time decreased.\n- DidAdvanced: Time increased.\n- DidChange: Time increased or decreased.\n- DidAdvancedWithMotionBlur: Like DidAdvanced, but ignores the additional motion blur render passes."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "4883b1ec-16c1-422f-8db6-c74c3d48e5be"/*HasChanged*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    },
    {
      "OutputId": "b459946d-253a-4583-88ee-897e8041f468"/*DeltaTime*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    }
  ]
}