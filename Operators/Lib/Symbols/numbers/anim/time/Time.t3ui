{
  "FormatVersion": 3,
  "Id": "b0d75f21-df33-460b-beab-d8c5e1f23e5e"/*Time*/,
  "Description": "Returns the current time in bars or seconds.\n\nIn most situations this is the playback time. It can be overridden by ops like [SetTime] or [TimeClip]. At 120 BPM one bar equals 2 seconds.\n\nAKA: clock, seconds, bars\n\nSee also: [ConvertTime], [AnimValue], [StopWatch]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "6d2f783a-23b7-425c-a4e3-cfcdcd61cf3a"/*Mode*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "- LocalIdleMotionFxTime: Context time including idle motion (keeps running while playback is paused).\n- LocalTime: Context time without idle motion.\n- PlaybackTime: Global playback time, ignores local time overrides.\n- Runtime: Time since application start.\n- Frozen: Always 0."
    },
    {
      "InputId": "ba443b6a-487f-4739-94a3-915584ee2d46"/*Units*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "e0f765f3-ac71-45c9-87a4-e9be3fa9a9a0"/*SpeedFactor*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Multiplies the time.",
      "Min": -5.0,
      "Max": 5.0
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "fd3049aa-4c22-405b-b9b4-0a2474d0e377"/*Timefloat*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}