{
  "FormatVersion": 3,
  "Id": "32325c5b-53f7-4414-b4dd-a436e45528b0"/*SetTime*/,
  "Description": "Overrides the animation time of a sub-command graph.\n\nSee also: [TimeClip], [Time]",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "01f2eef1-e3c1-49a5-b532-9c12da8caac5"/*SubTree*/,
      "Relevancy": "Required",
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    },
    {
      "InputId": "d2c934bb-de5c-449c-adf8-7a2f48082e9c"/*NewTime*/,
      "Relevancy": "Relevant",
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "The new time, or an offset to the current time when OffsetMode is relative.",
      "AddPadding": "True"
    },
    {
      "InputId": "efa8c97d-769c-4a26-b442-e702ac74a1f4"/*OffsetMode*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "- Absolute: Sets the time of the connected SubTree to NewTime.\n- Relative: Adds NewTime to the current time.\n- GlobalAbsolute: Only without a connected SubTree: sets the time of the current context."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "fe01c3b6-72e2-494e-8511-6d50c527463f"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 100.0
      }
    }
  ]
}