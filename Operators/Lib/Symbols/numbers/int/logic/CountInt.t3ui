{
  "FormatVersion": 3,
  "Id": "0e1d5f4b-3ba0-4e71-aa26-7308b6df214d"/*CountInt*/,
  "Description": "Counts up or down by Delta each time it is triggered.\n\nWhile TriggerIncrement is true, Delta is added on every evaluated frame unless OnlyCountChanges is enabled. TriggerReset (and the first evaluation) set the counter to DefaultValue.\n\nAKA: counter, accumulate\n\nSee also: [HasIntChanged], [RandomChoiceIndex]\nAlso check out the [HowToAnimate] tutorial.",
  "SymbolTags": "1",
  "InputUis": [
    {
      "InputId": "01027ce6-f4ca-44b6-a8ec-e4ab96280864"/*TriggerReset*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      }
    },
    {
      "InputId": "11f9cdb5-84fc-4413-8ca7-77e12047f521"/*DefaultValue*/,
      "Position": {
        "X": -200.0,
        "Y": 135.0
      }
    },
    {
      "InputId": "2ff3d674-90d7-4c8f-8551-aad9992540db"/*Modulo*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      },
      "Description": "If not 0, the counter wraps with this value. Negative counts stay negative."
    },
    {
      "InputId": "518a8bd6-d830-4f73-ac83-49be2fd4b09d"/*OnlyCountChanges*/,
      "Position": {
        "X": -200.0,
        "Y": 90.0
      },
      "Description": "Only count when a trigger changes from false to true, not on every frame it is true."
    },
    {
      "InputId": "6ebe2842-a8fc-4800-8296-c8664c804e3c"/*TriggerDecrement*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Subtracts Delta. Ignored while TriggerIncrement is true."
    },
    {
      "InputId": "abe64676-ccf7-4163-b4da-26d8b7179af4"/*Delta*/,
      "Position": {
        "X": -200.0,
        "Y": 180.0
      }
    },
    {
      "InputId": "bfd95809-61d2-49eb-85d4-ff9e36b2d158"/*TriggerIncrement*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      }
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "2e172f90-3995-4b16-af33-9957be07323b"/*Result*/,
      "Position": {
        "X": 0.0,
        "Y": 0.0
      }
    }
  ]
}