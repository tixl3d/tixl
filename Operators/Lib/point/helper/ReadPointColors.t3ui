{
  "FormatVersion": 3,
  "Id": "fdb843e8-d859-451a-989e-f0e7a00f5e5a"/*ReadPointColors*/,
  "Description": "Reads back the `Color` attribute of a structured Point buffer from GPU to CPU as a `List<Vector4>`.\n\nDesigned for live LED-strip / WLED output: feeds the `Colors` input of [WLedSerialOutput] without the GPU-pipeline stall that [PointsToCPU] causes in continuous mode.\n\nDefault `Async = true` uses a 3-buffer rotation so reads do not block rendering. The data shown is 1-2 frames old, which is invisible for VJ visuals. Set `Async = false` if you need same-frame data and can tolerate the stall.\n\nReuses one internal `List<Vector4>`, so connecting this op into a per-frame chain is allocation-free after warmup.\n\nAKA: pointcolors, readback, gpu-to-cpu, wled, led-strip, points",
  "InputUis": [
    {
      "InputId": "0406e85a-61c4-42ce-a174-8d683d2801b5"/*PointBuffer*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "GPU structured Point buffer to read from."
    },
    {
      "InputId": "7d40f8e1-cb43-4389-a12f-126160ab7e2c"/*MaxCount*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Maximum number of points to read. Cap it to your LED count to keep readback cheap."
    },
    {
      "InputId": "99bc9dc4-d416-4d50-9730-13e829c14bf2"/*StartIndex*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "First point index to read. Useful when only a slice of the buffer should drive the LEDs."
    },
    {
      "InputId": "b038c123-cdac-4e6d-9863-3446631dfed5"/*Async*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "When true (recommended), the readback uses a rotating staging buffer and does not stall the GPU pipeline. The output is 1-2 frames old. When false, blocks until the data is available - same-frame, but with a measurable hit on frame time."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "f3ceb246-a9f0-40bb-9c66-95e6f1fbcf22"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 100.0
      }
    }
  ]
}