          "8c3ffefe-8721-4dde-b252-22eb8be02d3f": "// Offset,A,B,C,D: -\nc= ImageA.Sample(Sampler, uv);\nc.rgb=max(0,c.rgb);\nfloat3 h=rgb2hsv(c.rgb);\nc.rgb=max(c.rgb,0);\n\nh.z=ApplyGainAndBias(SampleGradient(h.z).x, GainAndBias);\nc.rgb=hsv2rgb(h);\n",
          "c9a801ec-13fb-4ad4-b0cd-d125b5db500a": "float3 hsv2rgb(float3 hsv){return lerp(1,saturate(abs(frac((hsv.x-float3(0,2,4)/6))-.5)*6-1),hsv.y)*hsv.z;}\nfloat3 rgb2hsv(float3 c){\n     float v=max(c.x,max(c.y,c.z));float m=min(c.x,min(c.y,c.z));float r=v-m;\n     float h=(r!=0)?frac(((v==c.x)?((c.y-c.z)/r):(v==c.y)?(2+(c.z-c.x)/r):(4+(c.x-c.y)/r))/6):0;\n     float s=(v!=0)?(1-m/v):0;\n     return float3(h,s,v);\n}"
        }
