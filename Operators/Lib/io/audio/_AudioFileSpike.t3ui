{
  "FormatVersion": 3,
  "Id": "c3f10a50-1e42-4c8a-9f31-0ab1cd2e0100"/*_AudioFileSpike*/,
  "Description": "THROWAWAY SPIKE (G4) — plays an audio file (.wav / .mp3 / .ogg) as a looping source in the audio graph. Route its output into an [AudioBus], or leave it loose to auto-play. Proves real files through the graph. Delete after [AudioClip] integration.",
  "InputUis": [
    {
      "InputId": "c3f10a50-0002-4c8a-9f31-0ab1cd2e0100"/*Path*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "Path to the audio file (.wav / .mp3 / .ogg). Project-relative or absolute.",
      "AddPadding": "True",
      "Usage": "FilePath"
    },
    {
      "InputId": "c3f10a50-0003-4c8a-9f31-0ab1cd2e0100"/*Volume*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Min": 0.0,
      "Max": 1.0,
      "ClampMin": true
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "c3f10a50-0001-4c8a-9f31-0ab1cd2e0100"/*Result*/,
      "Position": {
        "X": 300.0,
        "Y": 0.0
      }
    }
  ]
}
