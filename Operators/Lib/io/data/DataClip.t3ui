{
  "Id": "4d1c0e80-7b2a-4f6d-9c1b-12d3e4f50607"/*DataClip*/,
  "Description": "Plays back a recorded .data file as a timeline-bound clip. Appears in the timeline clip area; drag and trim like any other TimeClip.\n\nThe DataSet output exposes the full parsed dataset; LocalSourceTimeSecs reports the current playhead position translated into seconds inside the source file. Downstream consumers (e.g. SimulateIoData) read both to replay events at the right wall-clock time.\n\nLoad / unload is shared via DataSetCache so multiple DataClip ops referencing the same file share one parsed dataset.",
  "SymbolTags": "64",
  "InputUis": [
    {
      "InputId": "70419103-ae5d-4ca0-cf4e-456071829304"/*FilePath*/,
      "Position": {
        "X": -200.0,
        "Y": 45.0
      },
      "Description": "Path to the .data recording. Drag-drop a file from the asset library or type a relative project path.",
      "Usage": "FilePath"
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "5e2d1f81-8c3b-4a7e-ad2c-23e4f5061718"/*Set*/,
      "Position": {
        "X": 300.0,
        "Y": 400.0
      }
    },
    {
      "OutputId": "6f3e2092-9d4c-4b8f-be3d-34f506172829"/*LocalSourceTimeSecs*/,
      "Position": {
        "X": 300.0,
        "Y": 500.0
      }
    }
  ]
}
