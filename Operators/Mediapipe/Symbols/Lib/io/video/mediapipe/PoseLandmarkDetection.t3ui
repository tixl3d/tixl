{
  "FormatVersion": 3,
  "Id": "34567890-abcd-ef12-3456-7890abcdef12"/*PoseLandmarkDetection*/,
  "Description": "Detects pose landmarks in an image using MediaPipe Pose Landmark Detection.\n\nThis operator uses MediaPipe Pose Landmark Detection task to detect human poses and their landmarks (33 points per pose) in the input image. It outputs detected landmarks as a buffer of points and a dictionary of pose data.\n\nInputs:\n- InputTexture: The image to process.\n- Enabled: Enables or disables pose detection.\n- MaxPoses: Maximum number of poses to detect.\n- MinPoseDetectionConfidence: Minimum confidence score for pose detection to be considered successful.\n- MinPosePresenceConfidence: Minimum confidence score for pose presence to be considered successful.\n- MinTrackingConfidence: Minimum confidence score for pose tracking.\n- Debug: Enables debug visualization with debug texture output.\n- CorrectAspectRatio: Whether to correct aspect ratio for non-square inputs.\n- ZScale: Scale factor for Z coordinate of points.\n\nOutputs:\n- OutputTexture: The input texture (passed through).\n- DebugTexture: Debug visualization texture showing pose landmarks and connections when Debug is enabled.\n- PoseCount: The number of poses detected.\n- UpdateCount: Increments each time a new frame is processed.\n- WorldLandmarksBuffer: A structured buffer containing world landmarks.\n- PointBuffer: A structured buffer containing points for detected pose landmarks.\n- SegmentationMask: A texture containing the person segmentation mask - only populated when the loaded pose model emits segmentation masks (the bundled pose_landmarker.task does not; use [ImageSegmentation] or a pose model with mask output).\n\nAcceleration selects the inference delegate: Cpu, Xnnpack (multithreaded CPU, the fast default) or Gpu. Gpu needs a native build with the OpenGL delegate (Linux here) and otherwise falls back to Cpu; InferenceThreads sets the Xnnpack worker-thread count (0 = library default).",
  "InputUis": [
    {
      "InputId": "0abcdef1-2345-6789-0abc-def123456789"/*Debug*/,
      "Position": {
        "X": -200.0,
        "Y": 450.0
      },
      "Description": "Enables debug visualization with debug texture output showing pose landmarks and connections."
    },
    {
      "InputId": "4567890a-bcde-f123-4567-890abcdef123"/*InputTexture*/,
      "Position": {
        "X": -200.0,
        "Y": 0.0
      },
      "Description": "The image to process."
    },
    {
      "InputId": "567890ab-cdef-1234-5678-90abcdef1234"/*Enabled*/,
      "Position": {
        "X": -200.0,
        "Y": 75.0
      },
      "Description": "Enables or disables pose detection."
    },
    {
      "InputId": "67890abc-def1-2345-6789-0abcdef12345"/*MaxPoses*/,
      "Position": {
        "X": -200.0,
        "Y": 150.0
      },
      "Description": "Maximum number of poses to detect."
    },
    {
      "InputId": "7890abcd-ef12-3456-7890-abcdef123456"/*MinPoseDetectionConfidence*/,
      "Position": {
        "X": -200.0,
        "Y": 225.0
      },
      "Description": "Minimum confidence score for pose detection to be considered successful."
    },
    {
      "InputId": "890abcde-f123-4567-890a-bcdef1234567"/*MinPosePresenceConfidence*/,
      "Position": {
        "X": -200.0,
        "Y": 300.0
      },
      "Description": "Minimum confidence score for pose presence to be considered successful."
    },
    {
      "InputId": "90abcdef-1234-5678-90ab-cdef12345678"/*MinTrackingConfidence*/,
      "Position": {
        "X": -200.0,
        "Y": 375.0
      },
      "Description": "Minimum confidence score for pose tracking."
    },
    {
      "InputId": "a1b2c3d4-0007-4a9b-8c2d-101010101010"/*Acceleration*/,
      "Position": {
        "X": -200.0,
        "Y": 675.0
      },
      "Description": "Inference acceleration: Cpu = plain single-threaded TF Lite (works everywhere), Xnnpack = multithreaded CPU (the fast default), Gpu = OpenGL/EGL delegate (Linux; the Windows/macOS natives are CPU-only and fall back to Cpu)."
    },
    {
      "InputId": "a1b2c3d4-1007-4a9b-8c2d-101010101010"/*InferenceThreads*/,
      "Position": {
        "X": -200.0,
        "Y": 750.0
      },
      "Min": 0,
      "Max": 16,
      "Description": "Xnnpack worker threads (default 4; 0 = library default, which is effectively single-threaded). Lower it to 2 when several MediaPipe operators run at once. Ignored by Cpu and Gpu."
    },
    {
      "InputId": "abcdef12-3456-7890-abcd-ef1234567890"/*CorrectAspectRatio*/,
      "Position": {
        "X": -200.0,
        "Y": 525.0
      },
      "Description": "Whether to correct aspect ratio for non-square inputs."
    },
    {
      "InputId": "bcdef123-4567-890a-bcde-f1234567890a"/*ZScale*/,
      "Position": {
        "X": -200.0,
        "Y": 600.0
      },
      "Description": "Scale factor for Z coordinate of points."
    }
  ],
  "SymbolChildUis": [],
  "OutputUis": [
    {
      "OutputId": "cdef1234-5678-90ab-cdef-1234567890ab"/*OutputTexture*/,
      "Position": {
